#!/bin/bash
export PATH=$PATH:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin:~/bin

# 管理系统服务和配置需要 root 权限。
if [ $(id -u) != "0" ]; then
    echo "错误：必须使用 root 用户运行此命令。"
    exit 1
else
    if env |grep -q SUDO; then
        acme_sh_sudo="-f"
    fi
fi

Text_Display_Width()
{
    local text="$1" bytes ascii_bytes wide_chars
    bytes=$(printf '%s' "${text}" | LC_ALL=C wc -c)
    ascii_bytes=$(printf '%s' "${text}" | LC_ALL=C tr -cd '\000-\177' | wc -c)
    wide_chars=$(( (bytes - ascii_bytes) / 3 ))
    printf '%d' $((ascii_bytes + wide_chars * 2))
}

Print_Banner()
{
    local width=72 border text text_width padding left right
    for text in "$@"; do
        text_width=$(Text_Display_Width "${text}")
        [ "${text_width}" -gt "${width}" ] && width=${text_width}
    done
    border=$(printf '%*s' "${width}" '' | tr ' ' '-')
    printf '+%s+\n' "${border}"
    for text in "$@"; do
        text_width=$(Text_Display_Width "${text}")
        padding=$((width - text_width))
        left=$((padding / 2))
        right=$((padding - left))
        printf '|%*s%s%*s|\n' "${left}" '' "${text}" "${right}" ''
    done
    printf '+%s+\n' "${border}"
}

Print_Banner "LNMPA 管理工具" 

# 服务名由 Detect_Managed_Services 在每次执行时按当前系统重新确定。
NGINX_SERVICE=
APACHE_SERVICE=
DB_SERVICE=

arg1=$1
arg2=$2
# database export/import 需要库名和文件名两个附加参数。
arg3=$3
arg4=$4

# 通知函数安装在 /bin/lnmp-tgnotice，载入后可由管理命令直接调用。
[ -r /bin/lnmp-tgnotice ] && . /bin/lnmp-tgnotice

# Svc <服务名> <动作>
# 服务操作优先通过 systemd 执行，使进程状态与 systemctl 及监控结果一致。
Systemd_Service_Exists()
{
    local service="$1" dir template

    for dir in /etc/systemd/system /lib/systemd/system /usr/lib/systemd/system; do
        [ -s "${dir}/${service}.service" ] && return 0
    done
    # 模板实例（如 php-fpm@8.3）没有独立 unit 文件，改判其模板是否存在。
    case "${service}" in
    *@*)
        template="${service%@*}@"
        for dir in /etc/systemd/system /lib/systemd/system /usr/lib/systemd/system; do
            [ -s "${dir}/${template}.service" ] && return 0
        done
        ;;
    esac
    return 1
}

Service_Exists()
{
    local service="$1"
    Systemd_Service_Exists "${service}" || [ -x "/etc/init.d/${service}" ]
}

Detect_Managed_Services()
{
    NGINX_SERVICE=
    APACHE_SERVICE=
    DB_SERVICE=
    Service_Exists nginx && NGINX_SERVICE=nginx
    Service_Exists httpd && APACHE_SERVICE=httpd
    if Service_Exists mariadb; then
        DB_SERVICE=mariadb
    elif Service_Exists mysql; then
        DB_SERVICE=mysql
    fi
}

Svc()
{
    local service="$1" action="$2"

    [ -z "${service}" ] && return 0

    case "${action}" in
    start|stop|restart|reload|status)
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1 \
           && Systemd_Service_Exists "${service}"; then
            systemctl --no-pager "${action}" "${service}.service"
            return $?
        fi
        ;;
    esac

    if [ -x "/etc/init.d/${service}" ]; then
        "/etc/init.d/${service}" "${action}"
        return $?
    fi
    echo "${service}: 既没有 systemd unit 也没有 /etc/init.d 脚本，跳过。"
    return 1
}

Svc_If_Installed()
{
    local label="$1" service="$2" action="$3"
    if [ -z "${service}" ]; then
        echo "${label}: 未检测到已安装服务，跳过 ${action}。"
        return 0
    fi
    Svc "${service}" "${action}"
}

# systemctl 成功时通常不输出内容，因此管理命令补充明确的成功或失败结果。
# status 已包含完整状态，不再重复提示。
Svc_Feedback()
{
    local service="$1" action="$2" rc

    Svc "${service}" "${action}"
    rc=$?

    case "${action}" in
    ''|status)
        ;;
    *)
        if [ ${rc} -eq 0 ]; then
            Echo_Green "${service} ${action} 成功"
        else
            Echo_Red "${service} ${action} 失败（退出码 ${rc}）"
            case "${service}" in
            mysql|mariadb) Diagnose_DB_Start_Failure "${action}" ;;
            nginx|httpd)   Diagnose_Web_Start_Failure "${service}" ;;
            esac
        fi
        ;;
    esac

    return ${rc}
}

# 输出服务对应的进程名。服务名与进程名不一致时在这里映射。
Svc_Process_Names()
{
    case "$1" in
    mariadb) echo "mariadbd mysqld" ;;
    mysql)   echo "mysqld" ;;
    *)       echo "$1" ;;
    esac
}

# 服务有进程在运行时返回 0。缺少 pgrep 时一律按未运行处理，
# 宁可给排错命令，也不给可能无效的 kill 建议。
Svc_Process_Running()
{
    local name
    command -v pgrep >/dev/null 2>&1 || return 1
    for name in $(Svc_Process_Names "$1"); do
        pgrep -x "${name}" >/dev/null 2>&1 && return 0
    done
    return 1
}

Check_Svc_State()
{
    local service state stray='' down=''

    [ -d /run/systemd/system ] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0

    for service in "$@"; do
        [ -z "${service}" ] && continue
        Systemd_Service_Exists "${service}" || continue
        state=$(systemctl is-active "${service}.service" 2>/dev/null)
        [ "${state}" = "active" ] && continue
        # unit 设了 Restart= 后，重启期间状态为 activating，此时尚未出结果，
        # 判定为异常会产生误报。
        case "${state}" in
            activating|deactivating|reloading) continue ;;
        esac
        # 进程在跑但 unit 不是 active，才是 systemd 之外启动导致的状态不一致；
        # 进程不在，说明启动确实失败，此时提示 kill 只会重复同一个失败。
        if Svc_Process_Running "${service}"; then
            stray="${stray} ${service}"
        else
            down="${down} ${service}"
        fi
    done

    [ -z "${stray}" ] && [ -z "${down}" ] && return 0

    if [ -n "${stray}" ]; then
        echo "警告：以下服务在运行，但不受 systemd 管理：${stray}"
        echo "      它们被 systemd 之外的方式启动过，systemctl 无法停止或重载。"
        echo "      执行 lnmp kill 后再 lnmp start，可让两边重新对齐。"
    fi
    if [ -n "${down}" ]; then
        echo "警告：以下服务未能启动：${down}"
        echo "      查看失败原因："
        for service in ${down}; do
            echo "        systemctl status ${service}.service"
            echo "        journalctl -xeu ${service}.service"
        done
    fi
    return 1
}

lnmpa_start()
{
    local failed=0
    echo "正在启动 LNMPA..."
    Svc_If_Installed Nginx "${NGINX_SERVICE}" start || failed=1
    Svc_If_Installed Database "${DB_SERVICE}" start ||
        { failed=1; Diagnose_DB_Start_Failure start; }
    Svc_If_Installed Apache "${APACHE_SERVICE}" start || failed=1
    Check_Svc_State "${NGINX_SERVICE}" "${DB_SERVICE}" "${APACHE_SERVICE}" || failed=1
    return ${failed}
}

lnmpa_stop()
{
    local failed=0
    echo "正在停止 LNMPA..."
    Svc_If_Installed Nginx "${NGINX_SERVICE}" stop || failed=1
    Svc_If_Installed Database "${DB_SERVICE}" stop || failed=1
    Svc_If_Installed Apache "${APACHE_SERVICE}" stop || failed=1
    return ${failed}
}

lnmpa_reload()
{
    local failed=0
    echo "正在重载 LNMPA..."
    Svc_If_Installed Nginx "${NGINX_SERVICE}" reload || failed=1
    Svc_If_Installed Database "${DB_SERVICE}" reload || failed=1
    # httpd.service 的 ExecReload 执行 httpd -k graceful。
    Svc_If_Installed Apache "${APACHE_SERVICE}" reload || failed=1
    return ${failed}
}

# Kill_Process <进程名> [等待秒数]
# 先 TERM 并等待进程真正退出，超时才 KILL。不等待会让随后的 start 撞上
# 尚未释放的端口或 pid 文件。目标进程本就不存在时静默返回 0。
Kill_Process()
{
    local name="$1" wait_sec="${2:-10}" i

    if ! command -v pgrep >/dev/null 2>&1 || ! command -v pkill >/dev/null 2>&1; then
        # 缺少 procps 时退回 killall，此路径无法确认进程是否已退出。
        if command -v killall >/dev/null 2>&1; then
            killall "${name}" 2>/dev/null
            return 0
        fi
        Echo_Red "缺少 pkill 和 killall，无法终止 ${name}，请安装 procps。"
        return 1
    fi

    pgrep -x "${name}" >/dev/null 2>&1 || return 0
    pkill -x "${name}" 2>/dev/null
    i=0
    while [ ${i} -lt ${wait_sec} ]; do
        pgrep -x "${name}" >/dev/null 2>&1 || return 0
        sleep 1
        i=$((i + 1))
    done

    Echo_Yellow "${name} 未响应 TERM，改用 KILL 强制终止。"
    echo
    pkill -9 -x "${name}" 2>/dev/null
    sleep 1
    pgrep -x "${name}" >/dev/null 2>&1 || return 0
    Echo_Red "${name} 进程未能终止，请手工检查。"
    return 1
}

# 先按 unit 停止再清残留：unit 设了 Restart=on-failure 时，直接发信号会被
# systemd 判为异常退出并重新拉起；systemctl stop 属主动停止，不触发重启。
Kill_By_Unit()
{
    local svc
    for svc in "$@"; do
        [ -z "${svc}" ] && continue
        Systemd_Service_Exists "${svc}" || continue
        Svc "${svc}" stop >/dev/null 2>&1
    done
}

lnmpa_kill()
{
    local failed=0
    echo "正在终止 Nginx、Apache 和数据库进程..."

    Kill_By_Unit "${NGINX_SERVICE}" "${APACHE_SERVICE}" "${DB_SERVICE}"

    Kill_Process nginx || failed=1
    Kill_Process httpd || failed=1
    # MariaDB 的进程名是 mariadbd，两者只会有一个存在。
    # 数据库关闭要刷缓冲池，给更长的等待时间。
    Kill_Process mysqld 30 || failed=1
    Kill_Process mariadbd 30 || failed=1
    [ ${failed} -eq 0 ] && echo "完成。"
    return ${failed}
}

lnmpa_status()
{
    Svc_If_Installed Nginx "${NGINX_SERVICE}" status
    Svc_If_Installed Database "${DB_SERVICE}" status
    Svc_If_Installed Apache "${APACHE_SERVICE}" status
    if [ -s /usr/local/phpmyadmin/.access_url ] &&
       [ -s /usr/local/nginx/conf/phpmyadmin.enable.conf ] &&
       [ -s /usr/local/apache/conf/extra/phpmyadmin.enable.conf ]; then
        echo "phpMyAdmin: http://<服务器IP>/$(cat /usr/local/phpmyadmin/.access_url)/"
    elif [ -s /usr/local/phpmyadmin/.access_url ]; then
        echo "phpMyAdmin：访问已禁用（程序和配置仍保留）"
    fi
}
# ---------------------------------------------------------------------------
# 应用托管：Node、Go 等自带后端进程的站点
# 元数据在 /etc/lnmp/apps/<名字>.env，由 init.d/lnmp-app@.service 读取。
# ---------------------------------------------------------------------------
App_Conf_Dir="/etc/lnmp/apps"
App_Unit_Tpl="/etc/systemd/system/lnmp-app@.service"

# 应用名同时用于 unit 实例名、专属账号名和文件名，字符集必须收紧。
# 账号名为 lnmp-app-<名字>，Linux 用户名上限 32 字符，故名字最长 23。
Check_App_Name()
{
    local n="$1"

    if [ -z "${n}" ]; then
        Echo_Red "应用名不能为空。"
        return 1
    fi
    if [ ${#n} -gt 23 ]; then
        Echo_Red "应用名过长（超过 23 字符）：${n}"
        return 1
    fi
    if ! printf '%s' "${n}" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'; then
        Echo_Red "应用名不合法：'${n}'"
        Echo_Red "只接受小写字母、数字和中划线，且必须以字母或数字开头结尾。"
        return 1
    fi
    return 0
}

App_Env_File()  { echo "${App_Conf_Dir}/$1.env"; }
App_User_Name() { echo "lnmp-app-$1"; }
App_Unit_Name() { echo "lnmp-app@$1.service"; }

App_Exists()
{
    [ -s "$(App_Env_File "$1")" ]
}

# 读取应用元数据到 App_Dir / App_Exec / App_Port。
App_Load()
{
    local name="$1" env_file
    env_file=$(App_Env_File "${name}")

    App_Dir=$(awk -F= '$1 == "APP_DIR" { sub(/^APP_DIR=/, ""); print; exit }' "${env_file}")
    App_Exec=$(awk -F= '$1 == "APP_EXEC" { sub(/^APP_EXEC=/, ""); print; exit }' "${env_file}")
    App_Port=$(awk -F= '$1 == "APP_PORT" { sub(/^APP_PORT=/, ""); print; exit }' "${env_file}")
    return 0
}

# 端口被别的进程占用时拒绝，避免应用起来后与现有服务抢端口。
Check_App_Port()
{
    local port="$1"

    [ -z "${port}" ] && return 0
    if ! printf '%s' "${port}" | grep -Eq '^[0-9]+$' \
       || [ "${port}" -lt 1 ] || [ "${port}" -gt 65535 ]; then
        Echo_Red "端口不合法：${port}"
        return 1
    fi
    if command -v ss >/dev/null 2>&1 \
       && ss -lntH 2>/dev/null | awk '{print $4}' | sed -E 's/.*:([0-9]+)$/\1/' \
          | grep -qx "${port}"; then
        Echo_Red "端口 ${port} 已被占用。"
        return 1
    fi
    return 0
}

# 模板 unit 由安装流程写入；命令行单独使用时按需补装。
Ensure_App_Unit_Tpl()
{
    if [ ! -s "${App_Unit_Tpl}" ]; then
        Echo_Red "缺少应用托管单元 ${App_Unit_Tpl}。"
        Echo_Yellow "请重新执行安装包中的收尾步骤，或手工放置 init.d/lnmp-app@.service。"
        return 1
    fi
    if ! command -v systemctl >/dev/null 2>&1 || [ ! -d /run/systemd/system ]; then
        Echo_Red "当前系统未运行 systemd，无法托管应用进程。"
        return 1
    fi
    return 0
}
# 目录已被其它托管应用使用时拒绝：chown -R 会夺走对方的属主。
App_Dir_In_Use()
{
    local dir="$1" env_file other other_dir

    [ -d "${App_Conf_Dir}" ] || return 1
    for env_file in "${App_Conf_Dir}"/*.env; do
        [ -s "${env_file}" ] || continue
        other=$(basename "${env_file}" .env)
        other_dir=$(awk -F= '$1 == "APP_DIR" { sub(/^APP_DIR=/, ""); print; exit }' "${env_file}")
        if [ "${other_dir}" = "${dir}" ]; then
            Echo_Red "目录 ${dir} 已被应用 ${other} 使用。"
            Echo_Red "（递归改属主会夺走该应用的目录属主。）"
            return 0
        fi
    done
    return 1
}


Add_App()
{
    local name dir exec_cmd port user env_file bin

    Ensure_App_Unit_Tpl || return 1

    while :; do
        Echo_Yellow "请输入应用名（小写字母、数字、中划线）: "
        Read_Input name "应用名"
        Check_App_Name "${name}" || continue
        if App_Exists "${name}"; then
            Echo_Red "应用 ${name} 已存在，请先用 lnmp app del 删除或换一个名字。"
            continue
        fi
        break
    done

    while :; do
        Echo_Yellow "请输入应用目录（绝对路径）: "
        Read_Input dir "应用目录"
        # 复用站点目录的边界校验：随后要对该目录执行 chown -R，
        # 必须挡住 /etc、/usr 这类系统目录、允许根本身和符号链接越界。
        if ! Check_Vhost_Dir "${dir}"; then
            Echo_Red "该目录不能作为应用目录，请另选。"
            continue
        fi
        if [ ! -d "${dir}" ]; then
            Echo_Red "目录不存在：${dir}"
            continue
        fi
        App_Dir_In_Use "${dir}" && continue
        break
    done

    while :; do
        Echo_Yellow "请输入启动命令（含绝对路径，如 /usr/bin/node server.js）: "
        Read_Input exec_cmd "启动命令"
        if [ -z "${exec_cmd}" ]; then
            Echo_Red "启动命令不能为空。"
            continue
        fi
        # 换行会破坏 EnvironmentFile 的一行一项格式。
        case "${exec_cmd}" in
        *$'\n'*) Echo_Red "启动命令不能包含换行。"; continue ;;
        esac
        bin=${exec_cmd%% *}
        case "${bin}" in
        /*) ;;
        *)  Echo_Red "启动命令的可执行文件必须写绝对路径：${bin}"; continue ;;
        esac
        if [ ! -x "${bin}" ]; then
            Echo_Red "不是可执行文件：${bin}"
            continue
        fi
        break
    done

    while :; do
        Echo_Yellow "请输入监听端口（留空跳过检查）: "
        Read_Input port "监听端口"
        Check_App_Port "${port}" || continue
        break
    done

    user=$(App_User_Name "${name}")
    if ! id -u "${user}" >/dev/null 2>&1; then
        # 专属账号，不复用 www：复用会让应用获得全部站点目录的读写权限。
        if ! useradd -r -M -s /sbin/nologin "${user}" 2>/dev/null \
           && ! useradd -r -M -s /usr/sbin/nologin "${user}" 2>/dev/null; then
            Echo_Red "创建运行账号 ${user} 失败。"
            return 1
        fi
        echo "已创建运行账号 ${user}。"
    fi

    if ! mkdir -p "${App_Conf_Dir}"; then
        Echo_Red "创建 ${App_Conf_Dir} 失败。"
        return 1
    fi
    chmod 750 "${App_Conf_Dir}"

    env_file=$(App_Env_File "${name}")
    if ! cat >"${env_file}"<<EOF
APP_DIR=${dir}
APP_EXEC=${exec_cmd}
APP_PORT=${port}
EOF
    then
        Echo_Red "写入 ${env_file} 失败。"
        return 1
    fi
    chmod 640 "${env_file}"

    # 应用需要读取自己的目录，交给专属账号。
    # 递归改属主前再次复核边界：dir 到这里为止经过了多次赋值与交互输入。
    if ! Check_Vhost_Dir "${dir}" || [ ! -d "${dir}" ]; then
        Echo_Red "应用目录 ${dir} 未通过写入前复核，已取消托管。"
        rm -f "${env_file}"
        return 1
    fi
    if ! chown -R "${user}:${user}" "${dir}"; then
        Echo_Yellow "变更 ${dir} 属主失败，请确认应用账号对该目录有读取权限。"
    fi

    systemctl daemon-reload
    if ! systemctl enable --now "$(App_Unit_Name "${name}")"; then
        Echo_Red "启动应用 ${name} 失败，配置已保留。"
        Echo_Yellow "可执行 lnmp app logs ${name} 查看原因。"
        return 1
    fi

    echo "========================================================"
    echo "应用 ${name} 已托管并设为开机启动。"
    echo "目录：${dir}"
    echo "命令：${exec_cmd}"
    [ -n "${port}" ] && echo "端口：${port}"
    echo "运行账号：${user}"
    echo "查看日志：lnmp app logs ${name}"
    [ -n "${port}" ] && echo "反向代理请执行 lnmp vhost add 建站后按 127.0.0.1:${port} 配置。"
    echo "========================================================"
    return 0
}

List_App()
{
    local env_file name state

    if [ ! -d "${App_Conf_Dir}" ] || [ -z "$(ls -A "${App_Conf_Dir}" 2>/dev/null)" ]; then
        echo "当前没有托管的应用。"
        return 0
    fi
    printf '%-24s %-10s %-8s %s\n' "应用名" "状态" "端口" "目录"
    for env_file in "${App_Conf_Dir}"/*.env; do
        [ -s "${env_file}" ] || continue
        name=$(basename "${env_file}" .env)
        App_Load "${name}"
        state=$(systemctl is-active "$(App_Unit_Name "${name}")" 2>/dev/null)
        printf '%-24s %-10s %-8s %s\n' "${name}" "${state:-unknown}" "${App_Port:-—}" "${App_Dir}"
    done
    return 0
}

Del_App()
{
    local name="$1" user env_file answer

    if [ -z "${name}" ]; then
        List_App
        while :; do
            Echo_Yellow "请输入要删除的应用名: "
            Read_Input name "应用名"
            Check_App_Name "${name}" || continue
            break
        done
    else
        Check_App_Name "${name}" || return 1
    fi

    if ! App_Exists "${name}"; then
        Echo_Red "应用 ${name} 不存在。"
        return 1
    fi

    App_Load "${name}"
    user=$(App_User_Name "${name}")
    env_file=$(App_Env_File "${name}")

    systemctl disable --now "$(App_Unit_Name "${name}")" >/dev/null 2>&1
    systemctl reset-failed "$(App_Unit_Name "${name}")" >/dev/null 2>&1
    rm -f "${env_file}"

    # 账号可能仍拥有应用目录，交由用户决定是否删除。
    if id -u "${user}" >/dev/null 2>&1; then
        Echo_Yellow "是否删除运行账号 ${user}？(y/N) "
        if read -r answer && [ "${answer}" = "y" -o "${answer}" = "Y" ]; then
            userdel "${user}" >/dev/null 2>&1 \
                && echo "已删除账号 ${user}。" \
                || Echo_Yellow "删除账号 ${user} 失败，请手工处理。"
        else
            echo "保留账号 ${user}。"
        fi
    fi

    systemctl daemon-reload
    echo "========================================================"
    echo "应用 ${name} 已取消托管。"
    echo "为安全起见，应用目录 ${App_Dir} 不会被自动删除。"
    echo "站点的反向代理配置需要另行用 lnmp vhost del 处理。"
    echo "========================================================"
    return 0
}

# start/stop/restart/status 统一走 systemd，与其余服务的语义保持一致。
App_Ctl()
{
    local action="$1" name="$2"

    if [ -z "${name}" ]; then
        Echo_Red "请指定应用名：lnmp app ${action} <应用名>"
        return 1
    fi
    Check_App_Name "${name}" || return 1
    if ! App_Exists "${name}"; then
        Echo_Red "应用 ${name} 不存在。"
        return 1
    fi
    systemctl --no-pager "${action}" "$(App_Unit_Name "${name}")"
}

Logs_App()
{
    local name="$1"

    if [ -z "${name}" ]; then
        Echo_Red "请指定应用名：lnmp app logs <应用名>"
        return 1
    fi
    Check_App_Name "${name}" || return 1
    if ! App_Exists "${name}"; then
        Echo_Red "应用 ${name} 不存在。"
        return 1
    fi
    if ! command -v journalctl >/dev/null 2>&1; then
        Echo_Red "系统没有 journalctl，无法查看应用日志。"
        return 1
    fi
    journalctl -u "$(App_Unit_Name "${name}")" -n 100 --no-pager
}

Function_App()
{
    case "$1" in
        [aA][dD][dD])
            Add_App
            ;;
        [lL][iI][sS][tT])
            List_App
            ;;
        [dD][eE][lL])
            Del_App "$2"
            ;;
        [sS][tT][aA][rR][tT]|[sS][tT][oO][pP]|[rR][eE][sS][tT][aA][rR][tT]|[sS][tT][aA][tT][uU][sS])
            App_Ctl "$(echo "$1" | tr '[:upper:]' '[:lower:]')" "$2"
            ;;
        [lL][oO][gG][sS])
            Logs_App "$2"
            ;;
        *)
            echo "用法：lnmp app {add|list|del|start|stop|restart|status|logs}"
            echo "      lnmp app {del|start|stop|restart|status|logs} <应用名>"
            exit 1
            ;;
    esac
}


