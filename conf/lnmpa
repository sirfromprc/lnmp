        [aA][dD][dD])
            Add_Database_Menu && Add_Database
            ;;
        [lL][iI][sS][tT])
            List_Database
            ;;
        [dD][eE][lL])
            Del_Database
            ;;
        [eE][dD][iI][tT])
            Edit_Database
            ;;
        [eE][xX][pP][oO][rR][tT])
            Export_Database "$2" "$3"
            ;;
        [iI][mM][pP][oO][rR][tT])
            Import_Database "$2" "$3"
            ;;
