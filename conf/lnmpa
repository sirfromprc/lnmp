Add_SSL()
{
    local vhost_conf="/usr/local/nginx/conf/vhost/${domain}.conf"
    local apache_vhost_conf

    if [ "${domain}" = "default" ]; then
        apache_vhost_conf="/usr/local/apache/conf/extra/httpd-vhosts.conf"
    else
        apache_vhost_conf="/usr/local/apache/conf/vhost/${domain}.conf"
    fi

    if [ ! -s "${vhost_conf}" ] && [ ! -s "${apache_vhost_conf}" ]; then
        Echo_Red "未找到网站 ${domain} 的虚拟主机配置。"
        Echo_Yellow "请先执行 lnmp vhost add 创建网站，再执行 lnmp ssl add 添加证书。"
        echo
        return 1
    fi
    if [ ! -s "${vhost_conf}" ] || [ ! -s "${apache_vhost_conf}" ]; then
        Echo_Red "网站 ${domain} 的 LNMPA 虚拟主机配置不完整，无法添加证书。"
        return 1
    fi
    if [ -z "${vhostdir:-}" ] || [ ! -d "${vhostdir}" ]; then
        Echo_Red "网站 ${domain} 的根目录不存在，无法添加证书。"
        return 1
    fi
    if [[ "${domain}" = "default" && ! "${ssl_choice}" =~ ^(1|2)$ ]]; then
        Echo_Red "default 站点只支持自有证书或 Let's Encrypt IP 证书。"
        return 1
    fi

    if [ "${ssl_choice}" == "1" ]; then
        Verify_Own_Cert "${ssl_certificate}" "${ssl_certificate_key}" \
            "${domain}" "${moredomain}" || return 1
        Create_SSL_Config || return 1
    elif [[ "${ssl_choice}" =~ ^(2|3)$ ]]; then
        cert_profile_opt=""
        letsdomain="-d ${domain}"
        if [ "${moredomain}" != "" ]; then
            # 泛域名带 *，拆分期间关闭路径展开。
            set -f
            for i in ${moredomain};do
                # HTTP-01 不能签发泛域名，站点配置里已有的泛域名不带入本次证书。
                case "${i}" in
                \*.*)
                    Echo_Yellow "HTTP 验证不能签发泛域名，${i} 不加入本次证书。"
                    echo
                    continue
                    ;;
                esac
                letsdomain=${letsdomain}" -d ${i}"
            done
            set +f
        fi
        if [ "${domain}" = "default" ]; then
            Prepare_Default_Site_IP_Cert || return 1
        fi
        if [[ "${vhostdir}" == "" || "${letsdomain}" == "" ]]; then
            Echo_Red "缺少必要参数：网站目录和证书申请目标不能为空。"
            return 1
        fi

        Install_Check_Acme.sh || return 1

        Backup_Cert_Dir "/usr/local/nginx/conf/ssl/${domain}" || return 1
        acme_target="${domain}"
        [ "${domain}" = "default" ] && acme_target="${default_site_ip}"
        Note_Acme_Workdir "/usr/local/nginx/conf/ssl" "${acme_target}"

        if [ "${ssl_choice}" == "2" ]; then
            echo "正在使用 Let's Encrypt 签发 SSL 证书..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server letsencrypt --issue ${letsdomain} -w ${vhostdir} ${cert_profile_opt} --reloadcmd "/etc/init.d/nginx reload"
        elif [ "${ssl_choice}" == "3" ]; then
            echo "正在使用 ZeroSSL 签发 SSL 证书..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server zerossl --issue ${letsdomain} -w ${vhostdir} --reloadcmd "/etc/init.d/nginx reload"
        fi
        lets_status=$?

        if [ "${lets_status}" = 0 ]; then
            cert_install_domain="${domain}"
            [ "${domain}" = "default" ] && cert_install_domain="${default_site_ip}"
            mkdir -p "/usr/local/nginx/conf/ssl/${domain}" || { Restore_Cert_Dir; return 1; }
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --install-cert -d "${cert_install_domain}" --ecc \
                --key-file "/usr/local/nginx/conf/ssl/${domain}/${domain}.key" \
                --fullchain-file "/usr/local/nginx/conf/ssl/${domain}/fullchain.cer" \
                --reloadcmd "/etc/init.d/nginx reload"
            lets_status=$?
        fi

        ssl_certificate="/usr/local/nginx/conf/ssl/${domain}/fullchain.cer"
        ssl_certificate_key="/usr/local/nginx/conf/ssl/${domain}/${domain}.key"
        if [ "${lets_status}" = 0 ]; then
            Create_SSL_Config || { Restore_Cert_Dir; return 1; }
            Discard_Cert_Backup
            Echo_Green "SSL 证书签发成功。"
        else
            Restore_Cert_Dir
            Cleanup_Failed_Acme_Workdir
            Echo_Red "SSL 证书签发失败。"
            return 1
        fi
    fi
    return 0
}

