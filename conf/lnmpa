        ;;
    status)
        lnmpa_status
        ;;
    nginx)
        Svc nginx ${arg2}
        ;;
    mysql)
        Svc mysql ${arg2}
        ;;
    mariadb)
        Svc mariadb ${arg2}
        ;;
    pureftpd)
        Svc pureftpd ${arg2}
        ;;
    httpd)
        Svc httpd ${arg2}
        ;;
    vhost)
        Function_Vhost ${arg2}
        ;;
    database)
        Verify_DB_Password || exit 1
        Function_Database "${arg2}" "${arg3}" "${arg4}"
        db_rc=$?
        TempMycnf_Clean
        exit ${db_rc}
        ;;
    ftp)
        Check_Pureftpd
        Function_Ftp "${arg2}"
        exit $?
        ;;
    backup)
        # backup 子命令参数数量不同，移除命令名后完整转交。
        shift
        Function_Backup "$@"
        exit $?
        ;;
    tgnotice|notice)
        shift
        if [ ! -x /bin/lnmp-tgnotice ]; then
            Echo_Red "找不到 /bin/lnmp-tgnotice，安装不完整。"
            Echo_Red "补装：cp tools/lnmp-tgnotice.sh /bin/lnmp-tgnotice && chmod +x /bin/lnmp-tgnotice"
            exit 1
        fi
        /bin/lnmp-tgnotice "$@"
        exit $?
        ;;
    phpmyadmin)
        /bin/lnmp-phpmyadmin lnmpa "${arg2}"
        exit $?
        ;;
    ssl)
        info="n"
        Add_SSL_Menu || exit $?
        Add_SSL || exit $?
        ;;
    dnsssl|dns)
        Add_Dns_SSL ${arg2}
        ;;
    onlyssl)
        Add_Dns_SSL_Only ${arg2}
        ;;
    *)
        echo "用法：lnmp {start|stop|reload|restart|kill|status}"
        echo "用法：lnmp {nginx|mysql|mariadb|pureftpd|httpd} {start|stop|reload|restart|kill|status}"
        echo "用法：lnmp vhost {add|list|del}"
        echo "用法：lnmp database {add|list|edit|del}"
        echo "用法：lnmp database export <数据库名> <文件.sql.gz>"
        echo "用法：lnmp database import <数据库名> <文件.sql.gz>"
        echo "用法：lnmp ftp {add|list|edit|del|show}"
        echo "用法：lnmp backup {init|run|status|list|restore|test}"
        echo "用法：lnmp backup run [db|web|all] [域名...]"
        echo "用法：lnmp tgnotice {--init|--test|--status} | lnmp tgnotice \"文本\" [md]"
        echo "用法：lnmp phpmyadmin {enable|disable|status}"
        echo "用法：lnmp ssl add"
        echo "用法：lnmp {dnsssl|dns} {cx|ali|cf|dp|he|gd|aws}"
        echo "用法：lnmp onlyssl {cx|ali|cf|dp|he|gd|aws}"
esac
exit
