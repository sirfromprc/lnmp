}

Function_Backup()
{
    # 三种运行模式共用 /bin/lnmp-backup，避免备份行为不一致。
    local bin="/bin/lnmp-backup"
    if [ ! -x "${bin}" ]; then
        Echo_Red "找不到 ${bin}，安装不完整。"
        Echo_Red "可从源码目录补装："
        Echo_Red "  cp tools/lnmp-backup.sh /bin/lnmp-backup && chmod +x /bin/lnmp-backup"
        return 1
    fi
    "${bin}" "$@"
}

Function_Ftp()
{
    case "$1" in
        [aA][dD][dD])
            Add_Ftp_Menu && Add_Ftp
            ;;
        [lL][iI][sS][tT])
            List_Ftp
            ;;
        [dD][eE][lL])
            Del_Ftp
            ;;
        [eE][dD][iI][tT])
            Edit_Ftp
            ;;
        [eE][xX][iI][tT])
            return 1
            ;;
        [sS][hH][oO][wW])
            Show_Ftp
            ;;
        *)
            echo "用法：lnmp ftp {add|list|edit|del|show}"
            return 1
            ;;
esac
}

# 站点级 PHP 开关：默认由 Nginx 将 PHP 请求转发给 Apache；关闭后两端均拒绝 PHP。
# 非交互执行通过 VHOST_PHP=n 关闭 PHP，未设置时保持默认开启。
Site_PHP_Menu()
{
    local answer
    if [ ! -t 0 ]; then
        case "${VHOST_PHP}" in
            [nN])
                enable_site_php="n"
                echo "非交互执行，按 VHOST_PHP=n 关闭本站点的 PHP。"
                ;;
            *)
                enable_site_php="y"
                echo "非交互执行，本站点默认开启 PHP（如需关闭，设置环境变量 VHOST_PHP=n）。"
                ;;
        esac
        return 0
    fi

    while :;do
        Echo_Yellow "是否开启 PHP [Y/n]（默认 y）: "
        if ! read answer; then
            echo
            echo "读取 PHP 开关时遇到 EOF，按默认值开启 PHP。"
            enable_site_php="y"
            break
        fi
        case "${answer}" in
            ""|[yY])
                enable_site_php="y"
                echo "已开启 PHP。"
                break
                ;;
            [nN])
                enable_site_php="n"
                echo "已关闭 PHP，本站点不执行任何 .php。"
                break
                ;;
            *)
                Echo_Red "请输入 y 或 n。"
                ;;
        esac
    done
}

# Nginx 的 HTTP 与 HTTPS 共用以下规则，防止未解析的 .php 文件作为静态内容泄露。
Site_PHP_Off_Block()
{
    cat <<'EOF'
# 本站点未开启 PHP，.php 及其 PATH_INFO 请求统一返回 404，防止源码泄露。
        # 整站反向代理需要由后端处理 .php 路径时，可删除此 location。
        location ~ [^/]\.php(/|$) {
            return 404;
        }
EOF
}

# Apache 同时拒绝 PHP，防止绕过 Nginx 直接访问 88 端口。
Site_Apache_PHP_Off_Block()
{
    cat <<'EOF'
# 本站点未开启 PHP。php_admin_flag 不受 .htaccess 覆盖；RedirectMatch 防止
# Apache 将未解析的 .php 文件作为普通文件返回。
php_admin_flag engine off
RedirectMatch 404 "\.php(/|$)"
EOF
}

# 未开启 PHP 时，首页候选不包含 PHP 文件。
Site_Index_Line()
{
    if [ "${enable_site_php}" = "n" ]; then
        echo "index index.html index.htm default.html default.htm;"
    else
        echo "index index.html index.htm index.php default.html default.htm default.php;"
    fi
}

Add_VHost_Config()
{
    local vhost_index php_block apache_open_basedir apache_php_off apache_dir_index

    vhost_index="$(Site_Index_Line)"
    php_block="include proxy-pass-php.conf;"
    apache_open_basedir="php_admin_value open_basedir \"${vhostdir}:/tmp/:/var/tmp/:/proc/\""
    apache_php_off=""
    apache_dir_index="DirectoryIndex index.html index.php"
    if [ "${enable_site_php}" = "n" ]; then
        php_block="$(Site_PHP_Off_Block)"
        apache_open_basedir="#php_admin_value open_basedir \"${vhostdir}:/tmp/:/var/tmp/:/proc/\""
        apache_php_off="$(Site_Apache_PHP_Off_Block)"
        apache_dir_index="DirectoryIndex index.html"
    fi

    cat >"/usr/local/nginx/conf/vhost/${domain}.conf"<<EOF
server {
        listen 80;
        #listen [::]:80;
        server_name ${domain} ${moredomain};
        ${vhost_index}
        root  ${vhostdir};

        #error_page   404   /404.html;

        # 可按需禁止指定目录执行 PHP。
        #location ~ /(wp-content|uploads|wp-includes|images)/.*\.php$ { deny all; }

        ${php_block}

        location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
            expires      30d;
        }

        location ~ .*\.(js|css)$ {
            expires      12h;
        }

        location ^~ /.well-known/ {
            allow all;
        }

        location ~ /\. {
            deny all;
        }

        ${al}
    }
EOF
    cat >"/usr/local/apache/conf/vhost/${domain}.conf"<<EOF
<VirtualHost *:88>
ServerAdmin ${email}
${apache_open_basedir}
DocumentRoot "${vhostdir}"
ServerName ${domain}
ErrorLog "/home/wwwlogs/${al_name}-error_log"
CustomLog "/home/wwwlogs/${al_name}-access_log" combined
${apache_php_off}
<Directory "${vhostdir}">
    Options FollowSymLinks
    AllowOverride All
    Require all granted
    ${apache_dir_index}
</Directory>
</VirtualHost>
EOF

    if [ "${access_log}" != 'y' ]; then
        sed -i 's/^ErrorLog/#ErrorLog/g' /usr/local/apache/conf/vhost/${domain}.conf
        sed -i 's/^CustomLog/#CustomLog/g' /usr/local/apache/conf/vhost/${domain}.conf
    fi

    if [ "${moredomain}" != "" ]; then
        sed -i "/ServerName/a\
    ServerAlias ${moredomain}" /usr/local/apache/conf/vhost/${domain}.conf
    fi

    if [ "${enable_ipv6}" == "y" ]; then
        sed -i 's/#listen \[::\]:80;/listen \[::\]:80;/g' /usr/local/nginx/conf/vhost/${domain}.conf
    fi

    echo "正在检查 Nginx 配置......"
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，已撤销本次新增的虚拟主机配置。"
        rm -f "/usr/local/nginx/conf/vhost/${domain}.conf"
        rm -f "/usr/local/apache/conf/vhost/${domain}.conf"
        exit 1
    fi
    echo "正在检查 Apache 配置..."
    if ! /etc/init.d/httpd configtest; then
        Echo_Red "Apache 配置测试未通过，已撤销本次新增的虚拟主机配置。"
        rm -f "/usr/local/nginx/conf/vhost/${domain}.conf"
        rm -f "/usr/local/apache/conf/vhost/${domain}.conf"
        exit 1
    fi
    echo ""
    echo "正在重载 Nginx......"
    /usr/local/nginx/sbin/nginx -s reload
    echo "正在平滑重载 Apache..."
    /etc/init.d/httpd graceful
}

Print_Default_Site_Intro()
{
    Echo_Green "===================================================================="
    Echo_Green " 欢迎使用添加域名站点功能！"
    Echo_Green " 本包已内置 default「兜底站点」保留名，请勿将 default 用作普通站点域名。"
    Echo_Green " 所有未匹配到其它站点的访问请求（包括直接通过服务器 IP 访问）都会进入此站点，"
    Echo_Green " 根目录为 /home/wwwroot/default，无需通过 vhost add 重复创建。"
    Echo_Green "===================================================================="
}

Add_VHost()
{
    Print_Default_Site_Intro
    domain=""
    while :;do
        Echo_Yellow "请输入域名（示例：www.example.com）: "
        read domain
        # default 是安装时创建的兜底站点，不能作为普通域名重复创建。
        if [ "${domain}" = "default" ]; then
            Echo_Green " default 站已安装，是默认兜底站，如需为其配置 SSL 证书，请执行 lnmp ssl add"
            return 0
        fi
        Check_Domain_Name "${domain}" || continue
        if [[ -f "/usr/local/nginx/conf/vhost/${domain}.conf" || -f "/usr/local/apache/conf/vhost/${domain}.conf" ]]; then
            Echo_Red "域名 ${domain} 已存在，请检查。"
            exit 1
        fi
        echo "您的域名：${domain}"
        break
    done

    while :;do
        Echo_Yellow "请输入更多域名（示例：example.com sub.example.com，留空跳过）: "
        read moredomain
        [ -z "${moredomain}" ] && break
        Check_More_Domains "${moredomain}" && break
    done
    if [ "${moredomain}" != "" ]; then
        echo "附加域名：${moredomain}"
    fi

    while :;do
        echo "请输入域名 $domain 的网站目录。"
        Echo_Yellow "网站目录（默认 /home/wwwroot/${domain}）: "
        read vhostdir
        if [ "${vhostdir}" == "" ]; then
            vhostdir="/home/wwwroot/${domain}"
        fi
        # 目录会用于递归创建和授权，因此必须先规范化并限制在站点根目录内。
        Check_Vhost_Dir "${vhostdir}" || exit 1
        # 校验通过后使用规范化的网站目录路径。
        Check_Vhost_Dir "${vhostdir}" && break
    done
    echo "虚拟主机目录：${vhostdir}"

    Site_PHP_Menu

    Echo_Yellow "是否启用访问日志 [y/N]（默认 n）: "
    read access_log
    if [[ "${access_log}" == "n" || "${access_log}" == "" ]]; then
        echo "已禁用访问日志。"
        al="access_log off;"
        al_name="${domain}"
    else
        Echo_Yellow "访问日志文件名（默认 ${domain}.log）: "
        read al_name
        if [ "${al_name}" == "" ]; then
            al_name="${domain}"
        fi
        al="access_log  /home/wwwlogs/${al_name}.log main;"
        echo "访问日志文件名：${al_name}.log"
    fi

    Echo_Yellow "是否启用 IPv6 [y/N]（默认 n）: "
    read enable_ipv6
    if [[ "${enable_ipv6}" == "n" || "${enable_ipv6}" == "" ]]; then
        echo "当前虚拟主机已禁用 IPv6。"
        enable_ipv6="n"
    else
        echo "当前虚拟主机已启用 IPv6。"
        enable_ipv6="y"
    fi

    email=""
    Echo_Yellow "请输入管理员邮箱（默认 webmaster@example.com）: "
    read email
    if [ "${email}" == "" ]; then
        echo "未输入，管理员邮箱将设为 webmaster@example.com。"
        email='webmaster@example.com'
    else
        echo "服务器管理员邮箱：${email}"
    fi

    if [[ -x /usr/local/mysql/bin/mysql || -x /usr/local/mariadb/bin/mariadb || -x /usr/local/mariadb/bin/mysql ]]; then
        Echo_Yellow "是否创建同名数据库和 MySQL 用户 [y/N]（默认 n）: "
        read create_database

        if [ "${create_database}" == "y" ]; then
            Verify_DB_Password || exit 1
            Add_Database_Menu || exit 1
        fi
    fi

    if [ -f /usr/local/pureftpd/sbin/pure-ftpd ]; then
        Echo_Yellow "是否创建 FTP 账号 [y/N]（默认 n）: "
        read create_ftp

        if [ "${create_ftp}" == "y" ]; then
            Add_Ftp_Menu
        fi
    fi

    Echo_Yellow "是否添加 SSL 证书 [y/N]（默认 n）: "
    read create_ssl
    if [ "${create_ssl}" == "y" ]; then
        Add_SSL_Menu
    fi

    echo ""
    echo "按任意键开始创建虚拟主机，或按 Ctrl+C 取消..."
    OLDCONFIG=`stty -g`
    stty -icanon -echo min 1 time 0
    dd count=1 2>/dev/null
    stty ${OLDCONFIG}

    echo "正在创建虚拟主机目录......"
    mkdir -p "${vhostdir}"
    if [ "${access_log}" == "y" ]; then
        touch /home/wwwlogs/${al_name}.log
        touch /home/wwwlogs/${al_name}-access_log
    fi
    echo "正在设置虚拟主机目录权限......"
    chmod -R 755 "${vhostdir}"
    chown -R www:www "${vhostdir}"

    Add_VHost_Config

    if [ "${create_database}" == "y" ]; then
        Add_Database
        database_add_rc=$?
        # 建库完成后立即清理数据库 root 凭据，缩短明文凭据的留存时间。
        TempMycnf_Clean
    fi

    if [ "${create_ftp}" == "y" ]; then
        Add_Ftp
        ftp_add_rc=$?
    fi

    if [ "${create_ssl}" == "y" ]; then
        Add_SSL
    fi

    Echo_Green "================================================"
    echo "虚拟主机信息："
    echo "域名：${domain}"
    echo "网站目录：${vhostdir}"
    if [ "${enable_site_php}" == "n" ]; then
        echo "PHP：未开启（.php 请求一律返回 404）"
    else
        echo "PHP：已开启"
    fi
    if [ "${access_log}" == "n" ]; then
        echo "访问日志：未启用"
    else
        echo "访问日志：已启用"
    fi

    if [ "${create_database}" == "y" ]; then
        if [ "${database_add_rc:-1}" -eq 0 ]; then
            echo "数据库用户名：${database_name}"
            echo "数据库名：${database_name}"
            echo "数据库密码：刚才输入的密码（不回显）"
        else
            Echo_Red "数据库：创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp database add 单独重试建库。"
        fi
    else
        echo "创建数据库：否"
    fi
    if [ "${create_ftp}" == "y" ]; then
        if [ "${ftp_add_rc:-1}" -eq 0 ]; then
            echo "FTP 账号：${ftp_account_name}"
            echo "FTP 密码：刚才输入的密码（不回显）"
        else
            Echo_Red "FTP：账号创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp ftp add 单独重试。"
        fi
    else
        echo "创建 FTP 账号：否"
    fi
    if [ "${create_ssl}" == "y" ]; then
        echo "SSL：已启用"
        if [ "${ssl_choice}" == "1" ]; then
            echo "  =>自有证书文件"
        elif [ "${ssl_choice}" == "2" ]; then
            echo "  =>Let's Encrypt"
        elif [ "${ssl_choice}" == "3" ]; then
            echo "  =>BuyPass"
        elif [ "${ssl_choice}" == "4" ]; then
            echo "  =>ZeroSSL"
        fi
    fi
    if [ "${enable_ipv6}" == "y" ]; then
        echo "IPv6：已启用"
    else
        echo "IPv6：未启用"
    fi
    Echo_Green "================================================"
}

List_VHost()
{
    echo "Nginx 虚拟主机列表："
    ls /usr/local/nginx/conf/vhost/ | grep ".conf$" | sed 's/.conf//g'
    echo "Apache 虚拟主机列表："
    ls /usr/local/apache/conf/vhost/ | grep ".conf$" | sed 's/.conf//g'
}

Del_VHost()
{
    echo "======================================="
    echo "当前虚拟主机："
    List_VHost
    echo "======================================="
    domain=""
    while :;do
        Echo_Yellow "请输入要删除的域名："
        read domain
        # 域名会组成待删除的配置文件路径，因此必须先限制字符集。
        Check_Domain_Name "${domain}" || continue
        break
    done
    if [ ! -f "/usr/local/nginx/conf/vhost/${domain}.conf" ] || [ ! -f "/usr/local/apache/conf/vhost/${domain}.conf" ]; then
        echo "=========================================="
        echo "域名 ${domain} 不存在！"
        echo "=========================================="
        exit 1
    else
        rm -f /usr/local/nginx/conf/vhost/${domain}.conf
        rm -f /usr/local/apache/conf/vhost/${domain}.conf

        # 删除两端配置后必须重载 Nginx 和 Apache，才能使运行中的站点下线。
        Del_VHost_Reload || exit 1

        echo "========================================================"
        echo "域名 ${domain} 已删除。"
        echo "为安全起见，网站文件不会被自动删除。"
        echo "如需清理，请手动删除对应网站文件。"
        echo "========================================================"
    fi
}

Del_VHost_Reload()
{
    local rc=0

    if pgrep -f '/usr/local/nginx/sbin/nginx' >/dev/null 2>&1; then
        echo "正在检查 Nginx 配置..."
        if /usr/local/nginx/sbin/nginx -t && /usr/local/nginx/sbin/nginx -s reload; then
            echo "Nginx 重载完成。"
        else
            Echo_Red "Nginx 未能重载，运行中的 Nginx 仍在提供该站点。"
            Echo_Red "请修复后执行：lnmp nginx reload"
            rc=1
        fi
    fi

    if pgrep -f '/usr/local/apache/bin/httpd' >/dev/null 2>&1; then
        echo "正在检查 Apache 配置..."
        if /usr/local/apache/bin/httpd -t && Svc httpd reload; then
            echo "Apache 重载完成。"
        else
            Echo_Red "Apache 未能重载，运行中的 httpd 仍在提供该站点。"
            Echo_Red "请修复后执行：lnmp httpd reload"
            rc=1
        fi
    fi

    return ${rc}
}

First_Executable()
{
    local candidate

    for candidate in "$@"; do
        if [ -x "${candidate}" ]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    return 1
}

Check_DB()
{
    local mariadb_client mariadb_config mariadb_safe

    if mariadb_client=$(First_Executable /usr/local/mariadb/bin/mariadb /usr/local/mariadb/bin/mysql) \
        && mariadb_config=$(First_Executable /usr/local/mariadb/bin/mariadb_config /usr/local/mariadb/bin/mysql_config) \
        && mariadb_safe=$(First_Executable /usr/local/mariadb/bin/mariadbd-safe /usr/local/mariadb/bin/mysqld_safe) \
        && [ -s /etc/my.cnf ]; then
        MySQL_Bin="${mariadb_client}"
        MySQL_Ver=$("${mariadb_config}" --version)
    elif [[ -s /usr/local/mysql/bin/mysql && -s /usr/local/mysql/bin/mysqld_safe && -s /etc/my.cnf ]]; then
        MySQL_Bin="/usr/local/mysql/bin/mysql"
        MySQL_Ver=$(/usr/local/mysql/bin/mysql_config --version)
    else
        MySQL_Bin="None"
    fi
}

Make_TempMycnf()
{
    local pw
    # MySQL option file 会解析反斜杠转义，写入前需转义反斜杠以保持密码原值。
    # 单引号仅用于包围字段值，密码内部的单引号无需另行处理。
    pw="${1//\\/\\\\}"
    # 管理员已有的 ~/.my.cnf 会在凭据清理时恢复。
    if [ -s ~/.my.cnf ] && [ ! -e ~/.my.cnf.lnmp-bak ]; then
        cp -p ~/.my.cnf ~/.my.cnf.lnmp-bak
    fi
    umask 077
    cat >~/.my.cnf<<EOF
[client]
user=root
password='${pw}'
EOF
    chmod 600 ~/.my.cnf
    # 标记临时凭据，确保退出时清理。
    LNMP_Mycnf_Owned=1
    LNMP_Set_Trap
}

# 数据库 root 密码最多校验 3 次，避免输入错误或 EOF 导致无休止重试。
Verify_DB_Password()
{
    local attempt=0 max_attempt=3
    Check_DB
    while [ ${attempt} -lt ${max_attempt} ]; do
        attempt=$((attempt + 1))
        Echo_Yellow "请输入当前数据库 root 密码（输入内容不会显示）："
        Read_Secret DB_Root_Password "数据库 root 密码"
        echo
        Make_TempMycnf "${DB_Root_Password}"
        if Do_Query ""; then
            echo "数据库 root 密码验证通过。"
            return 0
        fi
        Echo_Red "数据库 root 密码校验失败（第 ${attempt}/${max_attempt} 次）。"
    done
    Echo_Red "连续 ${max_attempt} 次校验失败，已放弃。"
    return 1
}

# 凭据和 SQL 临时文件使用 root 专属随机目录，并在退出时统一清理。
# SQL 字符串需要转义，数据库标识符需要通过字符白名单校验。

# root 专属临时目录。
LNMP_Tmp_Dir=""
# 标记 ~/.my.cnf 是否为临时生成的数据库 root 凭据。
LNMP_Mycnf_Owned=0

# EXIT trap 同时清理临时目录和数据库凭据，覆盖异常退出路径。
LNMP_Cleanup()
{
    if [ -n "${LNMP_Tmp_Dir}" ]; then
        rm -rf "${LNMP_Tmp_Dir}"
        LNMP_Tmp_Dir=""
    fi
    TempMycnf_Clean
}

# INT/TERM 需要显式退出，确保中断倒计时后进入 EXIT 清理。
# trap 只能在主 shell 注册，防止子 shell 提前清理主流程仍在使用的文件。
LNMP_Set_Trap()
{
    trap 'LNMP_Cleanup' EXIT
    trap 'echo; exit 130' INT TERM
}

# 临时目录必须在当前 shell 初始化，使主流程和 EXIT trap 使用同一路径。
LNMP_Tmp_Init()
{
    [ -n "${LNMP_Tmp_Dir}" ] && return 0
    LNMP_Tmp_Dir=$(mktemp -d /tmp/.lnmp-adm.XXXXXXXX) || return 1
    chmod 700 "${LNMP_Tmp_Dir}"
    LNMP_Set_Trap
    return 0
}

# 调用前需要完成 LNMP_Tmp_Init。
LNMP_Mktemp()
{
    [ -n "${LNMP_Tmp_Dir}" ] || return 1
    mktemp "${LNMP_Tmp_Dir}/$1.XXXXXXXX"
}

# MySQL 字符串先转义反斜杠，再转义单引号，避免重复处理新增的转义符。
Sql_Quote()
{
    local v="$1"
    v="${v//\\/\\\\}"
    v="${v//\'/\\\'}"
    printf '%s' "${v}"
}

# 数据库名和用户名使用字符白名单，防止标识符构造为非法 SQL。
Check_DB_Identifier()
{
    case "$1" in
    ''|*[!A-Za-z0-9_]*)
        Echo_Red "名称 '$1' 不合法：只允许字母、数字和下划线，且不能为空。"
        return 1
        ;;
    esac
    if [ ${#1} -gt 32 ]; then
        Echo_Red "名称过长（超过 32 字符）。"
        return 1
    fi
    return 0
}

# 域名会写入文件路径和服务器配置，站点目录会用于递归授权，均需边界检查。

# 检测 EOF，防止非交互输入耗尽后校验循环空转。
Read_Input()
{
    local __var="$1" __what="${2:-输入}"
    if ! read -r "${__var}"; then
        echo
        Echo_Red "读取${__what}时遇到 EOF —— 标准输入已经没有内容了。"
        Echo_Red "若你用管道或重定向提供输入，请核对输入项的数量与顺序："
        Echo_Red "少喂一项就会走到这里。交互执行本命令则不会有此问题。"
        exit 1
    fi
}

# 读取不回显的密码，并检测 EOF。
Read_Secret()
{
    local __var="$1" __what="${2:-密码}"
    if ! read -r -s "${__var}"; then
        echo
        Echo_Red "读取${__what}时遇到 EOF —— 标准输入已经没有内容了。"
        exit 1
    fi
}

# DNS 名称可带前导泛域名标记，但不能包含路径分隔符、空白或配置元字符。
Check_Domain_Name()
{
    local d="$1"
    if [ -z "${d}" ]; then
        Echo_Red "域名不能为空。"
        return 1
    fi
    if [ ${#d} -gt 253 ]; then
        Echo_Red "域名过长（超过 253 字符）：${d}"
        return 1
    fi
    # 泛域名前缀不参与 DNS 标签格式校验。
    case "${d}" in
    \*.*) d="${d#\*.}" ;;
    esac
    if ! printf '%s' "${d}" \
        | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$'; then
        Echo_Red "域名不合法：'$1'"
        Echo_Red "只接受形如 example.com / www.example.com / *.example.com 的名字，"
        Echo_Red "不接受路径分隔符、空白以及 ; { } \$ 等配置元字符。"
        return 1
    fi
    return 0
}

# 附加域名按空格分隔，任一名称无效时拒绝整组输入。
Check_More_Domains()
{
    local d
    for d in $1; do
        Check_Domain_Name "${d}" || return 1
    done
    return 0
}

# 站点目录必须是无元字符的绝对路径，并位于允许的网站根目录内。
# 该限制防止递归 chmod 或 chown 影响系统目录及其它用户数据。
Check_Vhost_Dir()
{
    local d="$1" norm root ok='n'
    local matched_root='' rest probe comp resolved rroot

    if [ -z "${d}" ]; then
        Echo_Red "目录不能为空。"
        return 1
    fi
    case "${d}" in
    /*) : ;;
    *)
        Echo_Red "目录必须是绝对路径：'${d}'"
        return 1
        ;;
    esac
    if printf '%s' "${d}" | grep -Eq '[[:space:]`$;&|<>*?"'"'"'\\]'; then
        Echo_Red "目录名含空白或 shell 元字符，拒绝：'${d}'"
        return 1
    fi

    # 规范化路径，不要求目标已经存在。
    norm=$(printf '%s' "${d}" | sed -e 's#/\+#/#g' -e 's#/\./#/#g' -e 's#/$##')
    case "${norm}" in
    *..*)
        Echo_Red "目录不能包含 .. ：'${d}'"
        return 1
        ;;
    esac

    for root in /home /var/www /srv /data /www; do
        case "${norm}/" in
        "${root}"/*) ok='y'; matched_root="${root}"; break ;;
        esac
    done
    if [ "${ok}" != 'y' ]; then
        Echo_Red "目录 '${norm}' 不在允许的站点根之下。"
        Echo_Red "允许：/home /var/www /srv /data /www"
        Echo_Red "（限制它是因为随后要对该目录执行 chmod -R / chown -R，"
        Echo_Red "  打到 / 或 /usr 上是不可逆的。）"
        return 1
    fi

    # 网站必须位于允许根的子目录，避免递归授权整个根目录。
    if [ "${norm}" = "${matched_root}" ]; then
        Echo_Red "不能直接用 '${norm}' 作为站点目录，请在它下面建子目录。"
        Echo_Red "（随后的 chown -R 会作用于整个目录树。）"
        return 1
    fi

    # 逐级拒绝子路径中的符号链接，防止递归授权越过允许目录边界。
    # 允许根本身可由管理员配置为符号链接。
    rest="${norm#${matched_root}/}"
    probe="${matched_root}"
    while [ -n "${rest}" ]; do
        comp="${rest%%/*}"
        if [ "${comp}" = "${rest}" ]; then rest=''; else rest="${rest#*/}"; fi
        probe="${probe}/${comp}"
        if [ -L "${probe}" ]; then
            Echo_Red "路径组件 '${probe}' 是符号链接，拒绝作为站点目录。"
            Echo_Red "（递归改权限会跟着链接跑到目录树之外去。）"
            return 1
        fi
    done

    # realpath 解析后的路径仍需位于解析后的允许根目录内。
    # realpath -m 支持尚未创建的目标路径。
    if command -v realpath >/dev/null 2>&1; then
        resolved=$(realpath -m "${norm}" 2>/dev/null) || resolved="${norm}"
        ok='n'
        for root in /home /var/www /srv /data /www; do
            rroot=$(realpath -m "${root}" 2>/dev/null) || rroot="${root}"
            case "${resolved}/" in
            "${rroot}"/*) ok='y'; break ;;
            esac
        done
        if [ "${ok}" != 'y' ]; then
            Echo_Red "'${norm}' 解析后指向 '${resolved}'，不在允许的站点根之下，拒绝。"
            return 1
        fi
    fi

    vhostdir="${norm}"
    return 0
}

Do_Query()
{
    local sql_file rc
    # 临时目录创建失败属于环境错误，不能作为密码校验失败重试。
    LNMP_Tmp_Init || exit 1
    sql_file=$(LNMP_Mktemp query) || exit 1
    chmod 600 "${sql_file}"
    printf '%s\n' "$1" > "${sql_file}"
    Check_DB
    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${sql_file}"
    rc=$?
    rm -f "${sql_file}"
    return ${rc}
}

# 仅清理临时生成的凭据，避免删除管理员已有的 ~/.my.cnf。
# 清理函数可重复调用，不会重复恢复备份。
TempMycnf_Clean()
{
    [ "${LNMP_Mycnf_Owned}" -eq 1 ] || return 0
    LNMP_Mycnf_Owned=0
    rm -f ~/.my.cnf
    # 恢复安装前备份的客户端配置。
    if [ -e ~/.my.cnf.lnmp-bak ]; then
        mv -f ~/.my.cnf.lnmp-bak ~/.my.cnf
    fi
}

Enter_Database_Name()
{
    while :;do
        Echo_Yellow "请输入数据库名（只允许字母、数字和下划线）: "
        Read_Input database_name "数据库名"
        Check_DB_Identifier "${database_name}" || continue
        if [ "${database_name}" == "" ]; then
            Echo_Red "数据库名不能为空。"
        else
            break
        fi
    done
}

Add_Database_Menu()
{
    Enter_Database_Name
    echo "将创建数据库及同名数据库用户：${database_name}"
    Echo_Yellow "请输入数据库用户 ${database_name} 的密码（输入不回显）: "
    Read_Secret mysql_password "数据库用户密码"
    echo
    if [ -z "${mysql_password}" ]; then
        Echo_Red "密码不能为空。"
        return 1
    fi
    return 0
}

Add_Database()
{
    local sql_file mysql_password_q rc
    Check_DB_Identifier "${database_name}" || return 1
    mysql_password_q=$(Sql_Quote "${mysql_password}")
    LNMP_Tmp_Init || return 1
    sql_file=$(LNMP_Mktemp add_db) || return 1
    chmod 600 "${sql_file}"

    # 建库语句兼容当前 MySQL 和 MariaDB，并支持失败后重复执行。
    cat >"${sql_file}"<<EOF
CREATE USER IF NOT EXISTS '${database_name}'@'localhost' IDENTIFIED BY '${mysql_password_q}';
CREATE USER IF NOT EXISTS '${database_name}'@'127.0.0.1' IDENTIFIED BY '${mysql_password_q}';
ALTER USER '${database_name}'@'localhost' IDENTIFIED BY '${mysql_password_q}';
ALTER USER '${database_name}'@'127.0.0.1' IDENTIFIED BY '${mysql_password_q}';
GRANT USAGE ON *.* TO '${database_name}'@'localhost';
GRANT USAGE ON *.* TO '${database_name}'@'127.0.0.1';
CREATE DATABASE IF NOT EXISTS \`${database_name}\`;
GRANT ALL PRIVILEGES ON \`${database_name}\`.* TO '${database_name}'@'localhost';
GRANT ALL PRIVILEGES ON \`${database_name}\`.* TO '${database_name}'@'127.0.0.1';
FLUSH PRIVILEGES;
EOF

    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${sql_file}"
    rc=$?
    rm -f "${sql_file}"
    if [ ${rc} -ne 0 ]; then
        Echo_Red "数据库创建失败。"
        return ${rc}
    fi
    echo "数据库创建成功。"
    return 0
}

List_Database()
{
    local rc
    ${MySQL_Bin} --defaults-file=~/.my.cnf -e "SHOW DATABASES;"
    rc=$?
    if [ ${rc} -ne 0 ]; then
        Echo_Red "数据库列表读取失败。"
        return ${rc}
    fi
    echo "数据库列表读取成功。"
    return 0
}

Edit_Database()
{
    local pass_q
    while :;do
        Echo_Yellow "请输入数据库用户名（只允许字母、数字和下划线）: "
        Read_Input database_username "数据库用户名"
        Check_DB_Identifier "${database_username}" || continue
        break
    done
    while :;do
        Echo_Yellow "请输入新密码（输入不回显）: "
        Read_Secret database_username_passwd "新密码"
        echo
        if [ "${database_username_passwd}" == "" ]; then
            Echo_Red "数据库密码不能为空。"
        else
            break
        fi
    done
    pass_q=$(Sql_Quote "${database_username_passwd}")

    # 三条语句一次执行，确保任一主机授权失败都会返回错误。
    if ! Do_Query "ALTER USER '${database_username}'@'localhost' IDENTIFIED BY '${pass_q}';
ALTER USER '${database_username}'@'127.0.0.1' IDENTIFIED BY '${pass_q}';
FLUSH PRIVILEGES;"; then
        Echo_Red "数据库用户密码修改失败。"
        return 1
    fi
    echo "数据库用户密码修改成功。"
    return 0
}

Del_Database()
{
    local del_sql_file rc
    List_Database || return 1
    Enter_Database_Name
    if [[ "${database_name}" == "information_schema" || "${database_name}" == "mysql" || "${database_name}" == "performance_schema" ]]; then
        Echo_Red "MySQL 系统数据库不能删除。"
        return 1
    fi
    Check_DB_Identifier "${database_name}" || return 1
    # 删除倒计时前确认数据库存在，避免将名称错误误报为删除失败。
    if ! Database_Exists "${database_name}"; then
        Echo_Red "数据库不存在：${database_name}"
        return 1
    fi
    echo "将删除数据库及同名数据库用户：${database_name}"
    echo "10 秒后继续，按 Ctrl+C 可取消..."
    Sleep_Sec 10
    LNMP_Tmp_Init || return 1
    del_sql_file=$(LNMP_Mktemp del_db) || return 1
    chmod 600 "${del_sql_file}"
    cat >"${del_sql_file}"<<EOF
DROP USER IF EXISTS '${database_name}'@'127.0.0.1';
DROP USER IF EXISTS '${database_name}'@'localhost';
DROP DATABASE \`${database_name}\`;
FLUSH PRIVILEGES;
EOF
    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${del_sql_file}"
    rc=$?
    rm -f "${del_sql_file}"
    if [ ${rc} -ne 0 ]; then
        Echo_Red "数据库 ${database_name} 删除失败。"
        return ${rc}
    fi
    echo "数据库 ${database_name} 删除成功。"
    return 0
}

# 备份与恢复
#
#   lnmp database export <数据库名> <文件.sql.gz>
#   lnmp database import <数据库名> <文件.sql.gz>
#
# 导出文件不含 CREATE DATABASE 或 USE，导入目标由命令参数决定，支持恢复到其它库名。

# 从数据库客户端目录选择导出程序，MariaDB 优先使用 mariadb-dump。
MySQL_Dump_Bin=""
Check_Dump_Bin()
{
    if [ "${MySQL_Bin}" == "None" ]; then
        Echo_Red "未检测到已安装的 MySQL/MariaDB。"
        return 1
    fi
    MySQL_Dump_Bin=$(First_Executable \
        "$(dirname "${MySQL_Bin}")/mariadb-dump" \
        "$(dirname "${MySQL_Bin}")/mysqldump")
    if [ -z "${MySQL_Dump_Bin}" ]; then
        Echo_Red "找不到可执行的数据库导出程序。"
        return 1
    fi
    return 0
}

# 通过 information_schema 精确匹配库名，避免下划线被 LIKE 解释为通配符。
Database_Exists()
{
    local name_q out
    name_q=$(Sql_Quote "$1")
    out=$(${MySQL_Bin} --defaults-file=~/.my.cnf -N -B -e \
        "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='${name_q}';") || return 1
    [ -n "${out}" ]
}

# 备份文件的父目录必须存在，目标只能是普通文件路径。
Check_Backup_Path()
{
    local f="$1" dir
    if [ -z "${f}" ]; then
        Echo_Red "备份文件路径不能为空。"
        return 1
    fi
    case "${f}" in
        */)
            Echo_Red "备份文件路径不能以 / 结尾：${f}"
            return 1
            ;;
    esac
    dir=$(dirname -- "${f}")
    if [ ! -d "${dir}" ]; then
        Echo_Red "目录不存在：${dir}"
        return 1
    fi
    if [ -e "${f}" ] && [ ! -f "${f}" ]; then
        Echo_Red "目标已存在且不是普通文件：${f}"
        return 1
    fi
    return 0
}

Export_Database()
{
    local database_name="$1" out_file="$2" tmp_file dump_rc gzip_rc pipe_st

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "用法：lnmp database export <数据库名> <文件.sql.gz>"
        return 1
    fi
    Check_DB_Identifier "${database_name}" || return 1
    Check_Backup_Path "${out_file}" || return 1
    if [ -e "${out_file}" ]; then
        Echo_Red "文件已存在，不覆盖：${out_file}"
        Echo_Red "请换一个文件名，或自行删除旧文件后重试。"
        return 1
    fi
    Check_Dump_Bin || return 1
    if ! Database_Exists "${database_name}"; then
        Echo_Red "数据库不存在：${database_name}"
        return 1
    fi

    # 先写入同目录临时文件再原子改名，失败时不会留下不完整的备份文件。
    tmp_file=$(mktemp "${out_file}.lnmp-part.XXXXXXXX") || {
        Echo_Red "无法在目标目录创建临时文件：${out_file}"
        return 1
    }
    echo "正在导出数据库 ${database_name} ..."
    ${MySQL_Dump_Bin} --defaults-file=~/.my.cnf \
        --single-transaction --quick --routines --triggers --events \
        --default-character-set=utf8mb4 \
        "${database_name}" | gzip -c > "${tmp_file}"
    # 一次性保存 PIPESTATUS，确保导出和压缩任一失败都能被识别。
    pipe_st=("${PIPESTATUS[@]}")
    dump_rc=${pipe_st[0]}
    gzip_rc=${pipe_st[1]}
    if [ "${dump_rc}" -ne 0 ] || [ "${gzip_rc}" -ne 0 ]; then
        rm -f "${tmp_file}"
        Echo_Red "数据库 ${database_name} 导出失败（mysqldump=${dump_rc}，gzip=${gzip_rc}）。"
        return 1
    fi
    if ! mv -f "${tmp_file}" "${out_file}"; then
        rm -f "${tmp_file}"
        Echo_Red "写入备份文件失败：${out_file}"
        return 1
    fi
    chmod 600 "${out_file}"
    echo "数据库 ${database_name} 导出成功。"
    echo "备份文件：${out_file}"
    return 0
}

Import_Database()
{
    local database_name="$1" in_file="$2" rc gz_rc mysql_rc pipe_st

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "用法：lnmp database import <数据库名> <文件.sql.gz>"
        return 1
    fi
    Check_DB_Identifier "${database_name}" || return 1
    if [ ! -f "${in_file}" ]; then
        Echo_Red "备份文件不存在或不是普通文件：${in_file}"
        return 1
    fi
    if [ ! -r "${in_file}" ] || [ ! -s "${in_file}" ]; then
        Echo_Red "备份文件不可读或为空：${in_file}"
        return 1
    fi
    # 导入不自动建库，避免生成没有对应用户和授权的数据库。
    if ! Database_Exists "${database_name}"; then
        Echo_Red "数据库不存在：${database_name}"
        Echo_Red "请先执行 lnmp database add 建库建用户，再导入。"
        return 1
    fi

    Echo_Yellow "导入会覆盖数据库 ${database_name} 中的同名表，且无法撤销。"

    echo
    echo "10 秒后继续，按 Ctrl+C 可取消..."
    Sleep_Sec 10

    echo "正在导入数据库 ${database_name} ..."
    # 按文件内容识别压缩格式，未压缩的 SQL 文件也可直接导入。
    if gzip -t "${in_file}" 2>/dev/null; then
        gzip -dc "${in_file}" | ${MySQL_Bin} --defaults-file=~/.my.cnf \
            --default-character-set=utf8mb4 "${database_name}"
        pipe_st=("${PIPESTATUS[@]}")
        gz_rc=${pipe_st[0]}
        mysql_rc=${pipe_st[1]}
        rc=0
        [ "${gz_rc}" -ne 0 ] && rc=1
        [ "${mysql_rc}" -ne 0 ] && rc=1
    else
        ${MySQL_Bin} --defaults-file=~/.my.cnf \
            --default-character-set=utf8mb4 "${database_name}" < "${in_file}"
        rc=$?
    fi
    if [ "${rc}" -ne 0 ]; then
        Echo_Red "数据库 ${database_name} 导入失败。"
        return 1
    fi
    echo "数据库 ${database_name} 导入成功。"
    return 0
}

