# HTTP 验证不能签发泛域名，用户当场输入泛域名时拒绝整组输入。
Reject_Wildcards_For_HTTP()
{
    local d

    set -f
    for d in $1; do
        case "${d}" in
        \*.*)
            set +f
            Echo_Red "HTTP 验证不能签发泛域名证书：${d}"
            Echo_Yellow "泛域名只接受 DNS 验证，请改用 lnmp dnsssl {ali|cf|dp|he|gd|aws}。"
            echo
            return 1
            ;;
        esac
    done
    set +f
    return 0
}

# lnmp ssl add 读取现有的 Nginx 和 Apache 站点配置，仅询问证书相关选项。
Add_SSL_Only_Info_Menu()
{
    local input

    domain=""
    while :;do
        Echo_Yellow "HTTP 验证，请输入域名（示例：www.example.com）: "
        Read_Input input "域名"
        Check_Domain_Name "${input}" || continue
        # HTTP-01 不能签发泛域名，ACME 规定泛域名只接受 DNS-01。
        case "${input}" in
        \*.*)
            Echo_Red "HTTP 验证不能签发泛域名证书，泛域名只接受 DNS 验证。"
            Echo_Yellow "请改用 lnmp dnsssl {ali|cf|dp|he|gd|aws}。"
            echo
            return 1
            ;;
        esac
        if [ "${input}" = "default" ]; then
            domain="default"
            break
        fi
        # HTTP 验证要求该域名由现有网站直接服务，因此只认站点名和 server_name，
        # 不做 dnsssl 那样的根域回退。
        if Find_Site_For_SSL "${input}"; then
            domain="${Site_Match_Name}"
            break
        fi
        Echo_Red "未找到网站 ${input} 的虚拟主机配置。"
        if [ -n "${Site_Match_Hints}" ]; then
            Echo_Yellow "同一根域下现有网站：${Site_Match_Hints}"
            echo
            Echo_Yellow "HTTP 验证要求该域名由现有网站直接服务，请输入准确的域名。"
            echo
            continue
        fi
        Echo_Yellow "请先执行 lnmp vhost add 创建网站，再执行 lnmp ssl add 添加证书。"
        echo
        Echo_Yellow "只要证书不需要网站，请用 lnmp onlyssl {ali|cf|dp|he|gd|aws}。"
        echo
        return 1
    done
    echo "您的域名：${domain}"
    [ "${domain}" != "${input}" ] && echo "已匹配到网站：${domain}（输入的 ${input} 由该网站服务）"

    Load_Vhost_Params
}

# 从现有虚拟主机读回站点参数，供 ssl add 与 dnsssl 复用。
Load_Vhost_Params()
{
    local vhost_conf apache_vhost_conf

    vhost_conf="/usr/local/nginx/conf/vhost/${domain}.conf"
    if [ "${domain}" = "default" ]; then
        apache_vhost_conf="/usr/local/apache/conf/extra/httpd-vhosts.conf"
    else
        apache_vhost_conf="/usr/local/apache/conf/vhost/${domain}.conf"
    fi
    if [ ! -s "${vhost_conf}" ] && [ ! -s "${apache_vhost_conf}" ]; then
        Echo_Red "未找到网站 ${domain} 的虚拟主机配置。"
        Echo_Yellow "请先执行 lnmp vhost add 创建网站，再执行 lnmp ssl add 添加证书。"
        echo
        return 1
    fi
    if [ ! -s "${vhost_conf}" ] || [ ! -s "${apache_vhost_conf}" ]; then
        Echo_Red "网站 ${domain} 的 LNMPA 虚拟主机配置不完整。"
        Echo_Yellow "请先修复 Nginx 与 Apache 两端的站点配置，再添加证书。"
        echo
        return 1
    fi
    if Vhost_Has_HTTPS "${vhost_conf}"; then
        Echo_Red "网站 ${domain} 已存在 HTTPS/443 配置，不能重复添加证书。"
        Echo_Yellow "如需更换证书，请先检查并处理现有 SSL 配置。"
        echo
        return 1
    fi

    vhostdir=$(awk '$1 == "root" { value=$2; sub(/;$/, "", value); print value; exit }' "${vhost_conf}")
    if [ -z "${vhostdir}" ] || [ ! -d "${vhostdir}" ]; then
        Echo_Red "网站 ${domain} 的根目录不存在或无法从 ${vhost_conf} 读取。"
        return 1
    fi

    moredomain=$(awk -v primary="${domain}" '
        $1 == "server_name" {
            out=""
            for (i=2; i<=NF; i++) {
                value=$i
                sub(/;$/, "", value)
                if (value != primary && value != "_") {
                    if (out != "") out=out " "
                    out=out value
                }
            }
            print out
            exit
        }
    ' "${vhost_conf}")

    # HTTPS 沿用现有站点的 PHP 状态，防止 .php 源码作为静态文件返回。
    # default 站点由 Create_SSL_Config 单独处理。
    if [ "${domain}" != "default" ] && ! grep -Eq '^[[:space:]]*include[[:space:]]+proxy-pass-php\.conf;' "${vhost_conf}"; then
        enable_site_php="n"
        echo "网站 ${domain} 未开启 PHP，HTTPS 配置沿用同一状态。"
    else
        enable_site_php="y"
    fi

    # HTTPS 必须继承 HTTP 的站点级自定义配置，否则反代、WebSocket 等规则
    # 只在 80 端口生效，443 会落到静态 root 上返回目录内容、404 或 502。
    ssl_custom_block=$(Extract_Custom_Block "${vhost_conf}")
    if [ -n "${ssl_custom_block}" ]; then
        echo "已读取网站 ${domain} 的自定义配置，将一并写入 HTTPS 配置。"
    fi

    al=$(awk '$1 == "access_log" { sub(/^[[:space:]]*/, ""); print; exit }' "${vhost_conf}")
    al="${al:-access_log off;}"
    if grep -Eq '^[[:space:]]*listen[[:space:]]+\[::\]:80' "${vhost_conf}"; then
        enable_ipv6="y"
    else
        enable_ipv6="n"
    fi

    return 0
}

Check_Acme_EMail()
{
    if [ ! -s /usr/local/acme.sh/account.conf ] || ! cat /usr/local/acme.sh/account.conf | grep -Eq "^ACCOUNT_EMAIL="; then
        while :;do
            Echo_Yellow "请输入证书账户邮箱（可留空）: "
            Read_Input email_address "邮箱地址"
            if [ -z "${email_address}" ]; then
                echo "未填写账户邮箱，acme.sh 按无邮箱账户注册。"
                break
            fi
            if [[ "${email_address}" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$ ]]; then
                echo "邮箱地址 ${email_address} 格式有效。"
                break
            else
                echo "邮箱地址 ${email_address} 格式无效，请重新输入。"
            fi
        done
    fi
}

# ZeroSSL 的 ACME 端点与账户配置。acme.sh 按 CA 目录单独保存 CA_EMAIL，
# 与 Let's Encrypt 的账户邮箱互不影响。
Acme_ZeroSSL_CA_Conf="/usr/local/acme.sh/ca/acme.zerossl.com/v2/DV90/ca.conf"
Acme_ZeroSSL_Nonce_URL="https://acme.zerossl.com/v2/DV90/newNonce"

# ZeroSSL 必须用邮箱换取 EAB 凭据，与 Let's Encrypt 的可选邮箱不同，单独确认一次。
# 结果写入 ACCOUNT_EMAIL，acme.sh 取值时该变量优先于 account.conf。
Check_ZeroSSL_EMail()
{
    local saved val

    saved=$(sed -n "s/^CA_EMAIL='\(.*\)'$/\1/p" "${Acme_ZeroSSL_CA_Conf}" 2>/dev/null | tail -n 1)
    while :;do
        if [ -n "${saved}" ]; then
            Echo_Yellow "请输入 ZeroSSL 账户邮箱 [已保存 ${saved}，回车沿用]: "
        else
            Echo_Yellow "请输入 ZeroSSL 账户邮箱: "
        fi
        Read_Input val "ZeroSSL 账户邮箱"
        [ -z "${val}" ] && val="${saved}"
        if [ -z "${val}" ]; then
            Echo_Red "ZeroSSL 需要邮箱换取 EAB 凭据，不能为空。"
            continue
        fi
        if [[ "${val}" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$ ]]; then
            export ACCOUNT_EMAIL="${val}"
            email_address="${val}"
            return 0
        fi
        Echo_Red "邮箱地址 ${val} 格式无效，请重新输入。"
    done
}

# newNonce 端点故障时 acme.sh 会重试 20 轮（约 5 分钟）才失败，且只提示
# Could not get nonce，先探测一次给出可判断的结果。curl 缺失时跳过检查。
Check_ZeroSSL_Endpoint()
{
    local code

    command -v curl >/dev/null 2>&1 || return 0
    echo "正在检查 ZeroSSL 服务可用性..."
    code=$(curl -s -o /dev/null -I -w '%{http_code}' --max-time 5 "${Acme_ZeroSSL_Nonce_URL}" 2>/dev/null)
    case "${code}" in
    200|204)
        return 0
        ;;
    000|"")
        Echo_Red "ZeroSSL 的 ${Acme_ZeroSSL_Nonce_URL} 5 秒内无响应。"
        ;;
    *)
        Echo_Red "ZeroSSL 的 ${Acme_ZeroSSL_Nonce_URL} 返回 HTTP ${code}。"
        ;;
    esac
    Echo_Yellow "继续签发会在 acme.sh 重试约 5 分钟后失败。"
    echo
    return 1
}

Return_301_Menu()
