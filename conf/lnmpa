Prepare_Default_Site_IP_Cert()
{
    local ip nat_confirm=''
    ip=$(Detect_Server_IP)
    if [ -z "${ip}" ] || Is_Private_IP "${ip}"; then
        Echo_Red "default 站点未探测到可签发证书的公网 IPv4，无法使用 Let's Encrypt。"
        Echo_Yellow "请为网站绑定域名，或选择 1 使用自有证书。"
        echo
        return 1
    fi

    Echo_Yellow "default 将为服务器公网 IPv4 ${ip} 申请 Let's Encrypt IP 证书。"

    echo
    Echo_Yellow "该证书使用 shortlived profile，有效期 7 天，必须保留 acme.sh 自动续期任务。"
    echo
    # 出口地址未绑定在本机接口时，HTTP-01 验证到不了本机，签发必然失败，
    # 失败次数还计入 CA 的速率限制，因此要求显式确认后才继续。
    if ! Ip_On_Local_Interface "${ip}"; then
        Echo_Red "${ip} 未绑定在本机任何接口上，这台机器在 NAT 后面。"
        echo "只有已把该 IP 的 80 端口转发到本机，HTTP-01 验证才可能通过；"
        echo "否则本次申请会失败，并消耗账户的失败验证次数。"
        Read_YN nat_confirm "确认已做端口转发并继续申请? (y/N，默认 n) " n "端口转发确认"
        if [ "${nat_confirm}" != "y" ]; then
            Echo_Red "已取消 default 站点的证书申请。"
            return 1
        fi
        echo
    fi

    letsdomain="-d ${ip}"
    cert_profile_opt="--certificate-profile shortlived --days 6"
    default_site_ip="${ip}"
    return 0
}

# acme.sh 使用 GitHub 官方固定版本和 SHA256，更新版本时必须同步更新校验值。
