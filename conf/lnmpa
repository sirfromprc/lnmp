#!/bin/bash
export PATH=$PATH:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin:~/bin

# Check if user is root
if [ $(id -u) != "0" ]; then
    echo "Error: You must be root to run this script!"
    exit 1
else
    if env |grep -q SUDO; then
        acme_sh_sudo="-f"
    fi
fi

echo "+-------------------------------------------+"
echo "|    Manager for LNMP, Written by Licess    |"
echo "+-------------------------------------------+"
echo "|              https://lnmp.org             |"
echo "+-------------------------------------------+"

# 数据库服务名。安装 MariaDB 时由 include/end.sh 的 Startup_DB 改成 mariadb，
# 不装数据库时改成空值（Svc 遇到空服务名直接跳过）。
DB_SERVICE=mysql

arg1=$1
arg2=$2
# database export/import 需要库名和文件名两个附加参数
arg3=$3
arg4=$4

# 通知函数：安装时与 lnmp 一起装到 /bin/lnmp-tgnotice。
# source 进来之后，本脚本任何位置都可以直接写 tgnotice "文本" [md]。
[ -r /bin/lnmp-tgnotice ] && . /bin/lnmp-tgnotice

# ---------------------------------------------------------------------------
# Svc <服务名> <动作> — lnmp 命令与 systemd 共用同一条启停路径
#
# 原实现一律直调 /etc/init.d/<服务>，新进程跑在 systemd 之外，
# unit 随即变成 failed，systemctl 与基于 unit 状态的监控全部失真。
# 说明同 conf/lnmp。
# ---------------------------------------------------------------------------
Svc()
{
    local service="$1" action="$2"

    [ -z "${service}" ] && return 0

    case "${action}" in
    start|stop|restart|reload|status)
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1 \
           && [ -s "/etc/systemd/system/${service}.service" ]; then
            systemctl --no-pager ${action} ${service}.service
            return $?
        fi
        ;;
    esac

    if [ -x "/etc/init.d/${service}" ]; then
        /etc/init.d/${service} ${action}
        return $?
    fi
    echo "${service}: 既没有 systemd unit 也没有 /etc/init.d 脚本，跳过。"
    return 1
}

Check_Svc_State()
{
    local service failed=''

    [ -d /run/systemd/system ] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0

    for service in "$@"; do
        [ -z "${service}" ] && continue
        [ -s "/etc/systemd/system/${service}.service" ] || continue
        systemctl is-active --quiet ${service}.service || failed="${failed} ${service}"
    done

    [ -z "${failed}" ] && return 0
    echo "警告：以下服务的 systemd 状态不是 active：${failed}"
    echo "      若进程其实还在跑，说明它被 systemd 之外的方式启动过；"
    echo "      执行 lnmp kill 后再 lnmp start，可让两边重新对齐。"
    return 1
}

lnmpa_start()
{
    echo "Starting LNMPA..."
    Svc nginx start
    Svc "${DB_SERVICE}" start
    Svc httpd start
    Check_Svc_State nginx "${DB_SERVICE}" httpd
}

lnmpa_stop()
{
    echo "Stoping LNMPA..."
    Svc nginx stop
    Svc "${DB_SERVICE}" stop
    Svc httpd stop
}

lnmpa_reload()
{
    echo "Reload LNMPA..."
    Svc nginx reload
    Svc "${DB_SERVICE}" reload
    # httpd.service 的 ExecReload 就是 httpd -k graceful，两条路径等价
    Svc httpd reload
}

lnmpa_kill()
{
    echo "Kill nginx,apache,mysql process..."
    killall nginx
    killall httpd
    killall mysqld
    echo "done."
}

lnmpa_status()
{
    Svc nginx status
    Svc "${DB_SERVICE}" status
    Svc httpd status
}

Function_Vhost()
{
    case "$1" in
        [aA][dD][dD])
            Add_VHost
            ;;
        [lL][iI][sS][tT])
            List_VHost
            ;;
        [dD][eE][lL])
            Del_VHost
            ;;
        [eE][xX][iI][tT])
            exit 1
            ;;
        *)
            echo "Usage: lnmp vhost {add|list|del}"
            exit 1
            ;;
esac
}

Function_Database()
{
    case "$1" in
        [aA][dD][dD])
            Add_Database_Menu && Add_Database
            ;;
        [lL][iI][sS][tT])
            List_Database
            ;;
        [dD][eE][lL])
            Del_Database
            ;;
        [eE][dD][iI][tT])
            Edit_Database
            ;;
        [eE][xX][pP][oO][rR][tT])
            Export_Database "$2" "$3"
            ;;
        [iI][mM][pP][oO][rR][tT])
            Import_Database "$2" "$3"
            ;;
        [eE][xX][iI][tT])
            return 1
            ;;
        *)
            echo "Usage: lnmp database {add|list|edit|del}"
            echo "Usage: lnmp database export <数据库名> <文件.sql.gz>"
            echo "Usage: lnmp database import <数据库名> <文件.sql.gz>"
            return 1
            ;;
esac
}

Function_Backup()
{
    # 备份实现是独立文件，三个管理脚本共用同一份，安装时与 lnmp 一起复制
    local bin="/bin/lnmp-backup"
    if [ ! -x "${bin}" ]; then
        Echo_Red "找不到 ${bin}，安装不完整。"
        Echo_Red "可从源码目录补装："
        Echo_Red "  cp tools/lnmp-backup.sh /bin/lnmp-backup && chmod +x /bin/lnmp-backup"
        return 1
    fi
    "${bin}" "$@"
}

Function_Ftp()
{
    case "$1" in
        [aA][dD][dD])
            Add_Ftp_Menu && Add_Ftp
            ;;
        [lL][iI][sS][tT])
            List_Ftp
            ;;
        [dD][eE][lL])
            Del_Ftp
            ;;
        [eE][dD][iI][tT])
            Edit_Ftp
            ;;
        [eE][xX][iI][tT])
            return 1
            ;;
        [sS][hH][oO][wW])
            Show_Ftp
            ;;
        *)
            echo "Usage: lnmp ftp {add|list|edit|del|show}"
            return 1
            ;;
esac
}

Add_VHost_Config()
{
    cat >"/usr/local/nginx/conf/vhost/${domain}.conf"<<EOF
server {
        listen 80;
        #listen [::]:80;
        server_name ${domain} ${moredomain};
        index index.html index.htm index.php default.html default.htm default.php;
        root  ${vhostdir};

        #error_page   404   /404.html;

        # Deny access to PHP files in specific directory
        #location ~ /(wp-content|uploads|wp-includes|images)/.*\.php$ { deny all; }

        include proxy-pass-php.conf;

        location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
            expires      30d;
        }

        location ~ .*\.(js|css)$ {
            expires      12h;
        }

        location ^~ /.well-known/ {
            allow all;
        }

        location ~ /\. {
            deny all;
        }

        ${al}
    }
EOF
    cat >"/usr/local/apache/conf/vhost/${domain}.conf"<<EOF
<VirtualHost *:88>
ServerAdmin ${email}
php_admin_value open_basedir "${vhostdir}:/tmp/:/var/tmp/:/proc/"
DocumentRoot "${vhostdir}"
ServerName ${domain}
ErrorLog "/home/wwwlogs/${al_name}-error_log"
CustomLog "/home/wwwlogs/${al_name}-access_log" combined
<Directory "${vhostdir}">
    Options FollowSymLinks
    AllowOverride All
    Require all granted
    DirectoryIndex index.html index.php
</Directory>
</VirtualHost>
EOF

    if [ "${access_log}" != 'y' ]; then
        sed -i 's/^ErrorLog/#ErrorLog/g' /usr/local/apache/conf/vhost/${domain}.conf
        sed -i 's/^CustomLog/#CustomLog/g' /usr/local/apache/conf/vhost/${domain}.conf
    fi

    if [ "${moredomain}" != "" ]; then
        sed -i "/ServerName/a\
    ServerAlias ${moredomain}" /usr/local/apache/conf/vhost/${domain}.conf
    fi

    if [ "${enable_ipv6}" == "y" ]; then
        sed -i 's/#listen \[::\]:80;/listen \[::\]:80;/g' /usr/local/nginx/conf/vhost/${domain}.conf
    fi

    echo "Test Nginx configure file......"
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，已撤销本次新增的虚拟主机配置。"
        rm -f "/usr/local/nginx/conf/vhost/${domain}.conf"
        rm -f "/usr/local/apache/conf/vhost/${domain}.conf"
        exit 1
    fi
    echo "Test Apache configure file..."
    if ! /etc/init.d/httpd configtest; then
        Echo_Red "Apache 配置测试未通过，已撤销本次新增的虚拟主机配置。"
        rm -f "/usr/local/nginx/conf/vhost/${domain}.conf"
        rm -f "/usr/local/apache/conf/vhost/${domain}.conf"
        exit 1
    fi
    echo ""
    echo "Reload Nginx......"
    /usr/local/nginx/sbin/nginx -s reload
    echo "Restart Apache..."
    /etc/init.d/httpd graceful
}

Add_VHost()
{
    domain=""
    while :;do
        Echo_Yellow "Please enter domain(example: www.example.com): "
        read domain
        Check_Domain_Name "${domain}" || continue
        if [[ -f "/usr/local/nginx/conf/vhost/${domain}.conf" || -f "/usr/local/apache/conf/vhost/${domain}.conf" ]]; then
            Echo_Red " ${domain} is exist,please check!"
            exit 1
        fi
        echo " Your domain: ${domain}"
        break
    done

    while :;do
        Echo_Yellow "Enter more domain name(example: example.com sub.example.com): "
        read moredomain
        [ -z "${moredomain}" ] && break
        Check_More_Domains "${moredomain}" && break
    done
    if [ "${moredomain}" != "" ]; then
        echo " domain list: ${moredomain}"
    fi

    while :;do
        echo "Please enter the directory for the domain: $domain"
        Echo_Yellow "Default directory: /home/wwwroot/${domain}: "
        read vhostdir
        if [ "${vhostdir}" == "" ]; then
            vhostdir="/home/wwwroot/${domain}"
        fi
        # 目录随后会交给 mkdir -p / chown -R，先规范化并限制在允许的站点根下
        Check_Vhost_Dir "${vhostdir}" || exit 1
        # Check_Vhost_Dir 通过时会把规范化后的路径写回 vhostdir
        Check_Vhost_Dir "${vhostdir}" && break
    done
    echo "Virtual Host Directory: ${vhostdir}"

    Echo_Yellow "Allow access log? (y/n) "
    read access_log
    if [[ "${access_log}" == "n" || "${access_log}" == "" ]]; then
        echo "Disable access log."
        al="access_log off;"
        al_name="${domain}"
    else
        Echo_Yellow "Enter access log filename(Default:${domain}.log): "
        read al_name
        if [ "${al_name}" == "" ]; then
            al_name="${domain}"
        fi
        al="access_log  /home/wwwlogs/${al_name}.log;"
        echo "You access log filename: ${al_name}.log"
    fi

    Echo_Yellow "Enable IPv6? (y/n) "
    read enable_ipv6
    if [[ "${enable_ipv6}" == "n" || "${enable_ipv6}" == "" ]]; then
        echo "Disabled IPv6 Support in current Virtualhost."
        enable_ipv6="n"
    else
        echo "Enabled IPv6 Support in current Virtualhost."
        enable_ipv6="y"
    fi

    email=""
    Echo_Yellow "Please enter Administrator Email Address: "
    read email
    if [ "${email}" == "" ]; then
        echo "Administrator Email Address will set to webmaster@example.com!"
        email='webmaster@example.com'
    else
        echo "Server Administrator Email:${email}"
    fi

    if [[ -s /usr/local/mysql/bin/mysql || -s /usr/local/mariadb/bin/mysql ]]; then
        Echo_Yellow "Create database and MySQL user with same name (y/n) "
        read create_database

        if [ "${create_database}" == "y" ]; then
            Verify_DB_Password || exit 1
            Add_Database_Menu || exit 1
        fi
    fi

    if [ -f /usr/local/pureftpd/sbin/pure-ftpd ]; then
        Echo_Yellow "Create ftp account (y/n) "
        read create_ftp

        if [ "${create_ftp}" == "y" ]; then
            Add_Ftp_Menu
        fi
    fi

    Echo_Yellow "Add SSL Certificate (y/n) "
    read create_ssl
    if [ "${create_ssl}" == "y" ]; then
        Add_SSL_Menu
    fi

    echo ""
    echo "Press any key to start create virtul host..."
    OLDCONFIG=`stty -g`
    stty -icanon -echo min 1 time 0
    dd count=1 2>/dev/null
    stty ${OLDCONFIG}

    echo "Create Virtul Host directory......"
    mkdir -p "${vhostdir}"
    if [ "${access_log}" == "y" ]; then
        touch /home/wwwlogs/${al_name}.log
        touch /home/wwwlogs/${al_name}-access_log
    fi
    echo "set permissions of Virtual Host directory......"
    chmod -R 755 "${vhostdir}"
    chown -R www:www "${vhostdir}"

    Add_VHost_Config

    if [ "${create_database}" == "y" ]; then
        Add_Database
        database_add_rc=$?
        # 建库是 vhost 流程里最后一次用到数据库 root 凭据，用完立刻清掉，
        # 不等到脚本退出
        TempMycnf_Clean
    fi

    if [ "${create_ftp}" == "y" ]; then
        Add_Ftp
        ftp_add_rc=$?
    fi

    if [ "${create_ssl}" == "y" ]; then
        Add_SSL
    fi

    Echo_Green "================================================"
    echo "Virtualhost infomation:"
    echo "Your domain: ${domain}"
    echo "Home Directory: ${vhostdir}"
    if [ "${access_log}" == "n" ]; then
        echo "Enable log: no"
    else
        echo "Enable log: yes"
    fi

    if [ "${create_database}" == "y" ]; then
        if [ "${database_add_rc:-1}" -eq 0 ]; then
            echo "Database username: ${database_name}"
            echo "Database Name: ${database_name}"
            echo "Database userpassword: (你刚输入的那个，不回显)"
        else
            Echo_Red "Database: 创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp database add 单独重试建库。"
        fi
    else
        echo "Create database: no"
    fi
    if [ "${create_ftp}" == "y" ]; then
        if [ "${ftp_add_rc:-1}" -eq 0 ]; then
            echo "FTP account name: ${ftp_account_name}"
            echo "FTP account password: (你刚输入的那个，不回显)"
        else
            Echo_Red "FTP: 账号创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp ftp add 单独重试。"
        fi
    else
        echo "Create ftp account: no"
    fi
    if [ "${create_ssl}" == "y" ]; then
        echo "Enable SSL: yes"
        if [ "${ssl_choice}" == "1" ]; then
            echo "  =>Certificate file"
        elif [ "${ssl_choice}" == "2" ]; then
            echo "  =>Let's Encrypt"
        elif [ "${ssl_choice}" == "3" ]; then
            echo "  =>BuyPass"
        elif [ "${ssl_choice}" == "4" ]; then
            echo "  =>ZeroSSL"
        fi
    fi
    if [ "${enable_ipv6}" == "y" ]; then
        echo "IPv6 Support: Enabled"
    else
        echo "IPv6 Support: Disabled"
    fi
    Echo_Green "================================================"
}

List_VHost()
{
    echo "Nginx Virtualhost list:"
    ls /usr/local/nginx/conf/vhost/ | grep ".conf$" | sed 's/.conf//g'
    echo "Apache Virtualhost list:"
    ls /usr/local/apache/conf/vhost/ | grep ".conf$" | sed 's/.conf//g'
}

Del_VHost()
{
    echo "======================================="
    echo "Current Virtualhost:"
    List_VHost
    echo "======================================="
    domain=""
    while :;do
        Echo_Yellow "Please enter domain you want to delete: "
        read domain
        # 这个值会拼成 .../vhost/<域名>.conf 并被 rm 掉，同样要先约束字符集
        Check_Domain_Name "${domain}" || continue
        break
    done
    if [ ! -f "/usr/local/nginx/conf/vhost/${domain}.conf" ] || [ ! -f "/usr/local/apache/conf/vhost/${domain}.conf" ]; then
        echo "=========================================="
        echo "Domain: ${domain} was not exist!"
        echo "=========================================="
        exit 1
    else
        rm -f /usr/local/nginx/conf/vhost/${domain}.conf
        rm -f /usr/local/apache/conf/vhost/${domain}.conf

        # 删掉配置文件不等于站点下线：运行中的 nginx / httpd 用的是已加载的配置，
        # 不重载就会继续对外提供这个站点，而命令已经报告"已删除"。
        Del_VHost_Reload || exit 1

        echo "========================================================"
        echo "Domain: ${domain} has been deleted."
        echo "Website files will not be deleted for security reasons."
        echo "You need to manually delete the website files."
        echo "========================================================"
    fi
}

Del_VHost_Reload()
{
    local rc=0

    if pgrep -f '/usr/local/nginx/sbin/nginx' >/dev/null 2>&1; then
        echo "Test Nginx configure file......"
        if /usr/local/nginx/sbin/nginx -t && /usr/local/nginx/sbin/nginx -s reload; then
            echo "Nginx reloaded."
        else
            Echo_Red "Nginx 未能重载，运行中的 Nginx 仍在提供该站点。"
            Echo_Red "请修复后执行：lnmp nginx reload"
            rc=1
        fi
    fi

    if pgrep -f '/usr/local/apache/bin/httpd' >/dev/null 2>&1; then
        echo "Test Apache configure file......"
        if /usr/local/apache/bin/httpd -t && Svc httpd reload; then
            echo "Apache reloaded."
        else
            Echo_Red "Apache 未能重载，运行中的 httpd 仍在提供该站点。"
            Echo_Red "请修复后执行：lnmp httpd reload"
            rc=1
        fi
    fi

    return ${rc}
}

Check_DB()
{
    if [[ -s /usr/local/mariadb/bin/mysql && -s /usr/local/mariadb/bin/mysqld_safe && -s /etc/my.cnf ]]; then
        MySQL_Bin="/usr/local/mariadb/bin/mysql"
        MySQL_Ver=`/usr/local/mariadb/bin/mysql_config --version`
    elif [[ -s /usr/local/mysql/bin/mysql && -s /usr/local/mysql/bin/mysqld_safe && -s /etc/my.cnf ]]; then
        MySQL_Bin="/usr/local/mysql/bin/mysql"
        MySQL_Ver=`/usr/local/mysql/bin/mysql_config --version`
    else
        MySQL_Bin="None"
    fi
}

Make_TempMycnf()
{
    local pw
    # option file 在引号包裹的值里把反斜杠当转义符（\n、\t、\s 等），
    # 原样写入会让含反斜杠的密码被解析成别的字符，表现为“密码是对的却认证失败”。
    # 单引号不用另外处理：解析时只按首尾配对剥引号，值中间的单引号原样保留。
    pw="${1//\\/\\\\}"
    # 先备份管理员原有的 ~/.my.cnf，TempMycnf_Clean 会还原
    if [ -s ~/.my.cnf ] && [ ! -e ~/.my.cnf.lnmp-bak ]; then
        cp -p ~/.my.cnf ~/.my.cnf.lnmp-bak
    fi
    umask 077
    cat >~/.my.cnf<<EOF
[client]
user=root
password='${pw}'
EOF
    chmod 600 ~/.my.cnf
    # 标记这份凭据由本次执行写入，退出时无论走哪条分支都要清掉
    LNMP_Mycnf_Owned=1
    LNMP_Set_Trap
}

# 密码校验最多重试 3 次。原实现是 `while [ $status -eq 1 ]` 的无上限循环：
# 交互下输错密码只能 Ctrl+C 退出，非交互下输入耗尽后 read 立刻返回，
# 循环就变成空转刷屏。失败时返回非 0，由调用方决定是否继续。
Verify_DB_Password()
{
    local attempt=0 max_attempt=3
    Check_DB
    while [ ${attempt} -lt ${max_attempt} ]; do
        attempt=$((attempt + 1))
        Echo_Yellow "Enter current root password of Database (Password will not shown): "
        Read_Secret DB_Root_Password "数据库 root 密码"
        echo
        Make_TempMycnf "${DB_Root_Password}"
        if Do_Query ""; then
            echo "OK, MySQL root password correct."
            return 0
        fi
        Echo_Red "数据库 root 密码校验失败（第 ${attempt}/${max_attempt} 次）。"
    done
    Echo_Red "连续 ${max_attempt} 次校验失败，已放弃。"
    return 1
}

# ---------------------------------------------------------------------------
# 凭据和临时文件处理约束：
#   1. 临时文件使用 root 专属目录和不可预测名称；
#   2. 凭据不得写入终端日志；
#   3. SQL 字符串必须转义，标识符必须通过白名单校验。
# ---------------------------------------------------------------------------

# root 专属临时目录，退出时统一清理。
LNMP_Tmp_Dir=""
# 本次执行是否写过 ~/.my.cnf（里面是数据库 root 明文密码）。
LNMP_Mycnf_Owned=0

# 退出清理：临时目录和临时凭据挂在同一个 EXIT trap 上。
# 参数非法、系统库、EOF 等中途 exit 的分支也会经过这里，
# 不再依赖调用方在末尾补一次 TempMycnf_Clean —— 例如 vhost add 建库那条路径
# 原先就没有清理，root 密码会一直留在 ~/.my.cnf 里。
LNMP_Cleanup()
{
    if [ -n "${LNMP_Tmp_Dir}" ]; then
        rm -rf "${LNMP_Tmp_Dir}"
        LNMP_Tmp_Dir=""
    fi
    TempMycnf_Clean
}

# INT/TERM 必须单独退出：只挂 EXIT 的话，trap 执行完脚本会接着往下跑，
# Del_Database 里 "Press ctrl+c to cancel" 的倒计时就取消不掉了。
#
# 约束：注册 trap 的两个入口（Make_TempMycnf、LNMP_Tmp_Init）都只能在主 shell
# 调用，不要放进 $(...) 或管道右侧。子 shell 继承 LNMP_Tmp_Dir 的值，却会在自己
# 退出时执行这里注册的 EXIT trap，把主 shell 还在用的临时目录和凭据一起删掉。
LNMP_Set_Trap()
{
    trap 'LNMP_Cleanup' EXIT
    trap 'echo; exit 130' INT TERM
}

# 临时目录的初始化必须在当前 shell 完成，不能塞进 LNMP_Mktemp。
# LNMP_Mktemp 的返回值要靠命令替换取回，而命令替换是子 shell：在子 shell 里
# 给 LNMP_Tmp_Dir 赋值，父 shell 拿不到；在子 shell 里注册 EXIT trap，子 shell
# 一退出就把刚建好的文件连目录一起删掉，随后写 SQL 或密码文件必然失败，
# 退出时的清理也只是对着空变量执行 rm -rf ""。
LNMP_Tmp_Init()
{
    [ -n "${LNMP_Tmp_Dir}" ] && return 0
    LNMP_Tmp_Dir=$(mktemp -d /tmp/.lnmp-adm.XXXXXXXX) || return 1
    chmod 700 "${LNMP_Tmp_Dir}"
    LNMP_Set_Trap
    return 0
}

# 调用前必须已执行 LNMP_Tmp_Init。
LNMP_Mktemp()
{
    [ -n "${LNMP_Tmp_Dir}" ] || return 1
    mktemp "${LNMP_Tmp_Dir}/$1.XXXXXXXX"
}

# MySQL 单引号字符串的转义：先转反斜杠，再转单引号（顺序不能反，
# 否则会把上一步加进去的转义符再转一遍）。
Sql_Quote()
{
    local v="$1"
    v="${v//\\/\\\\}"
    v="${v//\'/\\\'}"
    printf '%s' "${v}"
}

# 库名 / 用户名走白名单，不做转义。
#
# 标识符（反引号里的东西）没有可靠的通用转义方式，而 MySQL 的库名和用户名
# 本来就只该用这些字符。与其想办法转义，不如直接拒绝越界的输入。
Check_DB_Identifier()
{
    case "$1" in
    ''|*[!A-Za-z0-9_]*)
        Echo_Red "名称 '$1' 不合法：只允许字母、数字和下划线，且不能为空。"
        return 1
        ;;
    esac
    if [ ${#1} -gt 32 ]; then
        Echo_Red "名称过长（超过 32 字符）。"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# 输入边界：域名用于配置文件名和配置内容，站点目录用于递归权限操作。
# 相关输入必须通过格式、元字符和允许目录范围检查。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Read_Input：检测 EOF，防止非交互输入耗尽后校验循环空转。
# ---------------------------------------------------------------------------
Read_Input()
{
    local __var="$1" __what="${2:-输入}"
    if ! read -r "${__var}"; then
        echo
        Echo_Red "读取${__what}时遇到 EOF —— 标准输入已经没有内容了。"
        Echo_Red "若你用管道或重定向提供输入，请核对输入项的数量与顺序："
        Echo_Red "少喂一项就会走到这里。交互执行本命令则不会有此问题。"
        exit 1
    fi
}

# Read_Secret — 同上，用于不回显的密码输入
Read_Secret()
{
    local __var="$1" __what="${2:-密码}"
    if ! read -r -s "${__var}"; then
        echo
        Echo_Red "读取${__what}时遇到 EOF —— 标准输入已经没有内容了。"
        exit 1
    fi
}

# 单个 DNS 名：标签由字母数字和连字符组成，点分隔，可带前导 *. 泛域名。
# 拒绝路径分隔符、空白和配置元字符。
Check_Domain_Name()
{
    local d="$1"
    if [ -z "${d}" ]; then
        Echo_Red "域名不能为空。"
        return 1
    fi
    if [ ${#d} -gt 253 ]; then
        Echo_Red "域名过长（超过 253 字符）：${d}"
        return 1
    fi
    # 去掉可能的泛域名前缀再校验主体
    case "${d}" in
    \*.*) d="${d#\*.}" ;;
    esac
    if ! printf '%s' "${d}" \
        | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$'; then
        Echo_Red "域名不合法：'$1'"
        Echo_Red "只接受形如 example.com / www.example.com / *.example.com 的名字，"
        Echo_Red "不接受路径分隔符、空白以及 ; { } \$ 等配置元字符。"
        return 1
    fi
    return 0
}

# 附加域名是空格分隔的一串，逐个校验，有一个不合法就整体拒绝
Check_More_Domains()
{
    local d
    for d in $1; do
        Check_Domain_Name "${d}" || return 1
    done
    return 0
}

# 站点目录：必须是绝对路径、规范化后仍落在允许的根之下、不含空白与元字符。
#
# 允许的根默认是 /home、/var/www、/srv、/data、/www 这几处常见位置，
# 外加 lnmp.conf 里配的 Default_Website_Dir 的父目录。
# 拒绝 /、/usr、/etc 等系统目录，避免对其执行 chmod -R 或 chown -R
# 是不可逆的破坏。
Check_Vhost_Dir()
{
    local d="$1" norm root ok='n'
    local matched_root='' rest probe comp resolved rroot

    if [ -z "${d}" ]; then
        Echo_Red "目录不能为空。"
        return 1
    fi
    case "${d}" in
    /*) : ;;
    *)
        Echo_Red "目录必须是绝对路径：'${d}'"
        return 1
        ;;
    esac
    if printf '%s' "${d}" | grep -Eq '[[:space:]`$;&|<>*?"'"'"'\\]'; then
        Echo_Red "目录名含空白或 shell 元字符，拒绝：'${d}'"
        return 1
    fi

    # 规范化（不要求已存在），把 .. 和多余的 / 折掉
    norm=$(printf '%s' "${d}" | sed -e 's#/\+#/#g' -e 's#/\./#/#g' -e 's#/$##')
    case "${norm}" in
    *..*)
        Echo_Red "目录不能包含 .. ：'${d}'"
        return 1
        ;;
    esac

    for root in /home /var/www /srv /data /www; do
        case "${norm}/" in
        "${root}"/*) ok='y'; matched_root="${root}"; break ;;
        esac
    done
    if [ "${ok}" != 'y' ]; then
        Echo_Red "目录 '${norm}' 不在允许的站点根之下。"
        Echo_Red "允许：/home /var/www /srv /data /www"
        Echo_Red "（限制它是因为随后要对该目录执行 chmod -R / chown -R，"
        Echo_Red "  打到 / 或 /usr 上是不可逆的。）"
        return 1
    fi

    # 允许根本身不能直接当站点目录。上面的匹配对 "/home" 也会成立
    # （模式 /home/* 里的 * 可以匹配空），而 chown -R www:www /home
    # 会把所有用户的家目录一起改掉。至少要深一层。
    if [ "${norm}" = "${matched_root}" ]; then
        Echo_Red "不能直接用 '${norm}' 作为站点目录，请在它下面建子目录。"
        Echo_Red "（随后的 chown -R 会作用于整个目录树。）"
        return 1
    fi

    # ---------------------------------------------------------------------
    # 逐级检查路径组件，任一为符号链接即拒绝。
    #
    # 从允许根的下一层开始逐级检查，防止中间路径组件通过符号链接越界。
    # 允许根本身可由管理员配置为符号链接。
    # ---------------------------------------------------------------------
    rest="${norm#${matched_root}/}"
    probe="${matched_root}"
    while [ -n "${rest}" ]; do
        comp="${rest%%/*}"
        if [ "${comp}" = "${rest}" ]; then rest=''; else rest="${rest#*/}"; fi
        probe="${probe}/${comp}"
        if [ -L "${probe}" ]; then
            Echo_Red "路径组件 '${probe}' 是符号链接，拒绝作为站点目录。"
            Echo_Red "（递归改权限会跟着链接跑到目录树之外去。）"
            return 1
        fi
    done

    # 再用 realpath 交叉确认一次：解析掉所有符号链接后仍须落在允许根之下。
    # 允许根本身也解析后再比，这样 /home -> /mnt/data/home 的部署不会被误拒。
    # realpath -m 不要求路径已存在（coreutils 8.15+，Debian/CentOS 均自带）。
    if command -v realpath >/dev/null 2>&1; then
        resolved=$(realpath -m "${norm}" 2>/dev/null) || resolved="${norm}"
        ok='n'
        for root in /home /var/www /srv /data /www; do
            rroot=$(realpath -m "${root}" 2>/dev/null) || rroot="${root}"
            case "${resolved}/" in
            "${rroot}"/*) ok='y'; break ;;
            esac
        done
        if [ "${ok}" != 'y' ]; then
            Echo_Red "'${norm}' 解析后指向 '${resolved}'，不在允许的站点根之下，拒绝。"
            return 1
        fi
    fi

    vhostdir="${norm}"
    return 0
}

Do_Query()
{
    local sql_file rc
    # 这里失败是环境问题（建不出临时目录），不能只返回非 0：
    # Verify_DB_Password 会把非 0 当成密码错误，一直重试下去。
    LNMP_Tmp_Init || exit 1
    sql_file=$(LNMP_Mktemp query) || exit 1
    chmod 600 "${sql_file}"
    printf '%s\n' "$1" > "${sql_file}"
    Check_DB
    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${sql_file}"
    rc=$?
    rm -f "${sql_file}"
    return ${rc}
}

# 只清理本次执行自己写进去的凭据，避免误删管理员原有的 ~/.my.cnf。
# 可重复调用：正常路径末尾调一次，EXIT trap 再调一次也不会重复还原备份。
TempMycnf_Clean()
{
    [ "${LNMP_Mycnf_Owned}" -eq 1 ] || return 0
    LNMP_Mycnf_Owned=0
    rm -f ~/.my.cnf
    # 恢复安装前备份的客户端配置。
    if [ -e ~/.my.cnf.lnmp-bak ]; then
        mv -f ~/.my.cnf.lnmp-bak ~/.my.cnf
    fi
}

Enter_Database_Name()
{
    while :;do
        Echo_Yellow "Enter database name (只允许字母/数字/下划线): "
        Read_Input database_name "数据库名"
        Check_DB_Identifier "${database_name}" || continue
        if [ "${database_name}" == "" ]; then
            Echo_Red "Database Name can't be empty!"
        else
            break
        fi
    done
}

Add_Database_Menu()
{
    Enter_Database_Name
    echo "Your will create a database and MySQL user with same name: ${database_name}"
    Echo_Yellow "Please enter password for mysql user ${database_name} (输入不回显): "
    Read_Secret mysql_password "数据库用户密码"
    echo
    if [ -z "${mysql_password}" ]; then
        Echo_Red "密码不能为空。"
        return 1
    fi
    return 0
}

Add_Database()
{
    local sql_file mysql_password_q rc
    Check_DB_Identifier "${database_name}" || return 1
    mysql_password_q=$(Sql_Quote "${mysql_password}")
    LNMP_Tmp_Init || return 1
    sql_file=$(LNMP_Mktemp add_db) || return 1
    chmod 600 "${sql_file}"

    # 使用兼容当前 MySQL 和 MariaDB 版本的统一建库流程。
    # 原 `grep -Eqi '^8\.0\.'` 只认 8.0.x，默认的 MySQL 8.4 会落进 else，
    # 用到已被 MySQL 8.0 移除的 `GRANT ... IDENTIFIED BY`，建库将报 1064。
    # mysql 客户端逐条执行 SQL，因此所有建库语句保持幂等，
    # 中途失败会留下已建好的用户，裸 CREATE USER 重试即报 1396。
    cat >"${sql_file}"<<EOF
CREATE USER IF NOT EXISTS '${database_name}'@'localhost' IDENTIFIED BY '${mysql_password_q}';
CREATE USER IF NOT EXISTS '${database_name}'@'127.0.0.1' IDENTIFIED BY '${mysql_password_q}';
ALTER USER '${database_name}'@'localhost' IDENTIFIED BY '${mysql_password_q}';
ALTER USER '${database_name}'@'127.0.0.1' IDENTIFIED BY '${mysql_password_q}';
GRANT USAGE ON *.* TO '${database_name}'@'localhost';
GRANT USAGE ON *.* TO '${database_name}'@'127.0.0.1';
CREATE DATABASE IF NOT EXISTS \`${database_name}\`;
GRANT ALL PRIVILEGES ON \`${database_name}\`.* TO '${database_name}'@'localhost';
GRANT ALL PRIVILEGES ON \`${database_name}\`.* TO '${database_name}'@'127.0.0.1';
FLUSH PRIVILEGES;
EOF

    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${sql_file}"
    rc=$?
    rm -f "${sql_file}"
    if [ ${rc} -ne 0 ]; then
        Echo_Red "Add database failed!"
        return ${rc}
    fi
    echo "Add database Sucessfully."
    return 0
}

List_Database()
{
    local rc
    ${MySQL_Bin} --defaults-file=~/.my.cnf -e "SHOW DATABASES;"
    rc=$?
    if [ ${rc} -ne 0 ]; then
        Echo_Red "List all databases failed!"
        return ${rc}
    fi
    echo "List all databases Sucessfully."
    return 0
}

Edit_Database()
{
    local pass_q
    while :;do
        Echo_Yellow "Enter database username (只允许字母/数字/下划线): "
        Read_Input database_username "数据库用户名"
        Check_DB_Identifier "${database_username}" || continue
        break
    done
    while :;do
        Echo_Yellow "Enter NEW Password (输入不回显): "
        Read_Secret database_username_passwd "新密码"
        echo
        if [ "${database_username_passwd}" == "" ]; then
            Echo_Red "Database Password can't be empty!"
        else
            break
        fi
    done
    pass_q=$(Sql_Quote "${database_username_passwd}")

    # 三条语句合成一次执行：mysql 客户端默认遇错即停，
    # 分三次调用只检查中间那次的返回码，前后两次失败都会被当成成功。
    if ! Do_Query "ALTER USER '${database_username}'@'localhost' IDENTIFIED BY '${pass_q}';
ALTER USER '${database_username}'@'127.0.0.1' IDENTIFIED BY '${pass_q}';
FLUSH PRIVILEGES;"; then
        Echo_Red "Edit user password failed!"
        return 1
    fi
    echo "Edit user password Sucessfully."
    return 0
}

Del_Database()
{
    local del_sql_file rc
    List_Database || return 1
    Enter_Database_Name
    if [[ "${database_name}" == "information_schema" || "${database_name}" == "mysql" || "${database_name}" == "performance_schema" ]]; then
        Echo_Red "MySQL System Database can't be delete!"
        return 1
    fi
    Check_DB_Identifier "${database_name}" || return 1
    # 先确认库确实存在：既把“库名敲错”和“删除失败”区分开，
    # 也不用等完 10 秒倒计时才发现名字打错了。
    if ! Database_Exists "${database_name}"; then
        Echo_Red "数据库不存在：${database_name}"
        return 1
    fi
    echo "Your will delete database and MySQL user with same name: ${database_name}"
    echo "Sleep 10s, Press ctrl+c to cancel..."
    Sleep_Sec 10
    LNMP_Tmp_Init || return 1
    del_sql_file=$(LNMP_Mktemp del_db) || return 1
    chmod 600 "${del_sql_file}"
    cat >"${del_sql_file}"<<EOF
DROP USER IF EXISTS '${database_name}'@'127.0.0.1';
DROP USER IF EXISTS '${database_name}'@'localhost';
DROP DATABASE \`${database_name}\`;
FLUSH PRIVILEGES;
EOF
    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${del_sql_file}"
    rc=$?
    rm -f "${del_sql_file}"
    if [ ${rc} -ne 0 ]; then
        Echo_Red "Delete database: ${database_name} failed!"
        return ${rc}
    fi
    echo "Delete database: ${database_name} Sucessfully."
    return 0
}

# ---------------------------------------------------------------------------
# 备份与恢复
#
#   lnmp database export <数据库名> <文件.sql.gz>
#   lnmp database import <数据库名> <文件.sql.gz>
#
# 导出的是单库内容，不带 CREATE DATABASE / USE 语句：目标库完全由命令行参数
# 决定，备份文件里记录的库名不会反过来盖掉用户指定的库，因此同一份备份可以
# 恢复到另一个库名，也不会误写到别的库上。
# ---------------------------------------------------------------------------

# 与 mysql 客户端同目录的 mysqldump。
MySQL_Dump_Bin=""
Check_Dump_Bin()
{
    if [ "${MySQL_Bin}" == "None" ]; then
        Echo_Red "未检测到已安装的 MySQL/MariaDB。"
        return 1
    fi
    MySQL_Dump_Bin="$(dirname "${MySQL_Bin}")/mysqldump"
    if [ ! -x "${MySQL_Dump_Bin}" ]; then
        Echo_Red "找不到可执行的 mysqldump：${MySQL_Dump_Bin}"
        return 1
    fi
    return 0
}

# 库是否存在。用 information_schema 精确比较，不用 SHOW DATABASES LIKE ——
# LIKE 会把库名里的下划线当成单字符通配符，wp_a 能匹配到 wpxa。
Database_Exists()
{
    local name_q out
    name_q=$(Sql_Quote "$1")
    out=$(${MySQL_Bin} --defaults-file=~/.my.cnf -N -B -e \
        "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='${name_q}';") || return 1
    [ -n "${out}" ]
}

# 备份文件路径：父目录必须已存在，目标不能是目录或其它非普通文件。
Check_Backup_Path()
{
    local f="$1" dir
    if [ -z "${f}" ]; then
        Echo_Red "备份文件路径不能为空。"
        return 1
    fi
    case "${f}" in
        */)
            Echo_Red "备份文件路径不能以 / 结尾：${f}"
            return 1
            ;;
    esac
    dir=$(dirname -- "${f}")
    if [ ! -d "${dir}" ]; then
        Echo_Red "目录不存在：${dir}"
        return 1
    fi
    if [ -e "${f}" ] && [ ! -f "${f}" ]; then
        Echo_Red "目标已存在且不是普通文件：${f}"
        return 1
    fi
    return 0
}

Export_Database()
{
    local database_name="$1" out_file="$2" tmp_file dump_rc gzip_rc pipe_st

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: lnmp database export <数据库名> <文件.sql.gz>"
        return 1
    fi
    Check_DB_Identifier "${database_name}" || return 1
    Check_Backup_Path "${out_file}" || return 1
    if [ -e "${out_file}" ]; then
        Echo_Red "文件已存在，不覆盖：${out_file}"
        Echo_Red "请换一个文件名，或自行删除旧文件后重试。"
        return 1
    fi
    Check_Dump_Bin || return 1
    if ! Database_Exists "${database_name}"; then
        Echo_Red "数据库不存在：${database_name}"
        return 1
    fi

    # 先写同目录临时文件再改名：中途失败不会留下一个看着像备份的半截文件，
    # 同目录也保证 mv 是原子改名而不是跨文件系统复制。
    tmp_file=$(mktemp "${out_file}.lnmp-part.XXXXXXXX") || {
        Echo_Red "无法在目标目录创建临时文件：${out_file}"
        return 1
    }
    echo "Exporting database ${database_name} ..."
    ${MySQL_Dump_Bin} --defaults-file=~/.my.cnf \
        --single-transaction --quick --routines --triggers --events \
        --default-character-set=utf8mb4 \
        "${database_name}" | gzip -c > "${tmp_file}"
    # PIPESTATUS 必须一次性快照：第一条赋值语句本身就会把它重置成
    # 那条赋值的状态，再取 [1] 拿到的不是管道右侧的退出码 ——
    # set -u 下直接报 unbound variable，没开 set -u 则静默变成空字符串，
    # gzip / mysql 的失败会被当成没发生。
    pipe_st=("${PIPESTATUS[@]}")
    dump_rc=${pipe_st[0]}
    gzip_rc=${pipe_st[1]}
    if [ "${dump_rc}" -ne 0 ] || [ "${gzip_rc}" -ne 0 ]; then
        rm -f "${tmp_file}"
        Echo_Red "Export database: ${database_name} failed! (mysqldump=${dump_rc} gzip=${gzip_rc})"
        return 1
    fi
    if ! mv -f "${tmp_file}" "${out_file}"; then
        rm -f "${tmp_file}"
        Echo_Red "写入备份文件失败：${out_file}"
        return 1
    fi
    chmod 600 "${out_file}"
    echo "Export database: ${database_name} Sucessfully."
    echo "Backup file: ${out_file}"
    return 0
}

Import_Database()
{
    local database_name="$1" in_file="$2" rc gz_rc mysql_rc pipe_st

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: lnmp database import <数据库名> <文件.sql.gz>"
        return 1
    fi
    Check_DB_Identifier "${database_name}" || return 1
    if [ ! -f "${in_file}" ]; then
        Echo_Red "备份文件不存在或不是普通文件：${in_file}"
        return 1
    fi
    if [ ! -r "${in_file}" ] || [ ! -s "${in_file}" ]; then
        Echo_Red "备份文件不可读或为空：${in_file}"
        return 1
    fi
    # 不自动建库：建库同时还要建用户和授权，那是 database add 的职责，
    # 这里凭空 CREATE DATABASE 会留下一个没有对应用户的库。
    if ! Database_Exists "${database_name}"; then
        Echo_Red "数据库不存在：${database_name}"
        Echo_Red "请先执行 lnmp database add 建库建用户，再导入。"
        return 1
    fi

    Echo_Yellow "导入会覆盖数据库 ${database_name} 中的同名表，且无法撤销。"
    echo "Sleep 10s, Press ctrl+c to cancel..."
    Sleep_Sec 10

    echo "Importing into database ${database_name} ..."
    # 按文件内容判断是否压缩，不按扩展名：直接给未压缩的 .sql 也能导入。
    if gzip -t "${in_file}" 2>/dev/null; then
        gzip -dc "${in_file}" | ${MySQL_Bin} --defaults-file=~/.my.cnf \
            --default-character-set=utf8mb4 "${database_name}"
        pipe_st=("${PIPESTATUS[@]}")
        gz_rc=${pipe_st[0]}
        mysql_rc=${pipe_st[1]}
        rc=0
        [ "${gz_rc}" -ne 0 ] && rc=1
        [ "${mysql_rc}" -ne 0 ] && rc=1
    else
        ${MySQL_Bin} --defaults-file=~/.my.cnf \
            --default-character-set=utf8mb4 "${database_name}" < "${in_file}"
        rc=$?
    fi
    if [ "${rc}" -ne 0 ]; then
        Echo_Red "Import database: ${database_name} failed!"
        return 1
    fi
    echo "Import database: ${database_name} Sucessfully."
    return 0
}

Enter_Ftp_Name()
{
    while :;do
        Echo_Yellow "Enter ftp account name (只允许字母/数字/下划线): "
        Read_Input ftp_account_name "FTP 账号名"
        # 账号名会被拼进 /tmp 路径和 pure-pw 的参数，必须先约束字符集
        if ! Check_DB_Identifier "${ftp_account_name}"; then
            continue
        else
            break
