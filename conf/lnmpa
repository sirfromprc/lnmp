Detect_Server_IP()
{
    local ip='' pub=''
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    if [ -z "${ip}" ] || Is_Private_IP "${ip}"; then
        pub=$(curl -fsS --max-time 8 https://api.ipify.org 2>/dev/null)
        [ -n "${pub}" ] && ip="${pub}"
    fi
    printf '%s' "${ip}"
}

Is_Private_IP()
{
    case "$1" in
        10.*|127.*|169.254.*|192.168.*)          return 0 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*)   return 0 ;;
        100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 0 ;;
        ''|*[!0-9.]*)                            return 0 ;;
    esac
    return 1
}

# IP 是否绑定在本机某个接口上。ip 命令不可用时返回 0，不阻断流程。
Ip_On_Local_Interface()
{
    local addr="$1"
    [ -n "${addr}" ] || return 1
    command -v ip >/dev/null 2>&1 || return 0
    ip -4 -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 |
        grep -qxF "${addr}"
}

Prepare_Default_Site_IP_Cert()
{
    local ip nat_confirm=''
    ip=$(Detect_Server_IP)
    if [ -z "${ip}" ] || Is_Private_IP "${ip}"; then
        Echo_Red "default 站点未探测到可签发证书的公网 IPv4，无法使用 Let's Encrypt。"
        Echo_Yellow "请为网站绑定域名，或选择 1 使用自有证书。"
        echo
        return 1
    fi

    Echo_Yellow "default 将为服务器公网 IPv4 ${ip} 申请 Let's Encrypt IP 证书。"

    echo
    Echo_Yellow "该证书使用 shortlived profile，有效期 7 天，必须保留 acme.sh 自动续期任务。"
    echo
    # 出口地址未绑定在本机接口时，HTTP-01 验证到不了本机，签发必然失败，
    # 失败次数还计入 CA 的速率限制，因此要求显式确认后才继续。
    if ! Ip_On_Local_Interface "${ip}"; then
        Echo_Red "${ip} 未绑定在本机任何接口上，这台机器在 NAT 后面。"
        echo "只有已把该 IP 的 80 端口转发到本机，HTTP-01 验证才可能通过；"
        echo "否则本次申请会失败，并消耗账户的失败验证次数。"
        read -p "确认已做端口转发并继续申请？(y/N)：" nat_confirm
        case "${nat_confirm}" in
            y|Y|yes|YES) ;;
            *) Echo_Red "已取消 default 站点的证书申请。"; return 1 ;;
        esac
        echo
    fi

    letsdomain="-d ${ip}"
    cert_profile_opt="--certificate-profile shortlived --days 6"
    default_site_ip="${ip}"
    return 0
}

# acme.sh 使用 GitHub 官方固定版本和 SHA256，更新版本时必须同步更新校验值。
Acme_Sh_Ver='3.1.4'
Acme_Sh_SHA256='e5f8e187bbf5251e0cd8891f2622daab9850366bd17bea9f92c2fe2ee091fd32'

Install_Check_Acme.sh()
{
    local tmpdir tarball srcdir actual
    local -a email_opt=()

    if [ -s /usr/local/acme.sh/acme.sh ]; then
        echo "/usr/local/acme.sh/acme.sh [已存在]"
        if [ -n "${email_address}" ] \
            && ! grep -Eq "^ACCOUNT_EMAIL=" /usr/local/acme.sh/account.conf 2>/dev/null; then
            /usr/local/acme.sh/acme.sh --register-account -m "${email_address}" || return 1
        fi
        . "/usr/local/acme.sh/acme.sh.env"
        return 0
    fi

    if ! command -v sha256sum >/dev/null 2>&1; then
        Echo_Red "缺少 sha256sum，无法校验 acme.sh 安装包，拒绝安装。"
        return 1
    fi

    tmpdir=$(mktemp -d /tmp/acme.sh.XXXXXXXX) || return 1
    chmod 700 "${tmpdir}"
    tarball="${tmpdir}/acme.sh-${Acme_Sh_Ver}.tar.gz"
    srcdir="${tmpdir}/acme.sh-${Acme_Sh_Ver}"

    echo "正在从 github.com/acmesh-official 下载 acme.sh ${Acme_Sh_Ver} ..."
    if ! wget --prefer-family=IPv4 --max-redirect=5 -O "${tarball}" \
         "https://github.com/acmesh-official/acme.sh/archive/refs/tags/${Acme_Sh_Ver}.tar.gz"; then
        Echo_Red "acme.sh 下载失败，未做任何修改。"
        rm -rf "${tmpdir}"
        return 1
    fi

    # 安装包通过固定 SHA256 校验后才能解压和执行。
    actual=$(sha256sum "${tarball}" | awk '{print $1}')
    if [ "${actual}" != "${Acme_Sh_SHA256}" ]; then
        Echo_Red "acme.sh 安装包 SHA256 不匹配，拒绝执行。"
        Echo_Red "  期望值：${Acme_Sh_SHA256}"
        Echo_Red "  实际值：${actual}"
        rm -rf "${tmpdir}"
        return 1
    fi

    if ! tar zxf "${tarball}" -C "${tmpdir}"; then
        Echo_Red "acme.sh 解压失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    # 归档目录必须与固定版本一致。
    if [ ! -s "${srcdir}/acme.sh" ]; then
        Echo_Red "acme.sh 归档结构异常：未找到 ${srcdir}/acme.sh"
        rm -rf "${tmpdir}"
        return 1
    fi

    [ -n "${email_address}" ] && email_opt=( -m "${email_address}" )
    ( cd "${srcdir}" && ./acme.sh --install ${acme_sh_sudo} --log \
        --home /usr/local/acme.sh --certhome /usr/local/nginx/conf/ssl "${email_opt[@]}" )
    if [ $? -ne 0 ] || [ ! -s /usr/local/acme.sh/acme.sh ]; then
        Echo_Red "acme.sh 安装失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    rm -rf "${tmpdir}"

    sed -i 's/cat "\$CERT_PATH"$/#cat "\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
    # 关闭 acme.sh 自动升级，避免未经固定版本校验的代码覆盖证书管理组件。
    # 安全更新通过 upgrade.sh 手动确认，完成后应重新核对来源和完整性。

    /usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
    cat >/usr/local/acme.sh/upgrade.sh<<EOF
#!/bin/bash
#
# 手动升级 acme.sh；禁止加入 crontab。
#
# 此操作直接从 GitHub 更新，不使用安装包的固定版本和 SHA256。
# 仅在需要上游安全更新时执行，完成后须确认组件来源和完整性。

echo "警告：即将从 GitHub 升级 acme.sh，此过程不做完整性校验。"
printf "确认继续请输入 yes: "
read -r _ans
[ "\$_ans" = "yes" ] || { echo "已取消。"; exit 1; }

. "/usr/local/acme.sh/acme.sh.env"
/usr/local/acme.sh/acme.sh --upgrade
/usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
sed -i 's/cat "\\\$CERT_PATH"\$/#cat "\\\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
EOF

    chmod +x /usr/local/acme.sh/upgrade.sh
    #if crontab -l|grep -q "/usr/local/acme.sh/upgrade.sh"; then
    #    echo "acme.sh upgrade crontab rule is exist."
    #else
    #    echo "Add acme.sh upgrade crontab rule..."
    #    (crontab -l ; echo '0 3 */7 * * /usr/local/acme.sh/upgrade.sh') | crontab -
    #fi
    if command -v yum >/dev/null 2>&1; then
        yum -y update nss
        yum -y install ca-certificates
        service crond restart
        chkconfig crond on
    elif command -v apt-get >/dev/null 2>&1; then
        /etc/init.d/cron restart
        update-rc.d cron defaults
    fi

    . "/usr/local/acme.sh/acme.sh.env"
}

Create_SSL_Config()
{
    local vhost_conf="/usr/local/nginx/conf/vhost/${domain}.conf" backup
    local ssl_listen='listen 443 ssl;' ssl_ipv6_listen='#listen [::]:443 ssl;'
    local ssl_server_name="${domain} ${moredomain}" ssl_php_block='include proxy-pass-php.conf;' ssl_index

    Check_Config_File_Path "${ssl_certificate}" "SSL 证书文件" || return 1
    Check_Config_File_Path "${ssl_certificate_key}" "SSL 私钥文件" || return 1
    ssl_index="$(Site_Index_Line)"
    if [ "${enable_site_php}" = "n" ]; then
        # 站点自行移除 .php 拦截时（整站反代要把 .php 交给后端）不再写回：
        # 正则 location 优先级高于 location /，写回会把反代请求拦成 404。
        if grep -qF '[^/]\.php(/|$)' "${vhost_conf}"; then
            ssl_php_block="$(Site_PHP_Off_Block)"
        else
            ssl_php_block=''
        fi
    fi
    if [ "${domain}" = "default" ]; then
        ssl_listen='listen 443 ssl default_server;'
        ssl_ipv6_listen='#listen [::]:443 ssl default_server ipv6only=on;'
        ssl_server_name='_'
        # default 的 HTTPS 配置保留 phpMyAdmin，并拒绝根目录中的其它 .php。
        ssl_index='index index.html index.htm index.php default.html default.htm default.php;'
        ssl_php_block='include phpmyadmin.*.conf;

    location ~ [^/]\.php(/|$) {
        return 404;
    }'
    fi
    if [ "${enable_ipv6}" = "y" ]; then
        if [ "${domain}" = "default" ]; then
            ssl_ipv6_listen='listen [::]:443 ssl default_server ipv6only=on;'
        else
            ssl_ipv6_listen='listen [::]:443 ssl;'
        fi
    fi

    backup=$(mktemp /tmp/lnmpa-ssl-vhost.XXXXXXXX) || return 1
    \cp -p "${vhost_conf}" "${backup}" || { rm -f "${backup}"; return 1; }
    cat >>"${vhost_conf}"<<EOF

server {
    ${ssl_listen}
    ${ssl_ipv6_listen}
    # Nginx 1.25.1 及以上使用独立的 http2 指令。
    http2 on;
    server_name ${ssl_server_name};
    ${ssl_index}
    root  ${vhostdir};

    ssl_certificate ${ssl_certificate};
    ssl_certificate_key ${ssl_certificate_key};
    # TLS 1.0 和 1.1 已被 RFC 8996 弃用。
    ssl_protocols TLSv1.2 TLSv1.3;
    # 仅保留基于 ECDHE 的 AEAD 套件，排除 3DES、静态 RSA、CBC 和需要 DH 参数的 DHE。
    # TLS 1.3 使用 OpenSSL 独立的默认套件配置。
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    # 由客户端选择套件，可优先使用设备具备硬件加速的算法。
    ssl_prefer_server_ciphers off;
    # 10 MB 会话缓存约可保存 4 万个握手结果，减少重复完整握手。
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 5m;
    # 关闭 session ticket，避免长期票据密钥泄露影响历史会话的前向保密。
    ssl_session_tickets off;

    # HSTS 会在有效期内强制浏览器使用 HTTPS。启用前须确认主域名和所有
    # 子域名均可持续提供有效证书，否则浏览器无法回退到 HTTP。
    #add_header Strict-Transport-Security "max-age=31536000" always;

    #error_page   404   /404.html;

    # 可按需禁止指定目录执行 PHP。
    #location ~ /(wp-content|uploads|wp-includes|images)/.*\.php$ { deny all; }

    ${ssl_php_block}

    location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
        expires      30d;
    }

    location ~ .*\.(js|css)$ {
        expires      12h;
    }

    location ^~ /.well-known/ {
        allow all;
    }

    location ~ /\. {
        deny all;
    }

    ${al}
    error_log   /home/wwwlogs/${domain}.error.log;

    # 自定义配置--开始
${ssl_custom_block}
    # 自定义配置--结束
}
EOF

    if [ "${using_301}" == "y" ]; then
        if Custom_Block_Has_Root_Location "${ssl_custom_block}"; then
            # 站点已自定义 location /，再插一个会 duplicate location 使 nginx -t 失败。
            # 改用 server 级跳转，并放行 ACME 续期用的 .well-known 路径。
            sed -i '0,/access_log/!b;//i\    if ($request_uri !~ "^/\\.well-known/") {\n        return 301 https://$host$request_uri;\n    }\n' /usr/local/nginx/conf/vhost/${domain}.conf
        else
            sed -i '0,/access_log/!b;//i\    location / {\n        return 301 https://$host$request_uri;\n    }\n' /usr/local/nginx/conf/vhost/${domain}.conf
        fi
        sed -i '0,/include proxy-pass-php.conf;/s/include proxy-pass-php.conf;/#include proxy-pass-php.conf;/' /usr/local/nginx/conf/vhost/${domain}.conf
    fi

    echo "正在检查 Nginx 配置......"
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，已恢复添加 SSL 前的虚拟主机配置。"
        \cp -p "${backup}" "${vhost_conf}"
        rm -f "${backup}"
        return 1
    fi
    echo "正在重载 Nginx......"
    if ! /usr/local/nginx/sbin/nginx -s reload; then
        Echo_Red "Nginx 重载失败，已恢复添加 SSL 前的虚拟主机配置。"
        \cp -p "${backup}" "${vhost_conf}"
        /usr/local/nginx/sbin/nginx -s reload
        rm -f "${backup}"
        return 1
    fi
    rm -f "${backup}"
    return 0
}

# KILL 或断电时 Restore_Cert_Dir 来不及执行，活动证书目录会停留在缺失状态。
# 申请前扫描同级遗留备份：产生它的进程已退出且活动路径缺失时恢复，其余只提示。
Recover_Cert_Backups()
{
    local dir="$1" parent bak base pid

    parent="${dir%/*}"
    [ -n "${parent}" ] && [ -d "${parent}" ] || return 0
    for bak in "${parent}"/*.lnmp-bak.*; do
        [ -d "${bak}" ] || continue
        pid="${bak##*.lnmp-bak.}"
        case "${pid}" in
        ''|*[!0-9]*) continue ;;
        esac
        [ "${pid}" = "$$" ] && continue
        # 备份进程仍在运行时不介入，避免破坏正在进行的申请。
        kill -0 "${pid}" 2>/dev/null && continue
        [ -n "$(ls -A "${bak}" 2>/dev/null)" ] || continue
        base="${bak%.lnmp-bak.*}"
        if [ -e "${base}" ]; then
            Echo_Yellow "存在遗留证书备份 ${bak}，活动证书已在位，确认后可自行删除。"
            echo
            continue
        fi
        if mv "${bak}" "${base}"; then
            Echo_Yellow "上次申请被中断，已恢复原有证书：${base}"
            echo
        else
            Echo_Red "恢复遗留证书备份失败：${bak}"
        fi
    done
    return 0
}

# 证书目录在签发前改名保留，任一环节失败即回滚。直接删除会在签发或安装
# 失败时留下不可用的证书路径，而旧证书可能仍被站点配置引用。
# 记录本次签发前 acme.sh 工作目录的状态，供失败时判断能否清理。
Note_Acme_Workdir()
{
    Acme_Workdir="$1/$2_ecc"
    Acme_Workdir_Was_Absent='n'
    [ -e "${Acme_Workdir}" ] || Acme_Workdir_Was_Absent='y'
}

# 签发失败时清理本次新建的 acme.sh 工作目录，避免遗留私钥与 csr。
# 目录在本次签发前就存在，或其中已有证书时保持不动。
Cleanup_Failed_Acme_Workdir()
{
    [ "${Acme_Workdir_Was_Absent:-n}" = 'y' ] || return 0
    [ -n "${Acme_Workdir:-}" ] && [ -d "${Acme_Workdir}" ] || return 0
    case "${Acme_Workdir}" in
        */conf/ssl/?*_ecc) ;;
        *) return 0 ;;
    esac
    [ -s "${Acme_Workdir}/fullchain.cer" ] && return 0
    rm -rf "${Acme_Workdir}" && echo "已清理签发失败遗留的 ${Acme_Workdir}"
}

Backup_Cert_Dir()
{
    local dir="$1"

    Cert_Backup_Src=""
    Cert_Backup_Dir=""
    [ -n "${dir}" ] || return 0
    Recover_Cert_Backups "${dir}"
    [ -d "${dir}" ] || return 0

    Cert_Backup_Dir="${dir}.lnmp-bak.$$"
    rm -rf "${Cert_Backup_Dir}"
    if ! mv "${dir}" "${Cert_Backup_Dir}"; then
        Cert_Backup_Dir=""
        Echo_Red "备份现有证书目录失败：${dir}"
        return 1
    fi
    Cert_Backup_Src="${dir}"
    # 中断信号必须走 EXIT 清理，否则活动证书路径会停在缺失状态。
    LNMP_Set_Trap
    echo "已备份现有证书，签发失败时会自动恢复。"
    return 0
}

# 失败回滚：丢弃本次写入的内容，把备份改回原路径。
Restore_Cert_Dir()
{
    [ -n "${Cert_Backup_Dir}" ] && [ -d "${Cert_Backup_Dir}" ] || return 0
    rm -rf "${Cert_Backup_Src}"
    if mv "${Cert_Backup_Dir}" "${Cert_Backup_Src}"; then
        Echo_Yellow "已恢复原有证书：${Cert_Backup_Src}"
        echo
    else
        Echo_Red "恢复原有证书失败，备份保留在：${Cert_Backup_Dir}"
    fi
    Cert_Backup_Src=""
    Cert_Backup_Dir=""
    return 0
}

# 成功后清理备份。
Discard_Cert_Backup()
{
    [ -n "${Cert_Backup_Dir}" ] && rm -rf "${Cert_Backup_Dir}"
    Cert_Backup_Src=""
    Cert_Backup_Dir=""
    return 0
}

Add_SSL()
{
    local vhost_conf="/usr/local/nginx/conf/vhost/${domain}.conf"
    local apache_vhost_conf

    if [ "${domain}" = "default" ]; then
        apache_vhost_conf="/usr/local/apache/conf/extra/httpd-vhosts.conf"
    else
        apache_vhost_conf="/usr/local/apache/conf/vhost/${domain}.conf"
    fi

    if [ ! -s "${vhost_conf}" ] && [ ! -s "${apache_vhost_conf}" ]; then
        Echo_Red "未找到网站 ${domain} 的虚拟主机配置。"
        Echo_Yellow "请先执行 lnmp vhost add 创建网站，再执行 lnmp ssl add 添加证书。"
        echo
        return 1
    fi
    if [ ! -s "${vhost_conf}" ] || [ ! -s "${apache_vhost_conf}" ]; then
        Echo_Red "网站 ${domain} 的 LNMPA 虚拟主机配置不完整，无法添加证书。"
        return 1
    fi
    if [ -z "${vhostdir:-}" ] || [ ! -d "${vhostdir}" ]; then
        Echo_Red "网站 ${domain} 的根目录不存在，无法添加证书。"
        return 1
    fi
    if [[ "${domain}" = "default" && ! "${ssl_choice}" =~ ^(1|2)$ ]]; then
        Echo_Red "default 站点只支持自有证书或 Let's Encrypt IP 证书。"
        return 1
    fi

    if [ "${ssl_choice}" == "1" ]; then
        Create_SSL_Config || return 1
    elif echo "${ssl_choice}" | grep -Eqi "^[23]$"; then
        letsdomain=""
        cert_profile_opt=""
        letsdomain="-d ${domain}"
        if [ "${moredomain}" != "" ]; then
            # 泛域名带 *，拆分期间关闭路径展开。
            set -f
            for i in ${moredomain};do
                # HTTP-01 不能签发泛域名，站点配置里已有的泛域名不带入本次证书。
                case "${i}" in
                \*.*)
                    Echo_Yellow "HTTP 验证不能签发泛域名，${i} 不加入本次证书。"
                    echo
                    continue
                    ;;
                esac
                letsdomain=${letsdomain}" -d ${i}"
            done
            set +f
        fi
        if [ "${domain}" = "default" ]; then
            Prepare_Default_Site_IP_Cert || return 1
        fi
        if [[ "${vhostdir}" == "" || "${letsdomain}" == "" ]]; then
            Echo_Red "缺少必要参数：网站目录和证书申请目标不能为空。"
            return 1
        fi

        Install_Check_Acme.sh || exit 1

        Backup_Cert_Dir "/usr/local/nginx/conf/ssl/${domain}" || return 1
        acme_target="${domain}"
        [ "${domain}" = "default" ] && acme_target="${default_site_ip}"
        Note_Acme_Workdir "/usr/local/nginx/conf/ssl" "${acme_target}"

        if [ "${ssl_choice}" == "2" ]; then
            echo "正在使用 Let's Encrypt 签发 SSL 证书..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server letsencrypt --issue ${letsdomain} -w ${vhostdir} ${cert_profile_opt} --reloadcmd "/etc/init.d/nginx reload"
        elif [ "${ssl_choice}" == "3" ]; then
            echo "正在使用 ZeroSSL 签发 SSL 证书..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server zerossl --issue ${letsdomain} -w ${vhostdir} --reloadcmd "/etc/init.d/nginx reload"
        fi
        lets_status=$?

        if [ "${lets_status}" = 0 ]; then
            cert_install_domain="${domain}"
            [ "${domain}" = "default" ] && cert_install_domain="${default_site_ip}"
            mkdir -p "/usr/local/nginx/conf/ssl/${domain}" || { Restore_Cert_Dir; return 1; }
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --install-cert -d "${cert_install_domain}" --ecc \
                --key-file "/usr/local/nginx/conf/ssl/${domain}/${domain}.key" \
                --fullchain-file "/usr/local/nginx/conf/ssl/${domain}/fullchain.cer" \
                --reloadcmd "/etc/init.d/nginx reload"
            lets_status=$?
        fi

        ssl_certificate="/usr/local/nginx/conf/ssl/${domain}/fullchain.cer"
        ssl_certificate_key="/usr/local/nginx/conf/ssl/${domain}/${domain}.key"
        if [ "${lets_status}" = 0 ]; then
            Create_SSL_Config || { Restore_Cert_Dir; return 1; }
            Discard_Cert_Backup
            Echo_Green "SSL 证书签发成功。"
        else
            Restore_Cert_Dir
            Cleanup_Failed_Acme_Workdir
            Echo_Red "SSL 证书签发失败。"
            return 1
        fi
    fi
    return 0
}

Add_Dns_SSL()
{
    provider=$1
    if [ "${provider}" != "" ]; then
        dns_provider="dns_${provider}"
        # acme.sh 已安装时先核对插件，免得走完交互才报错。
        if [ -d /usr/local/acme.sh/dnsapi ] \
            && [ ! -s "/usr/local/acme.sh/dnsapi/dns_${provider}.sh" ]; then
            echo "未找到 DNS 服务商插件：${provider}。"
            exit 1
        fi
    else
        Echo_Red "DNS 手工验证模式无法自动续期，证书到期前必须手动续期。"
    fi

    Add_DNS_SSL_Site_Info_Menu
    info_rc=$?
    # 返回 2 表示已复用现有证书写完配置，本次不需要签发。
    [ "${info_rc}" = "2" ] && return 0
    [ "${info_rc}" = "0" ] || exit 1
    Add_DNS_SSL_Select_Menu
    Return_301_Menu

    Install_Check_Acme.sh || exit 1

    if [[ ! -s /usr/local/acme.sh/dnsapi/dns_${provider}.sh && "${provider}" != "" ]]; then
        echo "未找到 DNS 服务商插件：${provider}。"
        exit 1
    fi
    Prompt_DNS_API_Credentials "${provider}" || exit 1

    # 泛域名已覆盖同级子域名，重复申请只会多一次 TXT 验证。
    cert_domains=$(Filter_Cert_Domains "${domain}" "${moredomain}")
    # acme.sh 按第一个 -d 建证书目录，主域名被泛域名取代时随之改变。
    cert_main="${cert_domains%% *}"
    # 泛域名不能直接做目录名，避免路径被通配符展开。
    cert_dir_name="${cert_main/#\*./_wildcard.}"
    cert_dir="/usr/local/nginx/conf/ssl/${cert_dir_name}"
    Backup_Cert_Dir "${cert_dir}" || return 1
    Note_Acme_Workdir "/usr/local/nginx/conf/ssl" "${cert_main}"
    # 泛域名带 *，拆分和传参期间关闭路径展开。
    letsdomain=()
    set -f
    for i in ${cert_domains};do
        letsdomain+=(-d "${i}")
    done
    set +f
    echo "证书域名：${cert_domains}"

    if [ "${dns_ssl_choice}" == "1" ]; then
        ca_server="letsencrypt"
    elif [ "${dns_ssl_choice}" == "2" ]; then
        ca_server="zerossl"
    fi

    echo "正在使用 ${ca_server} 签发 SSL 证书..."
    if [ "${provider}" != "" ]; then
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server ${ca_server} --issue "${letsdomain[@]}" --dns ${dns_provider} --reloadcmd "/etc/init.d/nginx reload"
        lets_status=$?
    else
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server ${ca_server} --issue "${letsdomain[@]}" --dns --yes-I-know-dns-manual-mode-enough-go-ahead-please
        Echo_Yellow "请在 120 秒内为域名添加上方显示的 TXT 记录。"
        echo
        Sleep_Sec 120
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --renew "${letsdomain[@]}" --yes-I-know-dns-manual-mode-enough-go-ahead-please
        lets_status=$?
    fi

    # acme.sh 默认签发 ECC 证书，须显式安装到站点证书目录。
    if [ "${lets_status}" = 0 ]; then
        mkdir -p "${cert_dir}" || { Restore_Cert_Dir; return 1; }
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --install-cert -d "${cert_main}" --ecc \
            --key-file "${cert_dir}/${cert_dir_name}.key" \
            --fullchain-file "${cert_dir}/fullchain.cer" \
            --reloadcmd "/etc/init.d/nginx reload"
        lets_status=$?
    fi

    if [ "${lets_status}" != 0 ]; then
        Restore_Cert_Dir
        Cleanup_Failed_Acme_Workdir
        Echo_Red "SSL 证书签发失败。"
        return 1
    fi

    ssl_certificate="${cert_dir}/fullchain.cer"
    ssl_certificate_key="${cert_dir}/${cert_dir_name}.key"
    if [ "${Wildcard_Mode}" = "y" ]; then
        # 证书已签发成功，个别站点写配置失败不回滚证书目录。
        Install_Cert_To_Sites "${Wildcard_Site_List}"
    else
        Create_SSL_Config || { Restore_Cert_Dir; return 1; }
    fi
    Discard_Cert_Backup
    Print_Banner \
        "SSL 证书信息" \
        "域名：${cert_domains}" \
        "证书：${cert_dir}/fullchain.cer" \
        "私钥：${cert_dir}/${cert_dir_name}.key"
    Echo_Green "SSL 证书签发成功。"
}

