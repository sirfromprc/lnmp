# acme.sh 使用 GitHub 官方固定 tag 和对应 SHA256，不使用浮动版本。
#
# 升级时必须同时更新版本和校验值。校验值获取方法：
#   curl -sSL https://github.com/acmesh-official/acme.sh/archive/refs/tags/<ver>.tar.gz | sha256sum
Acme_Sh_Ver='3.1.4'
Acme_Sh_SHA256='e5f8e187bbf5251e0cd8891f2622daab9850366bd17bea9f92c2fe2ee091fd32'

Install_Check_Acme.sh()
{
    local tmpdir tarball srcdir actual

    if [ -s /usr/local/acme.sh/acme.sh ]; then
        echo "/usr/local/acme.sh/acme.sh [found]"
        if ! grep -Eq "^ACCOUNT_EMAIL=" /usr/local/acme.sh/account.conf 2>/dev/null; then
            /usr/local/acme.sh/acme.sh --register-account -m ${email_address} || return 1
        fi
        . "/usr/local/acme.sh/acme.sh.env"
        return 0
    fi

    if ! command -v sha256sum >/dev/null 2>&1; then
        Echo_Red "缺少 sha256sum，无法校验 acme.sh 安装包，拒绝安装。"
        return 1
    fi

    tmpdir=$(mktemp -d /tmp/acme.sh.XXXXXXXX) || return 1
    chmod 700 "${tmpdir}"
    tarball="${tmpdir}/acme.sh-${Acme_Sh_Ver}.tar.gz"
    srcdir="${tmpdir}/acme.sh-${Acme_Sh_Ver}"

    echo "Downloading acme.sh ${Acme_Sh_Ver} from github.com/acmesh-official ..."
    if ! wget --prefer-family=IPv4 --max-redirect=5 -O "${tarball}" \
         "https://github.com/acmesh-official/acme.sh/archive/refs/tags/${Acme_Sh_Ver}.tar.gz"; then
        Echo_Red "acme.sh 下载失败，未做任何修改。"
        rm -rf "${tmpdir}"
        return 1
    fi

    # 下载内容必须通过固定 SHA256 后才能解压和执行。
    actual=$(sha256sum "${tarball}" | awk '{print $1}')
    if [ "${actual}" != "${Acme_Sh_SHA256}" ]; then
        Echo_Red "acme.sh 安装包 SHA256 不匹配，拒绝执行。"
        Echo_Red "  expected: ${Acme_Sh_SHA256}"
        Echo_Red "  actual:   ${actual}"
        rm -rf "${tmpdir}"
        return 1
    fi

    if ! tar zxf "${tarball}" -C "${tmpdir}"; then
        Echo_Red "acme.sh 解压失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    # 归档顶层目录必须与固定版本精确匹配。
    if [ ! -s "${srcdir}/acme.sh" ]; then
        Echo_Red "acme.sh 归档结构异常：未找到 ${srcdir}/acme.sh"
        rm -rf "${tmpdir}"
        return 1
    fi

    ( cd "${srcdir}" && ./acme.sh --install ${acme_sh_sudo} --log \
        --home /usr/local/acme.sh --certhome /usr/local/nginx/conf/ssl -m ${email_address} )
    if [ $? -ne 0 ] || [ ! -s /usr/local/acme.sh/acme.sh ]; then
        Echo_Red "acme.sh 安装失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    rm -rf "${tmpdir}"

    sed -i 's/cat "\$CERT_PATH"$/#cat "\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
    # 保留 acme.sh 默认密钥类型，并关闭自动升级。
    # acme.sh 的自更新是一条绕过本包全部校验的通道：`--upgrade` 直接从
    # GitHub 拉最新代码覆盖自己，不核对任何哈希或签名。本包在安装时
    # 固定 tag + 校验 SHA256（Acme_Sh_Ver / Acme_Sh_SHA256），
    # 但只要自更新开着，那个固定值第二天就可能不作数了。
    #
    # 处理：
    #   1. 显式关闭 acme.sh 自带的自动升级（--auto-upgrade 0）；
    #   2. 定时自动升级的 crontab 本就已注释掉，保持不装；
    #   3. upgrade.sh 保留并要求手动确认；需要跟进上游修复时由管理员
    #      自己决定，不在后台悄悄换掉一个持有全部证书私钥的组件。

    /usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
    cat >/usr/local/acme.sh/upgrade.sh<<EOF
#!/bin/bash
#
# 手动升级 acme.sh；禁止加入 crontab。
#
# 它执行 acme.sh --upgrade，从 GitHub 拉最新代码覆盖 /usr/local/acme.sh，
# 手动升级不使用本包固定的版本与 SHA256，执行后须重新确认组件来源和完整性。
#
# 需要跟进上游安全修复时再手动跑。

echo "警告：即将从 GitHub 升级 acme.sh，此过程不做完整性校验。"
printf "确认继续请输入 yes: "
read -r _ans
[ "\$_ans" = "yes" ] || { echo "已取消。"; exit 1; }

. "/usr/local/acme.sh/acme.sh.env"
/usr/local/acme.sh/acme.sh --upgrade
/usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
sed -i 's/cat "\\\$CERT_PATH"\$/#cat "\\\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
EOF

    chmod +x /usr/local/acme.sh/upgrade.sh
    #if crontab -l|grep -q "/usr/local/acme.sh/upgrade.sh"; then
    #    echo "acme.sh upgrade crontab rule is exist."
    #else
    #    echo "Add acme.sh upgrade crontab rule..."
    #    (crontab -l ; echo '0 3 */7 * * /usr/local/acme.sh/upgrade.sh') | crontab -
    #fi
    if command -v yum >/dev/null 2>&1; then
        yum -y update nss
        yum -y install ca-certificates
        service crond restart
        chkconfig crond on
    elif command -v apt-get >/dev/null 2>&1; then
        /etc/init.d/cron restart
        update-rc.d cron defaults
    fi

    . "/usr/local/acme.sh/acme.sh.env"
}

Create_SSL_Config()
{
    if [ ! -s /usr/local/nginx/conf/ssl/dhparam.pem ]; then
        echo "Create dhparam.pem..."
        mkdir -p /usr/local/nginx/conf/ssl/
        openssl dhparam -out /usr/local/nginx/conf/ssl/dhparam.pem 2048
    fi
    cat >>"/usr/local/nginx/conf/vhost/${domain}.conf"<<EOF

server {
        listen 443 ssl;
        #listen [::]:443 ssl;
        # nginx 1.25.1 起 HTTP/2 用独立的 http2 指令开启，
        # 写在 listen 后面的 http2 参数会被警告为已废弃。
        http2 on;
        server_name ${domain} ${moredomain};
        index index.html index.htm index.php default.html default.htm default.php;
        root  ${vhostdir};

        ssl_certificate ${ssl_certificate};
        ssl_certificate_key ${ssl_certificate_key};
        # TLS 1.0/1.1 已被 RFC 8996 正式弃用，主流浏览器也早已不再连接。
        ssl_protocols TLSv1.2 TLSv1.3;
        # 只保留带前向保密（ECDHE/DHE）的 AEAD 套件。特意排除三类：
        #   3DES（Sweet32 攻击）、静态 RSA 密钥交换（私钥泄露后历史流量
        #   可被全部解密）、CBC 模式（Lucky13 一类填充攻击不断出新变种）。
        # TLS 1.3 不受本行控制，它有独立的套件命名空间，OpenSSL 的默认值
        # 本身就只有三个 AEAD 算法，无需干预。
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        # off = 由客户端挑套件。上面每个都安全，手机能选到有硬件加速的
        # CHACHA20，服务器强推 AES-GCM 反而更慢更费电。
        ssl_prefer_server_ciphers off;
        # 握手结果缓存，回头客可跳过完整握手。10m 约可存 4 万个会话。
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 5m;
        # off = 关闭 session ticket。加密 ticket 的那把密钥在 nginx 里长期不变，
        # 一旦泄露，此前录下的流量可被批量解密，等于抵消了上面的前向保密。
        ssl_session_tickets off;
        # DHE 系列套件所需的 DH 参数，由 lnmp ssl add 首次运行时生成
        # （openssl dhparam -out .../dhparam.pem 2048）。
        ssl_dhparam /usr/local/nginx/conf/ssl/dhparam.pem;

        # HSTS：让浏览器在 max-age 秒内始终使用 HTTPS。启用前必须确认证书
        # 可以持续续签，且所有子域名均有可用证书；浏览器一旦记录该策略
        # 就无法用 http 回退，配错会导致整站在有效期内都打不开。
        #add_header Strict-Transport-Security "max-age=31536000" always;

        #error_page   404   /404.html;

        # Deny access to PHP files in specific directory
        #location ~ /(wp-content|uploads|wp-includes|images)/.*\.php$ { deny all; }

        include proxy-pass-php.conf;

        location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
            expires      30d;
        }

        location ~ .*\.(js|css)$ {
            expires      12h;
        }

        location ^~ /.well-known/ {
            allow all;
        }

        location ~ /\. {
            deny all;
        }

        ${al}
    }
EOF

    if [ "${using_301}" == "y" ]; then
        sed -i '0,/access_log/!b;//i\        location / {\n            return 301 https://$host$request_uri;\n        }\n' /usr/local/nginx/conf/vhost/${domain}.conf
        sed -i '0,/include proxy-pass-php.conf;/s/include proxy-pass-php.conf;/#include proxy-pass-php.conf;/' /usr/local/nginx/conf/vhost/${domain}.conf
    fi

    if [ "${enable_ipv6}" == "y" ]; then
        sed -i 's/#listen \[::\]:443 ssl;/listen \[::\]:443 ssl;/g' /usr/local/nginx/conf/vhost/${domain}.conf
    fi

    echo "Test Nginx configure file......"
    /usr/local/nginx/sbin/nginx -t
    echo "Reload Nginx......"
    /usr/local/nginx/sbin/nginx -s reload
}

Add_SSL()
{
    if [ "${ssl_choice}" == "1" ]; then
        Create_SSL_Config
    elif echo "${ssl_choice}" | grep -Eqi "^[2-4]$"; then
        letsdomain=""
        if [ "${moredomain}" != "" ]; then
            letsdomain="-d ${domain}"
            for i in ${moredomain};do
                letsdomain=${letsdomain}" -d ${i}"
            done
        else
            letsdomain="-d ${domain}"
        fi
        if [ ! -s "/usr/local/nginx/conf/vhost/${domain}.conf" ]; then
            Add_VHost_Config
        fi
        if [ ! -d "${vhostdir}" ]; then
            mkdir -p "${vhostdir}"
        fi

        if [[ "${vhostdir}" == "" || "${letsdomain}" == "" ]]; then
            Echo_Red "Two parameters are needed!"
            exit 1
        fi
        if [ ! -d "${vhostdir}" ]; then
            Echo_Red "${vhostdir} does not exist or is not a directory!"
            exit
        fi

        Install_Check_Acme.sh || exit 1

        if [ -s /usr/local/nginx/conf/ssl/${domain}/fullchain.cer ]; then
            echo "Removing exist domain certificate..."
            rm -rf /usr/local/nginx/conf/ssl/${domain}
        fi

        if [ "${ssl_choice}" == "2" ]; then
            echo "Generate ssl certificate using Let's Encrypt..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server letsencrypt --issue ${letsdomain} -w ${vhostdir} --reloadcmd "/etc/init.d/nginx reload"
        elif [ "${ssl_choice}" == "3" ]; then
            echo "Generate ssl certificate using BuyPass..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server buypass --issue ${letsdomain} -w ${vhostdir} --days 170 --reloadcmd "/etc/init.d/nginx reload"
        elif [ "${ssl_choice}" == "4" ]; then
            echo "Generate ssl certificate using ZeroSSL..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server zerossl --issue ${letsdomain} -w ${vhostdir} --reloadcmd "/etc/init.d/nginx reload"
        fi
        lets_status=$?

        ssl_certificate="/usr/local/nginx/conf/ssl/${domain}/fullchain.cer"
        ssl_certificate_key="/usr/local/nginx/conf/ssl/${domain}/${domain}.key"
        if [ "${lets_status}" = 0 ]; then
            Create_SSL_Config
            Echo_Green " Generate SSL Certificate successfully."
        else
            Echo_Red " Generate SSL Certificate failed!"
        fi
    fi
}

Add_Dns_SSL()
{
    provider=$1
    if [ "${provider}" != "" ]; then
        dns_provider="dns_${provider}"
    else
        Echo_Red "The dns manual mode can not renew automatically, you must renew it manually."
    fi

    Add_SSL_Info_Menu
    Add_DNS_SSL_Select_Menu
    Return_301_Menu
    Install_Check_Acme.sh || exit 1

    if [[ ! -s /usr/local/acme.sh/dnsapi/dns_${provider}.sh && "${provider}" != "" ]]; then
        echo "DNS Provider: ${provider} not found."
        exit 1
    fi

    if [ -s /usr/local/nginx/conf/ssl/${domain}/fullchain.cer ]; then
        echo "Removing exist domain certificate..."
        rm -rf /usr/local/nginx/conf/ssl/${domain}
    fi

    letsdomain=""
    if [ "${moredomain}" != "" ]; then
        letsdomain="-d ${domain}"
        for i in ${moredomain};do
            letsdomain=${letsdomain}" -d ${i}"
        done
    else
        letsdomain="-d ${domain}"
    fi

    if echo "${letsdomain}" | grep -q '\*\.' && echo "${letsdomain}" | grep -qi 'www\.'; then
        Echo_Red "wildcard SSL certificate DO NOT allow add www. subdomain."
        exit 1
    fi

    if [ "${dns_ssl_choice}" == "1" ]; then
        ca_server="letsencrypt"
    elif [ "${dns_ssl_choice}" == "2" ]; then
        ca_server="zerossl"
    fi

    echo "Generate ssl certificate using ${ca_server}..."
    if [ "${provider}" != "" ]; then
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server ${ca_server} --issue ${letsdomain} --dns ${dns_provider} --reloadcmd "/etc/init.d/nginx reload"
        lets_status=$?
    else
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server ${ca_server} --issue ${letsdomain} --dns --yes-I-know-dns-manual-mode-enough-go-ahead-please
        Echo_Yellow "Please add the above TXT record to the domain in 120 seconds!!!"
        echo
        Sleep_Sec 120
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --renew ${letsdomain} --yes-I-know-dns-manual-mode-enough-go-ahead-please
        lets_status=$?
    fi
    if [ "${lets_status}" = 0 ] || [[ "${provider}" = "" && "${lets_status}" = 1 && -s "/usr/local/nginx/conf/ssl/${domain}/fullchain.cer" ]]; then
        if [ ! -d "${vhostdir}" ]; then
            echo "Create Virtul Host directory......"
            mkdir -p "${vhostdir}"
            echo "set permissions of Virtual Host directory......"
            chmod -R 755 "${vhostdir}"
            chown -R www:www "${vhostdir}"
        fi

        if [ ! -s "/usr/local/nginx/conf/vhost/${domain}.conf" ]; then
            Add_VHost_Config
        fi
        ssl_certificate="/usr/local/nginx/conf/ssl/${domain}/fullchain.cer"
        ssl_certificate_key="/usr/local/nginx/conf/ssl/${domain}/${domain}.key"
        Create_SSL_Config
        Echo_Blue "------------------ SSL Certificate information as follows ------------------"
        Echo_Blue "| Domain: ${domain} ${moredomain}"
        Echo_Blue "| SSL Certificate: /usr/local/nginx/conf/ssl/${domain}/fullchain.cer"
        Echo_Blue "| SSL Certificate Key: /usr/local/nginx/conf/ssl/${domain}/${domain}.key"
        Echo_Blue "------------------------------------ ---------------------------------------"
        Echo_Green " Generate SSL Certificate successfully."
    else
        Echo_Red " Generate SSL Certificate failed!"
    fi
}

