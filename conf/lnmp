        # 先认动作名，避免无效参数也要求输入数据库口令。
        case "${arg2}" in
        [aA][dD][dD]|[lL][iI][sS][tT]|[dD][eE][lL]|[eE][dD][iI][tT])
            ;;
        [eE][xX][pP][oO][rR][tT]|[iI][mM][pP][oO][rR][tT])
            # 导出与导入需要库名和文件名，参数不全时先报用法，不必先输口令。
            if [ -z "${arg3}" ] || [ -z "${arg4}" ]; then
                echo "用法：lnmp database $(echo "${arg2}" | tr '[:upper:]' '[:lower:]') <数据库名> <文件.sql.gz>"
                exit 1
            fi
            ;;
        *)
            Function_Database "${arg2}"
            exit $?
            ;;
        esac
        Verify_DB_Password || exit 1
        Function_Database "${arg2}" "${arg3}" "${arg4}"
        db_rc=$?
        TempMycnf_Clean
        exit ${db_rc}
        ;;
    ftp)
        Check_Pureftpd
        Function_Ftp "${arg2}"
        exit $?
        ;;
    backup)
        # backup 子命令参数数量不同，移除命令名后完整转交。
        shift
        Function_Backup "$@"
        exit $?
        ;;
    perm)
        # perm 子命令参数数量不同，移除命令名后完整转交。
        shift
        Function_Perm "$@"
        exit $?
        ;;
    health)
        # health 子命令参数数量不同，移除命令名后完整转交。
        shift
        Function_Health "$@"
        exit $?
        ;;
    fw|firewall)
        # fw 子命令参数数量不同，移除命令名后完整转交。
        shift
        Function_Fw "$@"
        exit $?
        ;;
    tgnotice|notice)
        shift
        if [ ! -x /bin/lnmp-tgnotice ]; then
            Echo_Red "找不到 /bin/lnmp-tgnotice，安装不完整。"
            Echo_Red "补装：cp tools/lnmp-tgnotice.sh /bin/lnmp-tgnotice && chmod +x /bin/lnmp-tgnotice"
            exit 1
        fi
        /bin/lnmp-tgnotice "$@"
        exit $?
        ;;
    phpmyadmin)
        if [ ! -x /bin/lnmp-phpmyadmin ]; then
            Echo_Red "找不到 /bin/lnmp-phpmyadmin，安装不完整。"
            Echo_Red "补装：cp tools/lnmp-phpmyadmin.sh /bin/lnmp-phpmyadmin && chmod +x /bin/lnmp-phpmyadmin"
            exit 1
        fi
        /bin/lnmp-phpmyadmin lnmp "${arg2}"
        exit $?
        ;;
    ssl)
        # 只有 add 一个动作，无效参数不进入交互。
        case "${arg2}" in
        ''|[aA][dD][dD]) ;;
        *)
            echo "用法：lnmp ssl add"
            exit 1
            ;;
        esac
        info="n"
        Add_SSL_Menu || exit $?
        Add_SSL || exit $?
        ;;
    dnsssl|dns)
        Add_Dns_SSL ${arg2}
        ;;
    onlyssl)
        Add_Dns_SSL_Only ${arg2}
        ;;
    *)
        echo "用法：lnmp {start|stop|reload|restart|kill|status}"
        echo "用法：lnmp {nginx|mysql|mariadb|php-fpm|pureftpd|redis|memcached} {start|stop|reload|restart|status}"
        echo "用法：lnmp vhost {add|list|del|start|stop}"
        echo "用法：lnmp app {add|list|del|start|stop|restart|reload|status|logs}"
        echo "用法：lnmp database {add|list|edit|del}"
        echo "用法：lnmp database export <数据库名> <文件.sql.gz>"
        echo "用法：lnmp database import <数据库名> <文件.sql.gz>"
        echo "用法：lnmp ftp {add|list|edit|del|show}"
        echo "用法：lnmp backup {init|run|status|list|restore|test|remote-setup}"
        echo "用法：lnmp backup run [db|web|all] [域名...]"
        echo "用法：lnmp tgnotice {--init|--test|--status} | lnmp tgnotice \"文本\" [md]"
        echo "用法：lnmp perm {check|run|status|init|uninit}"
        echo "用法：lnmp perm check [服务名] | lnmp perm {ignore|unignore} <条目ID>"
        echo "用法：lnmp health {check|status|reset|init|uninit}"
        echo "用法：lnmp fw {status|sync|allow|block|unblock|reload|purge}"
        echo "用法：lnmp fw {allow|block|unblock} {tcp|udp} <端口|起-止>"
        echo "用法：lnmp phpmyadmin {enable|disable|status}"
        echo "用法：lnmp ssl add"
        echo "用法：lnmp {dnsssl|dns} [ali|cf|dp|he|gd|aws]"
        echo "用法：lnmp onlyssl [ali|cf|dp|he|gd|aws]"
        echo "      DNS 服务商名取 acme.sh 插件名，如 nsone、gcloud，见 /usr/local/acme.sh/dnsapi/"
        echo "      不带服务商 = 手工添加 TXT 记录验证，不能自动续期"
        exit 1
        ;;
esac
exit
