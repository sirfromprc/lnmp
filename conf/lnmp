# acme.sh 使用 GitHub 官方固定 tag 和对应 SHA256，不使用浮动版本。
# 升级时必须同时更新以下两个值。校验值获取方法：
#   curl -sSL https://github.com/acmesh-official/acme.sh/archive/refs/tags/<ver>.tar.gz | sha256sum
Acme_Sh_Ver='3.1.4'
Acme_Sh_SHA256='e5f8e187bbf5251e0cd8891f2622daab9850366bd17bea9f92c2fe2ee091fd32'

Install_Check_Acme.sh()
{
    local tmpdir tarball srcdir actual

    if [ -s /usr/local/acme.sh/acme.sh ]; then
        echo "/usr/local/acme.sh/acme.sh [已存在]"
        if ! grep -Eq "^ACCOUNT_EMAIL=" /usr/local/acme.sh/account.conf 2>/dev/null; then
            /usr/local/acme.sh/acme.sh --register-account -m ${email_address} || return 1
        fi
        . "/usr/local/acme.sh/acme.sh.env"
        return 0
    fi

    if ! command -v sha256sum >/dev/null 2>&1; then
        Echo_Red "缺少 sha256sum，无法校验 acme.sh 安装包，拒绝安装。"
        return 1
    fi

    tmpdir=$(mktemp -d /tmp/acme.sh.XXXXXXXX) || return 1
    chmod 700 "${tmpdir}"
    tarball="${tmpdir}/acme.sh-${Acme_Sh_Ver}.tar.gz"
    srcdir="${tmpdir}/acme.sh-${Acme_Sh_Ver}"

    echo "正在从 github.com/acmesh-official 下载 acme.sh ${Acme_Sh_Ver} ..."
    if ! wget --prefer-family=IPv4 --max-redirect=5 -O "${tarball}" \
         "https://github.com/acmesh-official/acme.sh/archive/refs/tags/${Acme_Sh_Ver}.tar.gz"; then
        Echo_Red "acme.sh 下载失败，未做任何修改。"
        rm -rf "${tmpdir}"
        return 1
    fi

    # 下载内容必须通过固定 SHA256 后才能解压和执行。
    actual=$(sha256sum "${tarball}" | awk '{print $1}')
    if [ "${actual}" != "${Acme_Sh_SHA256}" ]; then
        Echo_Red "acme.sh 安装包 SHA256 不匹配，拒绝执行。"
        Echo_Red "  期望值：${Acme_Sh_SHA256}"
        Echo_Red "  实际值：${actual}"
        rm -rf "${tmpdir}"
        return 1
    fi

    if ! tar zxf "${tarball}" -C "${tmpdir}"; then
        Echo_Red "acme.sh 解压失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    # 归档顶层目录必须与固定版本精确匹配。
    if [ ! -s "${srcdir}/acme.sh" ]; then
        Echo_Red "acme.sh 归档结构异常：未找到 ${srcdir}/acme.sh"
        rm -rf "${tmpdir}"
        return 1
    fi

    ( cd "${srcdir}" && ./acme.sh --install ${acme_sh_sudo} --log \
        --home /usr/local/acme.sh --certhome /usr/local/nginx/conf/ssl -m ${email_address} )
    if [ $? -ne 0 ] || [ ! -s /usr/local/acme.sh/acme.sh ]; then
        Echo_Red "acme.sh 安装失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    rm -rf "${tmpdir}"

    sed -i 's/cat "\$CERT_PATH"$/#cat "\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
    # 保留 acme.sh 默认密钥类型，并关闭绕过固定版本校验的自动升级。
    # upgrade.sh 仅提供需人工确认的手动升级入口。
    /usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
    cat >/usr/local/acme.sh/upgrade.sh<<EOF
#!/bin/bash
#
# 手动升级 acme.sh；禁止加入 crontab。
#
# 它执行 acme.sh --upgrade，从 GitHub 拉最新代码覆盖 /usr/local/acme.sh，
# 手动升级不使用本包固定的版本与 SHA256，执行后须重新确认组件来源和完整性。
#
# 需要跟进上游安全修复时再手动跑。

echo "警告：即将从 GitHub 升级 acme.sh，此过程不做完整性校验。"
printf "确认继续请输入 yes: "
read -r _ans
[ "\$_ans" = "yes" ] || { echo "已取消。"; exit 1; }

. "/usr/local/acme.sh/acme.sh.env"
/usr/local/acme.sh/acme.sh --upgrade
/usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
sed -i 's/cat "\\\$CERT_PATH"\$/#cat "\\\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
EOF

    chmod +x /usr/local/acme.sh/upgrade.sh
    #if crontab -l|grep -q "/usr/local/acme.sh/upgrade.sh"; then
    #    echo "acme.sh upgrade crontab rule is exist."
    #else
    #    echo "Add acme.sh upgrade crontab rule..."
    #    (crontab -l ; echo '0 3 */7 * * /usr/local/acme.sh/upgrade.sh') | crontab -
    #fi
    if command -v yum >/dev/null 2>&1; then
        yum -y update nss
        yum -y install ca-certificates
        service crond restart
        chkconfig crond on
    elif command -v apt-get >/dev/null 2>&1; then
        /etc/init.d/cron restart
        update-rc.d cron defaults
    fi

    . "/usr/local/acme.sh/acme.sh.env"
}

Create_SSL_Config()
{
    local vhost_conf="/usr/local/nginx/conf/vhost/${domain}.conf" backup
    local ssl_listen='listen 443 ssl;' ssl_ipv6_listen='#listen [::]:443 ssl;'
    local ssl_server_name="${domain} ${moredomain}" ssl_rewrite_line ssl_php_block

    ssl_rewrite_line="include rewrite/${rewrite}.conf;"
    ssl_php_block="${include_enable_php}"
    if [ "${domain}" = "default" ]; then
        ssl_listen='listen 443 ssl default_server;'
        ssl_ipv6_listen='#listen [::]:443 ssl default_server ipv6only=on;'
        ssl_server_name='_'
        ssl_rewrite_line=''
        ssl_php_block='include phpmyadmin.*.conf;

        location ~ [^/]\.php(/|$) {
            return 404;
        }'
    fi
    if [ "${enable_ipv6}" = "y" ]; then
        if [ "${domain}" = "default" ]; then
            ssl_ipv6_listen='listen [::]:443 ssl default_server ipv6only=on;'
        else
            ssl_ipv6_listen='listen [::]:443 ssl;'
        fi
    fi

    backup=$(mktemp /tmp/lnmp-ssl-vhost.XXXXXXXX) || return 1
    \cp -p "${vhost_conf}" "${backup}" || { rm -f "${backup}"; return 1; }
    if [ ! -s /usr/local/nginx/conf/ssl/dhparam.pem ]; then
        echo "正在创建 dhparam.pem..."
        mkdir -p /usr/local/nginx/conf/ssl/
        openssl dhparam -out /usr/local/nginx/conf/ssl/dhparam.pem 2048 || {
            rm -f "${backup}"
            return 1
        }
    fi
    cat >>"${vhost_conf}"<<EOF

server {
        ${ssl_listen}
        ${ssl_ipv6_listen}
        # nginx 1.25.1 起 HTTP/2 用独立的 http2 指令开启，
        # 写在 listen 后面的 http2 参数会被警告为已废弃。
        http2 on;
        server_name ${ssl_server_name};
        index index.html index.htm index.php default.html default.htm default.php;
        root  ${vhostdir};

        ssl_certificate ${ssl_certificate};
        ssl_certificate_key ${ssl_certificate_key};
        # TLS 1.0/1.1 已被 RFC 8996 正式弃用，主流浏览器也早已不再连接。
        ssl_protocols TLSv1.2 TLSv1.3;
        # 只保留带前向保密（ECDHE/DHE）的 AEAD 套件。特意排除三类：
        #   3DES（Sweet32 攻击）、静态 RSA 密钥交换（私钥泄露后历史流量
        #   可被全部解密）、CBC 模式（Lucky13 一类填充攻击不断出新变种）。
        # TLS 1.3 不受本行控制，它有独立的套件命名空间，OpenSSL 的默认值
        # 本身就只有三个 AEAD 算法，无需干预。
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        # off = 由客户端挑套件。上面每个都安全，手机能选到有硬件加速的
        # CHACHA20，服务器强推 AES-GCM 反而更慢更费电。
        ssl_prefer_server_ciphers off;
        # 握手结果缓存，回头客可跳过完整握手。10m 约可存 4 万个会话。
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 5m;
        # off = 关闭 session ticket。加密 ticket 的那把密钥在 nginx 里长期不变，
        # 一旦泄露，此前录下的流量可被批量解密，等于抵消了上面的前向保密。
        ssl_session_tickets off;
        # DHE 系列套件所需的 DH 参数，由 lnmp ssl add 首次运行时生成。
        ssl_dhparam /usr/local/nginx/conf/ssl/dhparam.pem;

        # HSTS：让浏览器在 max-age 秒内一律用 HTTPS 访问本站，可挡掉
        # 首次访问之外的降级劫持。启用前必须确认证书可以持续续签，
        # 且所有子域名均有可用证书；浏览器记录该策略后无法回退到 HTTP，
        # 配错会导致整站在有效期内都打不开。确认无误后再取消注释。
        #add_header Strict-Transport-Security "max-age=31536000" always;

        ${ssl_rewrite_line}
        #error_page   404   /404.html;

        # Deny access to PHP files in specific directory
        #location ~ /(wp-content|uploads|wp-includes|images)/.*\.php$ { deny all; }

        ${ssl_php_block}

        location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
            expires      30d;
        }

        location ~ .*\.(js|css)$ {
            expires      12h;
        }

        location ^~ /.well-known/ {
            allow all;
        }

        location ~ /\. {
            deny all;
        }

        ${al}
    }
EOF

    if [ "${using_301}" == "y" ]; then
        sed -i '0,/access_log/!b;//i\        location / {\n            return 301 https://$host$request_uri;\n        }\n' /usr/local/nginx/conf/vhost/${domain}.conf
        sed -i "0,/include rewrite\/${rewrite}.conf;/s//#include rewrite\/${rewrite}.conf;/" /usr/local/nginx/conf/vhost/${domain}.conf
    fi

    echo "正在检查 Nginx 配置......"
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，已撤销本次新增的虚拟主机配置。"
        \cp -p "${backup}" "${vhost_conf}"
        rm -f "${backup}"
        return 1
    fi
    echo "正在重载 Nginx......"
    if ! /usr/local/nginx/sbin/nginx -s reload; then
        Echo_Red "Nginx 重载失败，已恢复添加 SSL 前的虚拟主机配置。"
        \cp -p "${backup}" "${vhost_conf}"
        /usr/local/nginx/sbin/nginx -s reload
        rm -f "${backup}"
        return 1
    fi
    rm -f "${backup}"
    return 0
}

# ---------------------------------------------------------------------------
# default 站点（仅通过 IP 访问）的证书处理。
#
# `default` 是本包的保留站点名：根目录 /home/wwwroot/default，用服务器 IP
# 直接访问。该站点没有域名，无法申请需要验证域名控制权的 DV 证书。
#
# Let's Encrypt 自 2025 年起支持为 IP 地址签发证书，但有以下限制：
#   - 只有 shortlived profile 支持 IP 标识符（classic / tlsserver 都不支持）
#   - 有效期 7 天，必须启用自动续期
#   - 仅支持 IPv4，不支持 IPv6 地址
#   - 只能是公网可达的公网 IP；私有地址（10/172.16-31/192.168/127/169.254）
#     不符合公信 CA 的签发条件
#   - BuyPass 与 ZeroSSL 都不提供 IP 证书，只能用 Let's Encrypt
# ---------------------------------------------------------------------------

# Detect_Server_IP - 探测本机对外 IPv4
Detect_Server_IP()
{
    local ip=''
    # 读取默认路由使用的源地址
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    # NAT 环境下通过外部服务获取公网出口地址
    if [ -z "${ip}" ] || Is_Private_IP "${ip}"; then
        local pub
        pub=$(curl -fsS --max-time 8 https://api.ipify.org 2>/dev/null)
        [ -n "${pub}" ] && ip="${pub}"
    fi
    printf '%s' "${ip}"
}

# Is_Private_IP <ip> - 私有或保留地址返回 0；空值和非 IPv4 地址也返回 0
Is_Private_IP()
{
    case "$1" in
        10.*|127.*|169.254.*|192.168.*)          return 0 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*)   return 0 ;;
        100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 0 ;;
        ''|*[!0-9.]*)                            return 0 ;;
    esac
    return 1
}

# Prepare_Default_Site_IP_Cert - 打印说明并将证书申请目标从域名切换为 IP
# 返回 0 继续申请，1 中止
Prepare_Default_Site_IP_Cert()
{
    local ip
    echo
    Echo_Yellow "================= default 站点的证书说明 ================="
    echo
    echo "当前站点是 default —— 本包的默认站点，根目录 /home/wwwroot/default，"
    echo "通过**服务器 IP 直接访问**，它没有域名。"
    echo
    echo "没有域名就申请不了域名型证书（CA 要验证的正是域名控制权），"
    echo "因此这里自动转为 **IP 地址证书** 流程。"
    echo

    ip=$(Detect_Server_IP)
    if [ -z "${ip}" ]; then
        Echo_Red "未能探测到本机 IP，无法继续。"
        Echo_Red "请改用域名建站，或用自签名证书（命令见下方）。"
        Print_Self_Signed_Hint "${ip}"
        return 1
    fi
    echo "探测到本机 IP：${ip}"
    echo

    if Is_Private_IP "${ip}"; then
        Echo_Red "这是一个私有/保留地址，**任何公信 CA 都不会为它签发证书**。"
        echo
        echo "私有地址包括 10.x / 172.16-31.x / 192.168.x / 127.x / 169.254.x"
        echo "以及运营商级 NAT 的 100.64-127.x。"
        echo
        echo "你有三个选择："
        echo "  1) 用域名建站，再申请证书 —— 推荐，证书有效期 90 天且能自动续期"
        echo "  2) 如果这台机器其实有公网 IP（只是当前从内网探测不到），"
        echo "     请在有公网出口的环境下重试，或直接用域名"
        echo "  3) 用自签名证书 —— 加密有效，但浏览器会告警，仅适合内网自用"
        Print_Self_Signed_Hint "${ip}"
        return 1
    fi

    Echo_Yellow "这是公网 IPv4，可以走 Let's Encrypt 的 IP 证书。请先了解它的限制："
    echo
    echo "  * 有效期只有 **7 天**（Let's Encrypt 的 shortlived profile）。"
    echo "    这不是本包的选择 —— **只有这个 profile 支持 IP 地址**。"
    echo "  * 因此必须依赖自动续期。acme.sh 已装好 cron 任务，"
    echo "    本包按 --days 6 申请（比 7 天有效期提前 1 天续，留出容错余量）。"
    echo "    **请勿关闭该 cron**，否则证书一周内就会过期导致站点不可访问。"
    echo "  * **只支持 IPv4**，IPv6 地址申请不了证书。"
    echo "  * 只有 Let's Encrypt 提供 IP 证书，BuyPass 与 ZeroSSL 都不支持；"
    echo "    你若选了它们，这里会自动改用 Let's Encrypt。"
    echo "  * 申请期间该 IP 的 80 端口必须能从公网访问（HTTP-01 验证）。"
    echo "  * 账户邮箱不能用 example.com 这类保留域名，Let's Encrypt 会直接拒绝"
    echo "    （报 invalidContact / forbidden domain）。请填真实可收信的邮箱。"
    echo
    Echo_Yellow "  ⚠ 如果这台机器在 NAT 后面（内网地址 + 公网出口）："
    echo
    echo "    上面这个 IP 是**出口地址**，未必指向本机。除非你已经把该 IP 的"
    echo "    80 端口转发到这台机器，否则 HTTP-01 验证会失败。"
    echo "    可先自查：从外网访问 http://${ip}/ 看是否能打开本站。"
    echo
    echo "如果这台机器有域名，**建议改用域名证书**：有效期 90 天，更省心。"
    Echo_Yellow "=========================================================="
    echo

    # 把申请目标从域名换成 IP，并挂上必需的 profile。
    #
    # `--days 6` 不能省：acme.sh 的 cron 是按「距上次签发超过 --days 天就续」
    # 判断的，默认值（60）是给 90 天证书用的。shortlived 证书只有 7 天，
    # 不收紧这个阈值，cron 会认为"还早着呢"而一直不续，证书到期站点直接不可访问。
    # 取 6 而不是 7：比有效期提前 1 天续，留出续期失败重试的余量。
    #
    # 参数组合经实测可用（用户在真实公网 VPS 上验证）：
    #   acme.sh --issue -d <IPv4> -w /home/wwwroot/default \
    #           --server letsencrypt --certificate-profile shortlived --days 6
    letsdomain="-d ${ip}"
    cert_profile_opt="--certificate-profile shortlived --days 6"
    default_site_ip="${ip}"

    # BuyPass / ZeroSSL 不支持 IP，强制回落到 Let's Encrypt
    if [ "${ssl_choice}" != "2" ]; then
        Echo_Yellow "已自动改用 Let's Encrypt（原选择不支持 IP 证书）。"
        echo
        ssl_choice="2"
    fi
    return 0
}

# Print_Self_Signed_Hint — 给出可直接粘贴的自签名证书生成命令
