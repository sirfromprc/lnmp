Check_DB

case "${arg1}" in
    start)
        lnmp_start
        ;;
    stop)
        lnmp_stop
        ;;
    restart)
        lnmp_stop
        lnmp_start
        ;;
    reload)
        lnmp_reload
        ;;
    kill)
        lnmp_kill
        ;;
    status)
        lnmp_status
        ;;
    nginx)
        Svc_Feedback nginx ${arg2}
        exit $?
        ;;
    mysql)
        Svc_Feedback mysql ${arg2}
        exit $?
        ;;
    mariadb)
        Svc_Feedback mariadb ${arg2}
        exit $?
        ;;
    php-fpm)
        Svc_Feedback php-fpm ${arg2}
        exit $?
        ;;
    pureftpd)
        Svc_Feedback pureftpd ${arg2}
        exit $?
        ;;
    vhost)
        Function_Vhost ${arg2}
        ;;
    database)
        # 先认动作名，避免无效参数也要求输入数据库口令。
        case "${arg2}" in
        [aA][dD][dD]|[lL][iI][sS][tT]|[dD][eE][lL]|[eE][dD][iI][tT]|[eE][xX][pP][oO][rR][tT]|[iI][mM][pP][oO][rR][tT])
            ;;
        *)
            Function_Database "${arg2}"
            exit $?
            ;;
        esac
        Verify_DB_Password || exit 1
        Function_Database "${arg2}" "${arg3}" "${arg4}"
        db_rc=$?
        TempMycnf_Clean
        exit ${db_rc}
        ;;
    ftp)
        Check_Pureftpd
        Function_Ftp "${arg2}"
        exit $?
        ;;
    backup)
        # backup 子命令参数数量不同，移除命令名后完整转交。
        shift
        Function_Backup "$@"
        exit $?
        ;;
    tgnotice|notice)
        shift
        if [ ! -x /bin/lnmp-tgnotice ]; then
            Echo_Red "找不到 /bin/lnmp-tgnotice，安装不完整。"
            Echo_Red "补装：cp tools/lnmp-tgnotice.sh /bin/lnmp-tgnotice && chmod +x /bin/lnmp-tgnotice"
            exit 1
        fi
        /bin/lnmp-tgnotice "$@"
        exit $?
        ;;
    phpmyadmin)
        /bin/lnmp-phpmyadmin lnmp "${arg2}"
        exit $?
        ;;
    ssl)
        # 只有 add 一个动作，无效参数不进入交互。
        case "${arg2}" in
        ''|[aA][dD][dD]) ;;
        *)
            echo "用法：lnmp ssl add"
            exit 1
            ;;
        esac
        info="n"
        Add_SSL_Menu || exit $?
        Add_SSL || exit $?
        ;;
    dnsssl|dns)
        Add_Dns_SSL ${arg2}
        ;;
    onlyssl)
        Add_Dns_SSL_Only ${arg2}
        ;;
    *)
        echo "用法：lnmp {start|stop|reload|restart|kill|status}"
        echo "用法：lnmp {nginx|mysql|mariadb|php-fpm|pureftpd} {start|stop|reload|restart|kill|status}"
        echo "用法：lnmp vhost {add|list|del}"
        echo "用法：lnmp database {add|list|edit|del}"
        echo "用法：lnmp database export <数据库名> <文件.sql.gz>"
        echo "用法：lnmp database import <数据库名> <文件.sql.gz>"
        echo "用法：lnmp ftp {add|list|edit|del|show}"
        echo "用法：lnmp backup {init|run|status|list|restore|test}"
        echo "用法：lnmp backup run [db|web|all] [域名...]"
        echo "用法：lnmp tgnotice {--init|--test|--status} | lnmp tgnotice \"文本\" [md]"
        echo "用法：lnmp phpmyadmin {enable|disable|status}"
        echo "用法：lnmp ssl add"
        echo "用法：lnmp {dnsssl|dns} {cx|ali|cf|dp|he|gd|aws}"
        echo "用法：lnmp onlyssl {cx|ali|cf|dp|he|gd|aws}"
        exit 1
        ;;
esac
