}

# 站点级 PHP 开关：默认配置 PHP 入口；关闭后所有 .php 请求返回 404。
# 非交互执行通过 VHOST_PHP=n 关闭 PHP，未设置时保持默认开启。
Site_PHP_Menu()
{
    local answer
    if [ ! -t 0 ]; then
        case "${VHOST_PHP}" in
            [nN])
                enable_site_php="n"
                echo "非交互执行，按 VHOST_PHP=n 关闭本站点的 PHP。"
                ;;
            *)
                enable_site_php="y"
                echo "非交互执行，本站点默认开启 PHP（如需关闭，设置环境变量 VHOST_PHP=n）。"
                ;;
        esac
        return 0
    fi

    while :;do
        Echo_Yellow "是否开启 PHP? (Y/n，默认 y) "
        if ! read answer; then
            echo
            echo "读取 PHP 开关时遇到 EOF，按默认值开启 PHP。"
            enable_site_php="y"
            break
        fi
        case "${answer}" in
            ""|[yY])
                enable_site_php="y"
                echo "已开启 PHP。"
                break
                ;;
            [nN])
                enable_site_php="n"
                echo "已关闭 PHP，本站点不执行任何 .php。"
                break
                ;;
            *)
                Echo_Red "请输入 y 或 n。"
                ;;
        esac
    done
}

# HTTP 与 HTTPS 共用以下规则，防止未解析的 .php 文件作为静态内容泄露。
Site_PHP_Off_Block()
{
    cat <<'EOF'
# 本站点未开启 PHP，.php 及其 PATH_INFO 请求统一返回 404，防止源码泄露。
    # 整站反向代理需要由后端处理 .php 路径时，可删除此 location。
    location ~ [^/]\.php(/|$) {
        return 404;
    }
EOF
}

# 未开启 PHP 时，首页候选不包含 PHP 文件。
Site_Index_Line()
{
    if [ "${enable_site_php}" = "n" ]; then
        echo "index index.html index.htm default.html default.htm;"
    else
        echo "index index.html index.htm index.php default.html default.htm default.php;"
    fi
}

Add_VHost_Config()
{
    local vhost_index

    Check_Config_Name "${rewrite}" "伪静态规则名" || return 1
    if [ "${access_log:-n}" = 'y' ]; then
        Check_Config_Name "${al_name}" "访问日志文件名" || return 1
    fi
    vhost_index="$(Site_Index_Line)"

    if [ ! -f "/usr/local/nginx/conf/rewrite/${rewrite}.conf" ]; then
        echo "正在创建虚拟主机伪静态规则文件......"
        touch "/usr/local/nginx/conf/rewrite/${rewrite}.conf" || return 1
        echo "伪静态规则文件创建成功，可编辑 /usr/local/nginx/conf/rewrite/${rewrite}.conf 添加规则。"
    else
        echo "使用已有伪静态规则：/usr/local/nginx/conf/rewrite/${rewrite}.conf"
    fi
    cat >"/usr/local/nginx/conf/vhost/${domain}.conf"<<EOF
server {
    listen 80;
    #listen [::]:80;
    server_name ${domain} ${moredomain};
    ${vhost_index}
    root  ${vhostdir};

    include rewrite/${rewrite}.conf;
    #error_page   404   /404.html;

    # Deny access to PHP files in specific directory
    #location ~ /(wp-content|uploads|wp-includes|images)/.*\.php$ { deny all; }

    ${include_enable_php}

    location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
        expires      30d;
    }

    location ~ .*\.(js|css)$ {
        expires      12h;
    }

    location ^~ /.well-known/ {
        allow all;
    }

    location ~ /\. {
        deny all;
    }

    ${al}
    error_log   /home/wwwlogs/${domain}.error.log;

    # 自定义配置--开始

    # 自定义配置--结束
}
EOF

    if [ "${enable_ipv6}" == "y" ]; then
        sed -i 's/#listen \[::\]:80;/listen \[::\]:80;/g' /usr/local/nginx/conf/vhost/${domain}.conf
    fi

    echo "正在检查 Nginx 配置..."
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，已恢复添加 SSL 前的虚拟主机配置。"
        rm -f "/usr/local/nginx/conf/vhost/${domain}.conf"
        exit 1
    fi
    echo "正在重载 Nginx..."
    /usr/local/nginx/sbin/nginx -s reload
}

