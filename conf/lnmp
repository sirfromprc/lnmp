#!/bin/bash
export PATH=$PATH:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin:~/bin

# 管理系统服务和配置需要 root 权限。
if [ $(id -u) != "0" ]; then
    echo "错误：必须使用 root 用户运行此命令。"
    exit 1
else
    if env |grep -q SUDO; then
        acme_sh_sudo="-f"
    fi
fi

PHPFPMPIDFILE=/usr/local/php/var/run/php-fpm.pid
WEB_SERVICE=
PHP_SERVICE=

# 服务名由 Detect_Managed_Services 在每次执行时按当前系统重新确定。
DB_SERVICE=

arg1=$1
arg2=$2
# database export/import 需要库名和文件名两个附加参数。
arg3=$3
arg4=$4

Text_Display_Width()
{
    local text="$1" bytes ascii_bytes wide_chars
    bytes=$(printf '%s' "${text}" | LC_ALL=C wc -c)
    ascii_bytes=$(printf '%s' "${text}" | LC_ALL=C tr -cd '\000-\177' | wc -c)
    wide_chars=$(( (bytes - ascii_bytes) / 3 ))
    printf '%d' $((ascii_bytes + wide_chars * 2))
}

Print_Banner()
{
    local width=72 border text text_width padding left right
    for text in "$@"; do
        text_width=$(Text_Display_Width "${text}")
        [ "${text_width}" -gt "${width}" ] && width=${text_width}
    done
    border=$(printf '%*s' "${width}" '' | tr ' ' '-')
    printf '+%s+\n' "${border}"
    for text in "$@"; do
        text_width=$(Text_Display_Width "${text}")
        padding=$((width - text_width))
        left=$((padding / 2))
        right=$((padding - left))
        printf '|%*s%s%*s|\n' "${left}" '' "${text}" "${right}" ''
    done
    printf '+%s+\n' "${border}"
}

# 通知函数安装在 /bin/lnmp-tgnotice，载入后可由管理命令直接调用。
[ -r /bin/lnmp-tgnotice ] && . /bin/lnmp-tgnotice

# Svc <服务名> <动作>
# 服务操作优先通过 systemd 执行，使进程状态与 systemctl 及监控结果一致。
# systemd 不支持的动作和无 unit 的服务由 SysV 脚本处理。
Systemd_Service_Exists()
{
    local service="$1"
    [ -s "/etc/systemd/system/${service}.service" ] || \
    [ -s "/lib/systemd/system/${service}.service" ] || \
    [ -s "/usr/lib/systemd/system/${service}.service" ]
}

Service_Exists()
{
    local service="$1"
    Systemd_Service_Exists "${service}" || [ -x "/etc/init.d/${service}" ]
}

# 每次运行管理命令时检测现有组件，使后续增装的服务自动纳入管理。
Detect_Managed_Services()
{
    WEB_SERVICE=
    PHP_SERVICE=
    DB_SERVICE=

    Service_Exists nginx && WEB_SERVICE=nginx
    Service_Exists php-fpm && PHP_SERVICE=php-fpm
    if Service_Exists mariadb; then
        DB_SERVICE=mariadb
    elif Service_Exists mysql; then
        DB_SERVICE=mysql
    fi
}

Svc()
{
    local service="$1" action="$2"

    [ -z "${service}" ] && return 0

    case "${action}" in
    start|stop|restart|reload|status)
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1 \
           && Systemd_Service_Exists "${service}"; then
            systemctl --no-pager "${action}" "${service}.service"
            return $?
        fi
        ;;
    esac

    if [ -x "/etc/init.d/${service}" ]; then
        "/etc/init.d/${service}" "${action}"
        return $?
    fi
    echo "${service}: 既没有 systemd unit 也没有 /etc/init.d 脚本，跳过。"
    return 1
}

Svc_If_Installed()
{
    local label="$1" service="$2" action="$3"
    if [ -z "${service}" ]; then
        echo "${label}: 未检测到已安装服务，跳过 ${action}。"
        return 0
    fi
    Svc "${service}" "${action}"
}

# systemctl 成功时通常不输出内容，因此管理命令补充明确的成功或失败结果。
# status 已包含完整状态，不再重复提示。
Svc_Feedback()
{
    local service="$1" action="$2" rc

    Svc "${service}" "${action}"
    rc=$?

    case "${action}" in
    ''|status)
        ;;
    *)
        if [ ${rc} -eq 0 ]; then
            Echo_Green "${service} ${action} 成功"
        else
            Echo_Red "${service} ${action} 失败（退出码 ${rc}）"
        fi
        ;;
    esac

    return ${rc}
}

# 启动完成后核对 unit 状态，及时提示进程与 systemd 状态不一致的服务。
Check_Svc_State()
{
    local service failed=''

    [ -d /run/systemd/system ] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0

    for service in "$@"; do
        [ -z "${service}" ] && continue
        Systemd_Service_Exists "${service}" || continue
        systemctl is-active --quiet "${service}.service" || failed="${failed} ${service}"
    done

    [ -z "${failed}" ] && return 0
    echo "警告：以下服务的 systemd 状态不是活动状态（active）：${failed}"
    echo "      若进程其实还在跑，说明它被 systemd 之外的方式启动过；"
    echo "      执行 lnmp kill 后再 lnmp start，可让两边重新对齐。"
    return 1
}

lnmp_start()
{
    echo "正在启动 LNMP..."
    Svc_If_Installed Nginx "${WEB_SERVICE}" start
    Svc_If_Installed Database "${DB_SERVICE}" start
    Svc_If_Installed PHP-FPM "${PHP_SERVICE}" start
    for mphpfpm in /etc/init.d/php-fpm[5,7,8].[0-9]
    do
        if [ -f ${mphpfpm} ]; then
            ${mphpfpm} start
        fi
    done
    Check_Svc_State "${WEB_SERVICE}" "${DB_SERVICE}" "${PHP_SERVICE}"
}

lnmp_stop()
{
    echo "正在停止 LNMP..."
    Svc_If_Installed Nginx "${WEB_SERVICE}" stop
    Svc_If_Installed Database "${DB_SERVICE}" stop
    Svc_If_Installed PHP-FPM "${PHP_SERVICE}" stop
    for mphpfpm in /etc/init.d/php-fpm[5,7,8].[0-9]
    do
        if [ -f ${mphpfpm} ]; then
            ${mphpfpm} stop
        fi
    done
}

lnmp_reload()
{
    echo "正在重载 LNMP..."
    Svc_If_Installed Nginx "${WEB_SERVICE}" reload
    Svc_If_Installed Database "${DB_SERVICE}" reload
    Svc_If_Installed PHP-FPM "${PHP_SERVICE}" reload
    for mphpfpm in /etc/init.d/php-fpm[5,7,8].[0-9]
    do
        if [ -f ${mphpfpm} ]; then
            ${mphpfpm} reload
        fi
    done
}

lnmp_kill()
{
    echo "正在终止 Nginx、PHP-FPM 和数据库进程..."
    killall nginx
    # MariaDB 的进程名是 mariadbd，两者只会有一个存在。
    killall mysqld 2>/dev/null
    killall mariadbd 2>/dev/null
    killall php-fpm
    killall php-cgi
    echo "完成。"
}

lnmp_status()
{
    Svc_If_Installed Nginx "${WEB_SERVICE}" status
    Svc_If_Installed PHP-FPM "${PHP_SERVICE}" status
    Svc_If_Installed Database "${DB_SERVICE}" status

    # 显示安装时随机生成的 phpMyAdmin 访问路径。
    if [ -s /usr/local/phpmyadmin/.access_url ] &&
       [ -s /usr/local/nginx/conf/phpmyadmin.enable.conf ]; then
        echo "phpMyAdmin: http://<服务器IP>/$(cat /usr/local/phpmyadmin/.access_url)/"
    elif [ -s /usr/local/phpmyadmin/.access_url ]; then
        echo "phpMyAdmin：访问已禁用（程序和配置仍保留）"
    fi
}

Function_Vhost()
{
    case "$1" in
        [aA][dD][dD])
            Add_VHost
            ;;
        [lL][iI][sS][tT])
            List_VHost
            ;;
        [dD][eE][lL])
            Del_VHost
            ;;
        [eE][xX][iI][tT])
            exit 1
            ;;
        *)
            echo "用法：lnmp vhost {add|list|del}"
            exit 1
            ;;
    esac
}

Function_Database()
{
    case "$1" in
        [aA][dD][dD])
            Add_Database_Menu && Add_Database
            ;;
        [lL][iI][sS][tT])
            List_Database
            ;;
        [dD][eE][lL])
            Del_Database
            ;;
        [eE][dD][iI][tT])
            Edit_Database
            ;;
        [eE][xX][pP][oO][rR][tT])
            Export_Database "$2" "$3"
            ;;
        [iI][mM][pP][oO][rR][tT])
            Import_Database "$2" "$3"
            ;;
        [eE][xX][iI][tT])
            return 1
            ;;
        *)
            echo "用法：lnmp database {add|list|edit|del}"
            echo "用法：lnmp database export <数据库名> <文件.sql.gz>"
            echo "用法：lnmp database import <数据库名> <文件.sql.gz>"
            return 1
            ;;
    esac
}

Function_Backup()
{
    # 三种运行模式共用 /bin/lnmp-backup，避免备份行为不一致。
    local bin="/bin/lnmp-backup"
    if [ ! -x "${bin}" ]; then
        Echo_Red "找不到 ${bin}，安装不完整。"
        Echo_Red "可从源码目录补装："
        Echo_Red "  cp tools/lnmp-backup.sh /bin/lnmp-backup && chmod +x /bin/lnmp-backup"
        return 1
    fi
    "${bin}" "$@"
}

Function_Ftp()
{
    case "$1" in
        [aA][dD][dD])
            Add_Ftp_Menu && Add_Ftp
            ;;
        [lL][iI][sS][tT])
            List_Ftp
            ;;
        [dD][eE][lL])
            Del_Ftp
            ;;
        [eE][dD][iI][tT])
            Edit_Ftp
            ;;
        [eE][xX][iI][tT])
            return 1
            ;;
        [sS][hH][oO][wW])
            Show_Ftp
            ;;
        *)
