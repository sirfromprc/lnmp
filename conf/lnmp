# default 兜底站点：接收匹配不上其它域名的访问，包括直接用服务器 IP 访问。
# Add_VHost 会在询问域名前统一打印说明；用户随后输入 default 时，这里只负责
# 检查内置站点是否存在。找不到该文件时才现场补建一次（老环境升级、或文件被误删）。
Print_Default_Site_Intro()
{
    Echo_Green "===================================================================="
    Echo_Green " 欢迎使用添加域名站点功能！"
    Echo_Green " 本包已内置 default「兜底站点」保留名，请勿将 default 用作普通站点域名。"
    Echo_Green " 所有未匹配到其它站点的访问请求（包括直接通过服务器 IP 访问）都会进入此站点，"
    Echo_Green " 根目录为 /home/wwwroot/default，无需重复配置目录、伪静态及日志等选项。"
    Echo_Green " 如需为其配置 SSL 证书，请执行 lnmp ssl add，域名填写 default，系统会自动进入 IP 证书流程。"
    Echo_Green "===================================================================="
}

Add_VHost_Default()
{
    local listen_extra='' uname_r

    if [ -s /usr/local/nginx/conf/vhost/default.conf ]; then
        return 0
    fi

    # 与 include/nginx.sh 的 Write_Nginx_Default_VHost 保持一致：内核支持时
    # 加 reuseport。两处内容不同的话，补建出来的 default 会和安装时生成的
    # 不是同一份配置。
    uname_r=$(uname -r)
    if echo "${uname_r}" | grep -Eq '^3\.(9|1[0-9])|^[4-9]\.'; then
        listen_extra=' reuseport'
    fi

    Echo_Yellow " 未找到 vhost/default.conf，现场补建 default 兜底站点..."

    echo
    mkdir -p /home/wwwroot/default
    chown -R www:www /home/wwwroot/default
    chmod 755 /home/wwwroot/default
    cat >/usr/local/nginx/conf/vhost/default.conf<<EOF
server {
        listen 80 default_server${listen_extra};
        #listen [::]:80 default_server ipv6only=on;
        server_name _;
        index index.html index.htm;
        root  /home/wwwroot/default;

        #error_page   404   /404.html;

        # phpMyAdmin 的访问入口。该片段由安装脚本按开关生成或删除，
        # 开启时片段会同时带入 PHP/反代配置；关闭时 default 保持静态。
        include phpmyadmin.*.conf;

        # phpinfo / redis / memcached 三个演示页由 Enable_PHPInfo_Page、
        # Enable_Redis_Test_Page、Enable_Memcached_Test_Page 决定是否写入本目录，
        # 默认都不写。正则 location 按出现顺序匹配，本条在下面拒绝 PHP 的规则
        # 之前，因此这三个固定文件名可执行；开关关闭时文件不存在，请求按 404
        # 处理，不需要按开关改配置。
        location ~ ^/(phpinfo|redis|memcached)\.php\$ {
            try_files \$uri =404;
            fastcgi_pass  unix:/tmp/php-cgi.sock;
            fastcgi_index index.php;
            include fastcgi.conf;
        }

        # default 是静态兜底站点，除上面三个演示页外一律不执行 PHP，
        # 避免源码被当作静态文件下载。phpMyAdmin 片段用 ^~ 前缀 location
        # 自带 PHP 处理，前缀匹配优先于本正则，因此启用 phpMyAdmin 不会让
        # 根目录下的其它 .php 变得可执行。
        location ~ [^/]\.php(/|\$) {
            return 404;
        }

        location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)\$ {
            expires      30d;
        }

        location ~ .*\.(js|css)\$ {
            expires      12h;
        }

        location ^~ /.well-known/ {
            allow all;
        }

        location ~ /\. {
            deny all;
        }

        access_log  /home/wwwlogs/default.log main;
        error_log   /home/wwwlogs/default.error.log;
    }
EOF
    echo "正在检查 Nginx 配置..."
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，已撤销刚补建的默认站点配置。"
        rm -f /usr/local/nginx/conf/vhost/default.conf
        return 1
    fi
    /usr/local/nginx/sbin/nginx -s reload
    Echo_Green " 已补建 default 兜底站点。"
    return 0
}

Add_VHost()
{
    Print_Default_Site_Intro
    domain=""
    while :;do
        Echo_Yellow "请输入域名(示例: www.example.com): "
        Read_Input domain "域名"
        Check_Domain_Name "${domain}" || continue
        if [ "${domain}" = "default" ]; then
            # default 是内置兜底站点，vhost add 不重复建站，只在缺失时补建配置。
            Add_VHost_Default || return 1
            Echo_Green " default 站已安装，是默认兜底站，如需为其配置 SSL 证书，请执行 lnmp ssl add"
            return 0
        fi
        if [ -f "/usr/local/nginx/conf/vhost/${domain}.conf" ]; then
            Echo_Red "域名 ${domain} 已存在，请检查！"
            exit 1
        fi
        echo "您的域名：${domain}"
        break
    done

    moredomain=""
    while :;do
        Echo_Yellow "请输入更多域名(示例: example.com sub.example.com，直接回车跳过): "
        read moredomain
        [ -z "${moredomain}" ] && break
        Check_More_Domains "${moredomain}" && break
    done
    echo "域名列表：${domain} ${moredomain}"

    while :;do
        Echo_Yellow "请输入网站目录: $domain"
        echo
        Echo_Yellow "默认目录(直接回车使用): /home/wwwroot/${domain}"
        read vhostdir
        if [ "${vhostdir}" == "" ]; then
            vhostdir="/home/wwwroot/${domain}"
        fi
        # 目录随后会交给 mkdir -p / chown -R，先规范化并限制在允许的站点根下
        Check_Vhost_Dir "${vhostdir}" || exit 1
        # Check_Vhost_Dir 通过时会把规范化后的路径写回 vhostdir
        Check_Vhost_Dir "${vhostdir}" && break
    done
    echo "虚拟主机目录：${vhostdir}"

    Echo_Yellow "是否开启伪静态规则? (y/n，默认 n) "
    read allow_rewrite
    if [[ "${allow_rewrite}" == "n" || "${allow_rewrite}" == "" ]]; then
        rewrite="none"
    elif [ "${allow_rewrite}" == "y" ]; then
        rewrite="other"
        echo "请输入程序对应的伪静态规则名，"
        echo "已内置的伪静态规则（直接输名字即可）："
        echo "  wordpress  wp2  typecho  typecho2  discuzx  dedecms  ecshop"
        echo "  drupal  joomla  thinkphp  laravel  codeigniter  yii2  zblog"
        echo "输入其它名字会在 /usr/local/nginx/conf/rewrite/ 下建一个空文件，规则需自己填。"
        Echo_Yellow "(默认 other，直接回车使用): "
        read rewrite
        if [ "${rewrite}" == "" ]; then
            rewrite="other"
        fi
    fi
    echo "已选择伪静态规则：$([ "${rewrite}" = "none" ] && echo "无" || echo "${rewrite}")"

    Echo_Yellow "是否开启 PHP Pathinfo? (y/n，默认 n) "
    read enable_pathinfo
    if [[ "${enable_pathinfo}" == "n" || "${enable_pathinfo}" == "" ]]; then
        echo "已禁用 PHP Pathinfo。"
        enable_pathinfo="n"
    elif [ "${enable_pathinfo}" == "y" ]; then
        echo "已启用 PHP Pathinfo。"
        enable_pathinfo="y"
    fi

    Echo_Yellow "是否开启访问日志? (y/n，默认 n) "
    read access_log
    if [[ "${access_log}" == "n" || "${access_log}" == "" ]]; then
        echo "已禁用访问日志。"
        al="access_log off;"
    else
        Echo_Yellow "请输入访问日志文件名(默认: ${domain}.log，直接回车使用): "
        read al_name
        if [ "${al_name}" == "" ]; then
            al_name="${domain}"
        fi
        al="access_log  /home/wwwlogs/${al_name}.log main;"
        echo "访问日志文件名：${al_name}.log"
    fi

    Echo_Yellow "是否开启 IPv6? (y/n，默认 n) "
    read enable_ipv6
    if [[ "${enable_ipv6}" == "n" || "${enable_ipv6}" == "" ]]; then
        echo "当前虚拟主机已禁用 IPv6。"
        enable_ipv6="n"
    else
        echo "当前虚拟主机已启用 IPv6。"
        enable_ipv6="y"
    fi

    Multiple_PHP_Select

    if [[ -x /usr/local/mysql/bin/mysql || -x /usr/local/mariadb/bin/mariadb || -x /usr/local/mariadb/bin/mysql ]]; then
        Echo_Yellow "是否创建同名数据库和 MySQL 用户? (y/n，默认 n) "
        read create_database

        if [ "${create_database}" == "y" ]; then
            Verify_DB_Password || exit 1
            Add_Database_Menu || exit 1
        fi
    fi

    if [ -s /usr/local/pureftpd/sbin/pure-ftpd ]; then
        Echo_Yellow "是否创建 FTP 账号? (y/n，默认 n) "
        read create_ftp

        if [ "${create_ftp}" == "y" ]; then
            Add_Ftp_Menu
        fi
    fi

    Echo_Yellow "是否添加 SSL 证书? (y/n，默认 n) "
    read create_ssl
    if [ "${create_ssl}" == "y" ]; then
        Add_SSL_Menu
    fi

    echo ""
    echo "按任意键开始创建虚拟主机，或按 Ctrl+C 取消..."
    OLDCONFIG=`stty -g`
    stty -icanon -echo min 1 time 0
    dd count=1 2>/dev/null
    stty ${OLDCONFIG}

    echo "正在创建虚拟主机目录..."
    mkdir -p "${vhostdir}"
    if [ "${access_log}" == "y" ]; then
        touch /home/wwwlogs/${al_name}.log
    fi
    echo "正在设置虚拟主机目录权限..."
    chmod -R 755 "${vhostdir}"
    chown -R www:www "${vhostdir}"

    # default 站点的 80 端口已经由 nginx.conf 里内置的 default_server 块
    # 处理（server_name _;，接收所有未匹配到其它 vhost 的请求），不需要、
    # 也不应该再建一个 vhost/default.conf 去重复监听 80。该文件只在后面
    # 选择加 SSL 证书时才会由 Create_SSL_Config 生成，只装 443 那个 server
    # 块。Add_SSL 里对同一情况的判断（"${domain}" != "default"）与此一致。
    if [ "${domain}" != "default" ]; then
        Add_VHost_Config
    fi

    # 重建同名站点时旧的 .user.ini 可能还在，且带着 immutable 属性。
    # 不先解除，下面的重定向会以 "Operation not permitted" 失败，
    # 同时更新 open_basedir，避免站点目录变更后仍限制在旧路径。
    [ -f "${vhostdir}/.user.ini" ] && chattr -i "${vhostdir}/.user.ini" 2>/dev/null
    cat >"${vhostdir}/.user.ini"<<EOF
open_basedir=${vhostdir}:/tmp/:/proc/
EOF
    chmod 644 "${vhostdir}/.user.ini"
    chattr +i "${vhostdir}/.user.ini"

    /etc/init.d/php-fpm reload

    if [ "${create_database}" == "y" ]; then
        Add_Database
        database_add_rc=$?
        # 建库是 vhost 流程里最后一次用到数据库 root 凭据，用完立刻清掉，
        # 不等到脚本退出
        TempMycnf_Clean
    fi

    if [ "${create_ftp}" == "y" ]; then
        Add_Ftp
        ftp_add_rc=$?
    fi

    if [ "${create_ssl}" == "y" ]; then
        Add_SSL
    fi

    Echo_Green "================================================"
    echo "虚拟主机信息："
    echo "域名：${domain}"
    echo "网站目录：${vhostdir}"
    echo "伪静态规则：$([ "${rewrite}" = "none" ] && echo "无" || echo "${rewrite}")"
    if [ "${access_log}" == "n" ]; then
        echo "访问日志：未启用"
    else
        echo "访问日志：已启用"
    fi

    if [ "${create_database}" == "y" ]; then
        if [ "${database_add_rc:-1}" -eq 0 ]; then
            echo "数据库用户名：${database_name}"
            echo "数据库名：${database_name}"
            echo "数据库密码：刚才输入的密码（不回显）"
        else
            Echo_Red "Database: 创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp database add 单独重试建库。"
        fi
    else
        echo "创建数据库：否"
    fi
    if [ "${create_ftp}" == "y" ]; then
        if [ "${ftp_add_rc:-1}" -eq 0 ]; then
            echo "FTP 账号：${ftp_account_name}"
            echo "FTP 密码：刚才输入的密码（不回显）"
        else
            Echo_Red "FTP: 账号创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp ftp add 单独重试。"
        fi
    elif [ -s /usr/local/pureftpd/sbin/pure-ftpd ]; then
        # 只有装了 pure-ftpd 才会问“是否创建 FTP 账号”，未装时这里不该
        # 冒出一行没问过的“no”，对没装 FTP 的用户没有意义。
        echo "创建 FTP 账号：否"
    fi
    if [ "${create_ssl}" == "y" ]; then
        echo "SSL：已启用"
        if [ "${ssl_choice}" == "1" ]; then
            echo "  =>自有证书文件"
        elif [ "${ssl_choice}" == "2" ]; then
            echo "  =>Let's Encrypt"
        elif [ "${ssl_choice}" == "3" ]; then
            echo "  =>BuyPass"
        elif [ "${ssl_choice}" == "4" ]; then
            echo "  =>ZeroSSL"
        fi
    fi
    if [ "${enable_ipv6}" == "y" ]; then
        echo "IPv6：已启用"
    else
        echo "IPv6：未启用"
    fi
    Echo_Green "================================================"
}

List_VHost()
{
    echo "Nginx 虚拟主机列表："
    ls /usr/local/nginx/conf/vhost/ | grep ".conf$" | sed 's/.conf//g'
}

Del_VHost()
{
    echo "======================================="
    echo "当前虚拟主机："
    List_VHost
    echo "======================================="
    domain=""
    while :;do
        Echo_Yellow "请输入要删除的域名: "
        Read_Input domain "域名"
        # 这个值会拼成 .../vhost/<域名>.conf 并被 rm 掉，同样要先约束字符集
        Check_Domain_Name "${domain}" || continue
        break
    done
    if [ ! -f "/usr/local/nginx/conf/vhost/${domain}.conf" ]; then
        echo "=========================================="
        echo "域名 ${domain} 不存在。"
        echo "=========================================="
        exit 1
    else

        vhostdir=$(awk '/^[[:space:]]*root[[:space:]]/ {gsub(/;/,"",$2); print $2; exit}' \
                   "/usr/local/nginx/conf/vhost/${domain}.conf" 2>/dev/null)
        if [ -n "${vhostdir}" ] && [ -f "${vhostdir}/.user.ini" ]; then
            chattr -i "${vhostdir}/.user.ini" 2>/dev/null
            rm -f "${vhostdir}/.user.ini"
            echo "已移除 ${vhostdir}/.user.ini（先解除 immutable 属性）"
        fi
        rm -f /usr/local/nginx/conf/vhost/${domain}.conf

        # 删掉配置文件不等于站点下线：运行中的 nginx 用的是已加载的配置，
        # 不 reload 就会继续对外提供这个站点，而命令已经报告"已删除"。
        # 与 Add_VHost_Config 一样，先 nginx -t 再 reload；任一步失败都返回非零，
        # 并说清楚线上配置还没切换。
        Del_VHost_Reload_Nginx || exit 1

        echo "========================================================"
        echo "域名 ${domain} 已删除。"
        echo "为安全起见，网站文件不会被自动删除。"
        echo "如需清理，请手动删除对应网站文件。"
        echo "========================================================"
    fi
}

Del_VHost_Reload_Nginx()
{
    if ! pgrep -f '/usr/local/nginx/sbin/nginx' >/dev/null 2>&1; then
        echo "Nginx 未在运行，跳过 reload。"
        return 0
    fi

    echo "正在检查 Nginx 配置......"
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，未执行 reload。"
        Echo_Red "站点配置文件已删除，但运行中的 Nginx 仍在提供该站点。"
        Echo_Red "请修复配置后执行：lnmp nginx reload"
        return 1
    fi
    echo "正在重载 Nginx......"
    if ! /usr/local/nginx/sbin/nginx -s reload; then
        Echo_Red "Nginx reload 失败，运行中的 Nginx 仍在提供该站点，请手工处理。"
        return 1
    fi
    return 0
}

First_Executable()
{
    local candidate

    for candidate in "$@"; do
        if [ -x "${candidate}" ]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    return 1
}

Check_DB()
{
    local mariadb_client mariadb_config mariadb_safe

    if mariadb_client=$(First_Executable /usr/local/mariadb/bin/mariadb /usr/local/mariadb/bin/mysql) \
        && mariadb_config=$(First_Executable /usr/local/mariadb/bin/mariadb_config /usr/local/mariadb/bin/mysql_config) \
        && mariadb_safe=$(First_Executable /usr/local/mariadb/bin/mariadbd-safe /usr/local/mariadb/bin/mysqld_safe) \
        && [ -s /etc/my.cnf ]; then
        MySQL_Bin="${mariadb_client}"
        MySQL_Ver=$("${mariadb_config}" --version)
    elif [[ -s /usr/local/mysql/bin/mysql && -s /usr/local/mysql/bin/mysqld_safe && -s /etc/my.cnf ]]; then
        MySQL_Bin="/usr/local/mysql/bin/mysql"
        MySQL_Ver=$(/usr/local/mysql/bin/mysql_config --version)
    else
        MySQL_Bin="None"
    fi
}

Make_TempMycnf()
{
    local pw
    # option file 在引号包裹的值里把反斜杠当转义符（\n、\t、\s 等），
    # 原样写入会让含反斜杠的密码被解析成别的字符，表现为“密码是对的却认证失败”。
    # 单引号不用另外处理：解析时只按首尾配对剥引号，值中间的单引号原样保留。
    pw="${1//\\/\\\\}"
    # 先备份管理员原有的 ~/.my.cnf，TempMycnf_Clean 会还原
    if [ -s ~/.my.cnf ] && [ ! -e ~/.my.cnf.lnmp-bak ]; then
        cp -p ~/.my.cnf ~/.my.cnf.lnmp-bak
    fi
    umask 077
    cat >~/.my.cnf<<EOF
[client]
user=root
password='${pw}'
EOF
    chmod 600 ~/.my.cnf
    # 标记这份凭据由本次执行写入，退出时无论走哪条分支都要清掉
    LNMP_Mycnf_Owned=1
    LNMP_Set_Trap
}

# 密码校验最多重试 3 次。原实现是 `while [ $status -eq 1 ]` 的无上限循环：
# 交互下输错密码只能 Ctrl+C 退出，非交互下输入耗尽后 read 立刻返回，
# 循环就变成空转刷屏。失败时返回非 0，由调用方决定是否继续。
Verify_DB_Password()
{
    local attempt=0 max_attempt=3
    Check_DB
    while [ ${attempt} -lt ${max_attempt} ]; do
        attempt=$((attempt + 1))
        Echo_Yellow "请输入当前数据库 root 密码（输入不回显）: "
        Read_Secret DB_Root_Password "数据库 root 密码"
        echo
        Make_TempMycnf "${DB_Root_Password}"
        if Do_Query ""; then
            echo "数据库 root 密码验证通过。"
            return 0
        fi
        Echo_Red "数据库 root 密码校验失败（第 ${attempt}/${max_attempt} 次）。"
    done
    Echo_Red "连续 ${max_attempt} 次校验失败，已放弃。"
    return 1
}

# ---------------------------------------------------------------------------
# 凭据和临时文件处理约束：
#   1. 临时文件使用 root 专属目录和不可预测名称；
#   2. 凭据不得写入终端日志；
#   3. SQL 字符串必须转义，标识符必须通过白名单校验。
# ---------------------------------------------------------------------------

# root 专属临时目录，退出时统一清理。
LNMP_Tmp_Dir=""
# 本次执行是否写过 ~/.my.cnf（里面是数据库 root 明文密码）。
LNMP_Mycnf_Owned=0

# 退出清理：临时目录和临时凭据挂在同一个 EXIT trap 上。
# 参数非法、系统库、EOF 等中途 exit 的分支也会经过这里，
# 不再依赖调用方在末尾补一次 TempMycnf_Clean —— 例如 vhost add 建库那条路径
# 原先就没有清理，root 密码会一直留在 ~/.my.cnf 里。
LNMP_Cleanup()
{
    if [ -n "${LNMP_Tmp_Dir}" ]; then
        rm -rf "${LNMP_Tmp_Dir}"
        LNMP_Tmp_Dir=""
    fi
    TempMycnf_Clean
}

# INT/TERM 必须单独退出：只挂 EXIT 的话，trap 执行完脚本会接着往下跑，
# Del_Database 里 "Press ctrl+c to cancel" 的倒计时就取消不掉了。
#
# 约束：注册 trap 的两个入口（Make_TempMycnf、LNMP_Tmp_Init）都只能在主 shell
# 调用，不要放进 $(...) 或管道右侧。子 shell 继承 LNMP_Tmp_Dir 的值，却会在自己
# 退出时执行这里注册的 EXIT trap，把主 shell 还在用的临时目录和凭据一起删掉。
LNMP_Set_Trap()
{
    trap 'LNMP_Cleanup' EXIT
    trap 'echo; exit 130' INT TERM
}

# 临时目录的初始化必须在当前 shell 完成，不能塞进 LNMP_Mktemp。
# LNMP_Mktemp 的返回值要靠命令替换取回，而命令替换是子 shell：在子 shell 里
# 给 LNMP_Tmp_Dir 赋值，父 shell 拿不到；在子 shell 里注册 EXIT trap，子 shell
# 一退出就把刚建好的文件连目录一起删掉，随后写 SQL 或密码文件必然失败，
# 退出时的清理也只是对着空变量执行 rm -rf ""。
LNMP_Tmp_Init()
{
    [ -n "${LNMP_Tmp_Dir}" ] && return 0
    LNMP_Tmp_Dir=$(mktemp -d /tmp/.lnmp-adm.XXXXXXXX) || return 1
    chmod 700 "${LNMP_Tmp_Dir}"
    LNMP_Set_Trap
    return 0
}

# 调用前必须已执行 LNMP_Tmp_Init。
LNMP_Mktemp()
{
    [ -n "${LNMP_Tmp_Dir}" ] || return 1
    mktemp "${LNMP_Tmp_Dir}/$1.XXXXXXXX"
}

# MySQL 单引号字符串的转义：先转反斜杠，再转单引号（顺序不能反，
# 否则会把上一步加进去的转义符再转一遍）。
Sql_Quote()
{
    local v="$1"
    v="${v//\\/\\\\}"
    v="${v//\'/\\\'}"
    printf '%s' "${v}"
}

# 库名 / 用户名走白名单，不做转义。
#
# 标识符（反引号里的东西）没有可靠的通用转义方式，而 MySQL 的库名和用户名
# 本来就只该用这些字符。与其想办法转义，不如直接拒绝越界的输入。
Check_DB_Identifier()
{
    case "$1" in
    ''|*[!A-Za-z0-9_]*)
        Echo_Red "名称 '$1' 不合法：只允许字母、数字和下划线，且不能为空。"
        return 1
        ;;
    esac
    if [ ${#1} -gt 32 ]; then
        Echo_Red "名称过长（超过 32 字符）。"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# 输入边界：域名用于配置文件名和配置内容，站点目录用于递归权限操作。
# 相关输入必须通过格式、元字符和允许目录范围检查。
# ---------------------------------------------------------------------------

# 单个 DNS 名：标签由字母数字和连字符组成，点分隔，可带前导 *. 泛域名。
# 拒绝路径分隔符、空白和配置元字符。
# ---------------------------------------------------------------------------
# Read_Input：检测 EOF，防止非交互输入耗尽后校验循环空转。
# ---------------------------------------------------------------------------
Read_Input()
{
    local __var="$1" __what="${2:-输入}"
    if ! read -r "${__var}"; then
        echo
        Echo_Red "读取${__what}时遇到 EOF —— 标准输入已经没有内容了。"
        Echo_Red "若你用管道或重定向提供输入，请核对输入项的数量与顺序："
        Echo_Red "少喂一项就会走到这里。交互执行本命令则不会有此问题。"
        exit 1
    fi
}

# Read_Secret — 同上，用于不回显的密码输入
Read_Secret()
{
    local __var="$1" __what="${2:-密码}"
    if ! read -r -s "${__var}"; then
        echo
        Echo_Red "读取${__what}时遇到 EOF —— 标准输入已经没有内容了。"
        exit 1
    fi
}

Check_Domain_Name()
{
    local d="$1"
    if [ -z "${d}" ]; then
        Echo_Red "域名不能为空。"
        return 1
    fi

    if [ "${d}" = "default" ]; then
        return 0
    fi
    if [ ${#d} -gt 253 ]; then
        Echo_Red "域名过长（超过 253 字符）：${d}"
        return 1
    fi
    # 去掉可能的泛域名前缀再校验主体
    case "${d}" in
    \*.*) d="${d#\*.}" ;;
    esac
    if ! printf '%s' "${d}" \
        | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$'; then
        Echo_Red "域名不合法：'$1'"
        Echo_Red "只接受形如 example.com / www.example.com / *.example.com 的名字，"
        Echo_Red "不接受路径分隔符、空白以及 ; { } \$ 等配置元字符。"
        return 1
    fi
    return 0
}

# 附加域名是空格分隔的一串，逐个校验，有一个不合法就整体拒绝
Check_More_Domains()
{
    local d
    for d in $1; do
        Check_Domain_Name "${d}" || return 1
    done
    return 0
}

# 站点目录：必须是绝对路径、规范化后仍落在允许的根之下、不含空白与元字符。
#
# 允许的根默认是 /home、/var/www、/srv、/data、/www 这几处常见位置，
# 外加 lnmp.conf 里配的 Default_Website_Dir 的父目录。
# 拒绝 /、/usr、/etc 等系统目录，避免对其执行 chmod -R 或 chown -R
# 是不可逆的破坏。
Check_Vhost_Dir()
{
    local d="$1" norm root ok='n'
    local matched_root='' rest probe comp resolved rroot

    if [ -z "${d}" ]; then
        Echo_Red "目录不能为空。"
        return 1
    fi
    case "${d}" in
    /*) : ;;
    *)
        Echo_Red "目录必须是绝对路径：'${d}'"
        return 1
        ;;
    esac
    if printf '%s' "${d}" | grep -Eq '[[:space:]`$;&|<>*?"'"'"'\\]'; then
        Echo_Red "目录名含空白或 shell 元字符，拒绝：'${d}'"
        return 1
    fi

    # 规范化（不要求已存在），把 .. 和多余的 / 折掉
    norm=$(printf '%s' "${d}" | sed -e 's#/\+#/#g' -e 's#/\./#/#g' -e 's#/$##')
    case "${norm}" in
    *..*)
        Echo_Red "目录不能包含 .. ：'${d}'"
        return 1
        ;;
    esac

    for root in /home /var/www /srv /data /www; do
        case "${norm}/" in
        "${root}"/*) ok='y'; matched_root="${root}"; break ;;
        esac
    done
    if [ "${ok}" != 'y' ]; then
        Echo_Red "目录 '${norm}' 不在允许的站点根之下。"
        Echo_Red "允许：/home /var/www /srv /data /www"
        Echo_Red "（限制它是因为随后要对该目录执行 chmod -R / chown -R，"
        Echo_Red "  打到 / 或 /usr 上是不可逆的。）"
        return 1
    fi

    # 允许根本身不能直接当站点目录。上面的匹配对 "/home" 也会成立
    # （模式 /home/* 里的 * 可以匹配空），而 chown -R www:www /home
    # 会把所有用户的家目录一起改掉。至少要深一层。
    if [ "${norm}" = "${matched_root}" ]; then
        Echo_Red "不能直接用 '${norm}' 作为站点目录，请在它下面建子目录。"
        Echo_Red "（随后的 chown -R 会作用于整个目录树。）"
        return 1
    fi

    # ---------------------------------------------------------------------
    # 逐级检查路径组件，任一为符号链接即拒绝。
    #
    # 从允许根的下一层开始逐级检查，防止中间路径组件通过符号链接越界。
    # 允许根本身可由管理员配置为符号链接。
    # ---------------------------------------------------------------------
    rest="${norm#${matched_root}/}"
    probe="${matched_root}"
    while [ -n "${rest}" ]; do
        comp="${rest%%/*}"
        if [ "${comp}" = "${rest}" ]; then rest=''; else rest="${rest#*/}"; fi
        probe="${probe}/${comp}"
        if [ -L "${probe}" ]; then
            Echo_Red "路径组件 '${probe}' 是符号链接，拒绝作为站点目录。"
            Echo_Red "（递归改权限会跟着链接跑到目录树之外去。）"
            return 1
        fi
    done

    # 再用 realpath 交叉确认一次：解析掉所有符号链接后仍须落在允许根之下。
    # 允许根本身也解析后再比，这样 /home -> /mnt/data/home 的部署不会被误拒。
    # realpath -m 不要求路径已存在（coreutils 8.15+，Debian/CentOS 均自带）。
    if command -v realpath >/dev/null 2>&1; then
        resolved=$(realpath -m "${norm}" 2>/dev/null) || resolved="${norm}"
        ok='n'
        for root in /home /var/www /srv /data /www; do
            rroot=$(realpath -m "${root}" 2>/dev/null) || rroot="${root}"
            case "${resolved}/" in
            "${rroot}"/*) ok='y'; break ;;
            esac
        done
        if [ "${ok}" != 'y' ]; then
            Echo_Red "'${norm}' 解析后指向 '${resolved}'，不在允许的站点根之下，拒绝。"
            return 1
        fi
    fi

    vhostdir="${norm}"
    return 0
}

Do_Query()
{
    local sql_file rc
    # 这里失败是环境问题（建不出临时目录），不能只返回非 0：
    # Verify_DB_Password 会把非 0 当成密码错误，一直重试下去。
    LNMP_Tmp_Init || exit 1
    sql_file=$(LNMP_Mktemp query) || exit 1
    chmod 600 "${sql_file}"
    printf '%s\n' "$1" > "${sql_file}"
    Check_DB
    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${sql_file}"
    rc=$?
    rm -f "${sql_file}"
    return ${rc}
}

# 只清理本次执行自己写进去的凭据，避免误删管理员原有的 ~/.my.cnf。
# 可重复调用：正常路径末尾调一次，EXIT trap 再调一次也不会重复还原备份。
TempMycnf_Clean()
{
    [ "${LNMP_Mycnf_Owned}" -eq 1 ] || return 0
    LNMP_Mycnf_Owned=0
    rm -f ~/.my.cnf
    # 恢复安装前备份的客户端配置。
    if [ -e ~/.my.cnf.lnmp-bak ]; then
        mv -f ~/.my.cnf.lnmp-bak ~/.my.cnf
    fi
}

Enter_Database_Name()
{
    while :;do
        Echo_Yellow "请输入数据库名（只允许字母、数字和下划线）: "
        Read_Input database_name "数据库名"
        Check_DB_Identifier "${database_name}" || continue
        if [ "${database_name}" == "" ]; then
            Echo_Red "数据库名不能为空。"
        else
            break
        fi
    done
}

Add_Database_Menu()
{
    Enter_Database_Name
    echo "将创建数据库及同名数据库用户：${database_name}"
    Echo_Yellow "请输入数据库用户 ${database_name} 的密码（输入不回显）: "
    Read_Secret mysql_password "数据库用户密码"
    echo
    if [ -z "${mysql_password}" ]; then
        Echo_Red "密码不能为空。"
        return 1
    fi
    return 0
}

Add_Database()
{
    local sql_file mysql_password_q rc
    Check_DB_Identifier "${database_name}" || return 1
    mysql_password_q=$(Sql_Quote "${mysql_password}")
    LNMP_Tmp_Init || return 1
    sql_file=$(LNMP_Mktemp add_db) || return 1
    chmod 600 "${sql_file}"
    cat >"${sql_file}"<<EOF
CREATE USER IF NOT EXISTS '${database_name}'@'localhost' IDENTIFIED BY '${mysql_password_q}';
CREATE USER IF NOT EXISTS '${database_name}'@'127.0.0.1' IDENTIFIED BY '${mysql_password_q}';
ALTER USER '${database_name}'@'localhost' IDENTIFIED BY '${mysql_password_q}';
ALTER USER '${database_name}'@'127.0.0.1' IDENTIFIED BY '${mysql_password_q}';
GRANT USAGE ON *.* TO '${database_name}'@'localhost';
GRANT USAGE ON *.* TO '${database_name}'@'127.0.0.1';
CREATE DATABASE IF NOT EXISTS \`${database_name}\`;
GRANT ALL PRIVILEGES ON \`${database_name}\`.* TO '${database_name}'@'localhost';
GRANT ALL PRIVILEGES ON \`${database_name}\`.* TO '${database_name}'@'127.0.0.1';
FLUSH PRIVILEGES;
EOF

    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${sql_file}"
    rc=$?
    rm -f "${sql_file}"
    if [ ${rc} -ne 0 ]; then
        Echo_Red "数据库创建失败。"
        return ${rc}
    fi
    echo "数据库创建成功。"
    return 0
}

List_Database()
{
    local rc
    ${MySQL_Bin} --defaults-file=~/.my.cnf -e "SHOW DATABASES;"
    rc=$?
    if [ ${rc} -ne 0 ]; then
        Echo_Red "数据库列表读取失败。"
        return ${rc}
    fi
    echo "数据库列表读取成功。"
    return 0
}

Edit_Database()
{
    local pass_q
    while :;do
        Echo_Yellow "请输入数据库用户名（只允许字母、数字和下划线）: "
        Read_Input database_username "数据库用户名"
        Check_DB_Identifier "${database_username}" || continue
        break
    done
    while :;do
        Echo_Yellow "请输入新密码（输入不回显）: "
        Read_Secret database_username_passwd "新密码"
        echo
        if [ "${database_username_passwd}" == "" ]; then
            Echo_Red "数据库密码不能为空。"
        else
            break
        fi
    done
    pass_q=$(Sql_Quote "${database_username_passwd}")

    # 三条语句合成一次执行：mysql 客户端默认遇错即停，
    # 分三次调用只检查中间那次的返回码，前后两次失败都会被当成成功。
    if ! Do_Query "ALTER USER '${database_username}'@'localhost' IDENTIFIED BY '${pass_q}';
ALTER USER '${database_username}'@'127.0.0.1' IDENTIFIED BY '${pass_q}';
FLUSH PRIVILEGES;"; then
        Echo_Red "数据库用户密码修改失败。"
        return 1
    fi
    echo "数据库用户密码修改成功。"
    return 0
}

Del_Database()
{
    local del_sql_file rc
    List_Database || return 1
    Enter_Database_Name
    if [[ "${database_name}" == "information_schema" || "${database_name}" == "mysql" || "${database_name}" == "performance_schema" ]]; then
        Echo_Red "MySQL 系统数据库不能删除。"
        return 1
    fi
    Check_DB_Identifier "${database_name}" || return 1
    # 先确认库确实存在：既把“库名敲错”和“删除失败”区分开，
    # 也不用等完 10 秒倒计时才发现名字打错了。
    if ! Database_Exists "${database_name}"; then
        Echo_Red "数据库不存在：${database_name}"
        return 1
    fi
    echo "将删除数据库及同名数据库用户：${database_name}"
    echo "10 秒后继续，按 Ctrl+C 可取消..."
    Sleep_Sec 10
    LNMP_Tmp_Init || return 1
    del_sql_file=$(LNMP_Mktemp del_db) || return 1
    chmod 600 "${del_sql_file}"
    cat >"${del_sql_file}"<<EOF
DROP USER IF EXISTS '${database_name}'@'127.0.0.1';
DROP USER IF EXISTS '${database_name}'@'localhost';
DROP DATABASE \`${database_name}\`;
FLUSH PRIVILEGES;
EOF
    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${del_sql_file}"
    rc=$?
    rm -f "${del_sql_file}"
    if [ ${rc} -ne 0 ]; then
        Echo_Red "数据库 ${database_name} 删除失败。"
        return ${rc}
    fi
    echo "数据库 ${database_name} 删除成功。"
    return 0
}

# ---------------------------------------------------------------------------
# 备份与恢复
#
#   lnmp database export <数据库名> <文件.sql.gz>
#   lnmp database import <数据库名> <文件.sql.gz>
#
# 导出的是单库内容，不带 CREATE DATABASE / USE 语句：目标库完全由命令行参数
# 决定，备份文件里记录的库名不会反过来盖掉用户指定的库，因此同一份备份可以
# 恢复到另一个库名，也不会误写到别的库上。
# ---------------------------------------------------------------------------

# 与数据库客户端同目录选择导出程序；MariaDB 优先使用无弃用提示的新名称。
MySQL_Dump_Bin=""
Check_Dump_Bin()
{
    if [ "${MySQL_Bin}" == "None" ]; then
        Echo_Red "未检测到已安装的 MySQL/MariaDB。"
        return 1
    fi
    MySQL_Dump_Bin=$(First_Executable \
        "$(dirname "${MySQL_Bin}")/mariadb-dump" \
        "$(dirname "${MySQL_Bin}")/mysqldump")
    if [ -z "${MySQL_Dump_Bin}" ]; then
        Echo_Red "找不到可执行的数据库导出程序。"
        return 1
    fi
    return 0
}

# 库是否存在。用 information_schema 精确比较，不用 SHOW DATABASES LIKE ——
# LIKE 会把库名里的下划线当成单字符通配符，wp_a 能匹配到 wpxa。
Database_Exists()
{
    local name_q out
    name_q=$(Sql_Quote "$1")
    out=$(${MySQL_Bin} --defaults-file=~/.my.cnf -N -B -e \
        "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='${name_q}';") || return 1
    [ -n "${out}" ]
}

# 备份文件路径：父目录必须已存在，目标不能是目录或其它非普通文件。
Check_Backup_Path()
{
    local f="$1" dir
    if [ -z "${f}" ]; then
        Echo_Red "备份文件路径不能为空。"
        return 1
    fi
    case "${f}" in
        */)
            Echo_Red "备份文件路径不能以 / 结尾：${f}"
            return 1
            ;;
    esac
    dir=$(dirname -- "${f}")
    if [ ! -d "${dir}" ]; then
        Echo_Red "目录不存在：${dir}"
        return 1
    fi
    if [ -e "${f}" ] && [ ! -f "${f}" ]; then
        Echo_Red "目标已存在且不是普通文件：${f}"
        return 1
    fi
    return 0
}

Export_Database()
{
    local database_name="$1" out_file="$2" tmp_file dump_rc gzip_rc pipe_st

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "用法：lnmp database export <数据库名> <文件.sql.gz>"
        return 1
    fi
    Check_DB_Identifier "${database_name}" || return 1
    Check_Backup_Path "${out_file}" || return 1
    if [ -e "${out_file}" ]; then
        Echo_Red "文件已存在，不覆盖：${out_file}"
        Echo_Red "请换一个文件名，或自行删除旧文件后重试。"
        return 1
    fi
    Check_Dump_Bin || return 1
    if ! Database_Exists "${database_name}"; then
        Echo_Red "数据库不存在：${database_name}"
        return 1
    fi

    # 先写同目录临时文件再改名：中途失败不会留下一个看着像备份的半截文件，
    # 同目录也保证 mv 是原子改名而不是跨文件系统复制。
    tmp_file=$(mktemp "${out_file}.lnmp-part.XXXXXXXX") || {
        Echo_Red "无法在目标目录创建临时文件：${out_file}"
        return 1
    }
    echo "正在导出数据库 ${database_name} ..."
    ${MySQL_Dump_Bin} --defaults-file=~/.my.cnf \
        --single-transaction --quick --routines --triggers --events \
        --default-character-set=utf8mb4 \
        "${database_name}" | gzip -c > "${tmp_file}"
    # PIPESTATUS 必须一次性快照：第一条赋值语句本身就会把它重置成
    # 那条赋值的状态，再取 [1] 拿到的不是管道右侧的退出码 ——
    # set -u 下直接报 unbound variable，没开 set -u 则静默变成空字符串，
    # gzip / mysql 的失败会被当成没发生。
    pipe_st=("${PIPESTATUS[@]}")
    dump_rc=${pipe_st[0]}
    gzip_rc=${pipe_st[1]}
    if [ "${dump_rc}" -ne 0 ] || [ "${gzip_rc}" -ne 0 ]; then
        rm -f "${tmp_file}"
        Echo_Red "数据库 ${database_name} 导出失败（mysqldump=${dump_rc}，gzip=${gzip_rc}）。"
        return 1
    fi
    if ! mv -f "${tmp_file}" "${out_file}"; then
        rm -f "${tmp_file}"
        Echo_Red "写入备份文件失败：${out_file}"
        return 1
    fi
    chmod 600 "${out_file}"
    echo "数据库 ${database_name} 导出成功。"
    echo "备份文件：${out_file}"
    return 0
}

Import_Database()
{
    local database_name="$1" in_file="$2" rc gz_rc mysql_rc pipe_st

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "用法：lnmp database import <数据库名> <文件.sql.gz>"
        return 1
    fi
    Check_DB_Identifier "${database_name}" || return 1
    if [ ! -f "${in_file}" ]; then
        Echo_Red "备份文件不存在或不是普通文件：${in_file}"
        return 1
    fi
    if [ ! -r "${in_file}" ] || [ ! -s "${in_file}" ]; then
        Echo_Red "备份文件不可读或为空：${in_file}"
        return 1
    fi
    # 不自动建库：建库同时还要建用户和授权，那是 database add 的职责，
    # 这里凭空 CREATE DATABASE 会留下一个没有对应用户的库。
    if ! Database_Exists "${database_name}"; then
        Echo_Red "数据库不存在：${database_name}"
        Echo_Red "请先执行 lnmp database add 建库建用户，再导入。"
        return 1
    fi

    Echo_Yellow "导入会覆盖数据库 ${database_name} 中的同名表，且无法撤销。"

    echo
    echo "10 秒后继续，按 Ctrl+C 可取消..."
    Sleep_Sec 10

    echo "正在导入数据库 ${database_name} ..."
    # 按文件内容判断是否压缩，不按扩展名：直接给未压缩的 .sql 也能导入。
    if gzip -t "${in_file}" 2>/dev/null; then
        gzip -dc "${in_file}" | ${MySQL_Bin} --defaults-file=~/.my.cnf \
            --default-character-set=utf8mb4 "${database_name}"
        pipe_st=("${PIPESTATUS[@]}")
        gz_rc=${pipe_st[0]}
        mysql_rc=${pipe_st[1]}
        rc=0
        [ "${gz_rc}" -ne 0 ] && rc=1
        [ "${mysql_rc}" -ne 0 ] && rc=1
    else
        ${MySQL_Bin} --defaults-file=~/.my.cnf \
            --default-character-set=utf8mb4 "${database_name}" < "${in_file}"
        rc=$?
    fi
    if [ "${rc}" -ne 0 ]; then
        Echo_Red "数据库 ${database_name} 导入失败。"
        return 1
    fi
    echo "数据库 ${database_name} 导入成功。"
    return 0
}

Enter_Ftp_Name()
{
    while :;do
        Echo_Yellow "请输入 FTP 账号名（只允许字母、数字和下划线）: "
        Read_Input ftp_account_name "FTP 账号名"
        # 账号名会被拼进 /tmp 路径和 pure-pw 的参数，必须先约束字符集
        if ! Check_DB_Identifier "${ftp_account_name}"; then
            continue
        else
            break
        fi
    done
}

Add_Ftp_Menu()
{
    Enter_Ftp_Name
    while :;do
        Echo_Yellow "请输入 FTP 账号 ${ftp_account_name} 的密码（输入不回显）: "
        Read_Secret ftp_account_password "FTP 密码"
        echo
        if [ "${ftp_account_password}" == "" ]; then
            Echo_Red "FTP 密码不能为空。"
        else
            break
        fi
    done
    if [ "${vhostdir}" == "" ]; then
        while :;do
            Echo_Yellow "请输入 FTP 账号 ${ftp_account_name} 的目录: "
            Read_Input vhostdir "FTP 目录"
            # 复用站点目录校验。该目录随后会被 mkdir -p 与 chown -R www:www，
            # 并作为 FTP 根目录传给 pure-pw：填 / 或 /etc 时前者不可逆，
            # 后者会让该 FTP 账号看到 www 身份能访问的全部内容。
            # 校验通过时 Check_Vhost_Dir 会把规范化后的路径写回 vhostdir。
            Check_Vhost_Dir "${vhostdir}" && break
            vhostdir=''
        done
    fi
    return 0
}

Check_Pureftpd()
{
    if [ ! -f /usr/local/pureftpd/sbin/pure-ftpd ]; then
        Echo_Red "未检测到已安装的 Pure-FTPd。"
        exit 1
    fi
}

Add_Ftp()
{
    local rc ftp_pass_file www_uid www_gid
    # 兜底校验：本函数也可由 vhost 流程直接调用，不能假设 vhostdir 已被校验。
    # Check_Vhost_Dir 幂等，对已规范化的路径重复调用无副作用。
    Check_Vhost_Dir "${vhostdir}" || return 1
    # www 账号缺失时 id 输出为空，pure-pw 会拿到空的 -u/-g 参数并报一个
    # 难以对应到原因的用法错误，这里先说清楚
    www_uid=$(id -u www 2>/dev/null) || { Echo_Red "系统里没有 www 用户，无法创建 FTP 账号。"; return 1; }
    www_gid=$(id -g www 2>/dev/null) || { Echo_Red "系统里没有 www 用户组，无法创建 FTP 账号。"; return 1; }
    if [ ! -d "${vhostdir}" ]; then
        mkdir -p "${vhostdir}" || { Echo_Red "创建目录失败：${vhostdir}"; return 1; }
        chown www:www -R "${vhostdir}"
    fi

    LNMP_Tmp_Init || return 1
    ftp_pass_file=$(LNMP_Mktemp ftppass) || return 1
    chmod 600 "${ftp_pass_file}"
    cat >"${ftp_pass_file}"<<EOF
${ftp_account_password}
${ftp_account_password}
EOF
    /usr/local/pureftpd/bin/pure-pw useradd "${ftp_account_name}" -f /usr/local/pureftpd/etc/pureftpd.passwd -u "${www_uid}" -g "${www_gid}" -d "${vhostdir}" -m < "${ftp_pass_file}"
    rc=$?
    rm -f "${ftp_pass_file}"
    if [ ${rc} -ne 0 ]; then
        Echo_Red "FTP 账号 ${ftp_account_name} 创建失败（pure-pw 返回 ${rc}）。"
        Echo_Red "常见原因：同名账号已存在，或密码库 /usr/local/pureftpd/etc/pureftpd.passwd 不可写。"
        Echo_Red "先用 lnmp ftp list 确认账号是否已经存在。"
        return ${rc}
    fi
    echo "FTP 账号 ${ftp_account_name} 创建成功。"
    return 0
}

List_Ftp()
{
    local rc
    /usr/local/pureftpd/bin/pure-pw list -f /usr/local/pureftpd/etc/pureftpd.passwd
    rc=$?
    if [ ${rc} -ne 0 ]; then
        Echo_Red "FTP 账号列表读取失败（pure-pw 返回 ${rc}）。"
        return ${rc}
    fi
    echo "FTP 账号列表读取成功。"
    return 0
}

Edit_Ftp()
{
    local pass_rc=0 dir_rc=0 ftp_pass_file www_uid www_gid
    # 这里不因 List_Ftp 失败而中止：列表只是给用户看的参考
    List_Ftp
    Enter_Ftp_Name
    Echo_Yellow "请输入 FTP 账号 ${ftp_account_name} 的新密码（输入不回显，留空则不修改）: "
    read -r -s ftp_account_password
    echo
    if [ "${ftp_account_password}" != "" ]; then
        LNMP_Tmp_Init || return 1
        ftp_pass_file=$(LNMP_Mktemp ftppass) || return 1
        chmod 600 "${ftp_pass_file}"
        cat >"${ftp_pass_file}"<<EOF
${ftp_account_password}
${ftp_account_password}
EOF
        /usr/local/pureftpd/bin/pure-pw passwd "${ftp_account_name}" -f /usr/local/pureftpd/etc/pureftpd.passwd -m < "${ftp_pass_file}"
        pass_rc=$?
        rm -f "${ftp_pass_file}"
        if [ ${pass_rc} -ne 0 ]; then
            Echo_Red "FTP 账号 ${ftp_account_name} 的密码修改失败（pure-pw 返回 ${pass_rc}，账号可能不存在）。"
        else
            echo "FTP 账号 ${ftp_account_name} 的密码修改成功。"
        fi
    else
        echo "FTP 密码保持不变。"
    fi
    Echo_Yellow "请输入 FTP 账号 ${ftp_account_name} 的新目录（留空则不修改）: "
    Read_Input vhostdir "FTP 目录"
    if [ "${vhostdir}" != "" ]; then
        # 留空表示不修改，因此只在确实填了新值时校验。约束同 Add_Ftp_Menu。
        if ! Check_Vhost_Dir "${vhostdir}"; then
            Echo_Red "FTP 目录未修改。"
            return 1
        fi
        www_uid=$(id -u www 2>/dev/null) || { Echo_Red "系统里没有 www 用户。"; return 1; }
        www_gid=$(id -g www 2>/dev/null) || { Echo_Red "系统里没有 www 用户组。"; return 1; }
        if [ ! -d "${vhostdir}" ]; then
            mkdir -p "${vhostdir}" || { Echo_Red "创建目录失败：${vhostdir}"; return 1; }
            chown www:www -R "${vhostdir}"
        fi
        /usr/local/pureftpd/bin/pure-pw usermod "${ftp_account_name}" -f /usr/local/pureftpd/etc/pureftpd.passwd -u "${www_uid}" -g "${www_gid}" -d "${vhostdir}" -m
        dir_rc=$?
        if [ ${dir_rc} -ne 0 ]; then
            Echo_Red "FTP 账号 ${ftp_account_name} 的目录修改失败（pure-pw 返回 ${dir_rc}，账号可能不存在）。"
        else
            echo "FTP 账号 ${ftp_account_name} 的目录修改成功。"
        fi
    else
        echo "FTP 目录保持不变。"
    fi
    # 改密码和改目录是两件独立的事，任一失败都要让整体返回非 0
    if [ ${pass_rc} -ne 0 ] || [ ${dir_rc} -ne 0 ]; then
        return 1
    fi
    return 0
}

Del_Ftp()
{
    local rc
    List_Ftp
    Enter_Ftp_Name
    echo "将删除 FTP 账号 ${ftp_account_name}。"
