#!/bin/bash
# @CLI_COMMON@
# @CLI_NGINX@
export PATH=$PATH:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin:~/bin

# 管理系统服务和配置需要 root 权限。
if [ "$(id -u)" != "0" ]; then
    echo "错误：必须使用 root 用户运行此命令。"
    exit 1
else
    if env |grep -q SUDO; then
        acme_sh_sudo="-f"
    fi
fi

PHPFPMPIDFILE=/usr/local/php/var/run/php-fpm.pid
WEB_SERVICE=
PHP_SERVICE=

# 服务名由 Detect_Managed_Services 在每次执行时按当前系统重新确定。
DB_SERVICE=

arg1=$1
arg2=$2
# database export/import 需要库名和文件名两个附加参数。
arg3=$3
arg4=$4

# 通知函数安装在 /bin/lnmp-tgnotice，载入后可由管理命令直接调用。
[ -r /bin/lnmp-tgnotice ] && . /bin/lnmp-tgnotice

# 每次运行管理命令时检测现有组件，使后续增装的服务自动纳入管理。
Detect_Managed_Services()
{
    WEB_SERVICE=
    PHP_SERVICE=
    DB_SERVICE=

    Svc_Exists nginx && WEB_SERVICE=nginx
    Svc_Exists php-fpm && PHP_SERVICE=php-fpm
    if Svc_Exists mariadb; then
        DB_SERVICE=mariadb
    elif Svc_Exists mysql; then
        DB_SERVICE=mysql
    fi
}

# 输出已安装的多版本 PHP 版本号，取自 /etc/init.d 下的启动脚本。
Multiple_PHP_Versions()
{
    local script ver
    for script in /etc/init.d/php-fpm[578].[0-9]; do
        [ -f "${script}" ] || continue
        ver="${script##*/php-fpm}"
        printf '%s\n' "${ver}"
    done
}

# 多版本 PHP 的服务操作。模板 unit 已安装时走 systemd，使自动重启和
# systemctl 状态与主 php-fpm 一致；未安装时回退 SysV 脚本，兼容存量环境。
# 逐个执行，任一实例失败返回 1。
Multiple_PHP_Action()
{
    local action="$1" ver rc failed=0
    for ver in $(Multiple_PHP_Versions); do
        if Svc_Unit_Exists "php-fpm@"; then
            Svc "php-fpm@${ver}" "${action}"
        else
            "/etc/init.d/php-fpm${ver}" "${action}"
        fi
        rc=$?
        [ ${rc} -eq 0 ] && continue
        failed=1
        [ "${action}" = status ] || Echo_Red "PHP ${ver} ${action} 失败（退出码 ${rc}）"
    done
    return ${failed}
}

lnmp_start()
{
    local failed=0
    echo "正在启动 LNMP..."
    Svc_If_Installed Nginx "${WEB_SERVICE}" start || failed=1
    Svc_If_Installed Database "${DB_SERVICE}" start ||
        { failed=1; Diagnose_DB_Start_Failure start; }
    Svc_If_Installed PHP-FPM "${PHP_SERVICE}" start || failed=1
    Multiple_PHP_Action start || failed=1
    Check_Svc_State "${WEB_SERVICE}" "${DB_SERVICE}" "${PHP_SERVICE}" || failed=1
    return ${failed}
}

lnmp_stop()
{
    local failed=0
    echo "正在停止 LNMP..."
    Svc_If_Installed Nginx "${WEB_SERVICE}" stop || failed=1
    Svc_If_Installed Database "${DB_SERVICE}" stop || failed=1
    Svc_If_Installed PHP-FPM "${PHP_SERVICE}" stop || failed=1
    Multiple_PHP_Action stop || failed=1
    return ${failed}
}

lnmp_reload()
{
    local failed=0
    echo "正在重载 LNMP..."
    Svc_If_Installed Nginx "${WEB_SERVICE}" reload || failed=1
    Svc_If_Installed Database "${DB_SERVICE}" reload || failed=1
    Svc_If_Installed PHP-FPM "${PHP_SERVICE}" reload || failed=1
    Multiple_PHP_Action reload || failed=1
    return ${failed}
}

lnmp_kill()
{
    local failed=0 ver
    echo "正在终止 Nginx、PHP-FPM 和数据库进程..."

    Kill_By_Unit "${WEB_SERVICE}" "${PHP_SERVICE}" "${DB_SERVICE}"
    for ver in $(Multiple_PHP_Versions); do
        Kill_By_Unit "php-fpm@${ver}"
    done

    Kill_Process nginx || failed=1
    # MariaDB 的进程名是 mariadbd，两者只会有一个存在。
    # 数据库关闭要刷缓冲池，给更长的等待时间。
    Kill_Process mysqld 30 || failed=1
    Kill_Process mariadbd 30 || failed=1
    Kill_Process php-fpm || failed=1
    Kill_Process php-cgi || failed=1
    [ ${failed} -eq 0 ] && echo "完成。"
    return ${failed}
}

lnmp_status()
{
    local svc

    Svc_If_Installed Nginx "${WEB_SERVICE}" status
    Svc_If_Installed PHP-FPM "${PHP_SERVICE}" status
    Multiple_PHP_Action status
    Svc_If_Installed Database "${DB_SERVICE}" status
    # 附加组件不参与整体起停，已安装时一并显示状态。
    for svc in redis memcached pureftpd; do
        Svc_Exists "${svc}" && Svc "${svc}" status
    done

    # 访问地址含随机路径，与启用状态一同由 lnmp-phpmyadmin 输出。
    if [ -s /usr/local/phpmyadmin/.access_url ]; then
        if [ -x /bin/lnmp-phpmyadmin ]; then
            /bin/lnmp-phpmyadmin lnmp status
        else
            echo "phpMyAdmin 访问路径：/$(cat /usr/local/phpmyadmin/.access_url)/"
            Echo_Red "找不到 /bin/lnmp-phpmyadmin，无法判断启用状态和访问地址。"
            Echo_Red "补装：cp tools/lnmp-phpmyadmin.sh /bin/lnmp-phpmyadmin && chmod +x /bin/lnmp-phpmyadmin"
        fi
    fi
}
# ---------------------------------------------------------------------------
# 应用托管：Node、Go 等自带后端进程的站点
# 元数据在 /etc/lnmp/apps/<名字>.env，由 init.d/lnmp-app@.service 读取。
# ---------------------------------------------------------------------------
App_Conf_Dir="/etc/lnmp/apps"
App_Unit_Tpl="/etc/systemd/system/lnmp-app@.service"



# 主 PHP 是否可用：编译产物与 init 脚本齐备才算装好。
Main_PHP_Installed()
{
    [ -s /usr/local/php/bin/php-config ] && [ -x /etc/init.d/php-fpm ]
}

# 本机是否有可供站点使用的 PHP：主 PHP 或任一附加版本。
Site_PHP_Available()
{
    Main_PHP_Installed && return 0
    [ -n "$(Multiple_PHP_Installed_List)" ]
}

# 反代后端域名解析用的 DNS。写死公共地址而不是读 /etc/resolv.conf：
# 后者常指向 127.0.0.53 一类的本地 stub，容器或裁剪过的系统里未必可用。
Proxy_Resolver='8.8.8.8 8.8.4.4'

# 目录属主必须是 www，否则 PHP-FPM 读不到站点文件。权限位区别对待：
# 新建或空目录直接给 755；复用的非空目录默认保持原样，递归 755 会给普通文件
# 加上执行位，并把 .env、密钥一类原本 600/640 的文件放宽为所有本地用户可读。
Prepare_Vhost_Dir_Perm()
{
    local dir="$1" created="$2" fix='n' own='n' rc=0

    # 本次新建或本来就是空目录，里面没有别人的文件，可以直接定权限和属主。
    if [ "${created}" = 'y' ] || [ -z "$(ls -A "${dir}" 2>/dev/null)" ]; then
        chmod 755 "${dir}" || rc=1
        if ! chown -R www:www "${dir}"; then
            Echo_Red "变更 ${dir} 属主失败，PHP-FPM 可能无法读取站点文件。"
            rc=1
        fi
        return ${rc}
    fi

    echo "目录 ${dir} 已存在且非空，默认保留其中文件的权限位和属主。"
    # 非交互执行不占用输入行，否则既有的管道调用会在这里因 EOF 中断建站。
    if [ ! -t 0 ]; then
        case "${VHOST_FIX_PERM:-}" in
            [yY]) fix='y'; echo "非交互执行，按 VHOST_FIX_PERM=y 统一权限。" ;;
            *)    echo "非交互执行，保留原权限位（如需统一，设置 VHOST_FIX_PERM=y）。" ;;
        esac
    else
        Read_YN fix "是否把目录统一改为 755、普通文件改为 644? (y/N，默认 n) " n "权限规范化开关"
    fi
    if [ "${fix}" = 'y' ]; then
        find "${dir}" -type d -exec chmod 755 {} + || rc=1
        find "${dir}" -type f -exec chmod 644 {} + || rc=1
    fi

    # 属主单独确认：复用目录里可能有部署账号、CI 或其它服务的文件，
    # 递归改成 www:www 会破坏后续部署和最小权限边界。
    echo "该目录下现有的属主："
    find "${dir}" -mindepth 1 -maxdepth 1 -printf '%u:%g\n' 2>/dev/null \
        | sort -u | head -n 10 | sed 's/^/  /'
    if [ ! -t 0 ]; then
        case "${VHOST_FIX_OWNER:-}" in
            [yY]) own='y'; echo "非交互执行，按 VHOST_FIX_OWNER=y 统一属主为 www:www。" ;;
            *)    echo "非交互执行，保留原属主（如需统一，设置 VHOST_FIX_OWNER=y）。" ;;
        esac
    else
        Read_YN own "是否把 ${dir} 下所有文件的属主统一改为 www:www? (y/N，默认 n) " n "属主统一开关"
    fi
    if [ "${own}" = 'y' ]; then
        if ! chown -R www:www "${dir}"; then
            Echo_Red "变更 ${dir} 属主失败，部分文件可能已改、部分未改，请自行核对。"
            rc=1
        fi
    else
        echo "已保留原属主；若 PHP-FPM 读不到站点文件，请自行给 www 用户授予读取权限。"
    fi
    return ${rc}
}

# 站点级 open_basedir 的纵深防御层。生效值来自 fastcgi.conf 的
# PHP_ADMIN_VALUE（admin 值，.user.ini 覆盖不了），本文件用于 FastCGI 兜底
# 被人为移除后仍有边界，因此写入失败只告警，不中断建站。
# 参数：网站根目录 [open_basedir 根目录，默认同网站根目录]
Write_Site_User_Ini()
{
    local dir="$1" base="${2:-$1}"

    [ -f "${dir}/.user.ini" ] && chattr -i "${dir}/.user.ini" 2>/dev/null
    if ! cat >"${dir}/.user.ini"<<EOF
open_basedir=${base}:/tmp/:/var/tmp/:/proc/
EOF
    then
        Echo_Red "写入 ${dir}/.user.ini 失败，本站点缺少 .user.ini 这层 open_basedir。"
        return 1
    fi
    chmod 644 "${dir}/.user.ini"
    # immutable 是加固项，置不上不影响站点可用，但必须让用户看到。
    if ! chattr +i "${dir}/.user.ini" 2>/dev/null; then
        Echo_Yellow "警告：无法为 ${dir}/.user.ini 设置 immutable 属性，"
        Echo_Yellow "该文件可被站点内的写入覆盖。"
        echo
    fi
    return 0
}

# 站点启用 IPv6 后同步启用 default 的 IPv6 监听：[::]:80 上没有 default_server
# 时，未匹配 Host 的 IPv6 请求会落到先加载的业务站点，而不是 default。
# 返回 0 表示本次改动了 default 配置，调用方失败时需要回滚。
# 本次实际由注释状态改为启用的端口，回滚时只还原这些行。
Default_IPv6_Enabled_Ports=''

# Site_Project_PHP_Block <include 行> <open_basedir 根>：内联输出所选 enable-php 片段，
# 在 include fastcgi.conf 之后覆盖 PHP_ADMIN_VALUE。PHP-FPM 对重复参数取最后一个。
Site_Project_PHP_Block()
{
    local name="${1#include }" base="$2"

    name="${name%;}"
    if [ ! -s "/usr/local/nginx/conf/${name}" ]; then
        Echo_Red "找不到 /usr/local/nginx/conf/${name}，无法生成站点的 PHP 配置。" >&2
        return 1
    fi
    awk -v ov="fastcgi_param PHP_ADMIN_VALUE \"open_basedir=${base}/:/tmp/:/var/tmp/:/proc/\";" '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        { if (!p++) sub(/^    /, ""); print }
        /^[[:space:]]*include[[:space:]]+fastcgi\.conf;/ {
            match($0, /^[[:space:]]*/); print substr($0, 1, RLENGTH) ov; n++
        }
        END { exit n ? 0 : 1 }' "/usr/local/nginx/conf/${name}"
}

Add_VHost_Config()
{
    local vhost_index default_ipv6_added='n' rewrite_created='n' php_conf_block static_block

    Check_Config_Name "${rewrite}" "伪静态规则名" || return 1
    if [ "${access_log:-n}" = 'y' ]; then
        Check_Config_Name "${al_name}" "访问日志文件名" || return 1
    fi
    vhost_index="$(Site_Index_Line)"
    Site_Static_Cache_Block static_block
    # 项目目录与网站根目录不同时（Laravel 预设），open_basedir 放宽到项目目录。
    php_conf_block="${include_enable_php}"
    if [ "${enable_site_php}" = "y" ] && [ "${site_basedir:-${vhostdir}}" != "${vhostdir}" ]; then
        php_conf_block="$(Site_Project_PHP_Block "${include_enable_php}" "${site_basedir}")" || return 1
    fi

    if [ ! -f "/usr/local/nginx/conf/rewrite/${rewrite}.conf" ]; then
        echo "正在创建虚拟主机伪静态规则文件......"
        touch "/usr/local/nginx/conf/rewrite/${rewrite}.conf" || return 1
        rewrite_created='y'
        echo "伪静态规则文件创建成功，可编辑 /usr/local/nginx/conf/rewrite/${rewrite}.conf 添加规则。"
    else
        echo "使用已有伪静态规则：/usr/local/nginx/conf/rewrite/${rewrite}.conf"
    fi
    cat >"/usr/local/nginx/conf/vhost/${domain}.conf"<<EOF
server {
    listen 80;
    #listen [::]:80;
    server_name ${domain} ${moredomain};
    ${vhost_index}
    root  ${vhostdir};

    include rewrite/${rewrite}.conf;
    #error_page   404   /404.html;

    # ACME 验证路径用 ^~ 前缀声明，优先级高于全部正则 location，
    # 不受下面的隐藏文件规则影响。
    location ^~ /.well-known/ {
        allow all;
    }

    # 拒绝 .user.ini、.env、.git 等隐藏文件。正则 location 取首个匹配，
    # 该规则必须排在 PHP 和静态资源正则之前才能覆盖 .hidden.php、/.git/a.css。
    # 整站反向代理需要把点开头路径交给上游时，删除本条。
    location ~ /\. {
        deny all;
    }

    ${php_conf_block}
${static_block}
    # 自定义配置--开始

    # 自定义配置--结束

    ${al}
    error_log   /home/wwwlogs/${domain}.error.log;
}
EOF

    if [ "${enable_ipv6}" == "y" ]; then
        sed -i 's/#listen \[::\]:80;/listen \[::\]:80;/g' "/usr/local/nginx/conf/vhost/${domain}.conf"
        Enable_Default_IPv6_Listen && default_ipv6_added='y'
    fi

    echo "正在检查 Nginx 配置..."
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，已撤销本次新增的虚拟主机配置。"
        rm -f "/usr/local/nginx/conf/vhost/${domain}.conf"
        [ "${rewrite_created}" = 'y' ] && rm -f "/usr/local/nginx/conf/rewrite/${rewrite}.conf"
        [ -n "${Site_Enable_PHP_Conf_Created}" ] && rm -f "${Site_Enable_PHP_Conf_Created}"
        [ "${default_ipv6_added}" = 'y' ] && Disable_Default_IPv6_Listen
        return 1
    fi
    if ! pgrep -f '/usr/local/nginx/sbin/nginx' >/dev/null 2>&1; then
        echo "Nginx 未在运行，跳过 reload。"
        return 0
    fi
    echo "正在重载 Nginx..."
    # reload 失败必须撤销站点配置：留在磁盘上会让下次建站报"域名已存在"，
    # 而以后任意一次 reload 又会把这个未完成的站点放到线上。
    if ! /usr/local/nginx/sbin/nginx -s reload; then
        Echo_Red "Nginx 重载失败，已撤销本次新增的虚拟主机配置。"
        rm -f "/usr/local/nginx/conf/vhost/${domain}.conf"
        [ "${rewrite_created}" = 'y' ] && rm -f "/usr/local/nginx/conf/rewrite/${rewrite}.conf"
        [ -n "${Site_Enable_PHP_Conf_Created}" ] && rm -f "${Site_Enable_PHP_Conf_Created}"
        [ "${default_ipv6_added}" = 'y' ] && Disable_Default_IPv6_Listen
        /usr/local/nginx/sbin/nginx -s reload >/dev/null 2>&1
        return 1
    fi
    return 0
}

# 可与主 PHP 并存的附加版本。编号由已安装版本动态生成，不写死在菜单里。
Multiple_PHP_Version_List="5.2 5.3 5.4 5.5 5.6 7.0 7.1 7.2 7.3 7.4 8.0 8.1 8.2 8.3 8.4 8.5"

# 二进制、Nginx include 和 init 脚本三者齐备才算这个版本可用。
Multiple_PHP_Installed()
{
    local ver="$1"

    [ -s "/usr/local/php${ver}/sbin/php-fpm" ] \
        && [ -s "/usr/local/nginx/conf/enable-php${ver}.conf" ] \
        && [ -s "/etc/init.d/php-fpm${ver}" ]
}

# 输出已安装的附加 PHP 版本，供菜单和选择校验共用。
Multiple_PHP_Installed_List()
{
    local ver out=''

    for ver in ${Multiple_PHP_Version_List}; do
        Multiple_PHP_Installed "${ver}" && out="${out:+${out} }${ver}"
    done
    printf '%s' "${out}"
}

# 存在二进制或配置残留，但三者不齐的版本单独报出来：它们不能选，
# 选了会通过 nginx -t 却在请求时持续 502。
Report_Multiple_PHP_Residue()
{
    local ver residue=''

    for ver in ${Multiple_PHP_Version_List}; do
        Multiple_PHP_Installed "${ver}" && continue
        if [ -e "/usr/local/php${ver}" ] || [ -e "/usr/local/nginx/conf/enable-php${ver}.conf" ] \
           || [ -e "/etc/init.d/php-fpm${ver}" ]; then
            residue="${residue:+${residue} }${ver}"
        fi
    done
    [ -n "${residue}" ] || return 0
    Echo_Yellow "以下版本只有残留文件，未完整安装，不能选用：${residue}"
    echo
    Echo_Yellow "需要它们请重新执行 ./install.sh mphp 安装，或清理残留后再建站。"
    echo
    return 0
}

# 本次建站生成的 pathinfo 片段路径，建站回滚时删除。
Site_Enable_PHP_Conf_Created=''

# 为选定的附加 PHP 版本准备 Nginx include 片段并写入 include_enable_php。
Set_Include_Enable_PHP()
{
    local ver="$1" conf

    Site_Enable_PHP_Conf_Created=''
    if [ -z "${ver}" ]; then
        if [ "${enable_pathinfo}" == "y" ]; then
            include_enable_php="include enable-php-pathinfo.conf;"
        else
            include_enable_php="include enable-php.conf;"
        fi
        return 0
    fi
    if [ "${enable_pathinfo}" != "y" ]; then
        include_enable_php="include enable-php${ver}.conf;"
        return 0
    fi
    conf="/usr/local/nginx/conf/enable-php${ver}-pathinfo.conf"
    include_enable_php="include enable-php${ver}-pathinfo.conf;"
    [ -s "${conf}" ] && return 0
    # Pathinfo 片段按主 PHP 的模板生成，只替换为该版本的 socket。
    if ! \cp /usr/local/nginx/conf/enable-php-pathinfo.conf "${conf}"; then
        Echo_Red "生成 ${conf} 失败。"
        return 1
    fi
    sed -i "s/php-cgi.sock/php-cgi${ver}.sock/g" "${conf}" || return 1
    Site_Enable_PHP_Conf_Created="${conf}"
    return 0
}

# 菜单编号按实际可用版本动态生成：主 PHP 未安装时不占用编号，
# 否则会列出空版本号并生成指向不存在 socket 的站点配置。
Multiple_PHP_Select()
{
    local installed ver idx choice sel_ver cands='' total cur_ver=''

    installed="$(Multiple_PHP_Installed_List)"
    if Main_PHP_Installed; then
        cur_ver="$(/usr/local/php/bin/php-config --version)"
        cands='main'
    fi
    for ver in ${installed}; do
        cands="${cands:+${cands} }${ver}"
    done

    # 残留版本不能选，但要报出来，否则用户会以为自己装过的版本凭空消失。
    Report_Multiple_PHP_Residue

    if [ -z "${cands}" ]; then
        Echo_Red "未检测到完整安装的 PHP 版本，无法为本站点配置 PHP。"
        return 1
    fi

    set -- ${cands}
    total=$#
    if [ "${total}" -eq 1 ]; then
        if [ "$1" = 'main' ]; then
            Set_Include_Enable_PHP "" || return 1
        else
            echo "仅 PHP ${1} 可用，本站点使用该版本。"
            Set_Include_Enable_PHP "$1" || return 1
        fi
        return 0
    fi

    echo "检测到多个 PHP 版本，请选择要使用的版本。"
    idx=0
    for ver in ${cands}; do
        idx=$((idx + 1))
        if [ "${ver}" = 'main' ]; then
            Echo_Green "${idx}: 默认主 PHP ${cur_ver}"
        else
            Echo_Green "${idx}: PHP ${ver} [已安装]"
        fi
    done

    while :;do
        Echo_Yellow "请选择 [1-${idx}]（默认 1）："
        Read_Input choice "PHP 版本选择"
        [ -z "${choice}" ] && choice=1
        case "${choice}" in
        *[!0-9]*|'')
            Echo_Red "请输入 1 到 ${idx} 之间的编号。"
            continue
            ;;
        esac
        if [ "${choice}" -lt 1 ] || [ "${choice}" -gt "${idx}" ]; then
            Echo_Red "只能选择上面列出的编号 1 到 ${idx}。"
            continue
        fi
        sel_ver=$(printf '%s\n' ${cands} | sed -n "${choice}p")
        if [ "${sel_ver}" = 'main' ]; then
            echo "当前选择：PHP ${cur_ver}"
            Set_Include_Enable_PHP "" || return 1
        else
            echo "当前选择：PHP $(/usr/local/php${sel_ver}/bin/php-config --version)"
            Set_Include_Enable_PHP "${sel_ver}" || return 1
        fi
        return 0
    done
}

# default 兜底站点接收未匹配其它域名的请求，包括直接访问服务器 IP。
# 配置缺失时会重新创建内置站点。
Print_Default_Site_Intro()
{
    Echo_Green "===================================================================="
    Echo_Green " 欢迎使用添加域名站点功能！"
    Echo_Green " 本包已内置 default「兜底站点」保留名，请勿将 default 用作普通站点域名。"
    Echo_Green " 所有未匹配到其它站点的访问请求（包括直接通过服务器 IP 访问）都会进入此站点，"
    Echo_Green " 根目录为 /home/wwwroot/default，无需重复配置目录、伪静态及日志等选项。"
    Echo_Green " 如需为其配置 SSL 证书，请执行 lnmp ssl add，域名填写 default，系统会自动进入 IP 证书流程。"
    Echo_Green "===================================================================="
}

Add_VHost_Default()
{
    local listen_extra='' uname_r quic_lines=''

    if [ -s /usr/local/nginx/conf/vhost/default.conf ]; then
        return 0
    fi

    # 支持的内核启用 reuseport，使补建配置与安装配置保持一致。
    uname_r=$(uname -r)
    if echo "${uname_r}" | grep -Eq '^3\.(9|1[0-9])|^[4-9]\.'; then
        listen_extra=' reuseport'
    fi
    # 未编译 http_v3 时写入 quic 会使 nginx -t 失败。
    if [ -n "${listen_extra}" ] && Nginx_Has_HTTP3; then
        printf -v quic_lines '\n%s\n%s\n%s' \
            '    # QUIC 的 reuseport 在同一地址端口只能声明一次，由本块承担，业务站点只写 quic。' \
            '    listen 443 quic reuseport default_server;' \
            '    #listen [::]:443 quic reuseport default_server ipv6only=on;'
    fi

    Echo_Yellow " 未找到 vhost/default.conf，现场补建 default 兜底站点..."

    echo
    mkdir -p /home/wwwroot/default
    chown -R www:www /home/wwwroot/default
    chmod 755 /home/wwwroot/default
    cat >/usr/local/nginx/conf/vhost/default.conf<<EOF
server {
    listen 80 default_server${listen_extra};
    #listen [::]:80 default_server ipv6only=on;
    server_name _;
    index index.html index.htm;
    root  /home/wwwroot/default;

    #error_page   404   /404.html;

    # phpMyAdmin 启用时载入访问入口及其 PHP 或反向代理配置。
    include phpmyadmin.*.conf;

    # 仅允许已启用的 phpinfo、Redis 和 Memcached 演示页执行 PHP。
    location ~ ^/(phpinfo|redis|memcached)\.php\$ {
        try_files \$uri =404;
        fastcgi_pass  unix:/run/php-fpm/php-cgi.sock;
        fastcgi_index index.php;
        include fastcgi.conf;
    }

    # default 根目录中的其它 PHP 文件返回 404，防止源码作为静态文件下载。
    # phpMyAdmin 使用独立的优先前缀 location，不受此规则影响。
    location ~ [^/]\.php(/|\$) {
        return 404;
    }

    location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)\$ {
        expires      30d;
    }

    location ~ .*\.(js|css)\$ {
        expires      12h;
    }

    location ^~ /.well-known/ {
        allow all;
    }

    location ~ /\. {
        deny all;
    }

    # 自定义配置--开始

    # 自定义配置--结束

    access_log  /home/wwwlogs/default.log main;
    error_log   /home/wwwlogs/default.error.log;
}

server {
    # 未匹配 SNI 的 HTTPS 请求在此终止。没有这个块时，443 上的第一个业务
    # 站点会成为隐式默认站点，IP 直连和错误 DNS 指向都会拿到它的响应。
    # 为 default 配置证书时，lnmp ssl add 会自动移除本块。
    listen 443 ssl default_server;
    #listen [::]:443 ssl default_server ipv6only=on;${quic_lines}
    ssl_reject_handshake on;
}
EOF
    echo "正在检查 Nginx 配置..."
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，已撤销刚补建的默认站点配置。"
        rm -f /usr/local/nginx/conf/vhost/default.conf
        return 1
    fi
    if pgrep -f '/usr/local/nginx/sbin/nginx' >/dev/null 2>&1 \
       && ! /usr/local/nginx/sbin/nginx -s reload; then
        Echo_Red "Nginx 重载失败，已撤销刚补建的默认站点配置。"
        rm -f /usr/local/nginx/conf/vhost/default.conf
        return 1
    fi
    Echo_Green " 已补建 default 兜底站点。"
    return 0
}

Add_VHost()
{
    Print_Default_Site_Intro
    domain=""
    while :;do
        Echo_Yellow "请输入域名(示例: www.example.com): "
        Read_Input domain "域名"
        Lower_Domain_Input domain
        Check_Domain_Name "${domain}" || continue
        Reject_Wildcard_Site "${domain}" || continue
        if [ "${domain}" = "default" ]; then
            # default 是内置兜底站点，仅在配置缺失时补建。
            Add_VHost_Default || return 1
            Echo_Green " default 站已安装，是默认兜底站，如需为其配置 SSL 证书，请执行 lnmp ssl add"
            return 0
        fi
        if [ -f "/usr/local/nginx/conf/vhost/${domain}.conf" ]; then
            Echo_Red "域名 ${domain} 已存在，请检查！"
            continue
        fi
        Check_Domain_Not_Taken "${domain}" || continue
        echo "您的域名：${domain}"
        break
    done

    moredomain=""
    while :;do
        Echo_Yellow "请输入更多域名(示例: example.com sub.example.com，直接回车跳过): "
        Read_Input moredomain "更多域名"
        Lower_Domain_Input moredomain
        [ -z "${moredomain}" ] && break
        Check_More_Domains "${moredomain}" || continue
        Check_More_Domains_Unique "${domain}" "${moredomain}" || continue
        Reject_Wildcard_Site "${moredomain}" || continue
        Check_Domain_Not_Taken "${moredomain}" || continue
        break
    done
    echo "域名列表：${domain} ${moredomain}"

    Site_Type_Menu || return 1
    Site_Preset_Menu || return 1
    enable_proxy="n"
    proxy_backend=""
    proxy_backend_host=""
    proxy_use_backend_host="n"
    proxy_backend_resolvable="y"
    if [ "${site_type}" == "proxy" ]; then
        Site_Proxy_Menu || return 1
    fi

    while :;do
        Echo_Yellow "请输入网站目录: $domain"
        echo
        Echo_Yellow "默认目录(直接回车使用): /home/wwwroot/${domain}"
        Read_Input vhostdir "网站目录"
        if [ "${vhostdir}" == "" ]; then
            vhostdir="/home/wwwroot/${domain}"
        fi
        # 目录会用于递归创建和授权，必须先规范化并限制在站点根目录内；
        # 校验通过后 Check_Vhost_Dir 会把规范化路径写回 vhostdir。
        Check_Vhost_Dir "${vhostdir}" && Site_Project_Dir && break
        Echo_Red "请重新输入网站目录。"
    done
    echo "虚拟主机目录：${vhostdir}"

    # 伪静态规则只用于 PHP 站点；程序预设把开关与规则名的默认值改为对应程序。
    if [ "${site_type}" != "php" ]; then
        allow_rewrite="n"
    elif [ "${site_preset}" == "none" ]; then
        Read_YN allow_rewrite "是否开启伪静态规则? (y/N，默认 n) " n "伪静态规则开关"
    else
        Read_YN allow_rewrite "是否开启伪静态规则? (Y/n，默认 y) " y "伪静态规则开关"
    fi
    if [ "${allow_rewrite}" == "n" ]; then
        rewrite="none"
    else
        echo "请输入程序对应的伪静态规则名，"
        echo "已内置的伪静态规则（直接输名字即可）："
        echo "  wordpress  wp2  typecho  typecho2  discuzx  dedecms  ecshop"
        echo "  drupal  joomla  thinkphp  laravel  codeigniter  yii2  zblog"
        echo "输入其它名字会在 /usr/local/nginx/conf/rewrite/ 下建一个空文件，规则需自己填。"
        # 规则名非法时在本问题处重问，不带着空值进入创建阶段。
        rewrite_default="other"
        [ "${site_preset}" == "none" ] || rewrite_default="${site_preset}"
        while :;do
            Echo_Yellow "(默认 ${rewrite_default}，直接回车使用): "
            Read_Input rewrite "伪静态规则名"
            if [ "${rewrite}" == "" ]; then
                rewrite="${rewrite_default}"
            fi
            Check_Config_Name "${rewrite}" "伪静态规则名" && break
        done
    fi
    echo "已选择伪静态规则：$([ "${rewrite}" = "none" ] && echo "无" || echo "${rewrite}")"

    # Pathinfo 仅适用于启用 PHP 的站点。
    if [ "${enable_site_php}" == "y" ]; then
        Read_YN enable_pathinfo "是否开启 PHP Pathinfo? (y/N，默认 n) " n "Pathinfo 开关"
        if [ "${enable_pathinfo}" == "n" ]; then
            echo "已禁用 PHP Pathinfo。"
        else
            echo "已启用 PHP Pathinfo。"
        fi
    else
        enable_pathinfo="n"
    fi

    Read_YN access_log "是否开启访问日志? (Y/n，默认 y) " y "访问日志开关"
    if [ "${access_log}" == "n" ]; then
        echo "已禁用访问日志。"
        al="access_log off;"
        al_name="${domain}"
    else
        while :;do
            Echo_Yellow "请输入访问日志文件名(默认: ${domain}.log，直接回车使用): "
            Read_Input al_name "访问日志文件名"
            if [ "${al_name}" == "" ]; then
                al_name="${domain}"
            fi
            Check_Config_Name "${al_name}" "访问日志文件名" && break
        done
        al="access_log  /home/wwwlogs/${al_name}.log main;"
        echo "访问日志文件名：${al_name}.log"
    fi

    Read_YN enable_ipv6 "是否开启 IPv6? (y/N，默认 n) " n "IPv6 开关"
    if [ "${enable_ipv6}" == "n" ]; then
        echo "当前虚拟主机已禁用 IPv6。"
    else
        echo "当前虚拟主机已启用 IPv6。"
    fi

    if [ "${enable_site_php}" == "y" ]; then
        Multiple_PHP_Select || return 1
    elif [ "${enable_proxy}" == "y" ]; then
        include_enable_php="$(Site_Proxy_Block)"
    else
        include_enable_php="$(Site_PHP_Off_Block)"
    fi

    if [[ -x /usr/local/mysql/bin/mysql || -x /usr/local/mariadb/bin/mariadb || -x /usr/local/mariadb/bin/mysql ]]; then
        if [ "${site_preset}" == "none" ]; then
            Read_YN create_database "是否创建同名数据库和 MySQL 用户? (y/N，默认 n) " n "建库开关"
        else
            Read_YN create_database "是否创建同名数据库和 MySQL 用户? (Y/n，默认 y) " y "建库开关"
        fi

        if [ "${create_database}" == "y" ]; then
            Verify_DB_Password || exit 1
            Add_Database_Menu || exit 1
        fi
    fi

    if [ -s /usr/local/pureftpd/sbin/pure-ftpd ]; then
        Read_YN create_ftp "是否创建 FTP 账号? (y/N，默认 n) " n "FTP 账号开关"

        if [ "${create_ftp}" == "y" ]; then
            Add_Ftp_Menu
        fi
    fi

    Read_YN create_ssl "是否添加 SSL 证书?（HTTP 验证，需 80 端口可从公网访问）(y/N，默认 n) " n "SSL 开关"
    if [ "${create_ssl}" == "y" ]; then
        Add_SSL_Menu
    fi

    Press_Any_Key_Or_Line "按任意键开始创建虚拟主机，或按 Ctrl+C 取消..." || return 1

    echo "正在创建虚拟主机目录..."
    # 记录目录是否由本次创建，配置失败时只回收本次新建的空目录。
    vhostdir_created="n"
    [ -d "${vhostdir}" ] || vhostdir_created="y"
    basedir_created="${vhostdir_created}"
    [ -d "${site_basedir}" ] && basedir_created="n"
    mkdir -p "${vhostdir}" || return 1
    # 只记录本次新建的日志文件，回滚时才删除，避免清掉已有站点的日志。
    access_log_created="n"
    if [ "${access_log}" == "y" ] && [ ! -e "/home/wwwlogs/${al_name}.log" ]; then
        if ! touch "/home/wwwlogs/${al_name}.log"; then
            Echo_Red "创建访问日志 /home/wwwlogs/${al_name}.log 失败，已放弃建站。"
            [ "${vhostdir_created}" = "y" ] && rmdir "${vhostdir}" 2>/dev/null
            [ "${basedir_created}" = "y" ] && rmdir "${site_basedir}" 2>/dev/null
            return 1
        fi
        access_log_created="y"
    fi
    echo "正在设置虚拟主机目录权限..."
    # 复用旧站点目录时其中可能有 immutable 的 .user.ini，递归授权会对该文件报
    # Operation not permitted；无论本次是否开启 PHP 都要先解除锁定。
    if [ -f "${vhostdir}/.user.ini" ]; then
        chattr -i "${vhostdir}/.user.ini" 2>/dev/null
    fi
    # 权限设置失败不阻断建站，但必须提示用户核对，否则 PHP 可能读不到站点文件。
    if ! Prepare_Vhost_Dir_Perm "${site_basedir}" "${basedir_created}"; then
        Echo_Yellow "站点目录权限或属主未完全设置，建站继续，请稍后核对 ${site_basedir}。"
        echo
    fi

    # .user.ini 仅用于启用 PHP 的站点，在站点配置写入并 reload 之前完成。
    # 生效的 open_basedir 由 fastcgi.conf 的 PHP_ADMIN_VALUE 提供，这里失败
    # 只少一层纵深防御，站点仍然可用，因此提示后继续建站。
    if [ "${enable_site_php}" != "n" ]; then
        if ! Write_Site_User_Ini "${vhostdir}" "${site_basedir}"; then
            Echo_Yellow "建站继续。FastCGI 层的 open_basedir 仍在，如需这层限制，"
            echo
            Echo_Yellow "请检查 ${vhostdir} 的权限后手工写入 .user.ini。"
            echo
        fi
        [ -x /etc/init.d/php-fpm ] && /etc/init.d/php-fpm reload
    fi

    # default 的 80 端口由内置 default_server 处理，避免重复监听。
    if [ "${domain}" != "default" ]; then
        if ! Add_VHost_Config; then
            # 目录由本次创建时其中只可能有本次写入的 .user.ini；该文件带 immutable，
            # 不先解除就删不掉，rmdir 也会因目录非空失败，把空站点留在磁盘上。
            if [ "${vhostdir_created}" = "y" ]; then
                if [ -f "${vhostdir}/.user.ini" ]; then
                    chattr -i "${vhostdir}/.user.ini" 2>/dev/null
                    rm -f "${vhostdir}/.user.ini"
                fi
                rmdir "${vhostdir}" 2>/dev/null
            fi
            [ "${basedir_created}" = "y" ] && rmdir "${site_basedir}" 2>/dev/null
            [ "${access_log_created}" = "y" ] && rm -f "/home/wwwlogs/${al_name}.log"
            return 1
        fi
    fi

    if [ "${create_database}" == "y" ]; then
        Add_Database
        database_add_rc=$?
        # 建库完成后立即清理数据库 root 凭据，缩短明文凭据的留存时间。
        TempMycnf_Clean
    fi

    if [ "${create_ftp}" == "y" ]; then
        # FTP 根为项目目录，Laravel 预设下不是网站根目录。
        vhostdir="${site_basedir}" Add_Ftp
        ftp_add_rc=$?
    fi

    if [ "${create_ssl}" == "y" ]; then
        Add_SSL
        ssl_add_rc=$?
    fi

    # 经本机 Web 入口实际请求本站点，确认请求到达站点目录及对应的 PHP 或反代上游。
    local accept_rc=0 accept_ver
    if [ "${domain}" = "default" ]; then
        :
    elif [ "${enable_site_php}" == "y" ]; then
        accept_ver=$(printf '%s' "${include_enable_php}" | sed -n 's/.*enable-php\([0-9][0-9.]*[0-9]\)[-.].*/\1/p')
        [ -n "${accept_ver}" ] || accept_ver=$(/usr/local/php/bin/php-config --version 2>/dev/null)
        Vhost_Accept "${domain}" "${vhostdir}" php "${accept_ver}" || accept_rc=1
    elif [ "${enable_proxy}" == "y" ]; then
        Vhost_Accept "${domain}" "${vhostdir}" proxy || accept_rc=1
    else
        Vhost_Accept "${domain}" "${vhostdir}" static || accept_rc=1
    fi

    Echo_Green "================================================"
    echo "虚拟主机信息："
    echo "域名：${domain}"
    echo "网站目录：${vhostdir}"
    [ "${site_basedir}" != "${vhostdir}" ] && echo "项目目录：${site_basedir}（open_basedir 范围）"
    [ "${site_preset}" != "none" ] && echo "程序预设：${site_preset}"
    echo "伪静态规则：$([ "${rewrite}" = "none" ] && echo "无" || echo "${rewrite}")"
    if [ "${enable_site_php}" == "n" ]; then
        if [ "${enable_proxy}" == "y" ]; then
            echo "PHP：未开启（整站反代，.php 由后端处理）"
        else
            echo "PHP：未开启（.php 请求一律返回 404）"
        fi
    else
        echo "PHP：已开启"
    fi
    if [ "${enable_proxy}" == "y" ]; then
        echo "反向代理：${proxy_backend}"
    fi
    if [ "${access_log}" == "y" ]; then
        echo "访问日志：已启用"
    else
        echo "访问日志：未启用"
    fi

    if [ "${create_database}" == "y" ]; then
        if [ "${database_add_rc:-1}" -eq 0 ]; then
            echo "数据库用户名：${database_name}"
            echo "数据库名：${database_name}"
            echo "数据库密码：刚才输入的密码（不回显）"
        else
            Echo_Red "Database: 创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp database add 单独重试建库。"
        fi
    else
        echo "创建数据库：否"
    fi
    if [ "${create_ftp}" == "y" ]; then
        if [ "${ftp_add_rc:-1}" -eq 0 ]; then
            echo "FTP 账号：${ftp_account_name}"
            echo "FTP 密码：刚才输入的密码（不回显）"
        else
            Echo_Red "FTP: 账号创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp ftp add 单独重试。"
        fi
    elif [ -s /usr/local/pureftpd/sbin/pure-ftpd ]; then
        # 仅在已安装 Pure-FTPd 时显示 FTP 创建结果。
        echo "创建 FTP 账号：否"
    fi
    if [ "${create_ssl}" == "y" ]; then
        if [ "${ssl_add_rc:-1}" -eq 0 ]; then
            echo "SSL：已启用"
            if [ "${ssl_choice}" == "1" ]; then
                echo "  =>自有证书文件"
            elif [ "${ssl_choice}" == "2" ]; then
                echo "  =>Let's Encrypt"
            elif [ "${ssl_choice}" == "3" ]; then
                echo "  =>ZeroSSL"
            fi
        else
            Echo_Red "SSL: 证书添加失败，站点本身已建好，当前只有 HTTP。"
            Echo_Red "可稍后执行 lnmp ssl add 单独重试。"
        fi
    fi
    if [ "${enable_ipv6}" == "y" ]; then
        echo "IPv6：已启用"
    else
        echo "IPv6：未启用"
    fi
    Echo_Green "================================================"

    # 站点主体已建成，但用户明确请求过的附加操作有失败时返回非零，
    # 否则上层自动化会把未完成的站点当作已交付。
    if [ "${create_database}" == "y" ] && [ "${database_add_rc:-1}" -ne 0 ]; then
        return 1
    fi
    if [ "${create_ftp}" == "y" ] && [ "${ftp_add_rc:-1}" -ne 0 ]; then
        return 1
    fi
    if [ "${create_ssl}" == "y" ] && [ "${ssl_add_rc:-1}" -ne 0 ]; then
        return 1
    fi
    if [ "${accept_rc}" -ne 0 ]; then
        Echo_Red "站点配置已生成，但请求验收未通过，请按上面的提示处理后访问确认。"
        return 1
    fi
    return 0
}

List_VHost()
{
    echo "Nginx 虚拟主机列表："
    List_VHost_Dir /usr/local/nginx/conf/vhost
}

# Vhost_Entry_Conf <域名>：单站点启停改动的入口配置，输出 类型<TAB>路径。
Vhost_Entry_Conf()
{
    printf 'nginx\t%s\n' "/usr/local/nginx/conf/vhost/$1.conf"
}

Del_VHost()
{
    domain="$1"
    if [ -n "${domain}" ]; then
        Lower_Domain_Input domain
        # 域名会组成待删除的配置文件路径，因此必须先限制字符集。
        Check_Domain_Name "${domain}" || exit 1
        Reject_Default_Site_Del "${domain}" || exit 1
    else
        echo "======================================="
        echo "当前虚拟主机："
        List_VHost
        echo "======================================="
        while :;do
            Echo_Yellow "请输入要删除的域名: "
            Read_Input domain "域名"
            Lower_Domain_Input domain
            # 域名会组成待删除的配置文件路径，因此必须先限制字符集。
            Check_Domain_Name "${domain}" || continue
            Reject_Default_Site_Del "${domain}" || continue
            break
        done
    fi
    if [ ! -f "/usr/local/nginx/conf/vhost/${domain}.conf" ]; then
        echo "=========================================="
        echo "域名 ${domain} 不存在。"
        echo "=========================================="
        exit 1
    else
        Del_VHost_Files "${domain}" || exit 1

        echo "========================================================"
        echo "域名 ${domain} 已删除。"
        echo "为安全起见，网站文件不会被自动删除。"
        echo "如需清理，请手动删除对应网站文件。"
        echo "========================================================"
    fi
}

# 先备份再删除，语法检查或重载失败时整体回滚。
# 站点配置与 .user.ini 必须同进同退：只删掉一半会让磁盘状态与运行配置分离，
# 人工修复时还会连带丢失 open_basedir 限制。
Del_VHost_Files()
{
    local domain="$1"
    local vhost_conf="/usr/local/nginx/conf/vhost/${domain}.conf"
    local vhostdir user_ini='' conf_backup ini_backup=''

    vhostdir=$(awk '/^[[:space:]]*root[[:space:]]/ {gsub(/;/,"",$2); print $2; exit}' \
               "${vhost_conf}" 2>/dev/null)
    if [ -n "${vhostdir}" ] && [ -f "${vhostdir}/.user.ini" ]; then
        user_ini="${vhostdir}/.user.ini"
    fi

    LNMP_Tmp_Init || return 1
    conf_backup=$(LNMP_Mktemp del-vhost) || return 1
    if ! \cp -p "${vhost_conf}" "${conf_backup}"; then
        rm -f "${conf_backup}"
        Echo_Red "备份 ${vhost_conf} 失败，未删除任何文件。"
        return 1
    fi
    if [ -n "${user_ini}" ]; then
        ini_backup=$(LNMP_Mktemp del-userini) || { rm -f "${conf_backup}"; return 1; }
        if ! \cp -p "${user_ini}" "${ini_backup}"; then
            rm -f "${conf_backup}" "${ini_backup}"
            Echo_Red "备份 ${user_ini} 失败，未删除任何文件。"
            return 1
        fi
    fi

    if [ -n "${user_ini}" ]; then
        chattr -i "${user_ini}" 2>/dev/null
        rm -f "${user_ini}"
        echo "已移除 ${user_ini}（先解除 immutable 属性）"
    fi
    rm -f "${vhost_conf}"

    # 删除配置后需要先通过语法检查再重载，才能使运行中的站点下线。
    if ! Del_VHost_Reload_Nginx; then
        Del_VHost_Restore "${domain}" "${vhost_conf}" "${conf_backup}" "${user_ini}" "${ini_backup}"
        rm -f "${conf_backup}" "${ini_backup}"
        return 1
    fi

    # 站点已下线，此时扫描剩余站点才能判断证书是否还有人引用。
    Report_Vhost_Cert_Residue "${conf_backup}"
    rm -f "${conf_backup}" "${ini_backup}"
    return 0
}

# 回滚删站，使磁盘状态与运行中的配置重新一致。
# .user.ini 需要恢复权限和 immutable 属性，否则站点隔离会静默失效。
Del_VHost_Restore()
{
    local domain="$1" vhost_conf="$2" conf_backup="$3" user_ini="$4" ini_backup="$5"

    \cp -p "${conf_backup}" "${vhost_conf}"
    if [ -n "${user_ini}" ] && [ -n "${ini_backup}" ]; then
        \cp -p "${ini_backup}" "${user_ini}"
        chmod 644 "${user_ini}"
        chattr +i "${user_ini}" 2>/dev/null
    fi
    Echo_Yellow "已恢复站点 ${domain} 的配置文件，站点仍然存在。"

    # 恢复后尽力让运行配置与磁盘一致；此处失败不改变删站已失败的结论。
    if pgrep -f '/usr/local/nginx/sbin/nginx' >/dev/null 2>&1; then
        /usr/local/nginx/sbin/nginx -t >/dev/null 2>&1 \
            && /usr/local/nginx/sbin/nginx -s reload >/dev/null 2>&1
    fi
}

Del_VHost_Reload_Nginx()
{
    # 语法检查不依赖服务是否在运行，删完必须校验，否则会把未验证的结果报成成功。
    echo "正在检查 Nginx 配置......"
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，未执行 reload。"
        return 1
    fi

    if ! pgrep -f '/usr/local/nginx/sbin/nginx' >/dev/null 2>&1; then
        echo "Nginx 未在运行，跳过 reload。"
        return 0
    fi

    echo "正在重载 Nginx......"
    if ! /usr/local/nginx/sbin/nginx -s reload; then
        Echo_Red "Nginx reload 失败，运行中的 Nginx 仍在提供该站点。"
        return 1
    fi
    return 0
}

