Add_VHost()
{
    domain=""
    while :;do
        Echo_Yellow "Please enter domain(example: www.example.com): "
        Read_Input domain "域名"
        Check_Domain_Name "${domain}" || continue
        if [ "${domain}" = "default" ]; then
            # default 是默认站点的保留名，不建独立 vhost 配置。
            # 这里明确它意味着什么，避免用户以为自己建了个叫 default 的域名站点。
            Echo_Yellow " 'default' 是默认站点的保留名：根目录 /home/wwwroot/default，"
            Echo_Yellow " 通过服务器 IP 直接访问，没有域名。"
            Echo_Yellow " 稍后若选择添加 SSL 证书，会自动转为 **IP 地址证书** 流程"
            Echo_Yellow " （Let's Encrypt 的 shortlived profile，有效期约 6 天，依赖自动续期）。"
            Echo_Yellow " 如果你其实是想建一个有域名的站点，请按 Ctrl+C 退出后重新输入域名。"
        fi
        if [ -f "/usr/local/nginx/conf/vhost/${domain}.conf" ]; then
            Echo_Red " ${domain} is exist,please check!"
            exit 1
        fi
        echo " Your domain: ${domain}"
        break
    done

    while :;do
        Echo_Yellow "Enter more domain name(example: example.com sub.example.com): "
        read moredomain
        [ -z "${moredomain}" ] && break
        Check_More_Domains "${moredomain}" && break
    done
    echo " domain list: ${domain} ${moredomain}"

    while :;do
        Echo_Yellow "Please enter the directory for the domain: $domain"
        echo
        Echo_Yellow "Default directory: /home/wwwroot/${domain}: "
        read vhostdir
        if [ "${vhostdir}" == "" ]; then
            vhostdir="/home/wwwroot/${domain}"
        fi
        # 目录随后会交给 mkdir -p / chown -R，先规范化并限制在允许的站点根下
        Check_Vhost_Dir "${vhostdir}" || exit 1
        # Check_Vhost_Dir 通过时会把规范化后的路径写回 vhostdir
        Check_Vhost_Dir "${vhostdir}" && break
    done
    echo "Virtual Host Directory: ${vhostdir}"

    Echo_Yellow "Allow Rewrite rule? (y/n) "
    read allow_rewrite
    if [[ "${allow_rewrite}" == "n" || "${allow_rewrite}" == "" ]]; then
        rewrite="none"
    elif [ "${allow_rewrite}" == "y" ]; then
        rewrite="other"
        echo "Please enter the rewrite of programme, "
        echo "已内置的伪静态规则（直接输名字即可）："
        echo "  wordpress  wp2  typecho  typecho2  discuzx  dedecms  ecshop"
        echo "  drupal  joomla  thinkphp  laravel  codeigniter  yii2  zblog"
        echo "输入其它名字会在 /usr/local/nginx/conf/rewrite/ 下建一个空文件，规则需自己填。"
        Echo_Yellow "(Default rewrite: other): "
        read rewrite
        if [ "${rewrite}" == "" ]; then
            rewrite="other"
        fi
    fi
    echo "You choose rewrite: ${rewrite}"

    Echo_Yellow "Enable PHP Pathinfo? (y/n) "
    read enable_pathinfo
    if [[ "${enable_pathinfo}" == "n" || "${enable_pathinfo}" == "" ]]; then
        echo "Disable pathinfo."
        enable_pathinfo="n"
    elif [ "${enable_pathinfo}" == "y" ]; then
        echo "Enable pathinfo."
        enable_pathinfo="y"
    fi

    Echo_Yellow "Allow access log? (y/n) "
    read access_log
    if [[ "${access_log}" == "n" || "${access_log}" == "" ]]; then
        echo "Disable access log."
        al="access_log off;"
    else
        Echo_Yellow "Enter access log filename(Default:${domain}.log): "
        read al_name
        if [ "${al_name}" == "" ]; then
            al_name="${domain}"
        fi
        al="access_log  /home/wwwlogs/${al_name}.log;"
        echo "You access log filename: ${al_name}.log"
    fi

    Echo_Yellow "Enable IPv6? (y/n) "
    read enable_ipv6
    if [[ "${enable_ipv6}" == "n" || "${enable_ipv6}" == "" ]]; then
        echo "Disabled IPv6 Support in current Virtualhost."
        enable_ipv6="n"
    else
        echo "Enabled IPv6 Support in current Virtualhost."
        enable_ipv6="y"
    fi

    Multiple_PHP_Select

    if [[ -s /usr/local/mysql/bin/mysql || -s /usr/local/mariadb/bin/mysql ]]; then
        Echo_Yellow "Create database and MySQL user with same name (y/n) "
        read create_database

        if [ "${create_database}" == "y" ]; then
            Verify_DB_Password
            Add_Database_Menu
        fi
    fi

    if [ -s /usr/local/pureftpd/sbin/pure-ftpd ]; then
        Echo_Yellow "Create ftp account (y/n) "
        read create_ftp

        if [ "${create_ftp}" == "y" ]; then
            Add_Ftp_Menu
        fi
    fi

    Echo_Yellow "Add SSL Certificate (y/n) "
    read create_ssl
    if [ "${create_ssl}" == "y" ]; then
        Add_SSL_Menu
    fi

    echo ""
    echo "Press any key to start create virtul host..."
    OLDCONFIG=`stty -g`
    stty -icanon -echo min 1 time 0
    dd count=1 2>/dev/null
    stty ${OLDCONFIG}

    echo "Create Virtul Host directory......"
    mkdir -p "${vhostdir}"
    if [ "${access_log}" == "y" ]; then
        touch /home/wwwlogs/${al_name}.log
    fi
    echo "set permissions of Virtual Host directory......"
    chmod -R 755 "${vhostdir}"
    chown -R www:www "${vhostdir}"

    Add_VHost_Config

    # 重建同名站点时旧的 .user.ini 可能还在，且带着 immutable 属性。
    # 不先解除，下面的重定向会以 "Operation not permitted" 失败，
    # 同时更新 open_basedir，避免站点目录变更后仍限制在旧路径。
    [ -f "${vhostdir}/.user.ini" ] && chattr -i "${vhostdir}/.user.ini" 2>/dev/null
    cat >"${vhostdir}/.user.ini"<<EOF
open_basedir=${vhostdir}:/tmp/:/proc/
EOF
    chmod 644 "${vhostdir}/.user.ini"
    chattr +i "${vhostdir}/.user.ini"

    /etc/init.d/php-fpm reload

    if [ "${create_database}" == "y" ]; then
        Add_Database
    fi

    if [ "${create_ftp}" == "y" ]; then
        Add_Ftp
    fi

    if [ "${create_ssl}" == "y" ]; then
        Add_SSL
    fi

    Echo_Green "================================================"
    echo "Virtualhost infomation:"
    echo "Your domain: ${domain}"
    echo "Home Directory: ${vhostdir}"
    echo "Rewrite: ${rewrite}"
    if [ "${access_log}" == "n" ]; then
        echo "Enable log: no"
    else
        echo "Enable log: yes"
    fi

    if [ "${create_database}" == "y" ]; then
        echo "Database username: ${database_name}"
        echo "Database Name: ${database_name}"
        echo "Database userpassword: (你刚输入的那个，不回显)"
    else
        echo "Create database: no"
    fi
    if [ "${create_ftp}" == "y" ]; then
        echo "FTP account name: ${ftp_account_name}"
        echo "FTP account password: (你刚输入的那个，不回显)"
    else
        echo "Create ftp account: no"
    fi
    if [ "${create_ssl}" == "y" ]; then
        echo "Enable SSL: yes"
        if [ "${ssl_choice}" == "1" ]; then
            echo "  =>Certificate file"
        elif [ "${ssl_choice}" == "2" ]; then
            echo "  =>Let's Encrypt"
        elif [ "${ssl_choice}" == "3" ]; then
            echo "  =>BuyPass"
        elif [ "${ssl_choice}" == "4" ]; then
            echo "  =>ZeroSSL"
        fi
    fi
    if [ "${enable_ipv6}" == "y" ]; then
        echo "IPv6 Support: Enabled"
    else
        echo "IPv6 Support: Disabled"
    fi
    Echo_Green "================================================"
}

List_VHost()
{
    echo "Nginx Virtualhost list:"
    ls /usr/local/nginx/conf/vhost/ | grep ".conf$" | sed 's/.conf//g'
}

Del_VHost()
{
    echo "======================================="
    echo "Current Virtualhost:"
    List_VHost
    echo "======================================="
    domain=""
    while :;do
        Echo_Yellow "Please enter domain you want to delete: "
        Read_Input domain "域名"
        # 这个值会拼成 .../vhost/<域名>.conf 并被 rm 掉，同样要先约束字符集
        Check_Domain_Name "${domain}" || continue
        break
    done
    if [ ! -f "/usr/local/nginx/conf/vhost/${domain}.conf" ]; then
        echo "=========================================="
        echo "Domain: ${domain} was not exist!"
        echo "=========================================="
        exit 1
    else

        vhostdir=$(awk '/^[[:space:]]*root[[:space:]]/ {gsub(/;/,"",$2); print $2; exit}' \
                   "/usr/local/nginx/conf/vhost/${domain}.conf" 2>/dev/null)
        if [ -n "${vhostdir}" ] && [ -f "${vhostdir}/.user.ini" ]; then
            chattr -i "${vhostdir}/.user.ini" 2>/dev/null
            rm -f "${vhostdir}/.user.ini"
            echo "已移除 ${vhostdir}/.user.ini（先解除 immutable 属性）"
        fi
        rm -f /usr/local/nginx/conf/vhost/${domain}.conf

        # 删掉配置文件不等于站点下线：运行中的 nginx 用的是已加载的配置，
        # 不 reload 就会继续对外提供这个站点，而命令已经报告"已删除"。
        # 与 Add_VHost_Config 一样，先 nginx -t 再 reload；任一步失败都返回非零，
        # 并说清楚线上配置还没切换。
        Del_VHost_Reload_Nginx || exit 1

        echo "========================================================"
        echo "Domain: ${domain} has been deleted."
        echo "Website files will not be deleted for security reasons."
        echo "You need to manually delete the website files."
        echo "========================================================"
    fi
}

Del_VHost_Reload_Nginx()
{
    if ! pgrep -f '/usr/local/nginx/sbin/nginx' >/dev/null 2>&1; then
        echo "Nginx 未在运行，跳过 reload。"
        return 0
    fi

    echo "Test Nginx configure file......"
    if ! /usr/local/nginx/sbin/nginx -t; then
        Echo_Red "Nginx 配置测试未通过，未执行 reload。"
        Echo_Red "站点配置文件已删除，但运行中的 Nginx 仍在提供该站点。"
        Echo_Red "请修复配置后执行：lnmp nginx reload"
        return 1
    fi
    echo "Reload Nginx......"
    if ! /usr/local/nginx/sbin/nginx -s reload; then
        Echo_Red "Nginx reload 失败，运行中的 Nginx 仍在提供该站点，请手工处理。"
        return 1
    fi
    return 0
}

