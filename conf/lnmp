    echo "Error: You must be root to run this script!"
    exit 1
else
    if env |grep -q SUDO; then
        acme_sh_sudo="-f"
    fi
fi

echo "+-------------------------------------------+"
echo "|    Manager for LNMP, Written by Licess    |"
echo "+-------------------------------------------+"
echo "|              https://lnmp.org             |"
echo "+-------------------------------------------+"

PHPFPMPIDFILE=/usr/local/php/var/run/php-fpm.pid

# 数据库服务名。安装 MariaDB 时由 include/end.sh 的 Startup_DB 改成 mariadb，
# 不装数据库时改成空值（Svc 遇到空服务名直接跳过）。
DB_SERVICE=mysql

arg1=$1
arg2=$2

# ---------------------------------------------------------------------------
# Svc <服务名> <动作> — lnmp 命令与 systemd 共用同一条启停路径
#
# 原实现一律直调 /etc/init.d/<服务>。装机时服务是由 systemctl 拉起来的，
# 一旦执行过 lnmp restart，新进程就跑在 systemd 之外，unit 立刻变成 failed：
#
#   lnmp restart          → 返回 0，网站也正常
#   systemctl is-active nginx php-fpm → 都是 failed
#
# 于是 systemctl stop/restart、开机自启和一切基于 unit 状态的监控全部失真。
# 现在有 systemd 且本包装过对应 unit 时走 systemctl，否则才退回 SysV 脚本。
# configtest / force-quit / kill 这些 systemd 里没有的动作始终走 SysV 脚本。
# ---------------------------------------------------------------------------
Svc()
{
    local service="$1" action="$2"

    [ -z "${service}" ] && return 0

    case "${action}" in
    start|stop|restart|reload|status)
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1 \
           && [ -s "/etc/systemd/system/${service}.service" ]; then
            systemctl --no-pager ${action} ${service}.service
            return $?
        fi
        ;;
    esac

    if [ -x "/etc/init.d/${service}" ]; then
        /etc/init.d/${service} ${action}
        return $?
    fi
    echo "${service}: 既没有 systemd unit 也没有 /etc/init.d 脚本，跳过。"
    return 1
}

# 启停结束后核对 unit 状态。命令自己返回 0 不代表 systemd 那边也对得上，
# 这里把对不上的服务显式点出来，而不是留给下一次故障恢复时才发现。
Check_Svc_State()
{
    local service failed=''

    [ -d /run/systemd/system ] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0

    for service in "$@"; do
        [ -z "${service}" ] && continue
        [ -s "/etc/systemd/system/${service}.service" ] || continue
        systemctl is-active --quiet ${service}.service || failed="${failed} ${service}"
    done

    [ -z "${failed}" ] && return 0
    echo "警告：以下服务的 systemd 状态不是 active：${failed}"
    echo "      若进程其实还在跑，说明它被 systemd 之外的方式启动过；"
    echo "      执行 lnmp kill 后再 lnmp start，可让两边重新对齐。"
    return 1
}

lnmp_start()
{
    echo "Starting LNMP..."
    Svc nginx start
    Svc "${DB_SERVICE}" start
    Svc php-fpm start
    for mphpfpm in /etc/init.d/php-fpm[5,7,8].[0-9]
    do
        if [ -f ${mphpfpm} ]; then
            ${mphpfpm} start
        fi
    done
    Check_Svc_State nginx "${DB_SERVICE}" php-fpm
}

lnmp_stop()
{
    echo "Stoping LNMP..."
    Svc nginx stop
    Svc "${DB_SERVICE}" stop
    Svc php-fpm stop
    for mphpfpm in /etc/init.d/php-fpm[5,7,8].[0-9]
    do
        if [ -f ${mphpfpm} ]; then
            ${mphpfpm} stop
        fi
    done
}

lnmp_reload()
{
    echo "Reload LNMP..."
    Svc nginx reload
    Svc "${DB_SERVICE}" reload
    Svc php-fpm reload
    for mphpfpm in /etc/init.d/php-fpm[5,7,8].[0-9]
    do
        if [ -f ${mphpfpm} ]; then
            ${mphpfpm} reload
        fi
    done
}

lnmp_kill()
{
    echo "Kill nginx,php-fpm,mysql process..."
    killall nginx
    killall mysqld
    killall php-fpm
    killall php-cgi
    echo "done."
}

lnmp_status()
{
    Svc nginx status
    if [ -f $PHPFPMPIDFILE ]; then
        echo "php-fpm is runing!"
    else
        echo "php-fpm is stop!"
    fi
    Svc "${DB_SERVICE}" status

    # phpMyAdmin 的访问路径是安装时随机生成的，在这里回显，省得去翻安装日志
    if [ -s /usr/local/phpmyadmin/.access_url ]; then
        echo "phpMyAdmin: http://<服务器IP>/$(cat /usr/local/phpmyadmin/.access_url)/"
    fi
}

