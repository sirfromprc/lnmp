# lnmp ssl add 只给已经存在的虚拟主机添加证书。站点参数从现有配置读取，
# 不再重复询问目录、伪静态、日志、Pathinfo 和 IPv6 等建站选项。
Add_SSL_Only_Info_Menu()
{
    local vhost_conf

    domain=""
    while :;do
        Echo_Yellow "请输入域名（示例：www.example.com）: "
        Read_Input domain "域名"
        Check_Domain_Name "${domain}" || continue
        echo "您的域名：${domain}"
        break
    done

    vhost_conf="/usr/local/nginx/conf/vhost/${domain}.conf"
    if [ ! -s "${vhost_conf}" ]; then
        Echo_Red "未找到网站 ${domain} 的虚拟主机配置。"
        Echo_Yellow "请先执行 lnmp vhost add 创建网站，再执行 lnmp ssl add 添加证书。"
        echo
        return 1
    fi
    if grep -Eq '^[[:space:]]*listen[[:space:]][^;]*443[^;]*ssl' "${vhost_conf}"; then
        Echo_Red "网站 ${domain} 已存在 HTTPS/443 配置，不能重复执行 ssl add。"
        Echo_Yellow "如需更换证书，请先检查并处理现有 SSL 配置。"
        echo
        return 1
    fi

    vhostdir=$(awk '$1 == "root" { value=$2; sub(/;$/, "", value); print value; exit }' "${vhost_conf}")
    if [ -z "${vhostdir}" ] || [ ! -d "${vhostdir}" ]; then
        Echo_Red "网站 ${domain} 的根目录不存在或无法从 ${vhost_conf} 读取。"
        return 1
    fi

    moredomain=$(awk -v primary="${domain}" '
        $1 == "server_name" {
            out=""
            for (i=2; i<=NF; i++) {
                value=$i
                sub(/;$/, "", value)
                if (value != primary && value != "_") {
                    if (out != "") out=out " "
                    out=out value
                }
            }
            print out
            exit
        }
    ' "${vhost_conf}")

    rewrite=$(awk '$1 == "include" && $2 ~ /^rewrite\/[^;]+\.conf;$/ { value=$2; sub(/^rewrite\//, "", value); sub(/\.conf;$/, "", value); print value; exit }' "${vhost_conf}")
    rewrite="${rewrite:-none}"
    include_enable_php=$(awk '$1 == "include" && $2 ~ /^enable-php[^;]*\.conf;$/ { print "include " $2; exit }' "${vhost_conf}")
    al=$(awk '$1 == "access_log" { sub(/^[[:space:]]*/, ""); print; exit }' "${vhost_conf}")
    al="${al:-access_log off;}"
    if grep -Eq '^[[:space:]]*listen[[:space:]]+\[::\]:80' "${vhost_conf}"; then
        enable_ipv6="y"
    else
        enable_ipv6="n"
    fi

    return 0
}

