# ---------------------------------------------------------------------------
# 凭据和临时文件处理约束：
#   1. 临时文件使用 root 专属目录和不可预测名称；
#   2. 凭据不得写入终端日志；
#   3. SQL 字符串必须转义，标识符必须通过白名单校验。
# ---------------------------------------------------------------------------

# root 专属临时目录，退出时统一清理。
LNMP_Tmp_Dir=""
LNMP_Mktemp()
{
    if [ -z "${LNMP_Tmp_Dir}" ]; then
        LNMP_Tmp_Dir=$(mktemp -d /tmp/.lnmp-adm.XXXXXXXX) || exit 1
        chmod 700 "${LNMP_Tmp_Dir}"
        trap 'rm -rf "${LNMP_Tmp_Dir}"' EXIT INT TERM
    fi
    mktemp "${LNMP_Tmp_Dir}/$1.XXXXXXXX"
}

# MySQL 单引号字符串的转义：先转反斜杠，再转单引号（顺序不能反，
# 否则会把上一步加进去的转义符再转一遍）。
Sql_Quote()
{
    local v="$1"
    v="${v//\\/\\\\}"
    v="${v//\'/\\\'}"
    printf '%s' "${v}"
}

# 库名 / 用户名走白名单，不做转义。
#
# 标识符（反引号里的东西）没有可靠的通用转义方式，而 MySQL 的库名和用户名
# 本来就只该用这些字符。与其想办法转义，不如直接拒绝越界的输入。
Check_DB_Identifier()
{
    case "$1" in
    ''|*[!A-Za-z0-9_]*)
        Echo_Red "名称 '$1' 不合法：只允许字母、数字和下划线，且不能为空。"
        return 1
        ;;
    esac
    if [ ${#1} -gt 32 ]; then
        Echo_Red "名称过长（超过 32 字符）。"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# 输入边界：域名用于配置文件名和配置内容，站点目录用于递归权限操作。
# 相关输入必须通过格式、元字符和允许目录范围检查。
# ---------------------------------------------------------------------------

# 单个 DNS 名：标签由字母数字和连字符组成，点分隔，可带前导 *. 泛域名。
# 拒绝路径分隔符、空白和配置元字符。
# ---------------------------------------------------------------------------
# Read_Input：检测 EOF，防止非交互输入耗尽后校验循环空转。
# ---------------------------------------------------------------------------
Read_Input()
{
    local __var="$1" __what="${2:-输入}"
    if ! read -r "${__var}"; then
        echo
        Echo_Red "读取${__what}时遇到 EOF —— 标准输入已经没有内容了。"
        Echo_Red "若你用管道或重定向提供输入，请核对输入项的数量与顺序："
        Echo_Red "少喂一项就会走到这里。交互执行本命令则不会有此问题。"
        exit 1
    fi
}

# Read_Secret — 同上，用于不回显的密码输入
Read_Secret()
{
    local __var="$1" __what="${2:-密码}"
    if ! read -r -s "${__var}"; then
        echo
        Echo_Red "读取${__what}时遇到 EOF —— 标准输入已经没有内容了。"
        exit 1
    fi
}

Check_Domain_Name()
{
    local d="$1"
    if [ -z "${d}" ]; then
        Echo_Red "域名不能为空。"
        return 1
    fi

    if [ "${d}" = "default" ]; then
        return 0
    fi
    if [ ${#d} -gt 253 ]; then
        Echo_Red "域名过长（超过 253 字符）：${d}"
        return 1
    fi
    # 去掉可能的泛域名前缀再校验主体
    case "${d}" in
    \*.*) d="${d#\*.}" ;;
    esac
    if ! printf '%s' "${d}" \
        | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$'; then
        Echo_Red "域名不合法：'$1'"
        Echo_Red "只接受形如 example.com / www.example.com / *.example.com 的名字，"
        Echo_Red "不接受路径分隔符、空白以及 ; { } \$ 等配置元字符。"
        return 1
    fi
    return 0
}

# 附加域名是空格分隔的一串，逐个校验，有一个不合法就整体拒绝
Check_More_Domains()
{
    local d
    for d in $1; do
        Check_Domain_Name "${d}" || return 1
    done
    return 0
}

# 站点目录：必须是绝对路径、规范化后仍落在允许的根之下、不含空白与元字符。
#
# 允许的根默认是 /home、/var/www、/srv、/data、/www 这几处常见位置，
# 外加 lnmp.conf 里配的 Default_Website_Dir 的父目录。
# 拒绝 /、/usr、/etc 等系统目录，避免对其执行 chmod -R 或 chown -R
# 是不可逆的破坏。
Check_Vhost_Dir()
{
    local d="$1" norm root ok='n'
    local matched_root='' rest probe comp resolved rroot

    if [ -z "${d}" ]; then
        Echo_Red "目录不能为空。"
        return 1
    fi
    case "${d}" in
    /*) : ;;
    *)
        Echo_Red "目录必须是绝对路径：'${d}'"
        return 1
        ;;
    esac
    if printf '%s' "${d}" | grep -Eq '[[:space:]`$;&|<>*?"'"'"'\\]'; then
        Echo_Red "目录名含空白或 shell 元字符，拒绝：'${d}'"
        return 1
    fi

    # 规范化（不要求已存在），把 .. 和多余的 / 折掉
    norm=$(printf '%s' "${d}" | sed -e 's#/\+#/#g' -e 's#/\./#/#g' -e 's#/$##')
    case "${norm}" in
    *..*)
        Echo_Red "目录不能包含 .. ：'${d}'"
        return 1
        ;;
    esac

    for root in /home /var/www /srv /data /www; do
        case "${norm}/" in
        "${root}"/*) ok='y'; matched_root="${root}"; break ;;
        esac
    done
    if [ "${ok}" != 'y' ]; then
        Echo_Red "目录 '${norm}' 不在允许的站点根之下。"
        Echo_Red "允许：/home /var/www /srv /data /www"
        Echo_Red "（限制它是因为随后要对该目录执行 chmod -R / chown -R，"
        Echo_Red "  打到 / 或 /usr 上是不可逆的。）"
        return 1
    fi

    # 允许根本身不能直接当站点目录。上面的匹配对 "/home" 也会成立
    # （模式 /home/* 里的 * 可以匹配空），而 chown -R www:www /home
    # 会把所有用户的家目录一起改掉。至少要深一层。
    if [ "${norm}" = "${matched_root}" ]; then
        Echo_Red "不能直接用 '${norm}' 作为站点目录，请在它下面建子目录。"
        Echo_Red "（随后的 chown -R 会作用于整个目录树。）"
        return 1
    fi

    # ---------------------------------------------------------------------
    # 逐级检查路径组件，任一为符号链接即拒绝。
    #
    # 从允许根的下一层开始逐级检查，防止中间路径组件通过符号链接越界。
    # 允许根本身可由管理员配置为符号链接。
    # ---------------------------------------------------------------------
    rest="${norm#${matched_root}/}"
    probe="${matched_root}"
    while [ -n "${rest}" ]; do
        comp="${rest%%/*}"
        if [ "${comp}" = "${rest}" ]; then rest=''; else rest="${rest#*/}"; fi
        probe="${probe}/${comp}"
        if [ -L "${probe}" ]; then
            Echo_Red "路径组件 '${probe}' 是符号链接，拒绝作为站点目录。"
            Echo_Red "（递归改权限会跟着链接跑到目录树之外去。）"
            return 1
        fi
    done

    # 再用 realpath 交叉确认一次：解析掉所有符号链接后仍须落在允许根之下。
    # 允许根本身也解析后再比，这样 /home -> /mnt/data/home 的部署不会被误拒。
    # realpath -m 不要求路径已存在（coreutils 8.15+，Debian/CentOS 均自带）。
    if command -v realpath >/dev/null 2>&1; then
        resolved=$(realpath -m "${norm}" 2>/dev/null) || resolved="${norm}"
        ok='n'
        for root in /home /var/www /srv /data /www; do
            rroot=$(realpath -m "${root}" 2>/dev/null) || rroot="${root}"
            case "${resolved}/" in
            "${rroot}"/*) ok='y'; break ;;
            esac
        done
        if [ "${ok}" != 'y' ]; then
            Echo_Red "'${norm}' 解析后指向 '${resolved}'，不在允许的站点根之下，拒绝。"
            return 1
        fi
    fi

    vhostdir="${norm}"
    return 0
}

