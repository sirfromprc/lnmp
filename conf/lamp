# lnmp ssl add 只读取现有 Apache 虚拟主机，不重复进入建站问答。
Add_SSL_Only_Info_Menu()
{
    local vhost_conf

    domain=""
    while :;do
        Echo_Yellow "请输入域名（示例：www.example.com）: "
        Read_Input domain "域名"
        if [ "${domain}" != "default" ]; then
            Check_Domain_Name "${domain}" || continue
        fi
        echo "您的域名：${domain}"
        break
    done

    if [ "${domain}" = "default" ]; then
        vhost_conf="/usr/local/apache/conf/extra/httpd-vhosts.conf"
    else
        vhost_conf="/usr/local/apache/conf/vhost/${domain}.conf"
    fi
    if [ ! -s "${vhost_conf}" ]; then
        Echo_Red "未找到网站 ${domain} 的虚拟主机配置。"
        Echo_Yellow "请先执行 lnmp vhost add 创建网站，再执行 lnmp ssl add 添加证书。"
        echo
        return 1
    fi
    if grep -Eq '^[[:space:]]*<VirtualHost[[:space:]]+\*:443>' "${vhost_conf}"; then
        Echo_Red "网站 ${domain} 已存在 HTTPS/443 配置，不能重复执行 ssl add。"
        Echo_Yellow "如需更换证书，请先检查并处理现有 SSL 配置。"
        echo
        return 1
    fi
    ssl_vhost_conf="${vhost_conf}"

    vhostdir=$(awk '$1 == "DocumentRoot" { value=$2; gsub(/^\"|\"$/, "", value); print value; exit }' "${vhost_conf}")
    if [ -z "${vhostdir}" ] || [ ! -d "${vhostdir}" ]; then
        Echo_Red "网站 ${domain} 的根目录不存在或无法从 ${vhost_conf} 读取。"
        return 1
    fi

    moredomain=$(awk -v primary="${domain}" '
        $1 == "ServerName" || $1 == "ServerAlias" {
            for (i=2; i<=NF; i++) {
                if ($i != primary && $i != "_") {
                    if (out != "") out=out " "
                    out=out $i
                }
            }
        }
        END { print out }
    ' "${vhost_conf}")
    email=$(awk '$1 == "ServerAdmin" { print $2; exit }' "${vhost_conf}")
    email="${email:-webmaster@example.com}"
    # 现有配置里有 php_admin_flag engine off，说明建站时选择了不开启 PHP。
    # HTTPS 必须沿用同一状态，否则 443 上 .php 会照常执行。
    # default 站点由 Create_SSL_Config 单独处理，不参与判断。
    if [ "${domain}" != "default" ] && grep -Eq '^[[:space:]]*php_admin_flag[[:space:]]+engine[[:space:]]+off' "${vhost_conf}"; then
        enable_site_php="n"
        echo "网站 ${domain} 未开启 PHP，HTTPS 配置沿用同一状态。"
    else
        enable_site_php="y"
    fi
    al_name="${domain}"
    if grep -Eq '^[[:space:]]*CustomLog[[:space:]]+' "${vhost_conf}"; then
        access_log="y"
    else
        access_log="n"
    fi

    return 0
}

