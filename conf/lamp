# acme.sh 使用 GitHub 官方固定 tag 和对应 SHA256，不使用浮动版本。
#
# 升级时必须同时更新版本和校验值。校验值获取方法：
#   curl -sSL https://github.com/acmesh-official/acme.sh/archive/refs/tags/<ver>.tar.gz | sha256sum
Acme_Sh_Ver='3.1.4'
Acme_Sh_SHA256='e5f8e187bbf5251e0cd8891f2622daab9850366bd17bea9f92c2fe2ee091fd32'

Install_Check_Acme.sh()
{
    local tmpdir tarball srcdir actual

    if [ -s /usr/local/acme.sh/acme.sh ]; then
        echo "/usr/local/acme.sh/acme.sh [found]"
        if ! grep -Eq "^ACCOUNT_EMAIL=" /usr/local/acme.sh/account.conf 2>/dev/null; then
            /usr/local/acme.sh/acme.sh --register-account -m ${email_address} || return 1
        fi
        . "/usr/local/acme.sh/acme.sh.env"
        return 0
    fi

    if ! command -v sha256sum >/dev/null 2>&1; then
        Echo_Red "缺少 sha256sum，无法校验 acme.sh 安装包，拒绝安装。"
        return 1
    fi

    tmpdir=$(mktemp -d /tmp/acme.sh.XXXXXXXX) || return 1
    chmod 700 "${tmpdir}"
    tarball="${tmpdir}/acme.sh-${Acme_Sh_Ver}.tar.gz"
    srcdir="${tmpdir}/acme.sh-${Acme_Sh_Ver}"

    echo "Downloading acme.sh ${Acme_Sh_Ver} from github.com/acmesh-official ..."
    if ! wget --prefer-family=IPv4 --max-redirect=5 -O "${tarball}" \
         "https://github.com/acmesh-official/acme.sh/archive/refs/tags/${Acme_Sh_Ver}.tar.gz"; then
        Echo_Red "acme.sh 下载失败，未做任何修改。"
        rm -rf "${tmpdir}"
        return 1
    fi

    # 下载内容必须通过固定 SHA256 后才能解压和执行。
    actual=$(sha256sum "${tarball}" | awk '{print $1}')
    if [ "${actual}" != "${Acme_Sh_SHA256}" ]; then
        Echo_Red "acme.sh 安装包 SHA256 不匹配，拒绝执行。"
        Echo_Red "  expected: ${Acme_Sh_SHA256}"
        Echo_Red "  actual:   ${actual}"
        rm -rf "${tmpdir}"
        return 1
    fi

    if ! tar zxf "${tarball}" -C "${tmpdir}"; then
        Echo_Red "acme.sh 解压失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    # 归档顶层目录必须与固定版本精确匹配。
    if [ ! -s "${srcdir}/acme.sh" ]; then
        Echo_Red "acme.sh 归档结构异常：未找到 ${srcdir}/acme.sh"
        rm -rf "${tmpdir}"
        return 1
    fi

    ( cd "${srcdir}" && ./acme.sh --install ${acme_sh_sudo} --log \
        --home /usr/local/acme.sh --certhome /usr/local/apache/conf/ssl -m ${email_address} )
    if [ $? -ne 0 ] || [ ! -s /usr/local/acme.sh/acme.sh ]; then
        Echo_Red "acme.sh 安装失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    rm -rf "${tmpdir}"

    sed -i 's/cat "\$CERT_PATH"$/#cat "\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
    # 保留 acme.sh 默认密钥类型，并关闭自动升级。
    # acme.sh 的自更新是一条绕过本包全部校验的通道：`--upgrade` 直接从
    # GitHub 拉最新代码覆盖自己，不核对任何哈希或签名。本包在安装时
    # 固定 tag + 校验 SHA256（Acme_Sh_Ver / Acme_Sh_SHA256），
    # 但只要自更新开着，那个固定值第二天就可能不作数了。
    #
    # 处理：
    #   1. 显式关闭 acme.sh 自带的自动升级（--auto-upgrade 0）；
    #   2. 定时自动升级的 crontab 本就已注释掉，保持不装；
    #   3. upgrade.sh 保留并要求手动确认；需要跟进上游修复时由管理员
    #      自己决定，不在后台悄悄换掉一个持有全部证书私钥的组件。

    /usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
    cat >/usr/local/acme.sh/upgrade.sh<<EOF
#!/bin/bash
#
# 手动升级 acme.sh；禁止加入 crontab。
#
# 它执行 acme.sh --upgrade，从 GitHub 拉最新代码覆盖 /usr/local/acme.sh，
# 手动升级不使用本包固定的版本与 SHA256，执行后须重新确认组件来源和完整性。
#
# 需要跟进上游安全修复时再手动跑。

echo "警告：即将从 GitHub 升级 acme.sh，此过程不做完整性校验。"
printf "确认继续请输入 yes: "
read -r _ans
[ "\$_ans" = "yes" ] || { echo "已取消。"; exit 1; }

. "/usr/local/acme.sh/acme.sh.env"
/usr/local/acme.sh/acme.sh --upgrade
/usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
sed -i 's/cat "\\\$CERT_PATH"\$/#cat "\\\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
EOF

    chmod +x /usr/local/acme.sh/upgrade.sh
    #if crontab -l|grep -q "/usr/local/acme.sh/upgrade.sh"; then
    #    echo "acme.sh upgrade crontab rule is exist."
    #else
    #    echo "Add acme.sh upgrade crontab rule..."
    #    (crontab -l ; echo '0 3 */7 * * /usr/local/acme.sh/upgrade.sh') | crontab -
    #fi
    if command -v yum >/dev/null 2>&1; then
        yum -y update nss
        yum -y install ca-certificates
        service crond restart
        chkconfig crond on
    elif command -v apt-get >/dev/null 2>&1; then
        /etc/init.d/cron restart
        update-rc.d cron defaults
    fi

    . "/usr/local/acme.sh/acme.sh.env"
}

Create_SSL_Config()
{
    if /usr/local/apache/bin/httpd -v|grep -Eqi "Apache/2.4.*"; then
        Conf_H2='Protocols h2 h2c http/1.1'
    else
        Conf_H2=''
    fi
    if echo "${ssl_choice}" | grep -Eqi "^[2-4]$"; then
        Conf_SSLChain="SSLCertificateChainFile /usr/local/apache/conf/ssl/${domain}/ca.cer"
    fi

    sed -i 's@#Include conf/extra/httpd-ssl.conf@Include conf/extra/httpd-ssl.conf@g' /usr/local/apache/conf/httpd.conf
    cat >>"/usr/local/apache/conf/vhost/${domain}.conf"<<EOF

<VirtualHost *:443>
ServerAdmin ${email}
php_admin_value open_basedir "${vhostdir}:/tmp/:/var/tmp/:/proc/"
DocumentRoot ${vhostdir}
ServerName ${domain}
SSLEngine on
SSLCertificateFile ${ssl_certificate}
SSLCertificateKeyFile ${ssl_certificate_key}
${Conf_SSLChain}
${Conf_H2}
ErrorLog "/home/wwwlogs/${al_name}-error_log"
CustomLog "/home/wwwlogs/${al_name}-access_log" combined
<Directory "${vhostdir}">
    Options FollowSymLinks
    AllowOverride All
    Require all granted
    DirectoryIndex index.html index.php
</Directory>
</VirtualHost>
EOF

    if [ "${access_log}" != 'y' ]; then
        sed -i 's/^ErrorLog/#ErrorLog/g' /usr/local/apache/conf/vhost/${domain}.conf
        sed -i 's/^CustomLog/#CustomLog/g' /usr/local/apache/conf/vhost/${domain}.conf
    fi

    if [ "${using_301}" = "y" ]; then
        sed -i '0,/^ServerName/!b;//a\RewriteEngine On\nRewriteCond %{HTTPS} off\nRewriteCond %{REQUEST_URI} !^\/\.well-known/.*$\nRewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]' /usr/local/apache/conf/vhost/${domain}.conf
    fi

    if [ "${moredomain}" != "" ]; then
        sed -i "/^SSLEngine on/i\ServerAlias ${moredomain}" /usr/local/apache/conf/vhost/${domain}.conf
    fi

    echo "Test Apache configure file..."
    /etc/init.d/httpd configtest
    echo "Restart Apache..."
    /etc/init.d/httpd graceful
