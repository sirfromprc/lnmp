                if [ "${ssl_certificate}" == "" ]; then
                    Echo_Red "SSL 证书文件路径不能为空。"
                else
                    break
                fi
            done
            while :;do
                Echo_Yellow "请输入 SSL 私钥文件的完整路径: "
                Read_Input ssl_certificate_key "SSL 私钥路径"
                if [ "${ssl_certificate_key}" == "" ]; then
                    Echo_Red "SSL 私钥文件路径不能为空。"
                else
                    break
                fi
            done
            while :;do
                Echo_Yellow "请输入 SSL 证书链文件的完整路径（可留空）: "
                Read_Input ssl_chain "SSL 证书链路径"
                if [ "${ssl_chain}" == "" ]; then
                    Echo_Yellow "不设置独立的 SSL 证书链文件。"
                    echo
                    Conf_SSLChain="#SSLCertificateChainFile /path/to/your/chain.pem"
                    break
                else
                    Conf_SSLChain="SSLCertificateChainFile ${ssl_chain}"
                    break
                fi
            done
            break
        elif [ "${ssl_choice}" == "2" ]; then
            Check_Acme_EMail
            break
        elif [[ "${domain}" != "default" && "${ssl_choice}" =~ ^(3|4)$ ]]; then
            Check_Acme_EMail
            break
        else
            if [ "${domain}" = "default" ]; then
                Echo_Red "default 站点只支持自有证书或 Let's Encrypt IP 证书，请输入 1 或 2！"
            else
                Echo_Red "请输入 1、2、3 或 4。"
            fi
        fi
    done

    Return_301_Menu
}

Detect_Server_IP()
{
    local ip='' pub=''
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    if [ -z "${ip}" ] || Is_Private_IP "${ip}"; then
        pub=$(curl -fsS --max-time 8 https://api.ipify.org 2>/dev/null)
        [ -n "${pub}" ] && ip="${pub}"
    fi
    printf '%s' "${ip}"
}

Is_Private_IP()
{
    case "$1" in
        10.*|127.*|169.254.*|192.168.*)          return 0 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*)   return 0 ;;
        100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 0 ;;
        ''|*[!0-9.]*)                            return 0 ;;
    esac
    return 1
}

Prepare_Default_Site_IP_Cert()
{
    local ip
    ip=$(Detect_Server_IP)
    if [ -z "${ip}" ] || Is_Private_IP "${ip}"; then
        Echo_Red "default 站点未探测到可签发证书的公网 IPv4，无法使用 Let's Encrypt。"
        Echo_Yellow "请为网站绑定域名，或选择 1 使用自有证书。"
        echo
        return 1
    fi

    Echo_Yellow "default 将为服务器公网 IPv4 ${ip} 申请 Let's Encrypt IP 证书。"

    echo
    Echo_Yellow "该证书使用 shortlived profile，有效期 7 天，必须保留 acme.sh 自动续期任务。"
    echo
    letsdomain="-d ${ip}"
    cert_profile_opt="--certificate-profile shortlived --days 6"
    default_site_ip="${ip}"
    return 0
}

# acme.sh 使用 GitHub 官方固定 tag 和对应 SHA256，不使用浮动版本。
#
# 升级时必须同时更新版本和校验值。校验值获取方法：
#   curl -sSL https://github.com/acmesh-official/acme.sh/archive/refs/tags/<ver>.tar.gz | sha256sum
Acme_Sh_Ver='3.1.4'
Acme_Sh_SHA256='e5f8e187bbf5251e0cd8891f2622daab9850366bd17bea9f92c2fe2ee091fd32'

Install_Check_Acme.sh()
{
    local tmpdir tarball srcdir actual

    if [ -s /usr/local/acme.sh/acme.sh ]; then
        echo "/usr/local/acme.sh/acme.sh [已存在]"
        if ! grep -Eq "^ACCOUNT_EMAIL=" /usr/local/acme.sh/account.conf 2>/dev/null; then
            /usr/local/acme.sh/acme.sh --register-account -m ${email_address} || return 1
        fi
        . "/usr/local/acme.sh/acme.sh.env"
        return 0
    fi

    if ! command -v sha256sum >/dev/null 2>&1; then
        Echo_Red "缺少 sha256sum，无法校验 acme.sh 安装包，拒绝安装。"
        return 1
    fi

    tmpdir=$(mktemp -d /tmp/acme.sh.XXXXXXXX) || return 1
    chmod 700 "${tmpdir}"
    tarball="${tmpdir}/acme.sh-${Acme_Sh_Ver}.tar.gz"
    srcdir="${tmpdir}/acme.sh-${Acme_Sh_Ver}"

    echo "正在从 github.com/acmesh-official 下载 acme.sh ${Acme_Sh_Ver} ..."
    if ! wget --prefer-family=IPv4 --max-redirect=5 -O "${tarball}" \
         "https://github.com/acmesh-official/acme.sh/archive/refs/tags/${Acme_Sh_Ver}.tar.gz"; then
        Echo_Red "acme.sh 下载失败，未做任何修改。"
        rm -rf "${tmpdir}"
        return 1
    fi

    # 下载内容必须通过固定 SHA256 后才能解压和执行。
    actual=$(sha256sum "${tarball}" | awk '{print $1}')
    if [ "${actual}" != "${Acme_Sh_SHA256}" ]; then
        Echo_Red "acme.sh 安装包 SHA256 不匹配，拒绝执行。"
        Echo_Red "  期望值：${Acme_Sh_SHA256}"
        Echo_Red "  实际值：${actual}"
        rm -rf "${tmpdir}"
        return 1
    fi

    if ! tar zxf "${tarball}" -C "${tmpdir}"; then
        Echo_Red "acme.sh 解压失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    # 归档顶层目录必须与固定版本精确匹配。
    if [ ! -s "${srcdir}/acme.sh" ]; then
        Echo_Red "acme.sh 归档结构异常：未找到 ${srcdir}/acme.sh"
        rm -rf "${tmpdir}"
        return 1
    fi

    ( cd "${srcdir}" && ./acme.sh --install ${acme_sh_sudo} --log \
        --home /usr/local/acme.sh --certhome /usr/local/apache/conf/ssl -m ${email_address} )
    if [ $? -ne 0 ] || [ ! -s /usr/local/acme.sh/acme.sh ]; then
        Echo_Red "acme.sh 安装失败。"
        rm -rf "${tmpdir}"
        return 1
    fi
    rm -rf "${tmpdir}"

    sed -i 's/cat "\$CERT_PATH"$/#cat "\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
    # 保留 acme.sh 默认密钥类型，并关闭自动升级。
    # acme.sh 的自更新是一条绕过本包全部校验的通道：`--upgrade` 直接从
    # GitHub 拉最新代码覆盖自己，不核对任何哈希或签名。本包在安装时
    # 固定 tag + 校验 SHA256（Acme_Sh_Ver / Acme_Sh_SHA256），
    # 但只要自更新开着，那个固定值第二天就可能不作数了。
    #
    # 处理：
    #   1. 显式关闭 acme.sh 自带的自动升级（--auto-upgrade 0）；
    #   2. 定时自动升级的 crontab 本就已注释掉，保持不装；
    #   3. upgrade.sh 保留并要求手动确认；需要跟进上游修复时由管理员
    #      自己决定，不在后台悄悄换掉一个持有全部证书私钥的组件。

    /usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
    cat >/usr/local/acme.sh/upgrade.sh<<EOF
#!/bin/bash
#
# 手动升级 acme.sh；禁止加入 crontab。
#
# 它执行 acme.sh --upgrade，从 GitHub 拉最新代码覆盖 /usr/local/acme.sh，
# 手动升级不使用本包固定的版本与 SHA256，执行后须重新确认组件来源和完整性。
#
# 需要跟进上游安全修复时再手动跑。

echo "警告：即将从 GitHub 升级 acme.sh，此过程不做完整性校验。"
printf "确认继续请输入 yes: "
read -r _ans
[ "\$_ans" = "yes" ] || { echo "已取消。"; exit 1; }

. "/usr/local/acme.sh/acme.sh.env"
/usr/local/acme.sh/acme.sh --upgrade
/usr/local/acme.sh/acme.sh --upgrade --auto-upgrade 0 >/dev/null 2>&1
sed -i 's/cat "\\\$CERT_PATH"\$/#cat "\\\$CERT_PATH"/g' /usr/local/acme.sh/acme.sh
EOF

    chmod +x /usr/local/acme.sh/upgrade.sh
    #if crontab -l|grep -q "/usr/local/acme.sh/upgrade.sh"; then
    #    echo "acme.sh upgrade crontab rule is exist."
    #else
    #    echo "Add acme.sh upgrade crontab rule..."
    #    (crontab -l ; echo '0 3 */7 * * /usr/local/acme.sh/upgrade.sh') | crontab -
    #fi
    if command -v yum >/dev/null 2>&1; then
        yum -y update nss
        yum -y install ca-certificates
        service crond restart
        chkconfig crond on
    elif command -v apt-get >/dev/null 2>&1; then
        /etc/init.d/cron restart
        update-rc.d cron defaults
    fi

    . "/usr/local/acme.sh/acme.sh.env"
}

Create_SSL_Config()
{
    local vhost_conf="${ssl_vhost_conf:-/usr/local/apache/conf/vhost/${domain}.conf}"
    local backup httpd_conf_backup
    local ssl_server_name="${domain}" ssl_open_basedir ssl_directory_options ssl_php_off

    ssl_open_basedir="php_admin_value open_basedir \"${vhostdir}:/tmp/:/var/tmp/:/proc/\""
    ssl_directory_options='    AllowOverride All
    Require all granted
    DirectoryIndex index.html index.php'
    ssl_php_off=""
    if [ "${enable_site_php}" = "n" ]; then
        # 与 80 端口保持同一状态：关引擎并把 .php 请求统一挡成 404
        ssl_open_basedir="#php_admin_value open_basedir \"${vhostdir}:/tmp/:/var/tmp/:/proc/\""
        ssl_php_off="$(Site_Apache_PHP_Off_Block)"
        ssl_directory_options='    AllowOverride All
    Require all granted
    DirectoryIndex index.html'
    fi
    if [ "${domain}" = "default" ]; then
        # default 站点按内置形态生成：phpMyAdmin 与三个演示页仍要能跑，
        # 所以不整站关引擎，只在 <Directory> 里拒绝根目录下的 .php。
        ssl_server_name='_'
        ssl_php_off=""
        ssl_open_basedir="#php_admin_value open_basedir \"${vhostdir}:/tmp/:/var/tmp/:/proc/\""
        ssl_directory_options='    AllowOverride None
    Require all granted
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
    DirectoryIndex index.html'
    fi

    backup=$(mktemp /tmp/lamp-ssl-vhost.XXXXXXXX) || return 1
    httpd_conf_backup=$(mktemp /tmp/lamp-ssl-httpd.XXXXXXXX) || { rm -f "${backup}"; return 1; }
    \cp -p "${vhost_conf}" "${backup}" || { rm -f "${backup}" "${httpd_conf_backup}"; return 1; }
    \cp -p /usr/local/apache/conf/httpd.conf "${httpd_conf_backup}" || {
        rm -f "${backup}" "${httpd_conf_backup}"
        return 1
    }
    if /usr/local/apache/bin/httpd -v|grep -Eqi "Apache/2.4.*"; then
        Conf_H2='Protocols h2 h2c http/1.1'
    else
        Conf_H2=''
    fi
    if echo "${ssl_choice}" | grep -Eqi "^[2-4]$"; then
        Conf_SSLChain="SSLCertificateChainFile /usr/local/apache/conf/ssl/${domain}/ca.cer"
    fi

    sed -i 's@#Include conf/extra/httpd-ssl.conf@Include conf/extra/httpd-ssl.conf@g' /usr/local/apache/conf/httpd.conf
    cat >>"${vhost_conf}"<<EOF

<VirtualHost *:443>
ServerAdmin ${email}
${ssl_open_basedir}
DocumentRoot ${vhostdir}
ServerName ${ssl_server_name}
SSLEngine on
SSLCertificateFile ${ssl_certificate}
SSLCertificateKeyFile ${ssl_certificate_key}
${Conf_SSLChain}
${Conf_H2}
ErrorLog "/home/wwwlogs/${al_name}-error_log"
CustomLog "/home/wwwlogs/${al_name}-access_log" combined
${ssl_php_off}
<Directory "${vhostdir}">
    Options FollowSymLinks
${ssl_directory_options}
</Directory>
</VirtualHost>
EOF

    if [ "${access_log}" != 'y' ]; then
        sed -i 's/^ErrorLog/#ErrorLog/g' "${vhost_conf}"
        sed -i 's/^CustomLog/#CustomLog/g' "${vhost_conf}"
    fi

    if [ "${using_301}" = "y" ]; then
        sed -i '0,/^ServerName/!b;//a\RewriteEngine On\nRewriteCond %{HTTPS} off\nRewriteCond %{REQUEST_URI} !^\/\.well-known/.*$\nRewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]' "${vhost_conf}"
    fi

    if [ "${moredomain}" != "" ]; then
        sed -i "/^SSLEngine on/i\ServerAlias ${moredomain}" "${vhost_conf}"
    fi

    echo "正在检查 Apache 配置..."
    if ! /etc/init.d/httpd configtest; then
        Echo_Red "Apache 配置测试未通过，已恢复添加 SSL 前的配置。"
        \cp -p "${backup}" "${vhost_conf}"
        \cp -p "${httpd_conf_backup}" /usr/local/apache/conf/httpd.conf
        rm -f "${backup}" "${httpd_conf_backup}"
        return 1
    fi
    echo "正在平滑重载 Apache..."
    if ! /etc/init.d/httpd graceful; then
        Echo_Red "Apache 重载失败，已恢复添加 SSL 前的配置。"
        \cp -p "${backup}" "${vhost_conf}"
        \cp -p "${httpd_conf_backup}" /usr/local/apache/conf/httpd.conf
        /etc/init.d/httpd graceful
        rm -f "${backup}" "${httpd_conf_backup}"
        return 1
    fi
    rm -f "${backup}" "${httpd_conf_backup}"
    return 0
}

Add_SSL()
{
    local vhost_conf="${ssl_vhost_conf:-/usr/local/apache/conf/vhost/${domain}.conf}"

    if [ ! -s "${vhost_conf}" ]; then
        Echo_Red "未找到网站 ${domain} 的虚拟主机配置。"
        Echo_Yellow "请先执行 lnmp vhost add 创建网站，再执行 lnmp ssl add 添加证书。"
        echo
        return 1
    fi
    if [ -z "${vhostdir:-}" ] || [ ! -d "${vhostdir}" ]; then
        Echo_Red "网站 ${domain} 的根目录不存在，无法添加证书。"
        return 1
    fi
    if [[ "${domain}" = "default" && ! "${ssl_choice}" =~ ^(1|2)$ ]]; then
        Echo_Red "default 站点只支持自有证书或 Let's Encrypt IP 证书。"
        return 1
    fi

    if [ "${ssl_choice}" == "1" ]; then
        Create_SSL_Config || return 1
    elif echo "${ssl_choice}" | grep -Eqi "^[2-4]$"; then
        letsdomain=""
        cert_profile_opt=""
        if [ "${moredomain}" != "" ]; then
            letsdomain="-d ${domain}"
            for i in ${moredomain};do
                letsdomain=${letsdomain}" -d ${i}"
            done
        else
            letsdomain="-d ${domain}"
        fi
        if [ "${domain}" = "default" ]; then
            Prepare_Default_Site_IP_Cert || return 1
        fi
        if [[ "${vhostdir}" == "" || "${letsdomain}" == "" ]]; then
            Echo_Red "缺少必要参数：网站目录和证书申请目标不能为空。"
            return 1
        fi

        Install_Check_Acme.sh || exit 1

        if [ -s /usr/local/apache/conf/ssl/${domain}/fullchain.cer ]; then
            echo "正在删除已有域名证书..."
            rm -rf /usr/local/apache/conf/ssl/${domain}
        fi

        if [ "${ssl_choice}" == "2" ]; then
            echo "正在使用 Let's Encrypt 签发 SSL 证书..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server letsencrypt --issue ${letsdomain} -w ${vhostdir} ${cert_profile_opt} --reloadcmd "/etc/init.d/httpd graceful"
        elif [ "${ssl_choice}" == "3" ]; then
            echo "正在使用 BuyPass 签发 SSL 证书..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server buypass --issue ${letsdomain} -w ${vhostdir} --days 170 --reloadcmd "/etc/init.d/httpd graceful"
        elif [ "${ssl_choice}" == "4" ]; then
            echo "正在使用 ZeroSSL 签发 SSL 证书..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server zerossl --issue ${letsdomain} -w ${vhostdir} --reloadcmd "/etc/init.d/httpd graceful"
        fi
        lets_status=$?

        if [ "${lets_status}" = 0 ]; then
            cert_install_domain="${domain}"
            [ "${domain}" = "default" ] && cert_install_domain="${default_site_ip}"
            mkdir -p "/usr/local/apache/conf/ssl/${domain}" || return 1
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --install-cert -d "${cert_install_domain}" --ecc \
                --cert-file "/usr/local/apache/conf/ssl/${domain}/${domain}.cer" \
                --key-file "/usr/local/apache/conf/ssl/${domain}/${domain}.key" \
                --ca-file "/usr/local/apache/conf/ssl/${domain}/ca.cer" \
                --fullchain-file "/usr/local/apache/conf/ssl/${domain}/fullchain.cer" \
                --reloadcmd "/etc/init.d/httpd graceful"
            lets_status=$?
        fi

        ssl_certificate="/usr/local/apache/conf/ssl/${domain}/${domain}.cer"
        ssl_certificate_key="/usr/local/apache/conf/ssl/${domain}/${domain}.key"
        if [ "${lets_status}" = 0 ]; then
            Create_SSL_Config || return 1
            Echo_Green "SSL 证书签发成功。"
        else
            Echo_Red "SSL 证书签发失败。"
            return 1
        fi
    fi
    return 0
}

Add_Dns_SSL()
{
    provider=$1
    if [ "${provider}" != "" ]; then
        dns_provider="dns_${provider}"
    else
        Echo_Red "DNS 手工验证模式无法自动续期，证书到期前必须手动续期。"
    fi

    Add_SSL_Info_Menu
    Add_DNS_SSL_Select_Menu
    Return_301_Menu
    Install_Check_Acme.sh || exit 1

    if [[ ! -s /usr/local/acme.sh/dnsapi/dns_${provider}.sh && "${provider}" != "" ]]; then
        echo "未找到 DNS 服务商插件：${provider}。"
        exit 1
    fi

    if [ -s /usr/local/apache/conf/ssl/${domain}/fullchain.cer ]; then
        echo "正在删除已有域名证书..."
        rm -rf /usr/local/apache/conf/ssl/${domain}
    fi

    letsdomain=""
    if [ "${moredomain}" != "" ]; then
        letsdomain="-d ${domain}"
        for i in ${moredomain};do
            letsdomain=${letsdomain}" -d ${i}"
        done
    else
        letsdomain="-d ${domain}"
    fi

    if echo "${letsdomain}" | grep -q '\*\.' && echo "${letsdomain}" | grep -qi 'www\.'; then
        Echo_Red "泛域名证书不能同时添加 www 子域名。"
        exit 1
    fi

    if [ "${dns_ssl_choice}" == "1" ]; then
        ca_server="letsencrypt"
    elif [ "${dns_ssl_choice}" == "2" ]; then
        ca_server="zerossl"
    fi

    echo "正在使用 ${ca_server} 签发 SSL 证书..."
    if [ "${provider}" != "" ]; then
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server ${ca_server} --issue ${letsdomain} --dns ${dns_provider} --reloadcmd "/etc/init.d/httpd graceful"
        lets_status=$?
    else
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server ${ca_server} --issue ${letsdomain} --dns --yes-I-know-dns-manual-mode-enough-go-ahead-please
        Echo_Yellow "请在 120 秒内为域名添加上方显示的 TXT 记录。"
        echo
        Sleep_Sec 120
        /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --renew ${letsdomain} --yes-I-know-dns-manual-mode-enough-go-ahead-please
        lets_status=$?
    fi
    if [ "${lets_status}" = 0 ] || [[ "${provider}" = "" && "${lets_status}" = 1 && -s "/usr/local/apache/conf/ssl/${domain}/${domain}.cer" ]]; then
        if [ ! -d "${vhostdir}" ]; then
            echo "正在创建虚拟主机目录......"
            mkdir -p "${vhostdir}"
            echo "正在设置虚拟主机目录权限......"
            chmod -R 755 "${vhostdir}"
            chown -R www:www "${vhostdir}"
        fi

        if [ ! -s "/usr/local/apache/conf/vhost/${domain}.conf" ]; then
            Add_VHost_Config
        fi
        ssl_certificate="/usr/local/apache/conf/ssl/${domain}/${domain}.cer"
        ssl_certificate_key="/usr/local/apache/conf/ssl/${domain}/${domain}.key"
        Create_SSL_Config
        Print_Banner \
            "SSL 证书信息" \
            "域名：${domain} ${moredomain}" \
            "证书：/usr/local/apache/conf/ssl/${domain}/fullchain.cer" \
            "私钥：/usr/local/apache/conf/ssl/${domain}/${domain}.key"
        Echo_Green "SSL 证书签发成功。"
    else
        Echo_Red "SSL 证书签发失败。"
    fi
}

