Add_Database()
{
    local sql_file mysql_password_q
    Check_DB_Identifier "${database_name}" || exit 1
    mysql_password_q=$(Sql_Quote "${mysql_password}")
    sql_file=$(LNMP_Mktemp add_db) || exit 1
    chmod 600 "${sql_file}"

    # 使用兼容当前 MySQL 和 MariaDB 版本的统一建库流程。
    # 原 `grep -Eqi '^8\.0\.'` 只认 8.0.x，默认的 MySQL 8.4 会落进 else，
    # 用到已被 MySQL 8.0 移除的 `GRANT ... IDENTIFIED BY`，建库将报 1064。
    # mysql 客户端逐条执行 SQL，因此所有建库语句保持幂等，
    # 中途失败会留下已建好的用户，裸 CREATE USER 重试即报 1396。
    cat >"${sql_file}"<<EOF
CREATE USER IF NOT EXISTS '${database_name}'@'localhost' IDENTIFIED BY '${mysql_password_q}';
CREATE USER IF NOT EXISTS '${database_name}'@'127.0.0.1' IDENTIFIED BY '${mysql_password_q}';
ALTER USER '${database_name}'@'localhost' IDENTIFIED BY '${mysql_password_q}';
ALTER USER '${database_name}'@'127.0.0.1' IDENTIFIED BY '${mysql_password_q}';
GRANT USAGE ON *.* TO '${database_name}'@'localhost';
GRANT USAGE ON *.* TO '${database_name}'@'127.0.0.1';
CREATE DATABASE IF NOT EXISTS \`${database_name}\`;
GRANT ALL PRIVILEGES ON \`${database_name}\`.* TO '${database_name}'@'localhost';
GRANT ALL PRIVILEGES ON \`${database_name}\`.* TO '${database_name}'@'127.0.0.1';
FLUSH PRIVILEGES;
EOF

    ${MySQL_Bin} --defaults-file=~/.my.cnf < "${sql_file}"
    [ $? -eq 0 ] && echo "Add database Sucessfully." || echo "Add database failed!"
    rm -f "${sql_file}"
}

