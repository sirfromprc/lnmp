#!/bin/bash
# @CLI_COMMON@
export PATH=$PATH:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin:~/bin

# 管理系统服务和配置需要 root 权限。
if [ "$(id -u)" != "0" ]; then
    echo "错误：必须使用 root 用户运行此命令。"
    exit 1
else
    if env |grep -q SUDO; then
        acme_sh_sudo="-f"
    fi
fi

Print_Banner "LAMP 管理工具"

# 服务名由 Detect_Managed_Services 在每次执行时按当前系统重新确定。
APACHE_SERVICE=
PHP_SERVICE=
DB_SERVICE=

arg1=$1
arg2=$2
# database export/import 需要库名和文件名两个附加参数。
arg3=$3
arg4=$4

# 通知函数安装在 /bin/lnmp-tgnotice，载入后可由管理命令直接调用。
[ -r /bin/lnmp-tgnotice ] && . /bin/lnmp-tgnotice

Detect_Managed_Services()
{
    APACHE_SERVICE=
    PHP_SERVICE=
    DB_SERVICE=
    Svc_Exists httpd && APACHE_SERVICE=httpd
    # 存量 mod_php 机器没有 php-fpm 服务，PHP_SERVICE 为空。
    Svc_Exists php-fpm && PHP_SERVICE=php-fpm
    if Svc_Exists mariadb; then
        DB_SERVICE=mariadb
    elif Svc_Exists mysql; then
        DB_SERVICE=mysql
    fi
}

lamp_start()
{
    local failed=0
    echo "正在启动 LAMP..."
    [ -z "${PHP_SERVICE}" ] || Svc_If_Installed PHP-FPM "${PHP_SERVICE}" start || failed=1
    Apache_MPHP_Action start || failed=1
    Svc_If_Installed Apache "${APACHE_SERVICE}" start || failed=1
    Svc_If_Installed Database "${DB_SERVICE}" start ||
        { failed=1; Diagnose_DB_Start_Failure start; }
    Check_Svc_State "${PHP_SERVICE}" "${APACHE_SERVICE}" "${DB_SERVICE}" || failed=1
    return ${failed}
}

lamp_stop()
{
    local failed=0
    echo "正在停止 LAMP..."
    Svc_If_Installed Apache "${APACHE_SERVICE}" stop || failed=1
    [ -z "${PHP_SERVICE}" ] || Svc_If_Installed PHP-FPM "${PHP_SERVICE}" stop || failed=1
    Apache_MPHP_Action stop || failed=1
    Svc_If_Installed Database "${DB_SERVICE}" stop || failed=1
    return ${failed}
}

lamp_reload()
{
    local failed=0
    echo "正在重载 LAMP..."
    # httpd.service 的 ExecReload 执行 httpd -k graceful。
    Svc_If_Installed Apache "${APACHE_SERVICE}" reload || failed=1
    [ -z "${PHP_SERVICE}" ] || Svc_If_Installed PHP-FPM "${PHP_SERVICE}" reload || failed=1
    Apache_MPHP_Action reload || failed=1
    Svc_If_Installed Database "${DB_SERVICE}" reload || failed=1
    return ${failed}
}

lamp_kill()
{
    local failed=0 ver
    echo "正在终止 Apache、PHP-FPM 和数据库进程..."

    Kill_By_Unit "${APACHE_SERVICE}" "${PHP_SERVICE}" "${DB_SERVICE}"
    for ver in $(Apache_MPHP_Versions); do
        Kill_By_Unit "php-fpm@${ver}"
    done

    Kill_Process httpd || failed=1
    Kill_Process php-fpm || failed=1
    # MariaDB 的进程名是 mariadbd，两者只会有一个存在。
    # 数据库关闭要刷缓冲池，给更长的等待时间。
    Kill_Process mysqld 30 || failed=1
    Kill_Process mariadbd 30 || failed=1
    [ ${failed} -eq 0 ] && echo "完成。"
    return ${failed}
}

lamp_status()
{
    local svc

    Svc_If_Installed Apache "${APACHE_SERVICE}" status
    [ -z "${PHP_SERVICE}" ] || Svc_If_Installed PHP-FPM "${PHP_SERVICE}" status
    Apache_MPHP_Action status
    Svc_If_Installed Database "${DB_SERVICE}" status
    # 附加组件不参与整体起停，已安装时一并显示状态。
    for svc in redis memcached pureftpd; do
        Svc_Exists "${svc}" && Svc "${svc}" status
    done
    # 访问地址含随机路径，与启用状态一同由 lnmp-phpmyadmin 输出。
    if [ -s /usr/local/phpmyadmin/.access_url ]; then
        if [ -x /bin/lnmp-phpmyadmin ]; then
            /bin/lnmp-phpmyadmin lamp status
        else
            echo "phpMyAdmin 访问路径：/$(cat /usr/local/phpmyadmin/.access_url)/"
            Echo_Red "找不到 /bin/lnmp-phpmyadmin，无法判断启用状态和访问地址。"
            Echo_Red "补装：cp tools/lnmp-phpmyadmin.sh /bin/lnmp-phpmyadmin && chmod +x /bin/lnmp-phpmyadmin"
        fi
    fi
}
# ---------------------------------------------------------------------------
# 应用托管：Node、Go 等自带后端进程的站点
# 元数据在 /etc/lnmp/apps/<名字>.env，由 init.d/lnmp-app@.service 读取。
# ---------------------------------------------------------------------------
App_Conf_Dir="/etc/lnmp/apps"
App_Unit_Tpl="/etc/systemd/system/lnmp-app@.service"



# 本机是否有可供站点使用的 PHP：Apache 加载的 PHP 由此编译产物提供。
Site_PHP_Available()
{
    [ -s /usr/local/php/bin/php-config ]
}

# 取出配置文件中“自定义配置--开始/结束”之间的内容，保留原缩进。
# 标记缺失、不成对或区块只有空行时输出空，由调用方决定后续行为。
Extract_Custom_Block()
{
    local conf="$1"

    [ -s "${conf}" ] || return 0
    awk '
        !started && /# 自定义配置--开始/ { started = 1; next }
        started && !finished && /# 自定义配置--结束/ { finished = 1; next }
        started && !finished { lines[++n] = $0 }
        END {
            if (!started || !finished) exit
            s = 1; e = n
            while (s <= e && lines[s] ~ /^[ \t\r]*$/) s++
            while (e >= s && lines[e] ~ /^[ \t\r]*$/) e--
            for (i = s; i <= e; i++) print lines[i]
        }
    ' "${conf}"
}

# HTTP 与 HTTPS 共用以下规则，避免全局 PHP 处理器继续执行或泄露 .php 源文件。
Site_Apache_PHP_Off_Block()
{
    if Apache_PHP_Is_FPM; then
        cat <<'EOF'
# 本站点未开启 PHP。RedirectMatch 先于处理器生效，.php 请求不会交给 PHP-FPM。
RedirectMatch 404 "\.php(/|$)"
EOF
        return 0
    fi
    cat <<'EOF'
# 本站点未开启 PHP。php_admin_flag 不受 .htaccess 覆盖；RedirectMatch 防止
# Apache 将未解析的 .php 文件作为普通文件返回。
php_admin_flag engine off
RedirectMatch 404 "\.php(/|$)"
EOF
}

# 后端为域名时确定 Host 头策略并提示解析状态；IP 后端不需要这一步。
# 非交互执行读 VHOST_PROXY_HOST：n 向后端传递访问者的域名，其余按后端域名。
Site_Proxy_Backend_Detail()
{
    proxy_backend_host="$(Proxy_Backend_Host "${proxy_backend}")"
    proxy_use_backend_host="n"

    Proxy_Backend_Is_IP "${proxy_backend_host}" && return 0

    # 解析不到不阻断：内网域名和尚未生效的 DNS 都属正常，mod_proxy 在运行时解析。
    if command -v getent >/dev/null 2>&1 \
       && ! getent hosts "${proxy_backend_host}" >/dev/null 2>&1; then
        Echo_Yellow "后端域名 ${proxy_backend_host} 当前解析不到。"
        echo "配置仍会写入，域名由 mod_proxy 在运行时解析；届时仍解析不到会返回 502。"
    fi

    if [ ! -t 0 ]; then
        case "${VHOST_PROXY_HOST:-}" in
            [nN])
                proxy_use_backend_host="n"
                echo "非交互执行，按 VHOST_PROXY_HOST=n 向后端传递访问者的域名。"
                ;;
            *)
                proxy_use_backend_host="y"
                echo "非交互执行，向后端发送的 Host 头为 ${proxy_backend_host}。"
                ;;
        esac
        return 0
    fi

    Read_YN proxy_use_backend_host \
        "发给后端的 Host 头用后端域名 ${proxy_backend_host} 吗? [Y/n]（默认 y，选 n 传递访问者的域名）: " \
        y "后端 Host 头开关"
    if [ "${proxy_use_backend_host}" = "y" ]; then
        echo "后端将收到 Host: ${proxy_backend_host}。"
    else
        echo "后端将收到访问者请求中的域名。"
    fi
    return 0
}

# 反代后端地址：接受 主机:端口，缺少 scheme 时按 http 补全，并补齐末尾斜杠，
# 使 ProxyPass 的源路径 / 与目标路径成对。校验通过后把规范化结果写回 $1
# 指定的变量。字符集收紧到 URL 常用字符，挡住空格和引号，避免改变指令边界。
Check_Proxy_Backend()
{
    # 局部变量统一加前缀：调用方传进来的变量名不能被本函数的局部名遮蔽。
    local __var="$1" __val="${!1}" __port

    if [ -z "${__val}" ]; then
        Echo_Red "后端地址不能为空。"
        return 1
    fi
    case "${__val}" in
        http://*|https://*) ;;
        *) __val="http://${__val}" ;;
    esac
    if ! printf '%s' "${__val}" | grep -Eq \
         '^https?://[A-Za-z0-9._-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$'; then
        Echo_Red "后端地址格式不对，示例：127.0.0.1:3000 或 http://127.0.0.1:3000/api/"
        return 1
    fi
    __port=$(printf '%s' "${__val}" | sed -nE 's#^https?://[^/:]+:([0-9]+).*$#\1#p')
    if [ -n "${__port}" ] && { [ "${__port}" -lt 1 ] || [ "${__port}" -gt 65535 ]; }; then
        Echo_Red "端口不合法：${__port}"
        return 1
    fi
    case "${__val}" in
        */) ;;
        *) __val="${__val}/" ;;
    esac
    printf -v "${__var}" '%s' "${__val}"
    return 0
}

# 站点类型为反向代理时调用：整站请求转给后端，本地不解析。
# 非交互执行读 VHOST_PROXY=<后端地址>，未设置时不配置反代。
Site_Proxy_Menu()
{
    enable_proxy="n"
    proxy_backend=""
    proxy_backend_host=""
    proxy_use_backend_host="n"

    if [ ! -t 0 ]; then
        [ -n "${VHOST_PROXY:-}" ] || return 0
        proxy_backend="${VHOST_PROXY:-}"
        if ! Check_Proxy_Backend proxy_backend; then
            proxy_backend=""
            Echo_Red "非交互执行，VHOST_PROXY 不合法，已放弃建站。"
            return 1
        fi
        enable_proxy="y"
        echo "非交互执行，按 VHOST_PROXY 配置反向代理：${proxy_backend}"
        Site_Proxy_Backend_Detail
        return 0
    fi

    enable_proxy="y"

    while :;do
        Echo_Yellow "后端地址（示例 127.0.0.1:3000，默认 http://127.0.0.1:3000）: "
        Read_Input proxy_backend "后端地址"
        [ -n "${proxy_backend}" ] || proxy_backend="http://127.0.0.1:3000"
        Check_Proxy_Backend proxy_backend && break
    done
    echo "反向代理后端：${proxy_backend}"
    echo "站点目录仍会创建，用于 /.well-known/ 证书验证，其余请求全部转给后端。"
    Site_Proxy_Backend_Detail
    return 0
}

# 整站反代块，与 PHP 互斥，80 与 443 共用。mod_proxy 与 mod_proxy_http 由
# httpd24-lamp.conf 默认加载。不写 .php 的 404 规则，.php 路径由后端处理。
Site_Apache_Proxy_Block()
{
    local ws_scheme='ws' preserve='On'

    case "${proxy_backend}" in
        https://*) ws_scheme='wss' ;;
    esac
    # On 把访问者请求里的域名传给后端，Off 用 ProxyPass 目标里的主机名。
    # IP 后端没问过 Host 头，保持 On，与 Nginx 侧的 Host $host 一致。
    [ "${proxy_use_backend_host}" = "y" ] && preserve='Off'

    printf '%s\n' "# 整站反向代理到 ${proxy_backend}，本地 DocumentRoot 只用于 /.well-known/ 验证。"
    printf '%s\n' "ProxyRequests Off"
    printf '%s\n' "ProxyPreserveHost ${preserve}"
    case "${proxy_backend}" in
        https://*)
            # 后端是 HTTPS，代理侧要单独开 TLS；mod_proxy 会自动带 SNI。
            printf '%s\n' "SSLProxyEngine On"
            ;;
    esac
    cat <<'EOF'
# 代理请求不落到本地文件系统，DirectoryMatch 与 FilesMatch 拦不住它们，
# 点开头路径改按 URL 拒绝，否则后端的 /.git/、/.env 会被整站透传出去。
# 两个分支分别覆盖根下（放行 /.well-known/）和更深层级，与 Nginx 侧的
# location ~ /\. 取同一范围。
<LocationMatch "^(/\.(?!well-known/)|.+/\.)">
    Require all denied
</LocationMatch>
ProxyPass /.well-known/ !
EOF
    printf '%s\n' "ProxyPass / ${proxy_backend}"
    printf '%s\n' "ProxyPassReverse / ${proxy_backend}"
    printf '%s\n' "# WebSocket 需要额外规则，mod_proxy_wstunnel 已加载，按需去掉注释："
    printf '%s\n' "#RewriteEngine On"
    printf '%s\n' "#RewriteCond %{HTTP:Upgrade} =websocket [NC]"
    printf '%s\n' "#RewriteRule ^/?(.*) ${ws_scheme}://${proxy_backend#*://}\$1 [P,L]"
}

# 拒绝隐藏文件与隐藏目录（ACME 的 .well-known 除外）。80 与 443 共用。
Site_Apache_Hidden_Deny_Block()
{
    cat <<'EOF'
# 拒绝 .env、.git 等隐藏文件和隐藏目录；ACME 验证用的 .well-known 除外。
<DirectoryMatch "/\.(?!well-known)">
    Require all denied
</DirectoryMatch>
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>
EOF
}

# 站点公共配置片段目录。SSLEngine 只能按 VirtualHost 开关，80 与 443 无法合并成
# 一个块，改为两个块 Include 同一个片段，使站点级配置只有一份来源。
Vhost_Shared_Dir="/usr/local/apache/conf/vhost/shared"

# 片段在 Apache 配置中的 Include 路径，相对 ServerRoot。
Site_Shared_Include()
{
    printf 'conf/vhost/shared/%s.conf' "$1"
}

# 返回站点参数所在的配置文件：片段结构返回片段，内联结构返回主文件。
# 2.3 之前建的站点没有片段，两种形态都要能读。
Site_Params_Conf()
{
    local domain="$1" main="${2:-/usr/local/apache/conf/vhost/$1.conf}"
    local frag="${Vhost_Shared_Dir}/${domain}.conf"

    if [ -s "${frag}" ] && grep -qF "Include $(Site_Shared_Include "${domain}")" "${main}" 2>/dev/null; then
        printf '%s' "${frag}"
    else
        printf '%s' "${main}"
    fi
}

# 目录属主必须是 www，否则 PHP 进程读不到站点文件。权限位区别对待：
# 新建或空目录直接给 755；复用的非空目录默认保持原样，递归 755 会给普通文件
# 加上执行位，并把 .env、密钥一类原本 600/640 的文件放宽为所有本地用户可读。
Prepare_Vhost_Dir_Perm()
{
    local dir="$1" created="$2" fix='n' own='n' rc=0

    # 本次新建或本来就是空目录，里面没有别人的文件，可以直接定权限和属主。
    if [ "${created}" = 'y' ] || [ -z "$(ls -A "${dir}" 2>/dev/null)" ]; then
        chmod 755 "${dir}" || rc=1
        if ! chown -R www:www "${dir}"; then
            Echo_Red "变更 ${dir} 属主失败，PHP 进程 可能无法读取站点文件。"
            rc=1
        fi
        return ${rc}
    fi

    echo "目录 ${dir} 已存在且非空，默认保留其中文件的权限位和属主。"
    # 非交互执行不占用输入行，否则既有的管道调用会在这里因 EOF 中断建站。
    if [ ! -t 0 ]; then
        case "${VHOST_FIX_PERM:-}" in
            [yY]) fix='y'; echo "非交互执行，按 VHOST_FIX_PERM=y 统一权限。" ;;
            *)    echo "非交互执行，保留原权限位（如需统一，设置 VHOST_FIX_PERM=y）。" ;;
        esac
    else
        Read_YN fix "是否把目录统一改为 755、普通文件改为 644? (y/N，默认 n) " n "权限规范化开关"
    fi
    if [ "${fix}" = 'y' ]; then
        find "${dir}" -type d -exec chmod 755 {} + || rc=1
        find "${dir}" -type f -exec chmod 644 {} + || rc=1
    fi

    # 属主单独确认：复用目录里可能有部署账号、CI 或其它服务的文件，
    # 递归改成 www:www 会破坏后续部署和最小权限边界。
    echo "该目录下现有的属主："
    find "${dir}" -mindepth 1 -maxdepth 1 -printf '%u:%g\n' 2>/dev/null \
        | sort -u | head -n 10 | sed 's/^/  /'
    if [ ! -t 0 ]; then
        case "${VHOST_FIX_OWNER:-}" in
            [yY]) own='y'; echo "非交互执行，按 VHOST_FIX_OWNER=y 统一属主为 www:www。" ;;
            *)    echo "非交互执行，保留原属主（如需统一，设置 VHOST_FIX_OWNER=y）。" ;;
        esac
    else
        Read_YN own "是否把 ${dir} 下所有文件的属主统一改为 www:www? (y/N，默认 n) " n "属主统一开关"
    fi
    if [ "${own}" = 'y' ]; then
        if ! chown -R www:www "${dir}"; then
            Echo_Red "变更 ${dir} 属主失败，部分文件可能已改、部分未改，请自行核对。"
            rc=1
        fi
    else
        echo "已保留原属主；若 PHP 进程 读不到站点文件，请自行给 www 用户授予读取权限。"
    fi
    return ${rc}
}

Add_VHost_Config()
{
    local apache_open_basedir apache_php_off apache_dir_index apache_hidden_deny
    local main_conf="/usr/local/apache/conf/vhost/${domain}.conf"
    local shared_conf="${Vhost_Shared_Dir}/${domain}.conf"

    apache_hidden_deny="$(Site_Apache_Hidden_Deny_Block)"

    Check_Config_Name "${al_name}" "访问日志文件名" || return 1
    Check_Server_Admin_Email "${email}" || return 1
    apache_open_basedir="$(Site_Apache_Open_Basedir "${site_basedir:-${vhostdir}}")"
    apache_php_off="$(Site_Apache_PHP_Version_Block "${apache_php_ver:-}")"
    apache_dir_index="DirectoryIndex index.html index.php"
    if [ "${enable_site_php}" = "n" ]; then
        # 未启用 PHP 时无需设置 open_basedir。
        apache_open_basedir="$(Site_Apache_Open_Basedir "${vhostdir}" off)"
        apache_php_off="$(Site_Apache_PHP_Off_Block)"
        apache_dir_index="DirectoryIndex index.html"
        # 反代站点的 .php 由后端处理，本地既不解析也不返回 404。
        if [ "${enable_proxy}" = "y" ]; then
            apache_php_off="$(Site_Apache_Proxy_Block)"
        fi
    fi

    if ! mkdir -p "${Vhost_Shared_Dir}"; then
        Echo_Red "创建站点公共配置目录失败：${Vhost_Shared_Dir}"
        return 1
    fi

    # 片段被 80 与 443 共同 Include，只放两个端口都适用的指令。
    cat >"${shared_conf}"<<EOF || { Echo_Red "写入 ${shared_conf} 失败。"; return 1; }
# 站点公共配置，由 80 与 443 两个 VirtualHost 共同 Include。
# SSLEngine、证书路径和 301 跳转写在各自的 VirtualHost 内，不放这里。
ServerAdmin ${email}
${apache_open_basedir}
DocumentRoot "${vhostdir}"
ServerName ${domain}
ErrorLog "/home/wwwlogs/${al_name}-error_log"
CustomLog "/home/wwwlogs/${al_name}-access_log" combined
${apache_php_off}
<Directory "${vhostdir}">
    Options SymLinksIfOwnerMatch
    AllowOverride All
    Require all granted
    ${apache_dir_index}
</Directory>
${apache_hidden_deny}

# 自定义配置--开始

# 自定义配置--结束
EOF

    cat >"${main_conf}"<<EOF || { Echo_Red "写入 ${main_conf} 失败。"; rm -f "${shared_conf}"; return 1; }
<VirtualHost *:80>
Include $(Site_Shared_Include "${domain}")
</VirtualHost>
EOF

    # 错误日志始终保留，仅访问日志随开关关闭。
    if [ "${access_log}" != 'y' ]; then
        sed -i 's/^CustomLog/#CustomLog/g' "${shared_conf}"
    fi

    if [ "${moredomain}" != "" ]; then
        sed -i "/^ServerName/a\
ServerAlias ${moredomain}" "${shared_conf}"
    fi

    # 配置测试失败时撤销虚拟主机，避免无效配置影响 Apache。
    echo "正在检查 Apache 配置..."
    if ! /etc/init.d/httpd configtest; then
        Echo_Red "Apache 配置测试未通过，已撤销本次新增的虚拟主机配置。"
        rm -f "${main_conf}" "${shared_conf}"
        return 1
    fi
    echo "正在平滑重载 Apache..."
    # 重载失败必须撤销站点配置：留在磁盘上会让下次建站报"域名已存在"，
    # 而以后任意一次重载又会把这个未完成的站点放到线上。
    if ! /etc/init.d/httpd graceful; then
        Echo_Red "Apache 平滑重载失败，已撤销本次新增的虚拟主机配置。"
        rm -f "${main_conf}" "${shared_conf}"
        /etc/init.d/httpd graceful >/dev/null 2>&1
        return 1
    fi
    return 0
}

Print_Default_Site_Intro()
{
    Echo_Green "===================================================================="
    Echo_Green " 欢迎使用添加域名站点功能！"
    Echo_Green " 本包已内置 default「兜底站点」保留名，请勿将 default 用作普通站点域名。"
    Echo_Green " 所有未匹配到其它站点的访问请求（包括直接通过服务器 IP 访问）都会进入此站点，"
    Echo_Green " 根目录为 /home/wwwroot/default，无需通过 vhost add 重复创建。"
    Echo_Green "===================================================================="
}

# 新站点声明的域名不能已被其它虚拟主机使用：重复的 ServerName / ServerAlias 不会让配置
# 测试失败，但请求仍由先加载的站点处理，新站点实际访问不到。
Check_Domain_Not_Taken()
{
    local names="$1" f taken=0 d

    [ -d "${Vhost_Conf_Dir}" ] || return 0
    for f in "${Vhost_Conf_Dir}"/*.conf; do
        [ -s "${f}" ] || continue
        for d in ${names}; do
            Vhost_Has_Domain "$(Site_Params_Conf "$(basename "${f}" .conf)" "${f}")" "${d}" || continue
            [ "${taken}" -eq 0 ] && Echo_Red "以下域名已被现有站点声明："
            Echo_Red "  ${d} -> ${f}"
            taken=1
        done
    done
    [ "${taken}" -eq 0 ] && return 0
    Echo_Yellow "请换一个域名，或先用 lnmp vhost del 删除占用它的站点。"
    echo
    return 1
}

Add_VHost()
{
    Print_Default_Site_Intro
    domain=""
    while :;do
        Echo_Yellow "请输入域名（示例：www.example.com）: "
        Read_Input domain "域名"
        Lower_Domain_Input domain
        # default 是安装时创建的兜底站点，不能作为普通域名重复创建。
        if [ "${domain}" = "default" ]; then
            Echo_Green " default 站已安装，是默认兜底站，如需为其配置 SSL 证书，请执行 lnmp ssl add"
            return 0
        fi
        Check_Domain_Name "${domain}" || continue
        Reject_Wildcard_Site "${domain}" || continue
        if [ -f "/usr/local/apache/conf/vhost/${domain}.conf" ]; then
            Echo_Red "域名 ${domain} 已存在，请检查。"
            continue
        fi
        Check_Domain_Not_Taken "${domain}" || continue
        echo "您的域名：${domain}"
        break
    done

    while :;do
        Echo_Yellow "请输入更多域名（示例：example.com *.example.com，留空跳过）: "
        Read_Input moredomain "更多域名"
        Lower_Domain_Input moredomain
        [ -z "${moredomain}" ] && break
        Check_More_Domains "${moredomain}" || continue
        Check_More_Domains_Unique "${domain}" "${moredomain}" || continue
        Reject_Wildcard_Site "${moredomain}" || continue
        Check_Domain_Not_Taken "${moredomain}" || continue
        break
    done
    if [ "${moredomain}" != "" ]; then
        echo "附加域名：${moredomain}"
    fi

    Site_Type_Menu || return 1
    Site_Preset_Menu || return 1
    enable_proxy="n"
    proxy_backend=""
    proxy_backend_host=""
    proxy_use_backend_host="n"
    proxy_backend_resolvable="y"
    if [ "${site_type}" == "proxy" ]; then
        Site_Proxy_Menu || return 1
    fi

    while :;do
        echo "请输入域名 $domain 的网站目录。"
        Echo_Yellow "网站目录（默认 /home/wwwroot/${domain}）: "
        Read_Input vhostdir "网站目录"
        if [ "${vhostdir}" == "" ]; then
            vhostdir="/home/wwwroot/${domain}"
        fi
        # 目录会用于递归创建和授权，必须先规范化并限制在站点根目录内；
        # 校验通过后 Check_Vhost_Dir 会把规范化路径写回 vhostdir。
        Check_Vhost_Dir "${vhostdir}" && Site_Project_Dir && break
        Echo_Red "请重新输入网站目录。"
    done
    echo "虚拟主机目录：${vhostdir}"

    # 已装附加 PHP 版本时为站点选择版本，只有主 PHP 时不询问。
    apache_php_ver=''
    [ "${enable_site_php}" = "y" ] && Apache_MPHP_Choose

    Read_YN access_log "是否启用访问日志 [Y/n]（默认 y）: " y "访问日志开关"
    if [ "${access_log}" == "n" ]; then
        echo "已禁用访问日志。"
        al_name="${domain}"
    else
        while :;do
            Echo_Yellow "访问日志文件名（默认 ${domain}-access_log）: "
            Read_Input al_name "访问日志文件名"
            if [ "${al_name}" == "" ]; then
                al_name="${domain}"
            fi
            Check_Config_Name "${al_name}" "访问日志文件名" && break
        done
        echo "访问日志文件名：${al_name}-access_log"
    fi

    email=""
    while :;do
        Echo_Yellow "请输入管理员邮箱（默认 webmaster@example.com）: "
        Read_Input email "管理员邮箱"
        if [ "${email}" == "" ]; then
            echo "未输入，管理员邮箱将设为 webmaster@example.com。"
            email='webmaster@example.com'
            break
        fi
        Check_Server_Admin_Email "${email}" || continue
        echo "服务器管理员邮箱：${email}"
        break
    done

    if [[ -x /usr/local/mysql/bin/mysql || -x /usr/local/mariadb/bin/mariadb || -x /usr/local/mariadb/bin/mysql ]]; then
        if [ "${site_preset}" == "none" ]; then
            Read_YN create_database "是否创建同名数据库和 MySQL 用户 [y/N]（默认 n）: " n "建库开关"
        else
            Read_YN create_database "是否创建同名数据库和 MySQL 用户 [Y/n]（默认 y）: " y "建库开关"
        fi

        if [ "${create_database}" == "y" ]; then
            Verify_DB_Password || exit 1
            Add_Database_Menu || exit 1
        fi
    fi

    if [ -s /usr/local/pureftpd/sbin/pure-ftpd ]; then
        Read_YN create_ftp "是否创建 FTP 账号 [y/N]（默认 n）: " n "FTP 账号开关"

        if [ "${create_ftp}" == "y" ]; then
            Add_Ftp_Menu
        fi
    fi

    Read_YN create_ssl "是否添加 SSL 证书（HTTP 验证，需 80 端口可从公网访问）[y/N]（默认 n）: " n "SSL 开关"
    if [ "${create_ssl}" == "y" ]; then
        Add_SSL_Menu
    fi

    Press_Any_Key_Or_Line "按任意键开始创建虚拟主机，或按 Ctrl+C 取消..." || return 1

    echo "正在创建虚拟主机目录......"
    # 记录目录是否由本次创建，配置失败时只回收本次新建的空目录。
    vhostdir_created="n"
    [ -d "${vhostdir}" ] || vhostdir_created="y"
    basedir_created="${vhostdir_created}"
    [ -d "${site_basedir}" ] && basedir_created="n"
    mkdir -p "${vhostdir}" || return 1
    echo "正在设置虚拟主机目录权限......"
    # 权限设置失败不阻断建站，但必须提示用户核对，否则 PHP 可能读不到站点文件。
    if ! Prepare_Vhost_Dir_Perm "${site_basedir}" "${basedir_created}"; then
        Echo_Yellow "站点目录权限或属主未完全设置，建站继续，请稍后核对 ${site_basedir}。"
        echo
    fi

    if ! Add_VHost_Config; then
        [ "${vhostdir_created}" = "y" ] && rmdir "${vhostdir}" 2>/dev/null
        [ "${basedir_created}" = "y" ] && rmdir "${site_basedir}" 2>/dev/null
        return 1
    fi

    if [ "${create_database}" == "y" ]; then
        Add_Database
        database_add_rc=$?
        # 建库完成后立即清理数据库 root 凭据，缩短明文凭据的留存时间。
        TempMycnf_Clean
    fi

    if [ "${create_ftp}" == "y" ]; then
        # FTP 根为项目目录，Laravel 预设下不是网站根目录。
        vhostdir="${site_basedir}" Add_Ftp
        ftp_add_rc=$?
    fi

    if [ "${create_ssl}" == "y" ]; then
        Add_SSL
        ssl_add_rc=$?
    fi

    # 经本机 Web 入口实际请求本站点，确认请求到达站点目录及对应的 PHP 或反代上游。
    local accept_rc=0 accept_ver
    if [ "${domain}" = "default" ]; then
        :
    elif [ "${enable_site_php}" == "y" ]; then
        accept_ver="${apache_php_ver}"
        [ -n "${accept_ver}" ] || accept_ver=$(/usr/local/php/bin/php-config --version 2>/dev/null)
        Vhost_Accept "${domain}" "${vhostdir}" php "${accept_ver}" || accept_rc=1
    elif [ "${enable_proxy}" == "y" ]; then
        Vhost_Accept "${domain}" "${vhostdir}" proxy || accept_rc=1
    else
        Vhost_Accept "${domain}" "${vhostdir}" static || accept_rc=1
    fi

    Echo_Green "================================================"
    echo "虚拟主机信息："
    echo "域名：${domain}"
    echo "网站目录：${vhostdir}"
    [ "${site_basedir}" != "${vhostdir}" ] && echo "项目目录：${site_basedir}（open_basedir 范围）"
    [ "${site_preset}" != "none" ] && echo "程序预设：${site_preset}"
    if [ "${enable_site_php}" == "n" ]; then
        if [ "${enable_proxy}" == "y" ]; then
            echo "PHP：未开启（整站反代，.php 由后端处理）"
        else
            echo "PHP：未开启（.php 请求一律返回 404）"
        fi
    else
        echo "PHP：已开启"
    fi
    if [ "${enable_proxy}" == "y" ]; then
        echo "反向代理：${proxy_backend}"
    fi
    if [ "${access_log}" == "y" ]; then
        echo "访问日志：已启用"
    else
        echo "访问日志：未启用"
    fi

    if [ "${create_database}" == "y" ]; then
        if [ "${database_add_rc:-1}" -eq 0 ]; then
            echo "数据库用户名：${database_name}"
            echo "数据库名：${database_name}"
            echo "数据库密码：刚才输入的密码（不回显）"
        else
            Echo_Red "数据库：创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp database add 单独重试建库。"
        fi
    else
        echo "创建数据库：否"
    fi
    if [ "${create_ftp}" == "y" ]; then
        if [ "${ftp_add_rc:-1}" -eq 0 ]; then
            echo "FTP 账号：${ftp_account_name}"
            echo "FTP 密码：刚才输入的密码（不回显）"
        else
            Echo_Red "FTP：账号创建失败，站点本身已建好。"
            Echo_Red "可稍后执行 lnmp ftp add 单独重试。"
        fi
    else
        echo "创建 FTP 账号：否"
    fi
    if [ "${create_ssl}" == "y" ]; then
        if [ "${ssl_add_rc:-1}" -eq 0 ]; then
            echo "SSL：已启用"
            if [ "${ssl_choice}" == "1" ]; then
                echo "  =>自有证书文件"
            elif [ "${ssl_choice}" == "2" ]; then
                echo "  =>Let's Encrypt"
            elif [ "${ssl_choice}" == "3" ]; then
                echo "  =>ZeroSSL"
            fi
        else
            Echo_Red "SSL: 证书添加失败，站点本身已建好，当前只有 HTTP。"
            Echo_Red "可稍后执行 lnmp ssl add 单独重试。"
        fi
    fi
    Echo_Green "================================================"

    # 站点主体已建成，但用户明确请求过的附加操作有失败时返回非零，
    # 否则上层自动化会把未完成的站点当作已交付。
    if [ "${create_database}" == "y" ] && [ "${database_add_rc:-1}" -ne 0 ]; then
        return 1
    fi
    if [ "${create_ftp}" == "y" ] && [ "${ftp_add_rc:-1}" -ne 0 ]; then
        return 1
    fi
    if [ "${create_ssl}" == "y" ] && [ "${ssl_add_rc:-1}" -ne 0 ]; then
        return 1
    fi
    if [ "${accept_rc}" -ne 0 ]; then
        Echo_Red "站点配置已生成，但请求验收未通过，请按上面的提示处理后访问确认。"
        return 1
    fi
    return 0
}

List_VHost()
{
    echo "Apache 虚拟主机列表："
    List_VHost_Dir /usr/local/apache/conf/vhost
}

# Vhost_Entry_Conf <域名>：单站点启停改动的入口配置，输出 类型<TAB>路径。
# 片段结构改公共片段，80 与 443 同时生效；内联结构改主配置的每个 VirtualHost。
Vhost_Entry_Conf()
{
    if [ -s "${Vhost_Shared_Dir}/$1.conf" ]; then
        printf 'apache\t%s\n' "${Vhost_Shared_Dir}/$1.conf"
    elif [ -e "/usr/local/apache/conf/vhost/$1.conf" ]; then
        printf 'apache\t%s\n' "/usr/local/apache/conf/vhost/$1.conf"
    fi
}

Del_VHost()
{
    domain="$1"
    if [ -n "${domain}" ]; then
        Lower_Domain_Input domain
        # 域名会组成待删除的配置文件路径，因此必须先限制字符集。
        Check_Domain_Name "${domain}" || exit 1
        Reject_Default_Site_Del "${domain}" || exit 1
    else
        echo "======================================="
        echo "当前虚拟主机："
        List_VHost
        echo "======================================="
        while :;do
            Echo_Yellow "请输入要删除的域名: "
            Read_Input domain "域名"
            Lower_Domain_Input domain
            # 域名会组成待删除的配置文件路径，因此必须先限制字符集。
            Check_Domain_Name "${domain}" || continue
            Reject_Default_Site_Del "${domain}" || continue
            break
        done
    fi
    if [ ! -f "/usr/local/apache/conf/vhost/${domain}.conf" ]; then
        echo "=========================================="
        echo "域名 ${domain} 不存在。"
        echo "=========================================="
        exit 1
    else
        Del_VHost_Files "${domain}" || exit 1

        echo "========================================================"
        echo "域名 ${domain} 已删除。"
        echo "为安全起见，网站文件不会被自动删除。"
        echo "如需清理，请手动删除对应网站文件。"
        echo "========================================================"
    fi
}

# 先备份再删除，语法检查或重载失败时整体回滚。
# 直接删除会让磁盘状态与运行中的 Apache 配置分离，且被删文件无法自动恢复。
Del_VHost_Files()
{
    local domain="$1"
    local vhost_conf="/usr/local/apache/conf/vhost/${domain}.conf"
    local shared_conf="${Vhost_Shared_Dir}/${domain}.conf"
    local conf_backup shared_backup=''

    LNMP_Tmp_Init || return 1
    conf_backup=$(LNMP_Mktemp del-vhost) || return 1
    if ! \cp -p "${vhost_conf}" "${conf_backup}"; then
        rm -f "${conf_backup}"
        Echo_Red "备份 ${vhost_conf} 失败，未删除任何文件。"
        return 1
    fi
    # 片段结构的站点要连同片段删除，否则同名站点重建时会读到旧配置。
    if [ -s "${shared_conf}" ]; then
        if ! shared_backup=$(LNMP_Mktemp del-shared); then
            rm -f "${conf_backup}"
            return 1
        fi
        if ! \cp -p "${shared_conf}" "${shared_backup}"; then
            rm -f "${conf_backup}" "${shared_backup}"
            Echo_Red "备份 ${shared_conf} 失败，未删除任何文件。"
            return 1
        fi
    fi

    rm -f "${vhost_conf}"
    if [ -n "${shared_backup}" ]; then
        rm -f "${shared_conf}"
    fi

    # 删除配置后必须重载 Apache，才能使运行中的站点下线。
    if ! Del_VHost_Reload; then
        Del_VHost_Restore "${domain}" "${vhost_conf}" "${conf_backup}" "${shared_conf}" "${shared_backup}"
        rm -f "${conf_backup}"
        [ -n "${shared_backup}" ] && rm -f "${shared_backup}"
        return 1
    fi

    # 站点已下线，此时扫描剩余站点才能判断证书是否还有人引用。
    Report_Vhost_Cert_Residue "${conf_backup}"
    rm -f "${conf_backup}"
    [ -n "${shared_backup}" ] && rm -f "${shared_backup}"
    return 0
}

# 回滚删站，使磁盘状态与运行中的配置重新一致。
Del_VHost_Restore()
{
    local domain="$1" vhost_conf="$2" conf_backup="$3"
    local shared_conf="${4:-}" shared_backup="${5:-}"

    \cp -p "${conf_backup}" "${vhost_conf}"
    if [ -n "${shared_backup}" ] && [ -n "${shared_conf}" ]; then
        \cp -p "${shared_backup}" "${shared_conf}"
    fi
    Echo_Yellow "已恢复站点 ${domain} 的配置文件，站点仍然存在。"

    # 恢复后尽力让运行配置与磁盘一致；此处失败不改变删站已失败的结论。
    if pgrep -f '/usr/local/apache/bin/httpd' >/dev/null 2>&1; then
        /usr/local/apache/bin/httpd -t >/dev/null 2>&1 && Svc httpd reload >/dev/null 2>&1
    fi
}

Del_VHost_Reload()
{
    # 语法检查不依赖服务是否在运行，删完必须校验，否则会把未验证的结果报成成功。
    echo "正在检查 Apache 配置......"
    if ! /usr/local/apache/bin/httpd -t; then
        Echo_Red "Apache 配置测试未通过，未执行重载。"
        return 1
    fi

    if ! pgrep -f '/usr/local/apache/bin/httpd' >/dev/null 2>&1; then
        echo "Apache 未在运行，跳过重载。"
        return 0
    fi

    if Svc httpd reload; then
        echo "Apache 已重载。"
        return 0
    fi
    Echo_Red "Apache 未能重载，运行中的 httpd 仍在提供该站点。"
    return 1
}

# 站点配置中引用的证书与私钥路径。
Vhost_Cert_Paths()
{
    awk '($1 == "SSLCertificateFile" || $1 == "SSLCertificateKeyFile") {
             v = $2
             sub(/;$/, "", v)
             if (substr(v, 1, 1) == "/") print v
         }' "$1" | sort -u
}

# 证书目录是否仍被现存站点引用。泛域名证书常被多个站点共用，且各站点未必
# 引用目录里同一个文件，因此按目录而不是按文件路径判断。
Cert_Dir_In_Use()
{
    local dir="$1" f

    for f in "${Vhost_Conf_Dir}"/*.conf; do
        [ -s "${f}" ] || continue
        awk -v d="${dir}/" '
            ($1 == "SSLCertificateFile" || $1 == "SSLCertificateKeyFile" \
             || $1 == "SSLCertificateChainFile") {
                v = $2
                sub(/;$/, "", v)
                if (substr(v, 1, length(d)) == d) hit = 1
            }
            END { exit hit ? 0 : 1 }
        ' "${f}" && return 0
    done
    return 1
}

# 凭据和 SQL 临时文件使用 root 专属随机目录，并在退出时统一清理。
# SQL 字符串需要转义，数据库标识符需要通过字符白名单校验。

# root 专属临时目录。
LNMP_Tmp_Dir=""
# 标记 ~/.my.cnf 是否为临时生成的数据库 root 凭据。
LNMP_Mycnf_Owned=0

# 域名会写入文件路径和 Apache 配置，站点目录会用于递归授权，均需边界检查。

# 备份与恢复
#
#   lnmp database export <数据库名> <文件.sql.gz>
#   lnmp database import <数据库名> <文件.sql.gz>
#
# 导出文件不含 CREATE DATABASE 或 USE，导入目标由命令参数决定，支持恢复到其它库名。

# 从数据库客户端目录选择导出程序，MariaDB 优先使用 mariadb-dump。
MySQL_Dump_Bin=""

# 从现有虚拟主机读回站点参数，供 ssl add 与 dnsssl 复用。
Load_Vhost_Params()
{
    local vhost_conf params_conf

    if [ "${domain}" = "default" ]; then
        vhost_conf="/usr/local/apache/conf/extra/httpd-vhosts.conf"
    else
        vhost_conf="/usr/local/apache/conf/vhost/${domain}.conf"
    fi
    if [ ! -s "${vhost_conf}" ]; then
        Echo_Red "未找到网站 ${domain} 的虚拟主机配置。"
        Echo_Yellow "请先执行 lnmp vhost add 创建网站，再执行 lnmp ssl add 添加证书。"
        echo
        return 1
    fi
    if Vhost_Has_HTTPS "${vhost_conf}"; then
        Echo_Red "网站 ${domain} 已存在 HTTPS/443 配置，不能重复添加证书。"
        Echo_Yellow "如需更换证书，请先检查并处理现有 SSL 配置。"
        echo
        return 1
    fi
    ssl_vhost_conf="${vhost_conf}"
    # 站点参数在片段结构下位于片段文件内，内联结构下仍在主文件内。
    params_conf=$(Site_Params_Conf "${domain}" "${vhost_conf}")

    vhostdir=$(awk '$1 == "DocumentRoot" { value=$2; gsub(/^"|"$/, "", value); print value; exit }' "${params_conf}")
    if [ -z "${vhostdir}" ] || [ ! -d "${vhostdir}" ]; then
        Echo_Red "网站 ${domain} 的根目录不存在或无法从 ${params_conf} 读取。"
        return 1
    fi

    moredomain=$(awk -v primary="${domain}" '
        $1 == "ServerName" || $1 == "ServerAlias" {
            for (i=2; i<=NF; i++) {
                if ($i != primary && $i != "_") {
                    if (out != "") out=out " "
                    out=out $i
                }
            }
        }
        END { print out }
    ' "${params_conf}")
    email=$(awk '$1 == "ServerAdmin" { print $2; exit }' "${params_conf}")
    email="${email:-webmaster@example.com}"
    # HTTPS 沿用现有站点的 PHP 状态，防止 443 端口意外执行 .php。
    # default 站点由 Create_SSL_Config 单独处理。
    if [ "${domain}" != "default" ] && grep -Eq '^[[:space:]]*(php_admin_flag[[:space:]]+engine[[:space:]]+off|RedirectMatch[[:space:]]+404[[:space:]]+"\\\.php)' "${params_conf}"; then
        enable_site_php="n"
        echo "网站 ${domain} 未开启 PHP，HTTPS 配置沿用同一状态。"
    else
        enable_site_php="y"
    fi

    # HTTPS 必须继承 HTTP 的站点级自定义配置，否则 ProxyPass 等规则
    # 只在 80 端口生效，443 会落到静态 DocumentRoot 上。
    ssl_custom_block=$(Extract_Custom_Block "${params_conf}")
    if [ -n "${ssl_custom_block}" ]; then
        echo "已读取网站 ${domain} 的自定义配置，将一并写入 HTTPS 配置。"
    fi
    al_name="${domain}"
    if grep -Eq '^[[:space:]]*CustomLog[[:space:]]+' "${params_conf}"; then
        access_log="y"
    else
        access_log="n"
    fi

    return 0
}

