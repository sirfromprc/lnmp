Create_SSL_Config()
{
    local vhost_conf="${ssl_vhost_conf:-/usr/local/apache/conf/vhost/${domain}.conf}"
    local backup httpd_conf_backup use_shared='n'
    local ssl_server_name="${domain}" ssl_open_basedir ssl_directory_options ssl_php_off
    local ssl_hidden_deny

    # 站点已是片段结构时，443 只写 SSL 专有指令并 Include 同一片段。
    # default 站点的配置在 httpd-vhosts.conf 内，2.3 之前建的站点是内联结构，
    # 两者都保持原来的完整 VirtualHost 写法。
    if [ "${domain}" != 'default' ] \
        && [ -s "${Vhost_Shared_Dir}/${domain}.conf" ] \
        && grep -qF "Include $(Site_Shared_Include "${domain}")" "${vhost_conf}"; then
        use_shared='y'
    fi
    # 内联结构追加的 443 块不含停用片段，停用期间添加会让 HTTPS 恢复访问。
    if [ "${use_shared}" != 'y' ] && Vhost_Is_Stopped "${vhost_conf}"; then
        Echo_Red "站点 ${domain} 已停用，请先执行 lnmp vhost start ${domain} 再添加 SSL。"
        return 1
    fi

    Check_Config_Name "${al_name}" "访问日志文件名" || return 1
    Check_Server_Admin_Email "${email}" || return 1
    Check_Config_File_Path "${ssl_certificate}" "SSL 证书文件" || return 1
    Check_Config_File_Path "${ssl_certificate_key}" "SSL 私钥文件" || return 1
    if [ "${ssl_choice}" = '1' ] && [ -n "${ssl_chain:-}" ]; then
        Check_Config_File_Path "${ssl_chain}" "SSL 证书链文件" || return 1
    fi
    ssl_hidden_deny="$(Site_Apache_Hidden_Deny_Block)"
    ssl_open_basedir="$(Site_Apache_Open_Basedir "${vhostdir}")"
    ssl_directory_options='    AllowOverride All
    Require all granted
    DirectoryIndex index.html index.php'
    ssl_php_off=""
    if [ "${enable_site_php}" = "n" ]; then
        # 与 80 端口保持相同的 PHP 状态，所有 .php 请求返回 404。
        ssl_open_basedir="$(Site_Apache_Open_Basedir "${vhostdir}" off)"
        # 站点自行移除 .php 拦截时（整站反代要把 .php 交给后端）不再写回。
        if grep -qF 'RedirectMatch 404' "${vhost_conf}"; then
            ssl_php_off="$(Site_Apache_PHP_Off_Block)"
        else
            ssl_php_off="$(Site_Apache_Engine_Off)"
        fi
        ssl_directory_options='    AllowOverride All
    Require all granted
    DirectoryIndex index.html'
    fi
    if [ "${domain}" = "default" ]; then
        # default 站点保留 phpMyAdmin 和演示页运行环境，仅拒绝根目录下的 .php。
        ssl_server_name='_'
        ssl_php_off=""
        ssl_open_basedir="$(Site_Apache_Open_Basedir "${vhostdir}" off)"
        ssl_directory_options='    AllowOverride None
    Require all granted
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
    # 与 80 端口的 default 站点一致：仅放行按开关部署的演示页。
    <FilesMatch "^(phpinfo|redis|memcached)\.php$">
        Require all granted
    </FilesMatch>
    DirectoryIndex index.html'
    fi

    LNMP_Tmp_Init || return 1
    backup=$(LNMP_Mktemp ssl-vhost) || return 1
    httpd_conf_backup=$(LNMP_Mktemp ssl-httpd) || { rm -f "${backup}"; return 1; }
    \cp -p "${vhost_conf}" "${backup}" || { rm -f "${backup}" "${httpd_conf_backup}"; return 1; }
    \cp -p /usr/local/apache/conf/httpd.conf "${httpd_conf_backup}" || {
        rm -f "${backup}" "${httpd_conf_backup}"
        return 1
    }
    if /usr/local/apache/bin/httpd -v|grep -Eqi "Apache/2.4.*"; then
        Conf_H2='Protocols h2 h2c http/1.1'
    else
        Conf_H2=''
    fi
    if echo "${ssl_choice}" | grep -Eqi "^[2-4]$"; then
        # 证书目录随主域名变化，泛域名证书目录名与站点名不同。
        Conf_SSLChain="SSLCertificateChainFile $(dirname "${ssl_certificate}")/ca.cer"
    fi

    sed -i 's@#Include conf/extra/httpd-ssl.conf@Include conf/extra/httpd-ssl.conf@g' /usr/local/apache/conf/httpd.conf
    if [ "${use_shared}" = 'y' ]; then
        cat >>"${vhost_conf}"<<EOF

<VirtualHost *:443>
SSLEngine on
SSLCertificateFile ${ssl_certificate}
SSLCertificateKeyFile ${ssl_certificate_key}
${Conf_SSLChain}
${Conf_H2}
Include $(Site_Shared_Include "${domain}")
</VirtualHost>
EOF
    else
    cat >>"${vhost_conf}"<<EOF

<VirtualHost *:443>
ServerAdmin ${email}
${ssl_open_basedir}
DocumentRoot ${vhostdir}
ServerName ${ssl_server_name}
SSLEngine on
SSLCertificateFile ${ssl_certificate}
SSLCertificateKeyFile ${ssl_certificate_key}
${Conf_SSLChain}
${Conf_H2}
ErrorLog "/home/wwwlogs/${al_name}-error_log"
CustomLog "/home/wwwlogs/${al_name}-access_log" combined
${ssl_php_off}
<Directory "${vhostdir}">
    Options SymLinksIfOwnerMatch
${ssl_directory_options}
</Directory>
${ssl_hidden_deny}

# 自定义配置--开始
${ssl_custom_block}
# 自定义配置--结束
</VirtualHost>
EOF
    fi

    # 片段结构的日志、ServerAlias 都在片段里，两个 VirtualHost 共用，无需再处理。
    if [ "${use_shared}" != 'y' ]; then
        # 错误日志始终保留，仅访问日志随开关关闭。
        if [ "${access_log}" != 'y' ]; then
            sed -i 's/^CustomLog/#CustomLog/g' "${vhost_conf}"
        fi
        if [ "${moredomain}" != "" ]; then
            sed -i "/^SSLEngine on/i\ServerAlias ${moredomain}" "${vhost_conf}"
        fi
    fi

    if [ "${using_301}" = "y" ]; then
        if [ "${use_shared}" = 'y' ]; then
            # 片段结构的 80 端口块内没有 ServerName，锚点改用块起始行。
            sed -i '0,/^<VirtualHost \*:80>/!b;//a\RewriteEngine On\nRewriteCond %{HTTPS} off\nRewriteCond %{REQUEST_URI} !^\/\.well-known/.*$\nRewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]' "${vhost_conf}"
        else
            sed -i '0,/^ServerName/!b;//a\RewriteEngine On\nRewriteCond %{HTTPS} off\nRewriteCond %{REQUEST_URI} !^\/\.well-known/.*$\nRewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]' "${vhost_conf}"
        fi
    fi

    echo "正在检查 Apache 配置..."
    if ! /etc/init.d/httpd configtest; then
        Echo_Red "Apache 配置测试未通过，已恢复添加 SSL 前的配置。"
        \cp -p "${backup}" "${vhost_conf}"
        \cp -p "${httpd_conf_backup}" /usr/local/apache/conf/httpd.conf
        rm -f "${backup}" "${httpd_conf_backup}"
        return 1
    fi
    echo "正在平滑重载 Apache..."
    if ! /etc/init.d/httpd graceful; then
        Echo_Red "Apache 重载失败，已恢复添加 SSL 前的配置。"
        \cp -p "${backup}" "${vhost_conf}"
        \cp -p "${httpd_conf_backup}" /usr/local/apache/conf/httpd.conf
        /etc/init.d/httpd graceful
        rm -f "${backup}" "${httpd_conf_backup}"
        return 1
    fi
    rm -f "${backup}" "${httpd_conf_backup}"
    return 0
}

Add_SSL()
{
    local vhost_conf="${ssl_vhost_conf:-/usr/local/apache/conf/vhost/${domain}.conf}"

    if [ ! -s "${vhost_conf}" ]; then
        Echo_Red "未找到网站 ${domain} 的虚拟主机配置。"
        Echo_Yellow "请先执行 lnmp vhost add 创建网站，再执行 lnmp ssl add 添加证书。"
        echo
        return 1
    fi
    if [ -z "${vhostdir:-}" ] || [ ! -d "${vhostdir}" ]; then
        Echo_Red "网站 ${domain} 的根目录不存在，无法添加证书。"
        return 1
    fi
    if [[ "${domain}" = "default" && ! "${ssl_choice}" =~ ^(1|2)$ ]]; then
        Echo_Red "default 站点只支持自有证书或 Let's Encrypt IP 证书。"
        return 1
    fi

    if [ "${ssl_choice}" == "1" ]; then
        Verify_Own_Cert "${ssl_certificate}" "${ssl_certificate_key}" \
            "${domain}" "${moredomain}" || return 1
        Create_SSL_Config || return 1
    elif [[ "${ssl_choice}" =~ ^(2|3)$ ]]; then
        cert_profile_opt=""
        letsdomain="-d ${domain}"
        if [ "${moredomain}" != "" ]; then
            # 泛域名带 *，拆分期间关闭路径展开。
            set -f
            for i in ${moredomain};do
                # HTTP-01 不能签发泛域名，站点配置里已有的泛域名不带入本次证书。
                case "${i}" in
                \*.*)
                    Echo_Yellow "HTTP 验证不能签发泛域名，${i} 不加入本次证书。"
                    echo
                    continue
                    ;;
                esac
                letsdomain=${letsdomain}" -d ${i}"
            done
            set +f
        fi
        if [ "${domain}" = "default" ]; then
            Prepare_Default_Site_IP_Cert || return 1
        fi
        if [[ "${vhostdir}" == "" || "${letsdomain}" == "" ]]; then
            Echo_Red "缺少必要参数：网站目录和证书申请目标不能为空。"
            return 1
        fi

        Install_Check_Acme.sh || return 1

        Backup_Cert_Dir "/usr/local/apache/conf/ssl/${domain}" || return 1
        acme_target="${domain}"
        [ "${domain}" = "default" ] && acme_target="${default_site_ip}"
        Note_Acme_Workdir "/usr/local/apache/conf/ssl" "${acme_target}"

        if [ "${ssl_choice}" == "2" ]; then
            echo "正在使用 Let's Encrypt 签发 SSL 证书..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server letsencrypt --issue ${letsdomain} -w ${vhostdir} ${cert_profile_opt} --reloadcmd "/etc/init.d/httpd graceful"
        elif [ "${ssl_choice}" == "3" ]; then
            echo "正在使用 ZeroSSL 签发 SSL 证书..."
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --server zerossl --issue ${letsdomain} -w ${vhostdir} --reloadcmd "/etc/init.d/httpd graceful"
        fi
        lets_status=$?

        if [ "${lets_status}" = 0 ]; then
            cert_install_domain="${domain}"
            [ "${domain}" = "default" ] && cert_install_domain="${default_site_ip}"
            mkdir -p "/usr/local/apache/conf/ssl/${domain}" || { Restore_Cert_Dir; return 1; }
            /usr/local/acme.sh/acme.sh ${acme_sh_sudo} --install-cert -d "${cert_install_domain}" --ecc \
                --cert-file "/usr/local/apache/conf/ssl/${domain}/${domain}.cer" \
                --key-file "/usr/local/apache/conf/ssl/${domain}/${domain}.key" \
                --ca-file "/usr/local/apache/conf/ssl/${domain}/ca.cer" \
                --fullchain-file "/usr/local/apache/conf/ssl/${domain}/fullchain.cer" \
                --reloadcmd "/etc/init.d/httpd graceful"
            lets_status=$?
        fi

