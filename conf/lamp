    app)
        Function_App "${arg2}" "${arg3}"
        ;;
    database)
        # 先认动作名，避免无效参数也要求输入数据库口令。
        case "${arg2}" in
        [aA][dD][dD]|[lL][iI][sS][tT]|[dD][eE][lL]|[eE][dD][iI][tT])
            ;;
        [eE][xX][pP][oO][rR][tT]|[iI][mM][pP][oO][rR][tT])
            # 导出与导入需要库名和文件名，参数不全时先报用法，不必先输口令。
            if [ -z "${arg3}" ] || [ -z "${arg4}" ]; then
                echo "用法：lnmp database $(echo "${arg2}" | tr '[:upper:]' '[:lower:]') <数据库名> <文件.sql.gz>"
                exit 1
            fi
            ;;
        *)
            Function_Database "${arg2}"
            exit $?
            ;;
        esac
