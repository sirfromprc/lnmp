    # Check_Vhost_Dir 幂等，对已规范化的路径重复调用无副作用。
    Check_Vhost_Dir "${vhostdir}" || return 1
    www_uid=`id -u www`
    www_gid=`id -g www`
    if [ ! -d "${vhostdir}" ]; then
        mkdir -p "${vhostdir}"
        chown www:www -R "${vhostdir}"
    fi

    ftp_pass_file=$(LNMP_Mktemp ftppass) || exit 1
