# CentOS 8.5.2111 官方归档源，使用 HTTPS、GPG 校验和随包公钥。
# CentOS 8 已于 2021-12-31 停止安全维护，生产环境应使用仍在支持期的发行版。

[baseos]
name=CentOS-8.5.2111 - BaseOS
baseurl=https://vault.centos.org/8.5.2111/BaseOS/$basearch/os/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
enabled=1

[appstream]
name=CentOS-8.5.2111 - AppStream
baseurl=https://vault.centos.org/8.5.2111/AppStream/$basearch/os/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
enabled=1

[extras]
name=CentOS-8.5.2111 - Extras
baseurl=https://vault.centos.org/8.5.2111/extras/$basearch/os/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
enabled=1

# PowerTools 提供 rpcgen、re2c、oniguruma-devel 等编译依赖，安装时按需启用。
[powertools]
name=CentOS-8.5.2111 - PowerTools
baseurl=https://vault.centos.org/8.5.2111/PowerTools/$basearch/os/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
enabled=0

[centosplus]
name=CentOS-8.5.2111 - Plus
baseurl=https://vault.centos.org/8.5.2111/centosplus/$basearch/os/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
enabled=0
