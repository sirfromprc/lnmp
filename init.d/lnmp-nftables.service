[Unit]
Description=LNMP nftables rules (table inet lnmp)
Documentation=man:nft(8)
# 与 nftables.service 同阶段启动，并在其之后加载，避免被 flush ruleset 清掉。
DefaultDependencies=no
After=nftables.service
PartOf=nftables.service
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/etc/nftables.d/lnmp.nft

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=null
ExecStart=/usr/sbin/nft -f /etc/nftables.d/lnmp.nft
ExecStop=-/usr/sbin/nft delete table inet lnmp

[Install]
WantedBy=sysinit.target nftables.service
