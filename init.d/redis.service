[Unit]
Description=Redis
After=network.target

# 崩溃循环退避：60 秒窗口内最多启动 10 次，超出后标记 failed 并停止重试。
# 该限流对人工 restart 同样计数，窗口取短值避免调试期正常重启被拒绝。
# 不设 StartLimitAction，保持默认 none，不触发整机重启。
StartLimitIntervalSec=60
StartLimitBurst=10

# LNMP perm hooks
OnFailure=lnmp-perm-diagnose@%n.service

[Service]
Type=simple
User=redis
Group=redis
# 启动前检查：Type=simple 下 systemd 不等 bind 和配置解析结果，端口占用与
# 配置错误都在这里同步失败，systemctl start/restart 直接返回非零。
ExecStartPre=+/bin/sh -c 'test -x /usr/local/redis/bin/redis-preflight || exit 0; exec /usr/local/redis/bin/redis-preflight /usr/local/redis/etc/redis.conf'
# LNMP perm hooks
ExecStartPre=+/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook pre redis'
ExecStopPost=-+/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook post redis'
# 命令行的 --daemonize no 覆盖 redis.conf 取值，保证 systemd 跟踪的就是 Redis 主进程，
# 无需 PIDFile；旧版本遗留 daemonize yes 的配置升级后也能正常托管。
ExecStart=/usr/local/redis/bin/redis-server /usr/local/redis/etc/redis.conf --daemonize no
# 停止依赖 SIGTERM：Redis 收到后按 save 规则落盘再退出，端口与实例无关，
# 不会像 redis-cli shutdown 那样因端口不是 6379 而失效。
KillSignal=SIGTERM
TimeoutStopSec=90
# 仅进程异常退出时重启，systemctl stop 属主动停止，不触发。
Restart=on-failure
RestartSec=3
PrivateTmp=true

# 限制 Redis 访问不需要的系统资源。
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/usr/local/redis/var

[Install]
WantedBy=multi-user.target
