[Unit]
Description=Redis
After=network.target

# 崩溃循环退避：300 秒窗口内最多启动 5 次，超出后标记 failed 并停止重试。
# 不设 StartLimitAction，保持默认 none，不触发整机重启。
StartLimitIntervalSec=300
StartLimitBurst=5

# LNMP perm hooks
OnFailure=lnmp-perm-diagnose@%n.service

[Service]
Type=forking
User=redis
Group=redis
# PIDFile 必须与 redis.conf 保持一致。
PIDFile=/usr/local/redis/var/redis.pid
# LNMP perm hooks
ExecStartPre=+/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook pre redis'
ExecStopPost=-+/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook post redis'
ExecStart=/usr/local/redis/bin/redis-server /usr/local/redis/etc/redis.conf
ExecStop=-/usr/local/redis/bin/redis-cli shutdown
# 仅进程异常退出时重启，systemctl stop 属主动停止，不触发。
Restart=on-failure
RestartSec=3
PrivateTmp=true

# 限制 Redis 访问不需要的系统资源。
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/usr/local/redis/var

[Install]
WantedBy=multi-user.target
