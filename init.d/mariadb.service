[Unit]
Description=MariaDB Server
After=network.target syslog.target

# LNMP perm hooks
OnFailure=lnmp-perm-diagnose@%n.service

[Service]
Type=forking
RuntimeDirectory=mysqld
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/install -d -o mariadb -g mariadb -m 0755 /run/mysqld

# LNMP perm hooks
ExecStartPre=/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook pre mariadb'
ExecStopPost=-/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook post mariadb'
# 通用二进制依赖 libaio.so.1，兼容链接丢失时在这里补齐并给出明确原因。
ExecStartPre=+/bin/sh -c 'test -x /usr/local/mariadb/bin/db-preflight || exit 0; exec /usr/local/mariadb/bin/db-preflight /usr/local/mariadb/bin/mariadbd'
ExecStart=/etc/init.d/mariadb start
ExecStop=/etc/init.d/mariadb stop
ExecReload=/etc/init.d/mariadb reload

# mysqld_safe 已负责 mysqld 崩溃拉起，systemd 再加一层会形成双重启动者，
# 且 PID 跟踪失真；数据损坏时反复重启会加剧损坏。存活异常由 lnmp-health 告警。
Restart=no
PrivateTmp=true

[Install]
WantedBy=multi-user.target
