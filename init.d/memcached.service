[Unit]
Description=Memcached
After=network.target

[Service]
Type=forking
# 监听地址、端口、账号、容量和连接数统一由 SysV 脚本管理，避免参数重复。
# systemd 通过该脚本启动服务，使进程状态与 systemctl 及运维命令一致。
PIDFile=/run/memcached/memcached.pid
ExecStart=/etc/init.d/memcached start
ExecStop=/etc/init.d/memcached stop

[Install]
WantedBy=multi-user.target
