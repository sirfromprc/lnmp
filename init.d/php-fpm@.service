[Unit]
Description=The PHP %i FastCGI Process Manager
After=network.target

# 崩溃循环退避：300 秒窗口内最多启动 5 次，超出后标记 failed 并停止重试。
# 不设 StartLimitAction，保持默认 none，不触发整机重启。
StartLimitIntervalSec=300
StartLimitBurst=5

# LNMP perm hooks
OnFailure=lnmp-perm-diagnose@%n.service

[Service]
# %i 为版本号，如 8.3；路径与 include/multiplephp.sh 生成的配置一致。
Type=forking
PIDFile=/usr/local/php%i/var/run/php-fpm.pid
RuntimeDirectory=php-fpm
RuntimeDirectoryMode=0755
# LNMP perm hooks
ExecStartPre=-/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook pre php-fpm'
ExecStopPost=-/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook post php-fpm'
ExecStart=/usr/local/php%i/sbin/php-fpm --fpm-config /usr/local/php%i/etc/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
# 停止交给 systemd 发信号，SIGQUIT 为优雅退出。
KillSignal=SIGQUIT
# 仅进程异常退出时重启，systemctl stop 属主动停止，不触发。
Restart=on-failure
RestartSec=3
PrivateTmp=true

[Install]
WantedBy=multi-user.target
