[Unit]
Description=The NGINX HTTP and reverse proxy server
After=network.target remote-fs.target nss-lookup.target

# 崩溃循环退避：60 秒窗口内最多启动 10 次，超出后标记 failed 并停止重试。
# 该限流对人工 restart 同样计数，窗口取短值避免调试期正常重启被拒绝。
# 不设 StartLimitAction，保持默认 none，不触发整机重启。
StartLimitIntervalSec=60
StartLimitBurst=10

# LNMP perm hooks
OnFailure=lnmp-perm-diagnose@%n.service

[Service]
Type=forking
PIDFile=/usr/local/nginx/logs/nginx.pid
# LNMP perm hooks
ExecStartPre=-/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook pre nginx'
ExecStopPost=-/bin/sh -c 'test -x /bin/lnmp-perm || exit 0; exec /bin/lnmp-perm hook post nginx'
ExecStart=/usr/local/nginx/sbin/nginx -c /usr/local/nginx/conf/nginx.conf
ExecReload=/usr/local/nginx/sbin/nginx -s reload
# 停止交给 systemd 发信号，SIGQUIT 为优雅退出。
KillSignal=SIGQUIT
# 仅进程异常退出时重启，systemctl stop 属主动停止，不触发。
Restart=on-failure
RestartSec=3
PrivateTmp=true

[Install]
WantedBy=multi-user.target
