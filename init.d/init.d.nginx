#! /bin/sh
# chkconfig: 2345 55 25
# Description: Startup script for nginx webserver on Debian. Place in /etc/init.d and
# run 'update-rc.d -f nginx defaults', or use the appropriate command on your
# distro. For CentOS/Redhat run: 'chkconfig --add nginx'

### BEGIN INIT INFO
# Provides:          nginx
# Required-Start:    $all
# Required-Stop:     $all
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: starts the nginx web server
# Description:       starts nginx using start-stop-daemon
### END INIT INFO

# Author:   licess
# website:  https://lnmp.org

NGINX_BIN='/usr/local/nginx/sbin/nginx'
CONFIG='/usr/local/nginx/conf/nginx.conf'
# conf/nginx.conf、nginx_a.conf、openresty.conf 三份配置里都是这个路径；
# OpenResty 通过 /usr/local/nginx 软链落到自己的前缀，同样成立。
NGINX_PID='/usr/local/nginx/logs/nginx.pid'

# Nginx_Is_Nginx <pid> — 这个 pid 是否真的是 nginx 进程
#
# 判据是 /proc/<pid>/exe 指向的可执行文件，不是进程名。两个原因：
#
#   1. pid 会被系统回收再分配。只做 kill -0 只能证明"这个号码上有进程"，
#      不能证明它还是 nginx，而 stop 和 force-quit 是要 kill 它的。
#   2. 只比对 comm 同样不行：shebang 脚本的 comm 是脚本名，而本脚本自己就叫
#      nginx。实测 `pgrep -x nginx` 会把这个 init 脚本自身匹配进来，于是
#      status 报"nginx 在跑"（其实只有脚本自己），stop 和 force-quit 则直接
#      kill 掉自己 —— 实测退出码 143（SIGTERM）。
Nginx_Is_Nginx()
{
    _exe=$(readlink -f "/proc/$1/exe" 2>/dev/null)
    _want=$(readlink -f "$NGINX_BIN" 2>/dev/null)
    # /proc 不可用时退回进程名，并显式排除本脚本自己
    if [ -z "$_exe" ] || [ -z "$_want" ]; then
        [ "$1" = "$$" ] && return 1
        _comm=$(ps -p "$1" -o comm= 2>/dev/null)
        [ "$_comm" = "nginx" ] && return 0
        return 1
    fi
    [ "$_exe" = "$_want" ]
}

# Nginx_Pid — 在跑返回 0 并把 master 的 pid 放进 PID，否则返回 1
#
# 原来各分支都用 `ps -ef | grep "$NGINX_BIN"` 找进程：命令行里出现过这个
# 路径的进程全都算数 —— 编辑器、tail、甚至一条带路径的 ssh 命令都会被当成
# nginx 在跑，status 凭空报成功，start 则拒绝启动。
# 改为以 pid 文件为准并逐个核对可执行文件；pid 文件不可用时按进程名找候选，
# 但仍要过 Nginx_Is_Nginx 这一关才算数。
Nginx_Pid()
{
    _p=''
    PID=''
    if [ -s "$NGINX_PID" ]; then
        _p=$(cat "$NGINX_PID" 2>/dev/null)
        case "$_p" in
            ''|*[!0-9]*) _p='' ;;
        esac
        if [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null && Nginx_Is_Nginx "$_p"; then
            PID="$_p"
            return 0
        fi
    fi

    # pid 文件缺失、为空或已经失效（包安装遗留、被删、进程没了）时，
    # 按进程名找候选，逐个核对
    for _p in $(pgrep -x nginx 2>/dev/null); do
        case "$_p" in
            ''|*[!0-9]*) continue ;;
        esac
        kill -0 "$_p" 2>/dev/null || continue
        Nginx_Is_Nginx "$_p" || continue
        # 只认 master：worker 的父进程也是 nginx，kill 掉 worker 只会被 master
        # 立刻拉起来，stop 看着成功其实没停。
        _pp=$(ps -p "$_p" -o ppid= 2>/dev/null | tr -d ' ')
        if [ -n "$_pp" ] && Nginx_Is_Nginx "$_pp"; then
            continue
        fi
        PID="$_p"
        return 0
    done
    return 1
}

case "$1" in
    start)
        echo -n "正在启动 Nginx... "

        if Nginx_Pid; then
            # 已经在跑就是"已达成目标"，返回 0 保持幂等，与 redis、pureftpd 一致。
            # 返回 1 会让重复执行的安装流程把正常情况当成失败。
            echo "Nginx 已在运行（pid $PID）。"
            exit 0
        fi

        $NGINX_BIN -c $CONFIG

        if [ "$?" != 0 ]; then
            echo " 失败"
            exit 1
        else
            echo " 完成"
        fi
        ;;

    stop)
        echo -n "正在停止 Nginx... "

        if ! Nginx_Pid; then
            echo "Nginx 未运行。"
            exit 1
        fi

        $NGINX_BIN -s stop

        if [ "$?" != 0 ] ; then
            echo " 失败，请使用 force-quit。"
            $0 force-quit
        else
            echo " 完成"
        fi
        ;;

    status)
        # 原来两个分支的返回码是反的：服务停止时 exit 0，在跑时靠 echo 的
        # 退出码碰巧也是 0，等于无论如何都报成功，调用方判断不了状态。
        # LSB 约定：0 表示在跑，3 表示没在跑。
        if Nginx_Pid; then
            echo "Nginx 正在运行（pid $PID）。"
            exit 0
        else
            echo "Nginx 已停止。"
            exit 3
        fi
        ;;

    force-quit|kill)
        echo -n "正在强制终止 Nginx... "

        if ! Nginx_Pid; then
            echo "Nginx 已停止。"
            exit 1
        fi

        kill $PID

        if [ "$?" != 0 ]; then
            echo " 失败"
            exit 1
        else
            echo " 完成"
        fi
        ;;

    restart)
        $0 stop
        sleep 1
        $0 start
        ;;

    reload)
        echo -n "正在重载 Nginx... "

        if Nginx_Pid; then
            # reload 失败必须传出去：conf/lnmp 的 vhost 删除靠这一步让站点真正
            # 下线，只打印 done 而返回 0，等于删完站点还在线也没人知道。
            if ! $NGINX_BIN -s reload; then
                echo " 失败"
                exit 1
            fi
            echo " 完成"
        else
            echo "Nginx 未运行，无法重载。"
            exit 1
        fi
        ;;

    configtest)
        echo -n "正在检查 Nginx 配置文件... "

        $NGINX_BIN -t
        ;;

    *)
        echo "用法：$0 {start|stop|restart|reload|status|configtest|force-quit|kill}"
        exit 1
        ;;

esac
