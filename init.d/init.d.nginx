#! /bin/sh
# chkconfig: 2345 55 25
# Description: Startup script for nginx webserver on Debian. Place in /etc/init.d and
# run 'update-rc.d -f nginx defaults', or use the appropriate command on your
# distro. For CentOS/Redhat run: 'chkconfig --add nginx'

### BEGIN INIT INFO
# Provides:          nginx
# Required-Start:    $all
# Required-Stop:     $all
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: starts the nginx web server
# Description:       starts nginx using start-stop-daemon
### END INIT INFO

# Author:   licess
# website:  https://lnmp.org

NGINX_BIN='/usr/local/nginx/sbin/nginx'
CONFIG='/usr/local/nginx/conf/nginx.conf'
# Nginx 和 OpenResty 配置统一通过兼容路径使用此 pid 文件。
NGINX_PID='/usr/local/nginx/logs/nginx.pid'

# 通过 /proc/<pid>/exe 确认 pid 对应 Nginx 二进制，避免 pid 复用或同名脚本
# 导致状态误判及终止错误进程。
Nginx_Is_Nginx()
{
    _exe=$(readlink -f "/proc/$1/exe" 2>/dev/null)
    _want=$(readlink -f "$NGINX_BIN" 2>/dev/null)
    # /proc 不可用时检查进程名，并排除当前脚本进程。
    if [ -z "$_exe" ] || [ -z "$_want" ]; then
        [ "$1" = "$$" ] && return 1
        _comm=$(ps -p "$1" -o comm= 2>/dev/null)
        [ "$_comm" = "nginx" ] && return 0
        return 1
    fi
    [ "$_exe" = "$_want" ]
}

# 运行时返回 Nginx master pid；优先使用 pid 文件，失效时核对同名进程的
# 实际可执行文件。
Nginx_Pid()
{
    _p=''
    PID=''
    if [ -s "$NGINX_PID" ]; then
        _p=$(cat "$NGINX_PID" 2>/dev/null)
        case "$_p" in
            ''|*[!0-9]*) _p='' ;;
        esac
        if [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null && Nginx_Is_Nginx "$_p"; then
            PID="$_p"
            return 0
        fi
    fi

    # pid 文件不可用时逐个核对同名候选进程。
    for _p in $(pgrep -x nginx 2>/dev/null); do
        case "$_p" in
            ''|*[!0-9]*) continue ;;
        esac
        kill -0 "$_p" 2>/dev/null || continue
        Nginx_Is_Nginx "$_p" || continue
        # 仅返回 master；worker 的父进程同样是 Nginx。
        _pp=$(ps -p "$_p" -o ppid= 2>/dev/null | tr -d ' ')
        if [ -n "$_pp" ] && Nginx_Is_Nginx "$_pp"; then
            continue
        fi
        PID="$_p"
        return 0
    done
    return 1
}

case "$1" in
    start)
        echo -n "正在启动 Nginx... "

        if Nginx_Pid; then
            # 服务已运行时返回成功，使重复启动保持幂等。
            echo "Nginx 已在运行（pid $PID）。"
            exit 0
        fi

        $NGINX_BIN -c $CONFIG

        if [ "$?" != 0 ]; then
            echo " 失败"
            exit 1
        else
            echo " 完成"
        fi
        ;;

    stop)
        echo -n "正在停止 Nginx... "

        if ! Nginx_Pid; then
            echo "Nginx 未运行。"
            exit 1
        fi

        $NGINX_BIN -s stop

        if [ "$?" != 0 ] ; then
            echo " 失败，请使用 force-quit。"
            $0 force-quit
        else
            echo " 完成"
        fi
        ;;

    status)
        # 按 LSB 约定返回 0（运行）或 3（停止）。
        if Nginx_Pid; then
            echo "Nginx 正在运行（pid $PID）。"
            exit 0
        else
            echo "Nginx 已停止。"
            exit 3
        fi
        ;;

    force-quit|kill)
        echo -n "正在强制终止 Nginx... "

        if ! Nginx_Pid; then
            echo "Nginx 已停止。"
            exit 1
        fi

        kill $PID

        if [ "$?" != 0 ]; then
            echo " 失败"
            exit 1
        else
            echo " 完成"
        fi
        ;;

    restart)
        $0 stop
        sleep 1
        $0 start
        ;;

    reload)
        echo -n "正在重载 Nginx... "

        if Nginx_Pid; then
            # 返回重载的真实结果，使虚拟主机变更能够确认已生效。
            if ! $NGINX_BIN -s reload; then
                echo " 失败"
                exit 1
            fi
            echo " 完成"
        else
            echo "Nginx 未运行，无法重载。"
            exit 1
        fi
        ;;

    configtest)
        echo -n "正在检查 Nginx 配置文件... "

        $NGINX_BIN -t
        ;;

    *)
        echo "用法：$0 {start|stop|restart|reload|status|configtest|force-quit|kill}"
        exit 1
        ;;

esac
