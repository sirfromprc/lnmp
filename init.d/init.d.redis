#! /bin/bash
#
# redis - this script starts and stops the redis-server daemon
#
# chkconfig:    2345 80 90
# description:  Redis is a persistent key-value database
#
### BEGIN INIT INFO
# Provides:          redis
# Required-Start:    $syslog
# Required-Stop:     $syslog
# Should-Start:        $local_fs
# Should-Stop:        $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description:    redis-server daemon
# Description:        redis-server daemon
### END INIT INFO

REDISPORT=6379
EXEC=/usr/local/redis/bin/redis-server
REDIS_CLI=/usr/local/redis/bin/redis-cli

PIDFILE=/usr/local/redis/var/redis.pid
CONF="/usr/local/redis/etc/redis.conf"
RUNAS=redis
Redis_Exec()
{
    if ! id -u "${RUNAS}" >/dev/null 2>&1; then
        echo "警告：账号 ${RUNAS} 不存在，将以当前用户($(id -un))启动 Redis。"
        echo "      建议创建专用账号：useradd -r -M -s /sbin/nologin ${RUNAS}"
        echo "      并把 /usr/local/redis/var 的属主改为它。"
        "$EXEC" "$CONF"
        return $?
    fi

    # 当前用户已是 Redis 专用账号时直接启动。
    if [ "$(id -un)" = "${RUNAS}" ]; then
        "$EXEC" "$CONF"
        return $?
    fi

    if command -v setpriv >/dev/null 2>&1; then
        setpriv --reuid="${RUNAS}" --regid="${RUNAS}" --init-groups "$EXEC" "$CONF"
    else
        su -s /bin/sh -c "'$EXEC' '$CONF'" "${RUNAS}"
    fi
}

# 运行时返回 0，并将进程号写入 REDIS_PID。
Redis_Running()
{
    REDIS_PID=''
    [ -f "$PIDFILE" ] || return 1
    REDIS_PID=$(cat "$PIDFILE" 2>/dev/null)
    case "$REDIS_PID" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$REDIS_PID" 2>/dev/null || return 1
    return 0
}

case "$1" in
    start)
        if Redis_Running; then
            echo "Redis 服务已在运行（pid $REDIS_PID）。"
            exit 0
        fi

        if [ -f "$PIDFILE" ]; then
            echo "正在删除失效的 pid 文件 $PIDFILE"
            rm -f "$PIDFILE"
        fi
        echo -n "正在启动 Redis 服务..."
        Redis_Exec
        rc=$?
        # daemonize yes 会立即返回，等待子进程写入 pid 文件后再判断结果。
        i=0
        while [ $i -lt 20 ]; do
            Redis_Running && break
            sleep 0.2
            i=$((i + 1))
        done
        if Redis_Running; then
            echo " 完成（pid $REDIS_PID）"
        else
            echo " 失败"
            echo "redis-server 退出码 ${rc}。常见原因："
            echo "  - 配置里的 loadmodule 指向了未安装的模块（Redis 8.x 默认配置会带）"
            echo "  - 端口 ${REDISPORT} 被占用，或 dir 指定的目录不可写"
            echo "排查：${EXEC} ${CONF} --daemonize no"
            exit 1
        fi
        ;;
    stop)
        if ! Redis_Running; then
            echo "Redis 服务未运行。"
            [ -f "$PIDFILE" ] && { echo "正在删除失效的 pid 文件 $PIDFILE"; rm -f "$PIDFILE"; }
            exit 0
        fi
        echo -n "正在停止 Redis 服务..."
        "$REDIS_CLI" -p "$REDISPORT" shutdown 2>/dev/null
        i=0
        while [ $i -lt 30 ]; do
            Redis_Running || break
            sleep 0.2
            i=$((i + 1))
        done
        if Redis_Running; then
            echo " 失败（pid $REDIS_PID 仍在运行）"
            exit 1
        fi
        rm -f "$PIDFILE"
        echo " 完成"
        ;;
    restart)
        ${0} stop || exit 1
        ${0} start
        ;;
    kill)
        echo -n "正在强制终止 Redis 服务..."
        if killall redis-server 2>/dev/null; then
            rm -f "$PIDFILE"
            echo " 完成"
        else
            echo " 未找到 redis-server 进程"
        fi
        ;;
    status)
        if Redis_Running; then
            echo "Redis 服务正在运行（pid $REDIS_PID）。"
            exit 0
        elif [ -f "$PIDFILE" ]; then
            echo "Redis 服务已停止（存在失效的 pid 文件 $PIDFILE）。"
            exit 1
        else
            echo "Redis 服务已停止。"
            exit 3
        fi
        ;;
  *)
    echo "用法：/etc/init.d/redis {start|stop|restart|status|kill}" >&2
        exit 1
esac
